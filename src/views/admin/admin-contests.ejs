<%- include('partials/admin-shell-start', {
  title: 'Contests',
  mobileTitle: 'Contests',
  activeTab: 'contests'
}) %>

<div class="page-head">
  <div>
    <h1>Contests</h1>
    <div class="sub">Create and manage contests.</div>
  </div>

  <div class="page-actions">
    <a class="btn ghost" href="/admin/contests/export.csv">Export CSV</a>
  </div>
</div>

<div class="card">
  <div class="strong" style="margin-bottom:6px">Create Contest</div>
  <div class="tiny">Add a new contest with title, price, description, deadline, and image.</div>

  <div class="section-line"></div>

  <form method="POST" action="/admin/contests/create">
    <div class="grid grid-2">
      <div>
        <label for="title">Title</label>
        <input id="title" name="title" placeholder="Contest title" required minlength="3" />
      </div>

      <div>
        <label for="price">Price</label>
        <input id="price" name="price" inputmode="numeric" placeholder="e.g. 199" />
        <div class="tiny" style="margin-top:6px">0 allowed</div>
      </div>
    </div>

    <div style="margin-top:12px">
      <label for="description">Description</label>
      <textarea id="description" name="description"></textarea>
    </div>

    <div class="grid grid-2" style="margin-top:12px">
      <div>
        <label for="submission_deadline">Submission Deadline (ISO)</label>
        <input id="submission_deadline" name="submission_deadline" placeholder="2026-01-31" />
      </div>

      <div>
        <label for="image_url">Image URL</label>
        <input id="image_url" name="image_url" placeholder="https://..." />
      </div>
    </div>

    <div style="margin-top:14px">
      <button class="btn primary" type="submit">Create Contest</button>
    </div>
  </form>
</div>

<div class="card">
  <div class="row" style="justify-content:space-between;margin-bottom:12px">
    <div>
      <div class="strong">Existing Contests</div>
      <div class="tiny">Edit details, update status, and manage visibility.</div>
    </div>
    <span class="pill"><%= (contests || []).length %> contest(s)</span>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th style="min-width:220px">Contest</th>
          <th style="min-width:420px">Details</th>
          <th style="min-width:100px">Active</th>
          <th style="min-width:180px">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% (contests || []).forEach(c => { %>
          <tr>
            <td>
              <div class="strong"><%= c.title %></div>
              <div class="tiny" style="margin-top:4px">
                ₹<%= c.price %> • Deadline: <%= c.submission_deadline || '-' %>
              </div>

              <% if (c.image_url) { %>
                <div class="tiny" style="margin-top:8px;word-break:break-all">
                  <%= c.image_url %>
                </div>
              <% } %>
            </td>

            <td>
              <div class="tiny" style="margin-bottom:10px"><%= c.description || '-' %></div>

              <form method="POST" action="/admin/contests/update">
                <input type="hidden" name="id" value="<%= c.id %>" />

                <div class="grid grid-2">
                  <div>
                    <label>Edit title</label>
                    <input name="title" value="<%= c.title %>" required minlength="3" />
                  </div>

                  <div>
                    <label>Edit price</label>
                    <input name="price" value="<%= c.price %>" inputmode="numeric" />
                  </div>
                </div>

                <div style="margin-top:10px">
                  <label>Edit description</label>
                  <textarea name="description"><%= c.description || '' %></textarea>
                </div>

                <div class="grid grid-2" style="margin-top:10px">
                  <div>
                    <label>Edit deadline</label>
                    <input name="submission_deadline" value="<%= c.submission_deadline || '' %>" />
                  </div>

                  <div>
                    <label>Edit image URL</label>
                    <input name="image_url" value="<%= c.image_url || '' %>" />
                  </div>
                </div>

                <div style="margin-top:12px" class="row mobile-stack">
                  <button class="btn ghost" type="submit">Save Changes</button>
                </div>
              </form>
            </td>

            <td>
              <span class="pill"><%= c.is_active ? 'Yes' : 'No' %></span>
            </td>

            <td>
              <form method="POST" action="/admin/contests/toggle">
                <input type="hidden" name="id" value="<%= c.id %>" />
                <button class="btn ghost" type="submit">
                  <%= c.is_active ? 'Deactivate' : 'Activate' %>
                </button>
              </form>
            </td>
          </tr>
        <% }) %>

        <% if (!contests || !contests.length) { %>
          <tr>
            <td colspan="4" class="muted">No contests found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-shell-end') %>