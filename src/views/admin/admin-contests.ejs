<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin - Contests</title>
  <style>
    body{margin:0;font-family:Segoe UI,Tahoma,Verdana,sans-serif;background:#0b1224;color:#fff}
    .layout{display:flex;min-height:100vh}
    .sidebar{width:260px;background:#0a1022;border-right:1px solid rgba(255,255,255,.08);padding:18px}
    .brand{font-weight:900;margin-bottom:18px}
    .nav a{display:block;padding:10px 12px;border-radius:12px;text-decoration:none;color:rgba(255,255,255,.85);margin-bottom:8px}
    .nav a.active{background:rgba(26,60,255,.18);border:1px solid rgba(26,60,255,.35);color:#fff}
    .content{flex:1;min-width:0}
    .wrap{max-width:1100px;margin:26px auto;padding:0 18px}
    .card{background:#111b35;border:1px solid rgba(255,255,255,.12);border-radius:18px;padding:18px}
    input,textarea{width:100%;padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,.18);background:#0e1630;color:#fff}
    textarea{min-height:70px}
    .grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .btn{border:none;border-radius:12px;padding:10px 12px;font-weight:900;cursor:pointer}
    .btn.primary{background:#1a3cff;color:#fff}
    .btn.ghost{background:rgba(255,255,255,.10);color:#fff}
    table{width:100%;border-collapse:collapse;margin-top:14px}
    th,td{padding:10px;border-bottom:1px solid rgba(255,255,255,.10);text-align:left;vertical-align:top}
    .muted{color:rgba(255,255,255,.7)}
    .mini{font-size:12px;color:rgba(255,255,255,.7)}
    @media (max-width: 900px){
      .grid2{grid-template-columns:1fr}
      .mobile-topbar{display:flex !important}
      .sidebar{
        position:fixed;
        left:0;
        top:0;
        bottom:0;
        z-index:1199;
        transform:translateX(-100%);
        transition:transform .22s ease;
        box-shadow:0 10px 30px rgba(0,0,0,.35);
        overflow:auto;
        flex-shrink:0;
      }
      body.menu-open .sidebar{transform:translateX(0)}
      body.menu-open .sidebar-backdrop{display:block}
      .wrap{margin:18px auto;padding:0 14px}
    }
  

  .mobile-topbar{
    display:none;
    position:sticky;
    top:0;
    z-index:1200;
    padding:12px 14px;
    background:#0a1022;
    border-bottom:1px solid rgba(255,255,255,.08);
    align-items:center;
    justify-content:space-between;
    gap:12px;
  }
  .mobile-title{font-weight:900}
  .menu-btn{
    border:none;
    border-radius:12px;
    padding:10px 12px;
    font-weight:900;
    cursor:pointer;
    background:#1a3cff;
    color:#fff;
  }

  .sidebar-backdrop{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.45);
    z-index:1198;
  }

</style>
</head>
<body>
<div class="mobile-topbar">
  <button type="button" class="menu-btn" onclick="toggleAdminMenu()">☰ Menu</button>
  <div class="mobile-title">Admin Panel</div>
</div>

<div class="sidebar-backdrop" onclick="closeAdminMenu()"></div>
  <div class="layout">
    <aside class="sidebar">
      <div class="brand">Admin Panel</div>
      <div class="nav">
  <a href="/admin">Overview</a>
  <a href="/admin/user360">View User</a>
  <a href="/admin/users">All Users</a>
  <a href="/admin/feedback">All Feedback</a>
  <a href="/admin/shipment-stock">Current Book Stock</a>
  <a href="/admin/shipments">Online Shipments</a>
  <a href="/admin/orders">Online Orders</a>
  <a href="/admin/submissions">Online Submissions</a>
  <a href="/admin/contests" class="active">Online Contests</a>
  <a href="/admin/offline-dashboard">Offline Overview</a>
  <a href="/admin/offline-orders">Offline Orders</a>
  <a href="/admin/agents">Offline Agents</a>
  <a href="/admin/payments/reconcile-bulk">Razorpay Reconcile</a>
  <a href="/logout" style="margin-top:14px;opacity:.9">Logout</a>
</div>
    </aside>

    <main class="content">
      <div class="wrap">
        <div class="card">
          <h1 style="margin:0 0 6px 0">Contests</h1>
          <div class="muted">Create and manage contests</div>
<a class="btn ghost" href="/admin/contests/export.csv">Export CSV</a>

          <div style="height:1px;background:rgba(255,255,255,.12);margin:14px 0"></div>

          <form method="POST" action="/admin/contests/create">
            <div class="grid2">
              <div>
                <label class="muted">Title</label>
                <input name="title" placeholder="Contest title" required minlength="3" />
              </div>
              <div>
                <label class="muted">Price</label>
                <input name="price" inputmode="numeric" placeholder="e.g. 199" />
                <div class="mini">0 allowed</div>
              </div>
            </div>

            <div style="margin-top:12px">
              <label class="muted">Description</label>
              <textarea name="description"></textarea>
            </div>

            <div class="grid2" style="margin-top:12px">
              <div>
                <label class="muted">Submission Deadline (ISO)</label>
                <input name="submission_deadline" placeholder="2026-01-31" />
              </div>
              <div>
                <label class="muted">Image URL</label>
                <input name="image_url" placeholder="https://..." />
              </div>
            </div>

            <div style="margin-top:12px">
              <button class="btn primary" type="submit">Create Contest</button>
            </div>
          </form>

          <table>
            <thead>
              <tr>
                <th style="width:260px">Contest</th>
                <th>Details</th>
                <th style="width:150px">Active</th>
                <th style="width:220px">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% contests.forEach(c => { %>
                <tr>
                  <td>
                    <div style="font-weight:900"><%= c.title %></div>
                    <div class="mini">₹<%= c.price %> • Deadline: <%= c.submission_deadline || '-' %></div>
                    <% if (c.image_url) { %>
                      <div class="mini" style="margin-top:6px;word-break:break-all"><%= c.image_url %></div>
                    <% } %>
                  </td>
                  <td>
                    <div class="mini"><%= c.description || '-' %></div>
                    <div style="margin-top:10px">
                      <form method="POST" action="/admin/contests/update">
                        <input type="hidden" name="id" value="<%= c.id %>" />
                        <div class="grid2">
                          <div>
                            <div class="mini">Edit title</div>
                            <input name="title" value="<%= c.title %>" required minlength="3" />
                          </div>
                          <div>
                            <div class="mini">Edit price</div>
                            <input name="price" value="<%= c.price %>" inputmode="numeric" />
                          </div>
                        </div>
                        <div style="margin-top:10px">
                          <div class="mini">Edit description</div>
                          <textarea name="description"><%= c.description || '' %></textarea>
                        </div>
                        <div class="grid2" style="margin-top:10px">
                          <div>
                            <div class="mini">Edit deadline</div>
                            <input name="submission_deadline" value="<%= c.submission_deadline || '' %>" />
                          </div>
                          <div>
                            <div class="mini">Edit image_url</div>
                            <input name="image_url" value="<%= c.image_url || '' %>" />
                          </div>
                        </div>

                        <div style="margin-top:10px" class="row">
                          <button class="btn ghost" type="submit">Save Changes</button>
                        </div>
                      </form>
                    </div>
                  </td>
                  <td><%= c.is_active ? 'Yes' : 'No' %></td>
                  <td>
                    <form method="POST" action="/admin/contests/toggle" style="display:inline">
                      <input type="hidden" name="id" value="<%= c.id %>" />
                      <button class="btn ghost" type="submit"><%= c.is_active ? 'Deactivate' : 'Activate' %></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>

        </div>
      </div>
    </main>
  </div>
<script>
  function toggleAdminMenu() {
    document.body.classList.toggle("menu-open");
  }

  function closeAdminMenu() {
    document.body.classList.remove("menu-open");
  }

  document.addEventListener("keydown", function(e) {
    if (e.key === "Escape") closeAdminMenu();
  });
</script>
</body>
</html>
