<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin - Overview</title>

  <style>
  body{margin:0;font-family:Segoe UI,Tahoma,Verdana,sans-serif;background:#0b1224;color:#fff}
  .layout{display:flex;min-height:100vh}
  .sidebar{
    width:260px;background:#0a1022;border-right:1px solid rgba(255,255,255,.08);
    padding:18px;flex-shrink:0
  }
  .brand{font-weight:900;margin-bottom:18px}
  .nav a{display:block;padding:10px 12px;border-radius:12px;text-decoration:none;color:rgba(255,255,255,.85);margin-bottom:8px}
  .nav a.active{background:rgba(26,60,255,.18);border:1px solid rgba(26,60,255,.35);color:#fff}
  .content{flex:1;min-width:0}
  .wrap{max-width:1200px;margin:26px auto;padding:0 18px}
  .card{background:#111b35;border:1px solid rgba(255,255,255,.12);border-radius:18px;padding:18px;margin-bottom:14px}
  .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
  .grid-6{display:grid;grid-template-columns:repeat(6,1fr);gap:14px}
  .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
  .grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
  .stat{background:#0e1630;border:1px solid rgba(255,255,255,.10);border-radius:16px;padding:14px;min-height:96px}
  .muted{color:rgba(255,255,255,.7)}
  .row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
  .row-between{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
  .btn{
    border:none;border-radius:12px;padding:10px 12px;font-weight:900;cursor:pointer;
    background:rgba(255,255,255,.10);color:#fff;text-decoration:none;display:inline-flex;align-items:center;justify-content:center
  }
  .btn.active{background:#1a3cff}
  .btn.ghost{border:1px solid rgba(255,255,255,.16)}
  .section-head{margin:0 0 10px 0;font-size:18px;font-weight:900}
  .stat-label{color:rgba(255,255,255,.72);font-size:13px;margin-bottom:8px}
  .stat-value{font-size:28px;font-weight:900;line-height:1.1}
  .pill{
    display:inline-flex;align-items:center;gap:6px;
    padding:6px 10px;border-radius:999px;font-size:12px;font-weight:800;
    background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12)
  }
  table{width:100%;border-collapse:collapse;margin-top:10px}
  th,td{padding:10px;border-bottom:1px solid rgba(255,255,255,.10);text-align:left}
  th{color:rgba(255,255,255,.78);font-size:13px}
  td{font-size:14px}
  .subtle-divider{height:1px;background:rgba(255,255,255,.12);margin:14px 0}
  .stats-section{margin-bottom:18px}
  .stats-caption{display:flex;align-items:center;gap:8px;margin-bottom:10px}
  .stats-caption .emoji{font-size:16px}
  .stats-caption .text{font-size:18px;font-weight:900}
  .chart-note{font-size:12px;color:rgba(255,255,255,.65)}

  .mobile-topbar{
    display:none;
    position:sticky;
    top:0;
    z-index:1200;
    padding:12px 14px;
    background:#0a1022;
    border-bottom:1px solid rgba(255,255,255,.08);
    align-items:center;
    justify-content:space-between;
    gap:12px;
  }
  .mobile-title{font-weight:900}
  .menu-btn{
    border:none;
    border-radius:12px;
    padding:10px 12px;
    font-weight:900;
    cursor:pointer;
    background:#1a3cff;
    color:#fff;
  }

  .sidebar-backdrop{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.45);
    z-index:1198;
  }

  @media (max-width: 1200px){
    .grid-6{grid-template-columns:repeat(3,1fr)}
  }

  @media (max-width: 1000px){
    .grid,.grid-3,.grid-2{grid-template-columns:repeat(2,1fr)}
    .grid-6{grid-template-columns:repeat(2,1fr)}
    .mobile-topbar{display:flex}
    .sidebar{
      position:fixed;
      left:0;
      top:0;
      bottom:0;
      z-index:1199;
      transform:translateX(-100%);
      transition:transform .22s ease;
      box-shadow:0 10px 30px rgba(0,0,0,.35);
      overflow:auto;
    }
    body.menu-open .sidebar{transform:translateX(0)}
    body.menu-open .sidebar-backdrop{display:block}
    .wrap{margin:18px auto;padding:0 14px}
  }

  @media (max-width: 700px){
    .grid,.grid-3,.grid-2,.grid-6{grid-template-columns:1fr}
    .stat-value{font-size:24px}
  }
</style>
</head>
<body>
  <div class="mobile-topbar">
    <button type="button" class="menu-btn" onclick="toggleAdminMenu()">☰ Menu</button>
    <div class="mobile-title">Admin Panel</div>
  </div>

  <div class="sidebar-backdrop" onclick="closeAdminMenu()"></div>

  <div class="layout">
    <aside class="sidebar">
      <div class="brand">Admin Panel</div>
      <div class="nav">
        <a href="/admin" class="active">Overview</a>
        <a href="/admin/offline-dashboard">Offline Dashboard</a>
        <a href="/admin/contests">Contests</a>
        <a href="/admin/user360">View User</a>
        <a href="/admin/orders">Orders</a>
        <a href="/admin/submissions">Submissions</a>
        <a href="/admin/shipments">Shipments</a>
        <a href="/admin/shipment-stock">Shipment Stock</a>
        <a href="/admin/users">Users</a>
        <a href="/admin/feedback">Feedback</a>
        <a href="/admin/payments/reconcile-bulk">Bulk Reconcile</a>
        <a href="/admin/agents">Agents</a>
        <a href="/admin/offline-orders">Offline Orders</a>
        <a href="/logout" style="margin-top:14px;opacity:.9">Logout</a>
      </div>
    </aside>

    <main class="content">
      <div class="wrap">

        <div class="card">
          <div class="row-between">
            <div>
              <h1 style="margin:0 0 6px 0">Admin Overview</h1>
              <div class="muted">Today vs overall contest performance</div>
            </div>

            <div class="row">
              <span class="pill">📍 IST-based reporting</span>
              <a class="btn ghost" href="/admin/export/overview.csv">Export CSV</a>
            </div>
          </div>

          <div class="subtle-divider"></div>

          <div class="stats-section">
            <div class="stats-caption">
              <span class="emoji">📅</span>
              <span class="text">Today's Stats</span>
            </div>

            <div class="grid-6">
              <div class="stat">
                <div class="stat-label">Orders Today</div>
                <div class="stat-value"><%= Number(stats.todayOrdersAll || 0).toLocaleString('en-IN') %></div>
              </div>
              <div class="stat">
                <div class="stat-label">Paid Today</div>
                <div class="stat-value"><%= Number(stats.todayPaidOrders || 0).toLocaleString('en-IN') %></div>
              </div>
              <div class="stat">
                <div class="stat-label">Gift Book Today</div>
                <div class="stat-value"><%= Number(stats.todayGift || 0).toLocaleString('en-IN') %></div>
              </div>
              <div class="stat">
                <div class="stat-label">Donation Today</div>
                <div class="stat-value"><%= Number(stats.todayDonate || 0).toLocaleString('en-IN') %></div>
              </div>
              <div class="stat">
                <div class="stat-label">Pending/Failed Today</div>
                <div class="stat-value"><%= Number(stats.todayPendingOrders || 0).toLocaleString('en-IN') %></div>
              </div>
              <div class="stat">
                <div class="stat-label">Revenue Today</div>
                <div class="stat-value">₹<%= Number(stats.todayRevenue || 0).toLocaleString('en-IN') %></div>
              </div>
            </div>
          </div>

          <div class="stats-section" style="margin-bottom:0">
            <div class="stats-caption">
              <span class="emoji">📊</span>
              <span class="text">Total Stats</span>
            </div>

            <div class="grid">
              <div class="stat">
                <div class="stat-label">Users</div>
                <div class="stat-value"><%= Number(stats.users || 0).toLocaleString('en-IN') %></div>
              </div>
              <div class="stat">
                <div class="stat-label">Total Orders</div>
                <div class="stat-value"><%= Number(stats.ordersAll || 0).toLocaleString('en-IN') %></div>
              </div>
              <div class="stat">
                <div class="stat-label">Paid Orders</div>
                <div class="stat-value"><%= Number(stats.paidOrders || 0).toLocaleString('en-IN') %></div>
              </div>
              <div class="stat">
                <div class="stat-label">Gift Book (paid)</div>
                <div class="stat-value"><%= Number(stats.gift || 0).toLocaleString('en-IN') %></div>
              </div>
              <div class="stat">
                <div class="stat-label">Donation (paid)</div>
                <div class="stat-value"><%= Number(stats.donate || 0).toLocaleString('en-IN') %></div>
              </div>
              <div class="stat">
                <div class="stat-label">Pending/Failed</div>
                <div class="stat-value"><%= Number(stats.pendingOrders || 0).toLocaleString('en-IN') %></div>
              </div>
              <div class="stat">
                <div class="stat-label">Total Revenue</div>
                <div class="stat-value">₹<%= Number(stats.revenue || 0).toLocaleString('en-IN') %></div>
              </div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="row-between">
            <div>
              <h2 style="margin:0 0 6px 0">Sales Report</h2>
              <div class="muted">Revenue trend from paid orders</div>
              <div class="chart-note" style="margin-top:6px">Chart should begin from March 27, 2026 in IST</div>
            </div>
            <div class="row">
              <button class="btn active" id="btnDaily" type="button">Daily</button>
              <button class="btn" id="btnWeekly" type="button">Weekly</button>
              <button class="btn" id="btnMonthly" type="button">Monthly</button>
            </div>
          </div>
          <div class="subtle-divider"></div>
          <canvas id="salesChart" height="90"></canvas>
        </div>

        <div class="card">
          <h2 style="margin:0 0 6px 0">Shipments Progress</h2>
          <div class="muted">Packed vs Dispatched</div>
          <div class="subtle-divider"></div>

          <div class="grid-2">
            <div class="stat">
              <div class="stat-label">Pending Dispatch</div>
              <div class="stat-value"><%= Number(stats.pendingDispatch || 0).toLocaleString('en-IN') %></div>
            </div>
            <div class="stat">
              <div class="stat-label">Dispatched</div>
              <div class="stat-value"><%= Number(stats.dispatched || 0).toLocaleString('en-IN') %></div>
            </div>
          </div>

          <div style="margin-top:12px">
            <div class="muted" style="margin-bottom:8px">Status breakdown</div>
            <table>
              <thead>
                <tr>
                  <th>Status</th>
                  <th>Count</th>
                </tr>
              </thead>
              <tbody>
                <% shipStatus.forEach(s => { %>
                  <tr>
                    <td><%= s.status %></td>
                    <td><%= Number(s.c || 0).toLocaleString('en-IN') %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="card">
          <h2 style="margin:0 0 6px 0">Contest Registrations</h2>
          <div class="muted">Registrations + submitted vs not submitted</div>
          <div class="subtle-divider"></div>

          <table>
            <thead>
              <tr>
                <th>Contest</th>
                <th>Registrations (paid)</th>
                <th>Submitted</th>
                <th>Not Submitted</th>
              </tr>
            </thead>
            <tbody>
              <% contestStats.forEach(c => { %>
                <tr>
                  <td><%= c.title %></td>
                  <td><%= Number(c.registrations || 0).toLocaleString('en-IN') %></td>
                  <td><%= Number(c.submitted || 0).toLocaleString('en-IN') %></td>
                  <td><%= Number(c.not_submitted || 0).toLocaleString('en-IN') %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="card">
          <h2 style="margin:0 0 6px 0">Upload Storage</h2>
          <div class="muted">Total size from submissions.file_size</div>
          <div class="subtle-divider"></div>

          <div class="grid-3">
            <div class="stat">
              <div class="stat-label">Files</div>
              <div class="stat-value"><%= Number(upload.files || 0).toLocaleString('en-IN') %></div>
            </div>
            <div class="stat">
              <div class="stat-label">Total Size</div>
              <div class="stat-value" id="sizeBox">-</div>
            </div>
            <div class="stat">
              <div class="stat-label">Missing file_size</div>
              <div class="stat-value"><%= Number(upload.missing_size || 0).toLocaleString('en-IN') %></div>
            </div>
          </div>
        </div>

      </div>
    </main>
  </div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  const series = {
    daily: <%- JSON.stringify(series.daily || []) %>,
    weekly: <%- JSON.stringify(series.weekly || []) %>,
    monthly: <%- JSON.stringify(series.monthly || []) %>
  };

  function bytesToHuman(b){
    const n = Number(b || 0);
    const gb = n / (1024 * 1024 * 1024);
    if (gb >= 1) return gb.toFixed(2) + " GB";
    const mb = n / (1024 * 1024);
    if (mb >= 1) return mb.toFixed(2) + " MB";
    const kb = n / 1024;
    if (kb >= 1) return kb.toFixed(2) + " KB";
    return n + " B";
  }

  const sizeBox = document.getElementById("sizeBox");
  if (sizeBox) {
    sizeBox.innerText = bytesToHuman(<%= Number(upload.bytes || 0) %>);
  }

  function fmtLabel(v){
    if (!v) return "";
    const s = String(v);
    if (/^\d{4}-\d{2}-\d{2}$/.test(s)) {
      const [y,m,d] = s.split("-");
      return `${d}-${m}-${y}`;
    }
    return s;
  }

  function buildData(mode){
    const rows = series[mode] || [];
    const labels = rows.map(r => fmtLabel(r.d || r.w || r.m || r.label));
    const values = rows.map(r => Number(r.revenue || r.value || 0));
    return { labels, values };
  }

  let chart = null;

  function setActiveButton(mode){
    document.getElementById("btnDaily").classList.toggle("active", mode === "daily");
    document.getElementById("btnWeekly").classList.toggle("active", mode === "weekly");
    document.getElementById("btnMonthly").classList.toggle("active", mode === "monthly");
  }

  function render(mode){
    const canvas = document.getElementById("salesChart");
    const { labels, values } = buildData(mode);

    if (chart) chart.destroy();

    chart = new Chart(canvas, {
      type: "line",
      data: {
        labels,
        datasets: [{
          label: "Revenue",
          data: values,
          tension: 0.25,
          borderWidth: 3,
          fill: false
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
          legend: {
            labels: { color: "#fff" }
          },
          tooltip: {
            callbacks: {
              label: function(ctx){
                return "Revenue: ₹" + Number(ctx.raw || 0).toLocaleString("en-IN");
              }
            }
          }
        },
        scales: {
          x: {
            ticks: { color: "rgba(255,255,255,.75)" },
            grid: { color: "rgba(255,255,255,.08)" }
          },
          y: {
            ticks: {
              color: "rgba(255,255,255,.75)",
              callback: function(v){
                return "₹" + Number(v || 0).toLocaleString("en-IN");
              }
            },
            grid: { color: "rgba(255,255,255,.08)" }
          }
        }
      }
    });

    setActiveButton(mode);
  }

  document.getElementById("btnDaily").addEventListener("click", () => render("daily"));
  document.getElementById("btnWeekly").addEventListener("click", () => render("weekly"));
  document.getElementById("btnMonthly").addEventListener("click", () => render("monthly"));

  function toggleAdminMenu() {
    document.body.classList.toggle("menu-open");
  }

  function closeAdminMenu() {
    document.body.classList.remove("menu-open");
  }

  render("daily");
</script>
</body>
</html>