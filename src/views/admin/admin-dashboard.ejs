<%- include('partials/admin-shell-start', {
  title: 'Overview',
  mobileTitle: 'Overview',
  activeTab: 'admin'
}) %>

<div class="page-head">
  <div>
    <h1>Admin Overview</h1>
    <div class="sub">Quick summary of platform activity and operational modules.</div>
  </div>
</div>

<div class="grid grid-4">
  <div class="stat">
    <div class="label">Total Users</div>
    <div class="value"><%= stats?.users ?? 0 %></div>
  </div>
  <div class="stat">
    <div class="label">Total Orders</div>
    <div class="value"><%= stats?.orders ?? 0 %></div>
  </div>
  <div class="stat">
    <div class="label">Paid Orders</div>
    <div class="value"><%= stats?.paidOrders ?? 0 %></div>
  </div>
  <div class="stat">
    <div class="label">Submissions</div>
    <div class="value"><%= stats?.submissions ?? 0 %></div>
  </div>
</div>

<div class="grid grid-3">
  <div class="card">
    <div class="strong">Contests</div>
    <div class="tiny" style="margin-top:6px">Manage contest visibility, pricing, dates, and descriptions.</div>
    <div style="margin-top:14px">
      <a class="btn ghost" href="/admin/contests">Open Contests</a>
    </div>
  </div>

  <div class="card">
    <div class="strong">Orders</div>
    <div class="tiny" style="margin-top:6px">Monitor payments, registrations, and order-level activity.</div>
    <div style="margin-top:14px">
      <a class="btn ghost" href="/admin/orders">Open Orders</a>
    </div>
  </div>

  <div class="card">
    <div class="strong">Shipments</div>
    <div class="tiny" style="margin-top:6px">Track dispatch status, courier details, and delivery progress.</div>
    <div style="margin-top:14px">
      <a class="btn ghost" href="/admin/shipments">Open Shipments</a>
    </div>
  </div>

  <div class="card">
    <div class="strong">Submissions</div>
    <div class="tiny" style="margin-top:6px">Review uploaded files, download them, and lock submissions.</div>
    <div style="margin-top:14px">
      <a class="btn ghost" href="/admin/submissions">Open Submissions</a>
    </div>
  </div>

  <div class="card">
    <div class="strong">Users</div>
    <div class="tiny" style="margin-top:6px">Search users, update roles, and inspect detailed user history.</div>
    <div style="margin-top:14px" class="row">
      <a class="btn ghost" href="/admin/users">Users</a>
      <a class="btn ghost" href="/admin/user360">User 360</a>
    </div>
  </div>

  <div class="card">
    <div class="strong">Feedback</div>
    <div class="tiny" style="margin-top:6px">Review issues reported by users and update resolution status.</div>
    <div style="margin-top:14px">
      <a class="btn ghost" href="/admin/feedback">Open Feedback</a>
    </div>
  </div>
</div>

<%- include('partials/admin-shell-end') %>