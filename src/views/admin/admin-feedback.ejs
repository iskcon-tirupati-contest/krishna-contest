<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin - Feedback</title>
  <style>
    body{margin:0;font-family:Segoe UI,Tahoma,Verdana,sans-serif;background:#0b1224;color:#fff}
    .layout{display:flex;min-height:100vh}
    .sidebar{width:260px;background:#0a1022;border-right:1px solid rgba(255,255,255,.08);padding:18px}
    .brand{font-weight:900;margin-bottom:18px}
    .nav a{display:block;padding:10px 12px;border-radius:12px;text-decoration:none;color:rgba(255,255,255,.85);margin-bottom:8px}
    .nav a.active{background:rgba(26,60,255,.18);border:1px solid rgba(26,60,255,.35);color:#fff}
    .content{flex:1}
    .wrap{max-width:1200px;margin:26px auto;padding:0 18px}
    .card{background:#111b35;border:1px solid rgba(255,255,255,.12);border-radius:18px;padding:18px}
    .muted{color:rgba(255,255,255,.7)}
    select{width:100%;padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,.18);background:#0e1630;color:#fff}
    .row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
    .btn{border:none;border-radius:12px;padding:10px 12px;font-weight:900;cursor:pointer}
    .btn.primary{background:#1a3cff;color:#fff}
    .btn.ghost{background:rgba(255,255,255,.10);color:#fff}
    table{width:100%;border-collapse:collapse;margin-top:14px}
    th,td{padding:10px;border-bottom:1px solid rgba(255,255,255,.10);text-align:left;vertical-align:top}
    @media (max-width:1100px){ .sidebar{display:none} }
  </style>
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="brand">Admin Panel</div>
      <div class="nav">
        <a href="/admin">Overview</a>
        <a href="/admin/contests">Contests</a>
        <a href="/admin/user360">View User</a>
        <a href="/admin/orders">Orders</a>
        <a href="/admin/submissions">Submissions</a>
        <a href="/admin/shipments">Shipments</a>
        <a href="/admin/users">Users</a>
        <a href="/admin/feedback" class="active">Feedback</a>
        <a href="/logout" style="margin-top:14px;opacity:.9">Logout</a>
      </div>
    </aside>

    <main class="content">
      <div class="wrap">
        <div class="card">
          <div class="row" style="justify-content:space-between">
            <div>
              <h1 style="margin:0 0 6px 0">Feedback Tickets</h1>
              <div class="muted">Track + close customer feedback</div>
            </div>
            <a class="btn ghost" href="/admin/feedback">Reset</a>
            <a class="btn ghost" href="/admin/feedback/export.csv?<%= qs %>">Export CSV</a>

          </div>

          <div style="height:1px;background:rgba(255,255,255,.12);margin:14px 0"></div>

          <form method="GET" action="/admin/feedback" class="row">
            <select name="status" style="min-width:180px">
              <option value="open" <%= status==='open'?'selected':'' %>>open</option>
              <option value="closed" <%= status==='closed'?'selected':'' %>>closed</option>
              <option value="all" <%= status==='all'?'selected':'' %>>all</option>
            </select>
            <button class="btn primary" type="submit">Apply</button>
          </form>

          <table>
            <thead>
              <tr>
                <th>Created</th>
                <th>User</th>
                <th>Message</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% items.forEach(t => { %>
                <tr>
                  <td class="muted" style="font-size:12px"><%= t.created_at %></td>
                  <td>
                    <div style="font-weight:900"><%= t.user_name || '-' %></div>
                    <div class="muted" style="font-size:12px"><%= t.email || '-' %> • <%= t.phone || '-' %></div>
                    <div class="muted" style="font-size:12px">UUID: <%= t.user_id %></div>
                  </td>
                  <td><%= t.message %></td>
                  <td><%= t.status %></td>
                  <td>
                    <% if (t.status === 'open') { %>
                      <form method="POST" action="/admin/feedback/close">
                        <input type="hidden" name="id" value="<%= t.id %>" />
                        <button class="btn ghost" type="submit">Close</button>
                      </form>
                    <% } else { %>
                      <span class="muted">Closed</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>

        </div>
      </div>
    </main>
  </div>
</body>
</html>
