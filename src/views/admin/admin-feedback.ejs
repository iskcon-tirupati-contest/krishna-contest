<%- include('partials/admin-shell-start', {
  title: 'Feedback',
  mobileTitle: 'Feedback',
  activeTab: 'feedback'
}) %>

<div class="page-head">
  <div>
    <h1>Feedback</h1>
    <div class="sub">Review and manage user complaints, issues, and support requests.</div>
  </div>
</div>

<div class="card">
  <form method="GET" action="/admin/feedback" class="grid grid-3">
    <div>
      <label for="q">Search</label>
      <input id="q" name="q" value="<%= q || '' %>" placeholder="Name / phone / subject / message" />
    </div>
    <div>
      <label for="status">Status</label>
      <select id="status" name="status">
        <option value="">All</option>
        <option value="open" <%= status === 'open' ? 'selected' : '' %>>open</option>
        <option value="closed" <%= status === 'closed' ? 'selected' : '' %>>closed</option>
        <option value="in_progress" <%= status === 'in_progress' ? 'selected' : '' %>>in_progress</option>
      </select>
    </div>
    <div style="display:flex;align-items:end;gap:10px;flex-wrap:wrap">
      <button class="btn primary" type="submit">Apply Filters</button>
      <a class="btn ghost" href="/admin/feedback">Reset</a>
    </div>
  </form>
</div>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>User</th>
          <th>Subject</th>
          <th>Message</th>
          <th>Status</th>
          <th>Created</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% (tickets || feedback || []).forEach(item => { %>
          <tr>
            <td>
              <div class="strong"><%= item.name || '-' %></div>
              <div class="tiny"><%= item.phone || item.email || '-' %></div>
            </td>
            <td><%= item.subject || '-' %></td>
            <td><%= item.message || '-' %></td>
            <td><span class="pill"><%= item.status || 'open' %></span></td>
            <td><%= item.created_at || '-' %></td>
            <td>
              <% if (item.id) { %>
                <form method="POST" action="/admin/feedback/<%= item.id %>/status" class="row mobile-stack" style="gap:8px">
                  <select name="status">
                    <option value="open" <%= (item.status || 'open') === 'open' ? 'selected' : '' %>>open</option>
                    <option value="in_progress" <%= (item.status || '') === 'in_progress' ? 'selected' : '' %>>in_progress</option>
                    <option value="closed" <%= (item.status || '') === 'closed' ? 'selected' : '' %>>closed</option>
                  </select>
                  <button class="btn ghost" type="submit">Save</button>
                </form>
              <% } else { %>
                <span class="tiny">No action</span>
              <% } %>
            </td>
          </tr>
        <% }) %>

        <% if (!(tickets || feedback || []).length) { %>
          <tr>
            <td colspan="6" class="muted">No feedback records found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-shell-end') %>