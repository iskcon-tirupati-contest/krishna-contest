<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin - Feedback</title>
  <style>
    :root{
      --bg:#0b1224;
      --panel:#111b35;
      --panel2:#0e1630;
      --line:rgba(255,255,255,.10);
      --line2:rgba(255,255,255,.14);
      --text:#fff;
      --muted:rgba(255,255,255,.72);
      --blue:#1a3cff;
      --blueSoft:rgba(26,60,255,.18);
      --green:#20c997;
      --red:#ff6b6b;
    }
    *{box-sizing:border-box}
    body{margin:0;font-family:Segoe UI,Tahoma,Verdana,sans-serif;background:var(--bg);color:var(--text)}
    .layout{display:flex;min-height:100vh}
    .sidebar{width:260px;background:#0a1022;border-right:1px solid rgba(255,255,255,.08);padding:18px}
    .brand{font-weight:900;margin-bottom:18px}
    .nav a{display:block;padding:10px 12px;border-radius:12px;text-decoration:none;color:rgba(255,255,255,.85);margin-bottom:8px}
    .nav a.active{background:rgba(26,60,255,.18);border:1px solid rgba(26,60,255,.35);color:#fff}
    .content{flex:1}
    .wrap{max-width:1320px;margin:26px auto;padding:0 18px}
    .card{background:var(--panel);border:1px solid var(--line2);border-radius:18px;padding:18px}
    .muted{color:var(--muted)}
    .row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;border:none;border-radius:12px;padding:10px 14px;font-weight:900;cursor:pointer;text-decoration:none}
    .btn.primary{background:var(--blue);color:#fff}
    .btn.ghost{background:rgba(255,255,255,.10);color:#fff}
    .btn.sm{padding:8px 10px;border-radius:10px;font-size:13px}
    .btn.status-pill{min-width:120px}
    .btn.status-pill.active{background:var(--blue);color:#fff}
    .btn.status-pill.inactive{background:rgba(255,255,255,.08);color:#fff;border:1px solid rgba(255,255,255,.10)}
    .toolbar{display:grid;grid-template-columns:1fr auto;gap:14px;align-items:end}
    .searchbox{display:grid;grid-template-columns:minmax(240px, 1fr) auto auto;gap:10px}
    .input, textarea{
      width:100%;
      padding:11px 12px;
      border-radius:12px;
      border:1px solid rgba(255,255,255,.16);
      background:var(--panel2);
      color:#fff;
      outline:none;
    }
    .input::placeholder, textarea::placeholder{color:rgba(255,255,255,.45)}
    .helper{font-size:12px;color:var(--muted)}
    .divider{height:1px;background:rgba(255,255,255,.12);margin:14px 0}
    .summary{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}
    .summary .chip{
      padding:8px 12px;
      border-radius:999px;
      background:rgba(255,255,255,.07);
      border:1px solid rgba(255,255,255,.10);
      font-size:13px;
      color:#fff;
    }
    .table-wrap{overflow:auto}
    table{width:100%;border-collapse:collapse;margin-top:10px;min-width:980px}
    th,td{padding:12px 10px;border-bottom:1px solid rgba(255,255,255,.10);text-align:left;vertical-align:top}
    th{font-size:13px;color:rgba(255,255,255,.75)}
    .user-card{display:flex;flex-direction:column;gap:4px}
    .status-badge{
      display:inline-flex;align-items:center;justify-content:center;
      padding:6px 10px;border-radius:999px;font-size:12px;font-weight:800;text-transform:capitalize
    }
    .status-badge.open{background:rgba(32,201,151,.14);color:#7df0c7;border:1px solid rgba(32,201,151,.28)}
    .status-badge.closed{background:rgba(255,107,107,.14);color:#ffb0b0;border:1px solid rgba(255,107,107,.28)}
    .message-cell{max-width:440px;white-space:pre-wrap;word-break:break-word;line-height:1.5}
    .actions{display:flex;gap:8px;flex-wrap:wrap}
    .alert{
      padding:12px 14px;border-radius:14px;margin-bottom:14px;font-weight:700
    }
    .alert.ok{background:rgba(32,201,151,.12);border:1px solid rgba(32,201,151,.25);color:#95f0cf}
    .alert.err{background:rgba(255,107,107,.12);border:1px solid rgba(255,107,107,.24);color:#ffbcbc}
    .empty{
      padding:28px 16px;text-align:center;color:var(--muted);
      border:1px dashed rgba(255,255,255,.14);border-radius:16px;margin-top:14px
    }

    .modal-backdrop{
      position:fixed;inset:0;background:rgba(0,0,0,.55);
      display:none;align-items:center;justify-content:center;padding:18px;z-index:1000
    }
    .modal-backdrop.show{display:flex}
    .modal{
      width:min(680px, 100%);
      background:var(--panel);
      border:1px solid rgba(255,255,255,.16);
      border-radius:20px;
      padding:18px;
      box-shadow:0 24px 80px rgba(0,0,0,.35);
    }
    .modal-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-bottom:12px}
    .modal-title{font-size:22px;font-weight:900;margin:0}
    .meta-box{
      background:rgba(255,255,255,.05);
      border:1px solid rgba(255,255,255,.10);
      border-radius:14px;
      padding:12px;
      margin-bottom:12px;
      line-height:1.5;
    }
    .close-x{
      background:transparent;border:none;color:#fff;font-size:24px;cursor:pointer;padding:0 4px;line-height:1
    }

    @media (max-width:1100px){ .sidebar{display:none} }
    @media (max-width:820px){
      .toolbar{grid-template-columns:1fr}
      .searchbox{grid-template-columns:1fr}
      .wrap{padding:0 12px}
      .card{padding:14px}
    }
  </style>
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="brand">Admin Panel</div>
      <div class="nav">
        <a href="/admin">Overview</a>
        <a href="/admin/contests">Contests</a>
        <a href="/admin/user360">View User</a>
        <a href="/admin/orders">Orders</a>
        <a href="/admin/submissions">Submissions</a>
        <a href="/admin/shipments">Shipments</a>
        <a href="/admin/users">Users</a>
        <a href="/admin/feedback" class="active">Feedback</a>
        <a href="/admin/payments/reconcile-bulk">Bulk Reconcile</a>
        <a href="/logout" style="margin-top:14px;opacity:.9">Logout</a>
      </div>
    </aside>

    <main class="content">
      <div class="wrap">
        <% if (okMsg) { %>
          <div class="alert ok"><%= okMsg %></div>
        <% } %>

        <% if (errMsg) { %>
          <div class="alert err"><%= errMsg %></div>
        <% } %>

        <div class="card">
          <div class="row" style="justify-content:space-between">
            <div>
              <h1 style="margin:0 0 6px 0">Feedback Tickets</h1>
              <div class="muted">Track, reply, view users, and close customer feedback tickets</div>
            </div>

            <div class="row">
              <a class="btn ghost" href="/admin/feedback">Reset</a>
              <a class="btn ghost" href="/admin/feedback/export.csv?<%= qs %>">Export CSV</a>
            </div>
          </div>

          <div class="divider"></div>

          <div class="summary">
            <a
              class="btn status-pill <%= status === 'open' ? 'active primary' : 'inactive ghost' %>"
              href="/admin/feedback?status=open<%= q ? '&q=' + encodeURIComponent(q) : '' %>"
            >
              Open (<%= counts?.open_count || 0 %>)
            </a>

            <a
              class="btn status-pill <%= status === 'closed' ? 'active primary' : 'inactive ghost' %>"
              href="/admin/feedback?status=closed<%= q ? '&q=' + encodeURIComponent(q) : '' %>"
            >
              Closed (<%= counts?.closed_count || 0 %>)
            </a>

            <a
              class="btn status-pill <%= status === 'all' ? 'active primary' : 'inactive ghost' %>"
              href="/admin/feedback?status=all<%= q ? '&q=' + encodeURIComponent(q) : '' %>"
            >
              All (<%= counts?.all_count || 0 %>)
            </a>
          </div>

          <form method="GET" action="/admin/feedback" class="toolbar">
            <input type="hidden" name="status" value="<%= status %>" />

            <div>
              <div class="searchbox">
                <input
                  class="input"
                  type="text"
                  name="q"
                  value="<%= q || '' %>"
                  placeholder="Search by mobile number, name, email, message text, ticket id, or user id"
                />
                <button class="btn primary" type="submit">Apply Filter</button>
                <a class="btn ghost" href="/admin/feedback?status=<%= encodeURIComponent(status || 'open') %>">Clear Search</a>
              </div>
              <div class="helper" style="margin-top:8px">
                Matching works on name, mobile, email, message text, ticket id, and user id.
              </div>
            </div>

            <div class="helper">
              Showing <strong style="color:#fff"><%= items.length %></strong> ticket(s)
            </div>
          </form>

          <% if (!items || !items.length) { %>
            <div class="empty">No feedback tickets matched your current filter.</div>
          <% } else { %>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Created</th>
                    <th>User</th>
                    <th>Message</th>
                    <th>Status</th>
                    <th>Reply</th>
                    <th style="min-width:220px">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% items.forEach(t => { %>
                    <tr>
                      <td class="muted" style="font-size:12px;white-space:nowrap">
                        <div><%= t.created_at %></div>
                        <% if (t.closed_at) { %>
                          <div style="margin-top:6px">Closed: <%= t.closed_at %></div>
                        <% } %>
                      </td>

                      <td>
                        <div class="user-card">
                          <div style="font-weight:900"><%= t.user_name || '-' %></div>
                          <div class="muted" style="font-size:12px"><%= t.email || '-' %></div>
                          <div class="muted" style="font-size:12px"><%= t.phone || '-' %></div>
                          <div class="muted" style="font-size:12px">User ID: <%= t.user_id || '-' %></div>
                          <div class="muted" style="font-size:12px">Ticket ID: <%= t.id %></div>
                        </div>
                      </td>

                      <td class="message-cell"><%= t.message %></td>

                      <td>
                        <span class="status-badge <%= (t.status || 'open').toLowerCase() === 'closed' ? 'closed' : 'open' %>">
                          <%= t.status %>
                        </span>
                      </td>

                      <td>
                        <% if (!t.reply_status) { %>
                          <span class="status-badge" style="background:rgba(255,255,255,.08);color:#fff;border:1px solid rgba(255,255,255,.10)">Not sent</span>
                        <% } else if (String(t.reply_status).toLowerCase() === 'sent') { %>
                          <div>
                            <span class="status-badge" style="background:rgba(32,201,151,.14);color:#7ff0ca;border:1px solid rgba(32,201,151,.35)">Sent once</span>
                            <% if (t.reply_created_at) { %>
                              <div class="muted" style="font-size:12px;margin-top:6px"><%= t.reply_created_at %></div>
                            <% } %>
                          </div>
                        <% } else { %>
                          <div>
                            <span class="status-badge" style="background:rgba(255,107,107,.14);color:#ff9a9a;border:1px solid rgba(255,107,107,.35)">Failed</span>
                            <% if (t.reply_created_at) { %>
                              <div class="muted" style="font-size:12px;margin-top:6px"><%= t.reply_created_at %></div>
                            <% } %>
                          </div>
                        <% } %>
                      </td>

                      <td>
                        <div class="actions">
                          <button
                            type="button"
                            class="btn primary sm"
                            onclick="openMessageModal(
                              '<%- String(t.id || '').replace(/'/g, '&#39;') %>',
                              '<%- String(t.user_id || '').replace(/'/g, '&#39;') %>',
                              '<%- String(t.user_name || 'Participant').replace(/'/g, '&#39;') %>',
                              '<%- String(t.phone || '').replace(/'/g, '&#39;') %>'
                            )"
                          >
                            <%= t.reply_status ? 'Send Again' : 'Send Message' %>
                          </button>

                          <% if (t.user_id) { %>
                            <a class="btn ghost sm" href="/admin/user360/<%= t.user_id %>">View User</a>
                          <% } else { %>
                            <span class="btn ghost sm" style="opacity:.6;pointer-events:none">View User</span>
                          <% } %>

                          <% if ((t.status || '').toLowerCase() === 'open') { %>
                            <form method="POST" action="/admin/feedback/close" style="display:inline">
                              <input type="hidden" name="id" value="<%= t.id %>" />
                              <input type="hidden" name="return_qs" value="<%= qs %>" />
                              <button class="btn ghost sm" type="submit">Close</button>
                            </form>
                          <% } else { %>
                            <span class="muted" style="font-size:12px;padding:8px 0">Already closed</span>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>

  <div class="modal-backdrop" id="messageModalBackdrop" onclick="handleBackdrop(event)">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="messageModalTitle">
      <div class="modal-head">
        <div>
          <h2 class="modal-title" id="messageModalTitle">Send WhatsApp Message</h2>
        </div>
        <button type="button" class="close-x" onclick="closeMessageModal()">×</button>
      </div>

      <div class="meta-box">
        <div><strong>User:</strong> <span id="modalUserName">-</span></div>
        <div><strong>Phone:</strong> <span id="modalPhone">-</span></div>
        <div><strong>Ticket ID:</strong> <span id="modalTicketId">-</span></div>
      </div>

      <form method="POST" action="/admin/feedback/send-message">
        <input type="hidden" name="ticketId" id="modalInputTicketId" />
        <input type="hidden" name="userId" id="modalInputUserId" />
        <input type="hidden" name="return_qs" value="<%= qs %>" />

        <label for="modalMessageBox" style="display:block;font-weight:800;margin-bottom:8px">Message</label>
        <textarea
          id="modalMessageBox"
          name="message"
          rows="7"
          placeholder="Type the WhatsApp message to send to this participant"
          required
        ></textarea>

        <div class="helper" style="margin-top:8px">
        </div>

        <div class="row" style="justify-content:flex-end;margin-top:14px">
          <button type="button" class="btn ghost" onclick="closeMessageModal()">Cancel</button>
          <button type="submit" class="btn primary">Send WhatsApp</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openMessageModal(ticketId, userId, userName, phone) {
      document.getElementById('modalTicketId').textContent = ticketId || '-';
      document.getElementById('modalUserName').textContent = userName || '-';
      document.getElementById('modalPhone').textContent = phone || '-';
      document.getElementById('modalInputTicketId').value = ticketId || '';
      document.getElementById('modalInputUserId').value = userId || '';
      document.getElementById('modalMessageBox').value = '';
      document.getElementById('messageModalBackdrop').classList.add('show');
      setTimeout(function () {
        var el = document.getElementById('modalMessageBox');
        if (el) el.focus();
      }, 50);
    }

    function closeMessageModal() {
      document.getElementById('messageModalBackdrop').classList.remove('show');
    }

    function handleBackdrop(event) {
      if (event.target && event.target.id === 'messageModalBackdrop') {
        closeMessageModal();
      }
    }

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') closeMessageModal();
    });
  </script>
</body>
</html>