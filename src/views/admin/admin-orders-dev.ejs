<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin — Orders</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      /* Sidebar — near-black navy */
      --sb-bg:         #0b0e1a;
      --sb-border:     rgba(255,255,255,.06);
      --sb-text:       rgba(255,255,255,.65);
      --sb-active-bg:  rgba(139,92,246,.2);
      --sb-active-bd:  rgba(139,92,246,.5);

      /* Content area — deep slate */
      --bg:       #0f1117;
      --surface:  #181d2e;
      --surface2: #1e2438;
      --surface3: #262d42;
      --border:   rgba(255,255,255,.08);
      --border2:  rgba(255,255,255,.14);

      /* Typography — crisp hierarchy */
      --text:     #f4f6fb;
      --text2:    #a8b3cf;
      --muted:    #64748b;

      /* Accent — vivid violet */
      --accent:        #8b5cf6;
      --accent-dim:    rgba(139,92,246,.15);
      --accent-border: rgba(139,92,246,.4);

      /* STATUS PILLS — vivid, high contrast on dark */
      --our-paid-bg:  #0d2e1a; --our-paid-bd:  #16a34a; --our-paid-tx:  #4ade80;
      --our-pend-bg:  #2d1f04; --our-pend-bd:  #d97706; --our-pend-tx:  #fcd34d;
      --our-fail-bg:  #2a0a0a; --our-fail-bd:  #dc2626; --our-fail-tx:  #fca5a5;
      --our-neut-bg:  #1a1f2e; --our-neut-bd:  #475569; --our-neut-tx:  #94a3b8;

      /* GATEWAY STATUS */
      --rp-cap-bg:  #0c1f3d; --rp-cap-bd:  #2563eb; --rp-cap-tx:  #93c5fd;
      --rp-fail-bg: #2d1200; --rp-fail-bd:  #ea580c; --rp-fail-tx: #fdba74;
      --rp-pend-bg: #1a0f2e; --rp-pend-bd:  #7c3aed; --rp-pend-tx: #c4b5fd;
      --rp-neut-bg: #1a1f2e; --rp-neut-bd:  #475569; --rp-neut-tx: #94a3b8;

      --radius-sm: 8px; --radius: 12px; --radius-lg: 16px; --radius-xl: 20px;
      --sidebar-w: 240px;
      --font: 'DM Sans', system-ui, sans-serif;
      --mono: 'DM Mono', monospace;
    }

    *, *::before, *::after { box-sizing: border-box; }
    body { margin:0; font-family:var(--font); background:var(--bg); color:var(--text); font-size:14px; line-height:1.6; -webkit-font-smoothing:antialiased; }

    /* LAYOUT */
    .layout { display:flex; min-height:100vh; }
    .content { flex:1; min-width:0; background:var(--bg); }
    .wrap { max-width:1400px; margin:0 auto; padding:26px 22px; }

    /* SIDEBAR — original dark */
    .sidebar { width:var(--sidebar-w); background:var(--sb-bg); border-right:1px solid var(--sb-border); padding:18px 14px; flex-shrink:0; }
    .brand { font-weight:900; font-size:15px; color:#fff; margin-bottom:18px; padding:0 4px; }
    .nav a { display:block; padding:9px 12px; border-radius:var(--radius-sm); text-decoration:none; color:var(--sb-text); margin-bottom:3px; font-size:13.5px; font-weight:500; transition:background .15s,color .15s; }
    .nav a:hover { background:rgba(255,255,255,.07); color:#fff; }
    .nav a.active { background:var(--sb-active-bg); border:1px solid var(--sb-active-bd); color:#fff; box-shadow:0 0 12px rgba(139,92,246,.2); }
    .nav-sep { height:1px; background:var(--sb-border); margin:10px 0; }

    /* CARD */
    .card { background:var(--surface); border:1px solid var(--border2); border-radius:var(--radius-xl); padding:22px 24px; box-shadow:0 4px 32px rgba(0,0,0,.5); }

    /* PAGE HEADER */
    .page-header { display:flex; justify-content:space-between; align-items:flex-start; gap:14px; flex-wrap:wrap; margin-bottom:18px; }
    .page-title { margin:0 0 4px; font-size:22px; font-weight:900; letter-spacing:-.03em; color:#fff; }
    .page-sub { color:var(--muted); font-size:13px; }

    /* BUTTONS */
    .btn { border:none; border-radius:var(--radius-sm); padding:8px 14px; font-weight:600; font-size:13px; cursor:pointer; text-decoration:none; display:inline-flex; align-items:center; gap:6px; white-space:nowrap; font-family:var(--font); transition:background .15s,transform .1s; }
    .btn:active { transform:scale(.98); }
    .btn.primary { background:var(--accent); color:#fff; }
    .btn.primary:hover { background:#2d4eef; }
    .btn.ghost  { background:var(--surface2); color:var(--text2); border:1px solid var(--border2); }
    .btn.ghost:hover  { background:var(--surface3); }
    .btn.danger-ghost { background:rgba(239,68,68,.1); color:#f87171; border:1px solid rgba(239,68,68,.3); }
    .btn.danger-ghost:hover { background:rgba(239,68,68,.18); }
    .actions { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }

    /* ALERTS */
    .msg { padding:11px 14px; border-radius:var(--radius); margin-bottom:14px; font-size:13px; }
    .msg.ok  { background:rgba(34,197,94,.1); border:1px solid rgba(34,197,94,.3); color:#4ade80; }
    .msg.err { background:rgba(239,68,68,.1); border:1px solid rgba(239,68,68,.3); color:#f87171; }

    /* STATS */
    .stat-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin:16px 0; }
    .stat { background:var(--surface2); border:1px solid var(--border2); border-radius:var(--radius); padding:14px 18px; box-shadow:inset 0 1px 0 rgba(255,255,255,.05); }
    .stat-label { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); margin-bottom:5px; }
    .stat-value { font-size:28px; font-weight:900; letter-spacing:-.03em; color:#fff; }

    /* DIVIDER */
    .divider { height:1px; background:var(--border); margin:18px 0; }

    /* FILTERS */
    .filters-wrap { background:var(--surface2); border:1px solid var(--border2); border-radius:var(--radius-lg); padding:18px 20px; margin-bottom:16px; box-shadow:inset 0 1px 0 rgba(255,255,255,.04); }
    .filter-label { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); margin-bottom:5px; }
    .filter-grid { display:grid; grid-template-columns:repeat(6,1fr); gap:10px; }
    .filter-grid-dates { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-top:10px; }
    input,select { width:100%; padding:8px 10px; border-radius:var(--radius-sm); border:1px solid var(--border2); background:var(--surface3); color:var(--text); font-size:13px; font-family:var(--font); outline:none; transition:border-color .15s,box-shadow .15s; }
    input:focus,select:focus { border-color:var(--accent); box-shadow:0 0 0 3px rgba(61,92,255,.10); }

    /* CHIPS */
    .chips { display:flex; gap:7px; flex-wrap:wrap; margin:10px 0 4px; }
    .chip { display:inline-flex; align-items:center; gap:7px; background:var(--accent-dim); border:1px solid var(--accent-border); padding:4px 10px; border-radius:999px; font-size:12px; font-weight:500; color:var(--accent); }
    .chip a { color:var(--accent); text-decoration:none; opacity:.6; font-size:14px; line-height:1; }
    .chip a:hover { opacity:1; }

    /* PILLS */
    .pill { display:inline-flex; align-items:center; padding:3px 10px; border-radius:999px; font-size:11px; font-weight:700; letter-spacing:.03em; white-space:nowrap; }

    /* Our status pills */
    .our-paid    { background:var(--our-paid-bg); border:1px solid var(--our-paid-bd); color:var(--our-paid-tx); }
    .our-pending { background:var(--our-pend-bg); border:1px solid var(--our-pend-bd); color:var(--our-pend-tx); }
    .our-failed  { background:var(--our-fail-bg); border:1px solid var(--our-fail-bd); color:var(--our-fail-tx); }
    .our-neutral { background:var(--our-neut-bg); border:1px solid var(--our-neut-bd); color:var(--our-neut-tx); }

    /* Razorpay status pills — different palette entirely */
    .rp-captured { background:var(--rp-cap-bg);  border:1px solid var(--rp-cap-bd);  color:var(--rp-cap-tx); }
    .rp-failed   { background:var(--rp-fail-bg); border:1px solid var(--rp-fail-bd); color:var(--rp-fail-tx); }
    .rp-pending  { background:var(--rp-pend-bg); border:1px solid var(--rp-pend-bd); color:var(--rp-pend-tx); }
    .rp-neutral  { background:var(--rp-neut-bg); border:1px solid var(--rp-neut-bd); color:var(--rp-neut-tx); }

    .pill-row { display:flex; gap:5px; flex-wrap:wrap; margin-top:5px; }
    .status-section-label { font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:.09em; color:var(--text2); margin-bottom:5px; }
    .status-block { margin-bottom:10px; }
    .status-block:last-child { margin-bottom:0; }

    /* PAGINATION */
    .pagination { display:flex; gap:6px; align-items:center; justify-content:center; flex-wrap:wrap; }
    .page-link { padding:7px 13px; border-radius:var(--radius-sm); text-decoration:none; background:var(--surface); border:1px solid var(--border2); color:var(--text2); font-weight:600; font-size:13px; transition:background .15s,border-color .15s; }
    .page-link:hover { background:var(--surface3); border-color:var(--accent-border); color:var(--accent); }
    .page-link.active { background:var(--accent); border-color:var(--accent); color:#fff; }
    .page-link.disabled { opacity:.35; pointer-events:none; }
    .page-dots { color:var(--muted); font-size:14px; }
    .pagination-bar { background:var(--surface2); border:1px solid var(--border); border-radius:var(--radius); padding:10px 14px; margin-bottom:16px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; }
    .pagination-info { font-size:12px; color:var(--muted); }

    /* ORDER GROUPS */
    .groups { display:grid; gap:12px; margin-top:8px; }
    .group-card { background:var(--surface); border:1px solid var(--border2); border-radius:var(--radius-lg); overflow:hidden; transition:box-shadow .25s,border-color .25s,transform .15s; border-left:4px solid var(--border2); }
    .group-card:hover { box-shadow:0 8px 32px rgba(0,0,0,.5); transform:translateY(-1px); }

    /* Status-tinted cards — left accent bar + very subtle bg wash */
    .group-card.card-paid    { border-left:4px solid #16a34a; background:linear-gradient(135deg, rgba(22,163,74,.06) 0%, var(--surface) 60%); }
    .group-card.card-paid:hover    { box-shadow:0 8px 28px rgba(22,163,74,.2); border-color:#16a34a; transform:translateY(-1px); }
    .group-card.card-pending { border-left:4px solid #d97706; background:linear-gradient(135deg, rgba(217,119,6,.06) 0%, var(--surface) 60%); }
    .group-card.card-pending:hover { box-shadow:0 8px 28px rgba(217,119,6,.2); border-color:#d97706; transform:translateY(-1px); }
    .group-card.card-failed  { border-left:4px solid #dc2626; background:linear-gradient(135deg, rgba(220,38,38,.06) 0%, var(--surface) 60%); }
    .group-card.card-failed:hover  { box-shadow:0 8px 28px rgba(220,38,38,.2); border-color:#dc2626; transform:translateY(-1px); }
    .group-head { display:grid; grid-template-columns:1.8fr 1fr 1fr 1.3fr; gap:14px; padding:18px 20px; border-bottom:2px solid var(--border2); align-items:start; }
    .group-name  { font-size:15px; font-weight:800; letter-spacing:-.01em; color:#fff; margin-bottom:2px; word-break:break-word; }
    .group-phone { font-size:13px; color:var(--text2); margin-bottom:8px; font-weight:500; }
    .id-tag { display:inline-flex; align-items:center; padding:3px 9px; border-radius:6px; font-size:11px; font-family:var(--mono); background:var(--surface3); border:1px solid rgba(139,92,246,.25); color:var(--text2); margin-bottom:3px; word-break:break-all; letter-spacing:.01em; }
    .meta-label { font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:.09em; color:var(--text2); margin-bottom:4px; border-bottom:1px solid var(--border); padding-bottom:3px; }
    .meta-value { font-size:14px; font-weight:600; color:var(--text); }
    .meta-value.large { font-size:22px; font-weight:800; color:#fff; }
    .meta-block { margin-bottom:10px; }
    .meta-block:last-child { margin-bottom:0; }

    .reconcile-banner { padding:7px 18px; background:rgba(239,68,68,.1); border-bottom:1px solid rgba(239,68,68,.25); display:flex; align-items:center; gap:8px; font-size:12px; font-weight:600; color:#f87171; }
    .reconcile-dot { width:7px; height:7px; border-radius:50%; background:#dc2626; flex-shrink:0; }

    /* TABLE */
    .item-table-wrap { padding:0 18px 16px; overflow-x:auto; }
    table { width:100%; border-collapse:collapse; min-width:640px; }
    th { font-size:10.5px; font-weight:900; text-transform:uppercase; letter-spacing:.08em; color:var(--text2); padding:9px 10px; border-bottom:2px solid var(--border2); text-align:left; background:var(--surface2); }
    td { padding:10px; border-bottom:1px solid var(--border); vertical-align:top; font-size:13px; color:var(--text); }
    tbody tr:last-child td { border-bottom:none; }
    tbody tr:hover td { background:var(--surface3); } tbody tr:nth-child(even) td { background:rgba(255,255,255,.015); }
    .td-main { font-weight:600; }
    .td-sub  { font-size:11px; color:var(--muted); margin-top:2px; }
    .mono    { font-family:var(--mono); font-size:11px; color:var(--text2); }

    /* PROGRESS */
    .progress-card { display:none; background:var(--surface); border:1px solid var(--border2); border-radius:var(--radius-lg); padding:18px; margin:14px 0; }
    .progress-card.show { display:block; }
    .progress-header { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; flex-wrap:wrap; margin-bottom:14px; }
    .progress-title { font-size:15px; font-weight:700; margin-bottom:3px; }
    .progress-sub { font-size:12px; color:var(--muted); }
    .progress-bar-track { width:100%; height:6px; border-radius:999px; background:var(--surface3); border:1px solid var(--border); overflow:hidden; margin-bottom:12px; }
    .progress-bar-fill { height:100%; width:0%; background:linear-gradient(90deg,var(--accent),#22c55e); transition:width .3s ease; border-radius:999px; }
    .progress-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; }
    .progress-stat { background:var(--surface2); border:1px solid var(--border); border-radius:var(--radius); padding:12px 14px; }
    .progress-stat .k { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); margin-bottom:4px; }
    .progress-stat .v { font-size:20px; font-weight:700; }
    .progress-msg { font-size:12px; color:var(--muted); margin:10px 0 0; }

    /* EMPTY */
    .empty { padding:40px; border:1px dashed var(--border2); border-radius:var(--radius-lg); text-align:center; color:var(--muted); margin-top:16px; }

    /* MOBILE */
    .mobile-topbar { display:none; position:sticky; top:0; z-index:1200; padding:12px 16px; background:var(--sb-bg); border-bottom:1px solid var(--sb-border); align-items:center; justify-content:space-between; gap:12px; }
    .mobile-title { font-weight:700; font-size:14px; color:#fff; }
    .menu-btn { border:none; border-radius:var(--radius-sm); padding:8px 14px; font-weight:700; cursor:pointer; background:#1a3cff; color:#fff; font-family:var(--font); }
    .sidebar-backdrop { display:none; position:fixed; inset:0; background:rgba(0,0,0,.55); z-index:1198; }

    @media (max-width:1100px) {
      .filter-grid { grid-template-columns:repeat(3,1fr); }
      .filter-grid-dates { grid-template-columns:repeat(2,1fr); }
      .stat-grid { grid-template-columns:repeat(3,1fr); }
      .group-head { grid-template-columns:1fr 1fr; }
      .progress-stats { grid-template-columns:repeat(2,1fr); }
      .mobile-topbar { display:flex !important; }
      .sidebar { position:fixed; left:0; top:0; bottom:0; z-index:1199; transform:translateX(-100%); transition:transform .22s ease; box-shadow:4px 0 24px rgba(0,0,0,.5); overflow-y:auto; }
      body.menu-open .sidebar { transform:translateX(0); }
      body.menu-open .sidebar-backdrop { display:block; }
      .wrap { padding:16px 14px; }
    }
    @media (max-width:680px) {
      .filter-grid { grid-template-columns:repeat(2,1fr); }
      .stat-grid { grid-template-columns:1fr 1fr; }
      .group-head { grid-template-columns:1fr; }
      .actions { gap:6px; }
      .page-header { flex-direction:column; align-items:flex-start; }
      .progress-stats { grid-template-columns:1fr 1fr; }
    }

    /* ── COD action bar ── */
    .cod-action-bar{padding:16px 20px 18px;background:linear-gradient(135deg,rgba(217,119,6,.12),rgba(217,119,6,.04));border-top:2px solid rgba(217,119,6,.4);display:flex;align-items:center;gap:14px;flex-wrap:wrap}
    .cod-icon{font-size:28px;flex-shrink:0}
    .cod-text{flex:1;min-width:180px}
    .cod-text-title{font-size:13px;font-weight:800;color:#fcd34d;margin-bottom:2px}
    .cod-text-sub{font-size:11px;color:#a16207;line-height:1.5}
    .btn-cod-paid{display:inline-flex;align-items:center;gap:7px;padding:10px 22px;border:0;border-radius:10px;font-size:13px;font-weight:800;background:linear-gradient(135deg,#16a34a,#15803d);color:#fff;cursor:pointer;box-shadow:0 4px 12px rgba(22,163,74,.35);transition:transform .12s,box-shadow .12s}
    .btn-cod-paid:hover{transform:translateY(-1px);box-shadow:0 6px 16px rgba(22,163,74,.45)}
    /* ── Premium toast ── */
    #cod-toast{position:fixed;top:24px;right:24px;z-index:9999;max-width:380px;min-width:280px;background:#1e2438;border:1px solid rgba(139,92,246,.3);border-radius:16px;box-shadow:0 24px 64px rgba(0,0,0,.7),0 0 0 1px rgba(139,92,246,.15);padding:20px;transform:translateY(-16px);opacity:0;transition:transform .35s cubic-bezier(.34,1.56,.64,1),opacity .25s;pointer-events:none}
    #cod-toast.show{transform:translateY(0);opacity:1;pointer-events:auto}
    .toast-hd{display:flex;align-items:flex-start;gap:12px;margin-bottom:14px}
    .toast-ico{width:42px;height:42px;border-radius:12px;flex-shrink:0;background:linear-gradient(135deg,#16a34a,#15803d);display:flex;align-items:center;justify-content:center;font-size:22px}
    .toast-title{font-size:14px;font-weight:800;color:#f4f6fb;line-height:1.3;margin-bottom:4px}
    .toast-msg{font-size:12px;color:#a8b3cf;line-height:1.6}
    .toast-x{margin-left:auto;width:28px;height:28px;border:0;border-radius:8px;background:var(--surface3);cursor:pointer;font-size:15px;color:var(--text2);flex-shrink:0}
    .toast-x:hover{background:#2d3748;color:#fff}
    .toast-acts{display:flex;gap:8px}
    .toast-btn{flex:1;padding:9px;border:0;border-radius:9px;font-size:12px;font-weight:700;cursor:pointer}
    .toast-btn.go{background:linear-gradient(135deg,#16a34a,#15803d);color:#fff;box-shadow:0 3px 8px rgba(22,163,74,.3)}
    .toast-btn.cancel{background:var(--surface3);color:var(--text2)}
    /* ── COD notify bar ── */
    #cod-notify-bar{display:none;margin-bottom:14px;background:linear-gradient(135deg,rgba(245,158,11,.12),rgba(245,158,11,.05));border:1.5px solid rgba(245,158,11,.3);border-radius:12px;padding:11px 15px;align-items:center;gap:10px}
    #cod-notify-bar.show{display:flex}
    .cnb-dot{width:8px;height:8px;border-radius:50%;background:#f59e0b;animation:cnbPulse 1.5s ease-in-out infinite;flex-shrink:0}
    @keyframes cnbPulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.7)}}
    .cnb-text{flex:1;font-size:13px;font-weight:600;color:#92400e}
    .cnb-text a{color:#b45309;font-weight:800;text-decoration:underline}
    .cnb-close{width:26px;height:26px;border:0;border-radius:7px;background:rgba(245,158,11,.18);cursor:pointer;font-size:13px;color:#92400e;flex-shrink:0}

    /* ── TABS ── */
    .tab-bar{display:flex;gap:0;border-bottom:2px solid var(--border2);margin-bottom:20px}
    .tab-btn{
      padding:10px 22px;font-size:13px;font-weight:700;cursor:pointer;
      border:none;background:none;color:var(--muted);
      border-bottom:3px solid transparent;margin-bottom:-2px;
      display:flex;align-items:center;gap:7px;transition:color .15s;
    }
    .tab-btn:hover{color:var(--text)}
    .tab-btn.active{color:var(--accent);border-bottom-color:var(--accent)}
    .tab-count{
      display:inline-flex;align-items:center;justify-content:center;
      min-width:20px;height:20px;padding:0 5px;border-radius:999px;
      font-size:10px;font-weight:900;line-height:1;
    }
    .tab-btn.active .tab-count{background:var(--accent);color:#fff}
    .tab-btn:not(.active) .tab-count{background:var(--surface3);color:var(--muted)}
    .tab-count.red{background:#ef4444!important;color:#fff!important}
    /* hide reconcile bar in COD tab */
    .cod-tab-hide{display:none!important}

    /* copy button */
    .copy-btn{display:inline-flex;align-items:center;gap:3px;padding:1px 7px;border:0;border-radius:5px;background:var(--surface3);color:var(--text2);font-size:10px;font-weight:700;cursor:pointer;font-family:var(--mono);transition:background .12s,color .12s;vertical-align:middle;margin-left:4px}
    .copy-btn:hover{background:var(--accent-dim);color:var(--accent)}
    .copy-btn.copied{background:rgba(34,197,94,.15);color:#4ade80}
    /* user360 link */
    .user360-link{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:700;color:var(--accent);text-decoration:none;padding:3px 9px;border-radius:6px;border:1px solid var(--accent-border);background:var(--accent-dim);transition:background .12s}
    .user360-link:hover{background:rgba(99,102,241,.22)}
    /* group head top row */
    .group-head-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:2px}
    /* loading overlay */
    #page-loader{display:none;position:fixed;inset:0;background:rgba(13,17,23,.7);backdrop-filter:blur(4px);z-index:9998;align-items:center;justify-content:center;flex-direction:column;gap:14px}
    #page-loader.show{display:flex}
    .loader-spin{width:40px;height:40px;border-radius:50%;border:3px solid rgba(99,102,241,.2);border-top-color:#6366f1;animation:spin .7s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}
    .loader-text{font-size:13px;font-weight:700;color:rgba(255,255,255,.7)}
  </style>
</head>
<body>

<div class="mobile-topbar">
  <button type="button" class="menu-btn" onclick="toggleAdminMenu()">&#9776; Menu</button>
  <div class="mobile-title">Admin Panel</div>
</div>
<div class="sidebar-backdrop" onclick="closeAdminMenu()"></div>

<div class="layout">
  <aside class="sidebar">
    <div class="brand">Admin Panel</div>
    <div class="nav">
      <a href="/admin">Overview</a>
      <a href="/admin/user360">View User</a>
      <a href="/admin/users">All Users</a>
      <a href="/admin/feedback">All Feedback</a>
      <a href="/admin/shipment-stock">Current Book Stock</a>
      <a href="/admin/shipments">Online Shipments</a>
      <a href="/admin/orders" class="active" style="display:flex;align-items:center;justify-content:space-between;gap:8px">
        <span>Online Orders</span>
        <% if (typeof codPendingCount !== 'undefined' && codPendingCount > 0) { %>
          <span style="display:inline-flex;align-items:center;justify-content:center;min-width:20px;height:20px;padding:0 5px;border-radius:999px;background:#ef4444;color:#fff;font-size:10px;font-weight:900;line-height:1;flex-shrink:0"><%= codPendingCount %></span>
        <% } %>
      </a>
      <a href="/admin/submissions">Online Submissions</a>
      <a href="/admin/contests">Online Contests</a>
      <div class="nav-sep"></div>
      <a href="/admin/offline-dashboard">Offline Overview</a>
      <a href="/admin/offline-orders">Offline Orders</a>
      <a href="/admin/agents">Offline Agents</a>
      <a href="/admin/payments/reconcile-bulk">Razorpay Reconcile</a>
      <div class="nav-sep"></div>
      <a href="/logout" style="opacity:.8">Logout</a>
    </div>
  </aside>

  <main class="content">
    <div class="wrap">
      <div class="card">

        <div class="page-header">
          <div>
            <h1 class="page-title">Online Orders</h1>
            <div class="page-sub">Grouped by user + order group ID &mdash; only KNC online orders shown</div>
          </div>
          <div class="actions">
            <a class="btn ghost" href="/admin/orders">Reset</a>
            <a class="btn ghost" href="/admin/orders/export.csv?<%= qs %>">Export CSV</a>
            <% if ((filters.tab||'online') !== 'cod') { %>
            <form method="POST" action="/admin/orders/reconcile-failed-page" style="display:inline">
              <input type="hidden" name="status"      value="<%= filters.status || '' %>" />
              <input type="hidden" name="book_option" value="<%= filters.bookOption || '' %>" />
              <input type="hidden" name="contest_id"  value="<%= filters.contestId || '' %>" />
              <input type="hidden" name="user_name"   value="<%= filters.userName || '' %>" />
              <input type="hidden" name="phone"       value="<%= filters.phone || '' %>" />
              <input type="hidden" name="order_id"    value="<%= filters.orderId || '' %>" />
              <input type="hidden" name="on_date"     value="<%= filters.onDate || '' %>" />
              <input type="hidden" name="date_from"   value="<%= filters.dateFrom || '' %>" />
              <input type="hidden" name="date_to"     value="<%= filters.dateTo || '' %>" />
              <input type="hidden" name="page"        value="<%= page %>" />
              <button class="btn ghost" type="submit">Reconcile Failed This Page</button>
            </form>
            <button class="btn danger-ghost" type="button" id="bulkReconcileBtn" onclick="startBulkFailedReconcile()">Bulk Reconcile Pending &rarr; Failed</button>
            <% } %>
            <button class="btn primary" type="submit" form="filtersForm">Apply Filters</button>
          </div>
        </div>

        <%
          // Smart bulk flash — parse bulk_paid_count / bulk_paid_ids from query
          const bulkCount = typeof bulk_paid_count !== 'undefined' ? Number(bulk_paid_count) : 0;
          const bulkIds   = typeof bulk_paid_ids   !== 'undefined' ? String(bulk_paid_ids).split(',').filter(Boolean) : [];
        %>
        <% if (bulkCount > 0) { %>
          <div class="msg ok" id="bulk-flash" style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px">
            <div style="flex:1">
              <strong>✅ <%= bulkCount %> COD order<%= bulkCount > 1 ? 's' : '' %> marked as paid</strong>
              <% if (bulkIds.length > 0) { %>
                <div style="margin-top:6px;display:flex;flex-wrap:wrap;gap:6px">
                  <% bulkIds.slice(0,10).forEach(function(id){ %>
                    <a href="/admin/orders?tab=cod&order_id=<%= id %>"
                       style="font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;
                              background:rgba(34,197,94,.15);color:#4ade80;
                              border:1px solid rgba(34,197,94,.3);text-decoration:none;font-family:monospace">
                      <%= id %>
                    </a>
                  <% }) %>
                  <% if (bulkIds.length > 10) { %>
                    <span style="font-size:11px;color:#4ade80">+<%= bulkIds.length - 10 %> more</span>
                  <% } %>
                </div>
              <% } %>
            </div>
            <button onclick="document.getElementById('bulk-flash').remove()"
                    style="background:none;border:0;color:#4ade80;cursor:pointer;font-size:18px;line-height:1;flex-shrink:0;padding:0 2px">✕</button>
          </div>
        <% } %>
        <% if (ok && !bulkCount) { %>
          <div class="msg ok" id="ok-flash" style="display:flex;align-items:center;justify-content:space-between;gap:10px">
            <span><%= ok %></span>
            <button onclick="document.getElementById('ok-flash').remove()"
                    style="background:none;border:0;color:#4ade80;cursor:pointer;font-size:18px;line-height:1;padding:0 2px">✕</button>
          </div>
        <% } %>
        <% if (err) { %>
          <div class="msg err" id="err-flash" style="display:flex;align-items:center;justify-content:space-between;gap:10px">
            <span><%= err %></span>
            <button onclick="document.getElementById('err-flash').remove()"
                    style="background:none;border:0;color:#f87171;cursor:pointer;font-size:18px;line-height:1;padding:0 2px">✕</button>
          </div>
        <% } %>

        <!-- BULK PROGRESS -->
        <div id="bulkProgressCard" class="progress-card">
          <div class="progress-header">
            <div>
              <div class="progress-title">Bulk pending &rarr; failed reconcile</div>
              <div class="progress-sub">Scans pending KNC order groups matching current filters. Paid reconcile is separate.</div>
            </div>
            <span class="pill our-pending" id="bulkProgressState">Idle</span>
          </div>
          <div class="progress-bar-track"><div id="bulkProgressFill" class="progress-bar-fill"></div></div>
          <div class="progress-stats">
            <div class="progress-stat"><div class="k">Scanned</div><div class="v" id="bulkScanned">0 / 0</div></div>
            <div class="progress-stat"><div class="k">Applied</div><div class="v" id="bulkApplied">0</div></div>
            <div class="progress-stat"><div class="k">Skipped</div><div class="v" id="bulkSkipped">0</div></div>
            <div class="progress-stat"><div class="k">API Skips</div><div class="v" id="bulkLookupSkips">0</div></div>
          </div>
          <div class="progress-msg" id="bulkProgressText">Start the bulk reconcile to begin scanning.</div>
          <div style="margin-top:12px"><button type="button" class="btn ghost" onclick="refreshOrdersAfterBulk()">Refresh Orders</button></div>
        </div>

        <!-- STATS -->
        <div class="stat-grid">
          <div class="stat"><div class="stat-label">Matched order groups</div><div class="stat-value"><%= totalCount %></div></div>
          <div class="stat"><div class="stat-label">Matched contest rows</div><div class="stat-value"><%= totalItemCount || 0 %></div></div>
          <div class="stat"><div class="stat-label">Groups on this page</div><div class="stat-value"><%= orders.length %></div></div>
        </div>

        <div class="divider"></div>

        <!-- TABS -->
        <div class="tab-bar">
          <a href="/admin/orders?tab=online" class="tab-btn <%= (filters.tab||'online')==='online' ? 'active' : '' %>">
            🏦 Online Payments
            <span class="tab-count"><%= totalCount %></span>
          </a>
          <a href="/admin/orders?tab=cod" class="tab-btn <%= filters.tab==='cod' ? 'active' : '' %>">
            💵 Cash on Delivery
            <% if (typeof codPendingCount !== 'undefined' && codPendingCount > 0) { %>
              <span class="tab-count red"><%= codPendingCount %></span>
            <% } else { %>
              <span class="tab-count"></span>
            <% } %>
          </a>
        </div>

        <!-- FILTERS -->
        <% if ((filters.tab||'online') === 'cod') { %>
        <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;background:linear-gradient(135deg,rgba(22,163,74,.1),rgba(22,163,74,.04));border:1.5px solid rgba(22,163,74,.3);border-radius:14px;padding:13px 18px;margin-bottom:14px;flex-wrap:wrap;">
          <div>
            <div style="font-size:13px;font-weight:800;color:#4ade80;margin-bottom:2px">📦 Bulk Mark Delivered COD Orders as Paid</div>
            <div style="font-size:11px;color:#86efac;line-height:1.5">Marks all COD orders where shipment status is <strong>Delivered</strong> as paid in one click. Only use after confirming cash has been collected.</div>
          </div>
          <form method="POST" action="/admin/orders/cod-bulk-mark-paid" onsubmit="return confirm('Mark ALL delivered COD shipments as PAID?\n\nOnly proceed after confirming cash collection.')">
            <button type="submit" style="display:inline-flex;align-items:center;gap:7px;padding:10px 20px;border:0;border-radius:10px;font-size:13px;font-weight:800;cursor:pointer;white-space:nowrap;background:linear-gradient(135deg,#16a34a,#15803d);color:#fff;box-shadow:0 4px 12px rgba(22,163,74,.35);">✅ Bulk Mark Delivered as Paid</button>
          </form>
        </div>
        <% } %>

        <div class="filters-wrap">
          <form id="filtersForm" method="GET" action="/admin/orders">
            <input type="hidden" name="tab" value="<%= filters.tab || 'online' %>">
            <div class="filter-grid">
              <div>
                <div class="filter-label">Status</div>
                <select name="status">
                  <option value="all"     <%= filters.status==='all'?'selected':'' %>>All</option>
                  <option value="paid"    <%= filters.status==='paid'?'selected':'' %>>Paid</option>
                  <% if ((filters.tab||'online') === 'cod') { %>
                    <option value="cod_pending" <%= filters.status==='cod_pending'?'selected':'' %>>COD Pending 💵</option>
                  <% } else { %>
                    <option value="pending" <%= filters.status==='pending'?'selected':'' %>>Pending</option>
                    <option value="failed"  <%= filters.status==='failed'?'selected':'' %>>Failed</option>
                  <% } %>
                </select>
              </div>
              <div>
                <div class="filter-label">Book option</div>
                <select name="book_option">
                  <option value="all"      <%= filters.bookOption==='all'?'selected':'' %>>All</option>
                  <option value="book"     <%= filters.bookOption==='book'?'selected':'' %>>Gift Book</option>
                  <option value="donation" <%= filters.bookOption==='donation'?'selected':'' %>>Donate</option>
                </select>
              </div>
              <div>
                <div class="filter-label">Contest</div>
                <select name="contest_id">
                  <option value="" <%= !filters.contestId?'selected':'' %>>All contests</option>
                  <% contests.forEach(c => { %>
                    <option value="<%= c.id %>" <%= (filters.contestId===c.id)?'selected':'' %>><%= c.title %></option>
                  <% }) %>
                </select>
              </div>
              <div>
                <div class="filter-label">User name</div>
                <input name="user_name" value="<%= filters.userName || '' %>" placeholder="e.g. Iskcon" />
              </div>
              <div>
                <div class="filter-label">Phone</div>
                <input name="phone" value="<%= filters.phone || '' %>" placeholder="e.g. 9876" />
              </div>
              <div>
                <div class="filter-label">Order / Group ID</div>
                <input name="order_id" value="<%= filters.orderId || '' %>" placeholder="KNC... or uuid..." />
              </div>
            </div>
            <div class="filter-grid-dates">
              <div><div class="filter-label">Specific date</div><input name="on_date" type="date" value="<%= filters.onDate || '' %>"/></div>
              <div><div class="filter-label">From</div><input name="date_from" type="date" value="<%= filters.dateFrom || '' %>"/></div>
              <div><div class="filter-label">To</div><input name="date_to" type="date" value="<%= filters.dateTo || '' %>"/></div>
              <div>
                <div class="filter-label">Quick date</div>
                <select id="quickDate">
                  <option value="">Choose...</option>
                  <option value="today">Today</option>
                  <option value="7">Last 7 days</option>
                  <option value="30">Last 30 days</option>
                </select>
              </div>
            </div>
          </form>
        </div>

        <%
          const base = (obj) => {
            const p = new URLSearchParams();
            Object.keys(obj).forEach(k => { if (obj[k]) p.set(k, obj[k]); });
            return p.toString();
          };
          const f = {
            status:      filters.status !== 'all' ? filters.status : '',
            book_option: filters.bookOption !== 'all' ? filters.bookOption : '',
            contest_id:  filters.contestId || '',
            user_name:   filters.userName || '',
            phone:       filters.phone || '',
            order_id:    filters.orderId || '',
            on_date:     filters.onDate || '',
            date_from:   filters.dateFrom || '',
            date_to:     filters.dateTo || ''
          };
          const pageQs = (n) => base({ ...f, page: String(n) });

          const ourClass = (value) => {
            const s = String(value || '').toLowerCase().trim();
            if (s === 'paid' || s === 'captured')                              return 'our-paid';
            if (s === 'failed' || s.includes('error') || s.includes('fail'))   return 'our-failed';
            if (s === 'pending')                                                return 'our-pending';
            return 'our-neutral';
          };

          const cardClass = (group) => {
            const statuses = String(group.our_status || group.payment_statuses || '').toLowerCase();
            if (statuses.includes('paid'))    return 'card-paid';
            if (statuses.includes('failed'))  return 'card-failed';
            if (statuses.includes('pending')) return 'card-pending';
            return '';
          };

          const rpClass = (value) => {
            const s = String(value || '').toLowerCase().trim();
            if (s === 'captured' || s === 'paid')               return 'rp-captured';
            if (s === 'failed' || s.includes('fail'))            return 'rp-failed';
            if (['created','pending','authorized'].includes(s))  return 'rp-pending';
            return 'rp-neutral';
          };

          const rpLabel = (v) => {
            const map = { unavailable:'unavailable', no_payment_id:'no payment id', no_payment_session:'no session', api_error:'api error', not_found:'not found' };
            return map[v] || v || '-';
          };

          const fmtDate = (value) => {
            if (!value) return '-';
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return String(value);
            const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
            let hh = d.getHours();
            const min = String(d.getMinutes()).padStart(2,'0');
            const ampm = hh >= 12 ? 'PM' : 'AM';
            hh = hh % 12 || 12;
            return `${String(d.getDate()).padStart(2,'0')} ${months[d.getMonth()]} ${d.getFullYear()}, ${String(hh).padStart(2,'0')}:${min} ${ampm}`;
          };

          const fmtDelivery = (value) => {
            const s = String(value || '').trim();
            return s ? s.replace(/_/g,' ') : '-';
          };
        %>

        <!-- CHIPS -->
        <div class="chips">
          <% Object.keys(f).forEach(k => { if (f[k]) {
            const copy = { ...f }; copy[k] = '';
            const qs2 = base(copy);
          %>
            <span class="chip"><span><%= k %>: <%= f[k] %></span><a href="/admin/orders?<%= qs2 %>">&times;</a></span>
          <% } }) %>
        </div>

        <!-- TOP PAGINATION -->
        <% if (totalPages > 1) { %>
          <div class="pagination-bar" style="margin-top:14px">
            <div class="pagination-info">Page <%= page %> of <%= totalPages %> &mdash; <%= totalCount %> groups total</div>
            <div class="pagination">
              <a class="page-link <%= page <= 1 ? 'disabled' : '' %>" href="/admin/orders?<%= pageQs(page - 1) %>">&larr;</a>
              <% let lastShownT = 0; for (let p = 1; p <= totalPages; p++) { if (p === 1 || p === totalPages || Math.abs(p - page) <= 2) { if (lastShownT && p - lastShownT > 1) { %><span class="page-dots">&hellip;</span><% } %><a class="page-link <%= p === page ? 'active' : '' %>" href="/admin/orders?<%= pageQs(p) %>"><%= p %></a><% lastShownT = p; } } %>
              <a class="page-link <%= page >= totalPages ? 'disabled' : '' %>" href="/admin/orders?<%= pageQs(page + 1) %>">&rarr;</a>
            </div>
          </div>
        <% } %>

        <!-- ORDER GROUPS -->
        <% if (!orders.length) { %>
          <div class="empty">No online order groups matched these filters.</div>
        <% } else { %>
          <div class="groups">
            <% orders.forEach(group => { %>
              <div class="group-card <%= cardClass(group) %>">
                <div class="group-head">
                  <!-- Col 1: User + IDs -->
                  <div>
                    <div class="group-head-top">
                      <div class="group-name"><%= group.user_name || group.full_name || 'Unknown user' %></div>
                      <a href="/admin/user360?phone=<%= encodeURIComponent(group.phone || '') %>" class="user360-link" title="View user 360">👤 User 360</a>
                    </div>
                    <div class="group-phone" style="display:flex;align-items:center;gap:4px">
                      <span><%= group.phone || '-' %></span>
                      <% if (group.phone) { %>
                        <button class="copy-btn" onclick="copyText('<%= group.phone %>', this)" title="Copy phone">📋</button>
                      <% } %>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:3px">
                      <span class="id-tag">
                        Order: <%= group.order_group_id || '-' %>
                        <button class="copy-btn" onclick="copyText('<%= group.order_group_id %>', this)" title="Copy order ID">📋</button>
                      </span>
                      <% if (group.payment_session_id) { %>
                        <span class="id-tag">
                          Session: <%= group.payment_session_id %>
                          <button class="copy-btn" onclick="copyText('<%= group.payment_session_id %>', this)" title="Copy session ID">📋</button>
                        </span>
                      <% } %>
                      <% if (group.shipment_ids) { %><span class="id-tag">Shipment: <%= group.shipment_ids %></span><% } %>
                    </div>
                  </div>
                  <!-- Col 2: Date + count -->
                  <div>
                    <div class="meta-block">
                      <div class="meta-label">Created</div>
                      <div class="meta-value" style="font-size:13px"><%= fmtDate ? fmtDate(group.created_at) : group.created_at %></div>
                    </div>
                    <div class="meta-block">
                      <div class="meta-label">Contests</div>
                      <div class="meta-value"><%= group.item_count %></div>
                    </div>
                  </div>
                  <!-- Col 3: Amount + option -->
                  <div>
                    <div class="meta-block">
                      <div class="meta-label">Total amount</div>
                      <div class="meta-value large">&#8377;<%= group.total_amount %></div>
                    </div>
                    <div class="meta-block">
                      <div class="meta-label">Book option</div>
                      <div class="meta-value"><%= group.book_options || '-' %></div>
                    </div>
                  </div>
                  <!-- Col 4: Two status blocks with different pill palettes -->
                  <div>
                    <div class="status-block">
                      <div class="status-section-label">Our status</div>
                      <div class="pill-row">
                        <% String(group.our_status || group.payment_statuses || '').split(',').map(v=>v.trim()).filter(Boolean).forEach(st => { %>
                          <span class="pill <%= ourClass(st) %>"><%= st %></span>
                        <% }) %>
                      </div>
                    </div>
                    <div class="status-block" style="margin-top:10px">
                      <% var isCod = group.razorpay_status === 'cod' || String(group.our_status || group.payment_statuses || '').includes('cod_pending') || String(group.gateway_order_id || '').startsWith('COD_'); %>
                      <% if (isCod) { %>
                        <div class="status-section-label">Payment method</div>
                        <div class="pill-row">
                          <span class="pill" style="background:#2d1f04;color:#fcd34d;border:1.5px solid #d97706;font-weight:800">💵 Cash on Delivery</span>
                        </div>
                      <% } else { %>
                        <div class="status-section-label">Razorpay status</div>
                        <div class="pill-row">
                          <span class="pill <%= rpClass(group.razorpay_status) %>"><%= rpLabel ? rpLabel(group.razorpay_status) : (group.razorpay_status || '-') %></span>
                        </div>
                      <% } %>
                    </div>
                  </div>
                </div>

                <% if (group.can_mark_failed) { %>
                  <div class="reconcile-banner">
                    <span class="reconcile-dot"></span>
                    Eligible for pending &rarr; failed reconcile
                  </div>
                <% } %>

                <% if (String(group.our_status || group.payment_statuses || '').includes('cod_pending')) { %>
                  <%
                    var shipStatuses = String(group.shipment_statuses || '').toLowerCase();
                    var codDelivered = shipStatuses.includes('delivered');
                  %>
                  <div class="cod-action-bar">
                    <div class="cod-icon">💵</div>
                    <div class="cod-text">
                      <div class="cod-text-title">
                        Cash on Delivery Order
                        <span style="
                          display:inline-block;margin-left:8px;
                          font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;
                          vertical-align:middle;
                          <%= codDelivered
                            ? 'background:rgba(22,163,74,.2);color:#4ade80;border:1px solid rgba(22,163,74,.4)'
                            : 'background:rgba(245,158,11,.2);color:#fcd34d;border:1px solid rgba(245,158,11,.4)' %>
                        ">
                          Shipment: <%= shipStatuses || 'unknown' %>
                        </span>
                      </div>
                      <div class="cod-text-sub">
                        <% if (codDelivered) { %>
                          ✅ Shipment delivered — safe to mark as paid after confirming cash collected.
                        <% } else { %>
                          ⚠️ Shipment not yet delivered (<%= shipStatuses || 'no status' %>). Mark shipment as <strong>Delivered</strong> first, then mark as paid.
                        <% } %>
                      </div>
                    </div>
                    <% if (codDelivered) { %>
                      <button type="button" class="btn-cod-paid"
                        onclick="showCodConfirm('<%= group.order_group_id %>', '<%= (group.user_name || '').replace(/'/g,'') %>', '<%= typeof qs !== 'undefined' ? qs : '' %>')">
                        ✅ Mark as Paid
                      </button>
                    <% } else { %>
                      <a href="/admin/shipments" style="
                        display:inline-flex;align-items:center;gap:6px;
                        padding:9px 16px;border-radius:10px;text-decoration:none;
                        font-size:12px;font-weight:800;
                        background:rgba(245,158,11,.15);color:#fcd34d;
                        border:1px solid rgba(245,158,11,.35);
                      ">📦 Go to Shipments →</a>
                    <% } %>
                  </div>
                <% } %>

                <div class="item-table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th>Contest</th>
                        <th>Book &amp; language</th>
                        <th>Shipment ID</th>
                        <th>Delivery mode</th>
                        <th>Status</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% (group.items || []).forEach(item => { %>
                        <tr>
                          <td>
                            <div class="td-main"><%= item.contest_title %></div>
                            <div class="td-sub"><%= fmtDate ? fmtDate(item.created_at) : item.created_at %></div>
                          </td>
                          <td>
                            <div class="td-main"><%= [item.book_title, item.book_language].filter(Boolean).join(' — ') || '-' %></div>
                            <% if (item.bonus_books) { %><div class="td-sub">Bonus: <%= item.bonus_books %></div><% } %>
                          </td>
                          <td class="mono"><%= item.shipment_id || '-' %></td>
                          <td style="font-size:13px"><%= fmtDelivery ? fmtDelivery(item.delivery_mode) : (item.delivery_mode || '-') %></td>
                          <td>
                            <% const rowStatus = item.shipment_status || item.payment_status; %>
                            <span class="pill <%= ourClass(rowStatus) %>"><%= rowStatus || '-' %></span>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>
            <% }) %>
          </div>

          <!-- BOTTOM PAGINATION -->
          <% if (totalPages > 1) { %>
            <div style="margin-top:18px" class="pagination">
              <a class="page-link <%= page <= 1 ? 'disabled' : '' %>" href="/admin/orders?<%= pageQs(page - 1) %>">&larr; Prev</a>
              <% let lastShown = 0; for (let p = 1; p <= totalPages; p++) { if (p === 1 || p === totalPages || Math.abs(p - page) <= 2) { if (lastShown && p - lastShown > 1) { %><span class="page-dots">&hellip;</span><% } %><a class="page-link <%= p === page ? 'active' : '' %>" href="/admin/orders?<%= pageQs(p) %>"><%= p %></a><% lastShown = p; } } %>
              <a class="page-link <%= page >= totalPages ? 'disabled' : '' %>" href="/admin/orders?<%= pageQs(page + 1) %>">Next &rarr;</a>
            </div>
          <% } %>
        <% } %>

      </div>
    </div>
  </main>
</div>

<script>
  (function(){
    const quick=document.getElementById('quickDate'),from=document.querySelector('input[name="date_from"]'),to=document.querySelector('input[name="date_to"]'),onDate=document.querySelector('input[name="on_date"]');
    const fmt=d=>{const y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,'0'),da=String(d.getDate()).padStart(2,'0');return `${y}-${m}-${da}`;};
    quick.addEventListener('change',()=>{const v=quick.value;if(!v)return;onDate.value='';const now=new Date();if(v==='today'){from.value=to.value=fmt(now);return;}from.value=fmt(new Date(now-parseInt(v,10)*864e5));to.value=fmt(now);});
  })();
</script>

<script>
  let bulkReconcileJobId=null,bulkReconcileTimer=null;

  function bulkFilterPayload(){
    return new URLSearchParams({status:document.querySelector('[name="status"]')?.value||'',book_option:document.querySelector('[name="book_option"]')?.value||'',contest_id:document.querySelector('[name="contest_id"]')?.value||'',user_name:document.querySelector('[name="user_name"]')?.value||'',phone:document.querySelector('[name="phone"]')?.value||'',order_id:document.querySelector('[name="order_id"]')?.value||'',on_date:document.querySelector('[name="on_date"]')?.value||'',date_from:document.querySelector('[name="date_from"]')?.value||'',date_to:document.querySelector('[name="date_to"]')?.value||''});
  }

  function setBulkProgressVisible(show){document.getElementById('bulkProgressCard').classList.toggle('show',show);}

  function setBulkState(text,cssClass){const el=document.getElementById('bulkProgressState');el.textContent=text;el.className='pill';if(cssClass)el.classList.add(cssClass);}

  function updateBulkUi(job){
    const total=Number(job?.total||0),scanned=Number(job?.scanned||0),pct=total>0?Math.max(0,Math.min(100,Math.round((scanned/total)*100))):100;
    document.getElementById('bulkProgressFill').style.width=pct+'%';
    document.getElementById('bulkScanned').textContent=`${scanned} / ${total}`;
    document.getElementById('bulkApplied').textContent=String(job?.applied||0);
    document.getElementById('bulkSkipped').textContent=String(job?.skipped||0);
    document.getElementById('bulkLookupSkips').textContent=String(job?.failedLookups||0);
    document.getElementById('bulkProgressText').textContent=job?.message||'Working...';
    if(job?.status==='completed')setBulkState('Completed','our-paid');
    else if(job?.status==='failed')setBulkState('Failed','our-failed');
    else setBulkState(`${pct}%`,'our-pending');
  }

  async function startBulkFailedReconcile(){
    const btn=document.getElementById('bulkReconcileBtn');
    btn.disabled=true;setBulkProgressVisible(true);setBulkState('Starting','our-pending');
    document.getElementById('bulkProgressText').textContent='Preparing pending groups...';
    try{
      const res=await fetch('/admin/orders/reconcile-failed-bulk/start',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded; charset=UTF-8','Accept':'application/json'},body:bulkFilterPayload().toString()});
      const data=await res.json();
      if(!res.ok||!data?.ok)throw new Error(data?.message||'Failed to start bulk reconcile');
      bulkReconcileJobId=data.jobId;
      updateBulkUi({total:data.total||0,scanned:0,applied:0,skipped:0,failedLookups:0,status:data.total?'running':'completed',message:data.total?'Bulk reconcile started...':'No pending groups matched the current filters.'});
      if(!data.total){btn.disabled=false;return;}
      if(bulkReconcileTimer)clearInterval(bulkReconcileTimer);
      bulkReconcileTimer=setInterval(fetchBulkFailedReconcileStatus,1000);
      await fetchBulkFailedReconcileStatus();
    }catch(err){setBulkState('Failed','our-failed');document.getElementById('bulkProgressText').textContent=err?.message||'Failed to start';btn.disabled=false;}
  }

  async function fetchBulkFailedReconcileStatus(){
    if(!bulkReconcileJobId)return;
    try{
      const res=await fetch(`/admin/orders/reconcile-failed-bulk/status/${encodeURIComponent(bulkReconcileJobId)}`,{headers:{'Accept':'application/json'}});
      const data=await res.json();
      if(!res.ok||!data?.ok||!data?.job)throw new Error(data?.message||'Failed to fetch status');
      updateBulkUi(data.job);
      if(data.job.status==='completed'||data.job.status==='failed'){clearInterval(bulkReconcileTimer);bulkReconcileTimer=null;document.getElementById('bulkReconcileBtn').disabled=false;}
    }catch(err){clearInterval(bulkReconcileTimer);bulkReconcileTimer=null;setBulkState('Failed','our-failed');document.getElementById('bulkProgressText').textContent=err?.message||'Failed to fetch status';document.getElementById('bulkReconcileBtn').disabled=false;}
  }

  function refreshOrdersAfterBulk(){window.location.href=`/admin/orders?<%= qs %>`;}
</script>

<script>
  function toggleAdminMenu(){document.body.classList.toggle('menu-open');}
  function closeAdminMenu(){document.body.classList.remove('menu-open');}
  document.addEventListener('keydown',e=>{if(e.key==='Escape')closeAdminMenu();});
</script>


<!-- Premium COD Confirm Toast -->
<div id="cod-toast">
  <div class="toast-hd">
    <div class="toast-ico">✅</div>
    <div style="flex:1">
      <div class="toast-title" id="toast-title">Mark order as Paid?</div>
      <div class="toast-msg" id="toast-msg">Confirm only after cash has been physically received.</div>
    </div>
    <button class="toast-x" onclick="closeCodToast()">✕</button>
  </div>
  <div class="toast-acts">
    <button class="toast-btn cancel" onclick="closeCodToast()">Cancel</button>
    <button class="toast-btn go" id="toast-confirm-btn" onclick="submitCodForm()">✅ Yes, Mark as Paid</button>
  </div>
</div>

<!-- Hidden form submitted by toast -->
<form id="cod-paid-form" method="POST" action="/admin/orders/cod-mark-paid" style="display:none">
  <input type="hidden" id="cod-form-payment-id" name="payment_id" value="">
  <input type="hidden" id="cod-form-qs"         name="return_qs"  value="">
</form>

<script>
  var _codFormPaymentId = '';
  var _codFormQs = '';

  function showCodConfirm(paymentId, userName, qs) {
    _codFormPaymentId = paymentId;
    _codFormQs        = qs;
    document.getElementById('toast-title').textContent = 'Mark ' + paymentId + ' as Paid?';
    document.getElementById('toast-msg').textContent   =
      'Customer: ' + (userName || 'Unknown') + ' — confirm only after cash has been physically received from the delivery partner.';
    document.getElementById('cod-toast').classList.add('show');
  }

  function closeCodToast() {
    document.getElementById('cod-toast').classList.remove('show');
  }

  function submitCodForm() {
    document.getElementById('cod-form-payment-id').value = _codFormPaymentId;
    document.getElementById('cod-form-qs').value         = _codFormQs;
    document.getElementById('toast-confirm-btn').textContent = 'Processing…';
    document.getElementById('toast-confirm-btn').disabled  = true;
    document.getElementById('cod-paid-form').submit();
  }

  // Close toast on backdrop click
  document.getElementById('cod-toast').addEventListener('click', function(e) {
    if (e.target === this) closeCodToast();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeCodToast();
  });
</script>

<!-- Page loader -->
<div id="page-loader">
  <div class="loader-spin"></div>
  <div class="loader-text" id="loader-text">Loading…</div>
</div>

<script>
  // ── Page loader on navigation ────────────────────────────────────────────
  function showLoader(text) {
    document.getElementById('loader-text').textContent = text || 'Loading details…';
    document.getElementById('page-loader').classList.add('show');
  }
  // Attach to all internal nav links (except anchors/copy)
  document.querySelectorAll('a[href^="/admin"]').forEach(function(a) {
    a.addEventListener('click', function(e) {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      showLoader('Loading details…');
    });
  });
  // Attach to filter form
  var ff = document.getElementById('filtersForm');
  if (ff) ff.addEventListener('submit', function() { showLoader('Applying filters…'); });
  // Hide on bfcache restore
  window.addEventListener('pageshow', function(e) {
    if (e.persisted) document.getElementById('page-loader').classList.remove('show');
  });

  // ── Copy to clipboard ────────────────────────────────────────────────────
  function copyText(text, btn) {
    if (!text) return;
    navigator.clipboard.writeText(text).then(function() {
      var orig = btn.textContent;
      btn.textContent = '✓';
      btn.classList.add('copied');
      setTimeout(function() {
        btn.textContent = orig;
        btn.classList.remove('copied');
      }, 1500);
    }).catch(function() {
      // Fallback for older browsers
      var ta = document.createElement('textarea');
      ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      btn.textContent = '✓'; btn.classList.add('copied');
      setTimeout(function() { btn.textContent = '📋'; btn.classList.remove('copied'); }, 1500);
    });
  }
</script>
</body>
</html>