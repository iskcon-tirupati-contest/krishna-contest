<%- include('partials/admin-shell-start', {
  title: 'Orders',
  mobileTitle: 'Orders',
  activeTab: 'orders'
}) %>

<div class="page-head">
  <div>
    <h1>Orders</h1>
    <div class="sub">
      Showing <strong><%= (orders || []).length %></strong> rows • Matched total
      <strong><%= totalCount %></strong> orders
    </div>
  </div>

  <div class="page-actions">
    <a class="btn ghost" href="/admin/orders">Reset All</a>
    <a class="btn ghost" href="/admin/orders/export.csv?<%= qs %>">Export CSV</a>
    <button class="btn primary" type="submit" form="filtersForm">Apply Filters</button>
  </div>
</div>

<div class="card">
  <div class="strong" style="margin-bottom:6px">Filters</div>
  <div class="tiny">Filter by payment status, book option, contest, user, phone, and date range.</div>

  <div class="section-line"></div>

  <form id="filtersForm" method="GET" action="/admin/orders">
    <div class="grid grid-3">
      <div>
        <label for="status">Status</label>
        <select id="status" name="status">
          <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All</option>
          <option value="paid" <%= filters.status === 'paid' ? 'selected' : '' %>>Paid</option>
          <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending/Not Paid</option>
          <option value="failed" <%= filters.status === 'failed' ? 'selected' : '' %>>Failed</option>
        </select>
      </div>

      <div>
        <label for="book_option">Book option</label>
        <select id="book_option" name="book_option">
          <option value="all" <%= filters.bookOption === 'all' ? 'selected' : '' %>>All</option>
          <option value="book" <%= filters.bookOption === 'book' ? 'selected' : '' %>>Gift Book</option>
          <option value="donation" <%= filters.bookOption === 'donation' ? 'selected' : '' %>>Donate</option>
        </select>
      </div>

      <div>
        <label for="contest_id">Contest</label>
        <select id="contest_id" name="contest_id">
          <option value="" <%= !filters.contestId ? 'selected' : '' %>>All contests</option>
          <% (contests || []).forEach(c => { %>
            <option value="<%= c.id %>" <%= filters.contestId === c.id ? 'selected' : '' %>>
              <%= c.title %>
            </option>
          <% }) %>
        </select>
      </div>

      <div>
        <label for="user_name">User name</label>
        <input id="user_name" name="user_name" value="<%= filters.userName || '' %>" placeholder="e.g. Iskcon" />
      </div>

      <div>
        <label for="phone">Phone (users)</label>
        <input id="phone" name="phone" value="<%= filters.phone || '' %>" placeholder="e.g. 9876" />
      </div>

      <div>
        <label for="quickDate">Quick date</label>
        <select id="quickDate">
          <option value="">Choose</option>
          <option value="today">Today</option>
          <option value="7">Last 7 days</option>
          <option value="30">Last 30 days</option>
        </select>
      </div>
    </div>

    <div class="grid grid-3" style="margin-top:12px">
      <div>
        <label for="on_date">On a specific date</label>
        <input id="on_date" name="on_date" type="date" value="<%= filters.onDate || '' %>" />
      </div>

      <div>
        <label for="date_from">From</label>
        <input id="date_from" name="date_from" type="date" value="<%= filters.dateFrom || '' %>" />
      </div>

      <div>
        <label for="date_to">To</label>
        <input id="date_to" name="date_to" type="date" value="<%= filters.dateTo || '' %>" />
      </div>
    </div>
  </form>

  <%
    const base = (obj) => {
      const p = new URLSearchParams();
      Object.keys(obj).forEach(k => {
        if (obj[k]) p.set(k, obj[k]);
      });
      return p.toString();
    };

    const f = {
      status: filters.status !== 'all' ? filters.status : '',
      book_option: filters.bookOption !== 'all' ? filters.bookOption : '',
      contest_id: filters.contestId || '',
      user_name: filters.userName || '',
      phone: filters.phone || '',
      on_date: filters.onDate || '',
      date_from: filters.dateFrom || '',
      date_to: filters.dateTo || ''
    };
  %>

  <div class="row" style="margin-top:14px">
    <% Object.keys(f).forEach(k => { if (f[k]) {
      const copy = { ...f };
      copy[k] = '';
      const chipQs = base(copy);
    %>
      <span class="pill">
        <span><%= k %>: <%= f[k] %></span>
        <a href="/admin/orders?<%= chipQs %>" style="margin-left:6px">✕</a>
      </span>
    <% } }) %>

    <% if (!Object.keys(f).some(k => f[k])) { %>
      <span class="tiny">No active filters.</span>
    <% } %>
  </div>
</div>

<div class="card">
  <div class="row" style="justify-content:space-between;margin-bottom:12px">
    <div>
      <div class="strong">Orders List</div>
      <div class="tiny">Horizontally scrollable on mobile for safe viewing.</div>
    </div>
    <span class="pill"><%= (orders || []).length %> row(s)</span>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Contest</th>
          <th>User</th>
          <th>Phone</th>
          <th>Amount</th>
          <th>Status</th>
          <th>Book option</th>
          <th>Order ID</th>
        </tr>
      </thead>
      <tbody>
        <% (orders || []).forEach(o => { %>
          <tr>
            <td><%= o.created_at %></td>
            <td><%= o.contest_title %></td>
            <td>
              <div class="strong"><%= o.user_name %></div>
              <div class="tiny"><%= o.email %></div>
            </td>
            <td><%= o.phone || '-' %></td>
            <td>₹<%= o.amount %></td>
            <td><span class="pill"><%= o.payment_status %></span></td>
            <td><%= o.book_option %></td>
            <td class="tiny"><%= o.id %></td>
          </tr>
        <% }) %>

        <% if (!orders || !orders.length) { %>
          <tr>
            <td colspan="8" class="muted">No orders found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  (function(){
    const quick = document.getElementById("quickDate");
    const from = document.querySelector('input[name="date_from"]');
    const to = document.querySelector('input[name="date_to"]');
    const onDate = document.querySelector('input[name="on_date"]');

    function fmt(d){
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const da = String(d.getDate()).padStart(2, '0');
      return `${y}-${m}-${da}`;
    }

    if (!quick || !from || !to || !onDate) return;

    quick.addEventListener("change", () => {
      const v = quick.value;
      if (!v) return;

      onDate.value = "";

      const now = new Date();

      if (v === "today") {
        from.value = fmt(now);
        to.value = fmt(now);
        return;
      }

      const days = parseInt(v, 10);
      const start = new Date(now.getTime() - (days * 24 * 60 * 60 * 1000));
      from.value = fmt(start);
      to.value = fmt(now);
    });
  })();
</script>

<%- include('partials/admin-shell-end') %>