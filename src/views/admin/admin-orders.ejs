<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin - Orders</title>
  <style>
    body{margin:0;font-family:Segoe UI,Tahoma,Verdana,sans-serif;background:#0b1224;color:#fff}
    .layout{display:flex;min-height:100vh}
    .sidebar{width:260px;background:#0a1022;border-right:1px solid rgba(255,255,255,.08);padding:18px}
    .brand{font-weight:900;margin-bottom:18px}
    .nav a{display:block;padding:10px 12px;border-radius:12px;text-decoration:none;color:rgba(255,255,255,.85);margin-bottom:8px}
    .nav a.active{background:rgba(26,60,255,.18);border:1px solid rgba(26,60,255,.35);color:#fff}
    .content{flex:1;min-width:0}
    .wrap{max-width:1300px;margin:26px auto;padding:0 18px}
    .card{background:#111b35;border:1px solid rgba(255,255,255,.12);border-radius:18px;padding:18px}
    .muted{color:rgba(255,255,255,.7)}
    input,select{width:100%;padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,.18);background:#0e1630;color:#fff}
    .grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}
    .btn{border:none;border-radius:12px;padding:10px 12px;font-weight:900;cursor:pointer}
    .btn.primary{background:#1a3cff;color:#fff}
    .btn.ghost{background:rgba(255,255,255,.10);color:#fff}
    table{width:100%;border-collapse:collapse;margin-top:14px}
    th,td{padding:10px;border-bottom:1px solid rgba(255,255,255,.10);text-align:left;vertical-align:top}
    .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
    .chip{display:inline-flex;gap:8px;align-items:center;background:rgba(26,60,255,.18);border:1px solid rgba(26,60,255,.35);padding:6px 10px;border-radius:999px}
    .chip a{color:#fff;text-decoration:none;opacity:.9}
    .right{display:flex;gap:10px;justify-content:flex-end;align-items:center}
    @media (max-width:1100px){
      .grid{grid-template-columns:repeat(2,1fr)}
      .mobile-topbar{display:flex !important}
      .sidebar{
        position:fixed;
        left:0;
        top:0;
        bottom:0;
        z-index:1199;
        transform:translateX(-100%);
        transition:transform .22s ease;
        box-shadow:0 10px 30px rgba(0,0,0,.35);
        overflow:auto;
        flex-shrink:0;
      }
      body.menu-open .sidebar{transform:translateX(0)}
      body.menu-open .sidebar-backdrop{display:block}
      .wrap{margin:18px auto;padding:0 14px}
    }
  

  .mobile-topbar{
    display:none;
    position:sticky;
    top:0;
    z-index:1200;
    padding:12px 14px;
    background:#0a1022;
    border-bottom:1px solid rgba(255,255,255,.08);
    align-items:center;
    justify-content:space-between;
    gap:12px;
  }
  .mobile-title{font-weight:900}
  .menu-btn{
    border:none;
    border-radius:12px;
    padding:10px 12px;
    font-weight:900;
    cursor:pointer;
    background:#1a3cff;
    color:#fff;
  }

  .sidebar-backdrop{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.45);
    z-index:1198;
  }

</style>
</head>
<body>
<div class="mobile-topbar">
  <button type="button" class="menu-btn" onclick="toggleAdminMenu()">☰ Menu</button>
  <div class="mobile-title">Admin Panel</div>
</div>

<div class="sidebar-backdrop" onclick="closeAdminMenu()"></div>
  <div class="layout">
    <aside class="sidebar">
      <div class="brand">Admin Panel</div>
      <div class="nav">
  <a href="/admin">Overview</a>
  <a href="/admin/user360">View User</a>
  <a href="/admin/users">All Users</a>
  <a href="/admin/feedback">All Feedback</a>
  <a href="/admin/shipment-stock">Current Book Stock</a>
  <a href="/admin/shipments">Online Shipments</a>
  <a href="/admin/orders" class="active">Online Orders</a>
  <a href="/admin/submissions">Online Submissions</a>
  <a href="/admin/contests">Online Contests</a>
  <a href="/admin/offline-dashboard">Offline Overview</a>
  <a href="/admin/offline-orders">Offline Orders</a>
  <a href="/admin/agents">Offline Agents</a>
  <a href="/admin/payments/reconcile-bulk">Razorpay Reconcile</a>
  <a href="/logout" style="margin-top:14px;opacity:.9">Logout</a>
</div>
    </aside>

    <main class="content">
      <div class="wrap">
        <div class="card">
          <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:14px;flex-wrap:wrap">
            <div>
              <h1 style="margin:0 0 6px 0">Orders</h1>
              <div class="muted">Showing <b><%= orders.length %></b> rows • Matched total <b><%= totalCount %></b> orders</div>
            </div>
            <div class="right">
              <a class="btn ghost" href="/admin/orders">Reset All</a>
              <a class="btn ghost" href="/admin/orders/export.csv?<%= qs %>">Export CSV</a>

              <button class="btn primary" type="submit" form="filtersForm">Apply Filters</button>
            </div>
          </div>

          <div style="height:1px;background:rgba(255,255,255,.12);margin:14px 0"></div>

          <form id="filtersForm" method="GET" action="/admin/orders">
            <div class="grid">
              <div>
                <div class="muted" style="font-size:12px;margin-bottom:6px">Status</div>
                <select name="status">
                  <option value="all" <%= filters.status==='all'?'selected':'' %>>All</option>
                  <option value="paid" <%= filters.status==='paid'?'selected':'' %>>Paid</option>
                  <option value="pending" <%= filters.status==='pending'?'selected':'' %>>Pending/Not Paid</option>
                  <option value="failed" <%= filters.status==='failed'?'selected':'' %>>Failed</option>
                </select>
              </div>

              <div>
                <div class="muted" style="font-size:12px;margin-bottom:6px">Book option</div>
                <select name="book_option">
                  <option value="all" <%= filters.bookOption==='all'?'selected':'' %>>All</option>
                  <option value="book" <%= filters.bookOption==='book'?'selected':'' %>>Gift Book</option>
                  <option value="donation" <%= filters.bookOption==='donation'?'selected':'' %>>Donate</option>
                </select>
              </div>

              <div>
                <div class="muted" style="font-size:12px;margin-bottom:6px">Contest</div>
                <select name="contest_id">
                  <option value="" <%= !filters.contestId ? 'selected':'' %>>All contests</option>
                  <% contests.forEach(c => { %>
                    <option value="<%= c.id %>" <%= (filters.contestId===c.id)?'selected':'' %>><%= c.title %></option>
                  <% }) %>
                </select>
              </div>

              <div>
                <div class="muted" style="font-size:12px;margin-bottom:6px">User name</div>
                <input name="user_name" value="<%= filters.userName || '' %>" placeholder="e.g. Iskcon" />
              </div>

              <div>
                <div class="muted" style="font-size:12px;margin-bottom:6px">Phone (users)</div>
                <input name="phone" value="<%= filters.phone || '' %>" placeholder="e.g. 9876" />
              </div>

              <div>
                <div class="muted" style="font-size:12px;margin-bottom:6px">Quick date</div>
                <select id="quickDate">
                  <option value="">Choose</option>
                  <option value="today">Today</option>
                  <option value="7">Last 7 days</option>
                  <option value="30">Last 30 days</option>
                </select>
              </div>
            </div>

            <div class="grid" style="grid-template-columns:repeat(3,1fr);margin-top:10px">
              <div>
                <div class="muted" style="font-size:12px;margin-bottom:6px">On a specific date</div>
                <input name="on_date" type="date" value="<%= filters.onDate || '' %>"/>
              </div>
              <div>
                <div class="muted" style="font-size:12px;margin-bottom:6px">From</div>
                <input name="date_from" type="date" value="<%= filters.dateFrom || '' %>"/>
              </div>
              <div>
                <div class="muted" style="font-size:12px;margin-bottom:6px">To</div>
                <input name="date_to" type="date" value="<%= filters.dateTo || '' %>"/>
              </div>
            </div>
          </form>

          <%
            // chips + remove links
            const base = (obj) => {
              const p = new URLSearchParams();
              Object.keys(obj).forEach(k => { if (obj[k]) p.set(k, obj[k]); });
              return p.toString();
            };
            const f = {
              status: filters.status !== 'all' ? filters.status : '',
              book_option: filters.bookOption !== 'all' ? filters.bookOption : '',
              contest_id: filters.contestId || '',
              user_name: filters.userName || '',
              phone: filters.phone || '',
              on_date: filters.onDate || '',
              date_from: filters.dateFrom || '',
              date_to: filters.dateTo || ''
            };
          %>

          <div class="chips">
            <% Object.keys(f).forEach(k => { if (f[k]) {
              const copy = { ...f }; copy[k] = '';
              const qs = base(copy);
            %>
              <span class="chip">
                <span><%= k %>: <%= f[k] %></span>
                <a href="/admin/orders?<%= qs %>">✕</a>
              </span>
            <% } }) %>
          </div>

          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Contest</th>
                <th>User</th>
                <th>Phone</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Book option</th>
                <th>Order ID</th>
              </tr>
            </thead>
            <tbody>
              <% orders.forEach(o => { %>
                <tr>
                  <td><%= o.created_at %></td>
                  <td><%= o.contest_title %></td>
                  <td>
                    <div style="font-weight:900"><%= o.user_name %></div>
                    <div class="muted" style="font-size:12px"><%= o.email %></div>
                  </td>
                  <td><%= o.phone || '-' %></td>
                  <td>₹<%= o.amount %></td>
                  <td><%= o.payment_status %></td>
                  <td><%= o.book_option %></td>
                  <td class="muted" style="font-size:12px"><%= o.id %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>

        </div>
      </div>
    </main>
  </div>

<script>
  (function(){
    const quick = document.getElementById("quickDate");
    const from = document.querySelector('input[name="date_from"]');
    const to = document.querySelector('input[name="date_to"]');
    const onDate = document.querySelector('input[name="on_date"]');

    function fmt(d){
      const y=d.getFullYear();
      const m=String(d.getMonth()+1).padStart(2,'0');
      const da=String(d.getDate()).padStart(2,'0');
      return `${y}-${m}-${da}`;
    }

    quick.addEventListener("change", () => {
      const v = quick.value;
      if (!v) return;
      onDate.value = ""; // Amazon-like: quick range overrides "on date"
      const now = new Date();
      if (v === "today") {
        from.value = fmt(now);
        to.value = fmt(now);
        return;
      }
      const days = parseInt(v,10);
      const start = new Date(now.getTime() - (days * 24*60*60*1000));
      from.value = fmt(start);
      to.value = fmt(now);
    });
  })();
</script>

<script>
  function toggleAdminMenu() {
    document.body.classList.toggle("menu-open");
  }

  function closeAdminMenu() {
    document.body.classList.remove("menu-open");
  }

  document.addEventListener("keydown", function(e) {
    if (e.key === "Escape") closeAdminMenu();
  });
</script>
</body>
</html>
