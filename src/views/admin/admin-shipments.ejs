<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin • Shipments</title>
  <style>
  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800;900&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap');

  :root{
    /* ── Light green — eye-friendly for long working hours ── */
    --bg:#e4efe4;
    --bg2:#d8e8d8;
    --surface:#edf5ed;
    --surface2:#e2ede2;
    --surface3:#d5e8d5;

    /* Count card individual themes */
    --cc-pending-bg:#fef9e7;   --cc-pending-bd:#f9d77e;
    --cc-packing-bg:#e8f4fd;   --cc-packing-bd:#93c9f0;
    --cc-packed-bg:#eafaf1;    --cc-packed-bd:#82e0aa;
    --cc-dispatched-bg:#e9f7ef;--cc-dispatched-bd:#58d68d;
    --cc-delivered-bg:#e8f8f5; --cc-delivered-bd:#48c9b0;
    --cc-returned-bg:#fdedec;  --cc-returned-bd:#f1948a;
    --cc-handed-bg:#f5eef8;    --cc-handed-bd:#c39bd3;

    /* Workflow card deep tints */
    --wf-pending-bg:#fdf5e0;   --wf-pending-bd:#e6c55a;
    --wf-packing-bg:#ddeeff;   --wf-packing-bd:#7db8f0;
    --wf-packed-bg:#d9f5e6;    --wf-packed-bd:#52be80;
    --wf-dispatched-bg:#d5f5e3;--wf-dispatched-bd:#27ae60;
    --wf-delivered-bg:#d0f0ea; --wf-delivered-bd:#1abc9c;
    --wf-returned-bg:#fde8e8;  --wf-returned-bd:#e74c3c;

    --border:#b8d4b8;
    --border2:#9abf9a;
    --text:#1a2e1a;
    --text2:#243d24;
    --muted:#4a6e4a;
    --faint:#7a9e7a;

    --green-dk:#145214;  --green-md:#1e8449;
    --green-lt:#d5f5e3;  --green-bd:#82e0aa;
    --blue-dk:#1a3a6e;   --blue-md:#2471a3;
    --blue-lt:#d6eaf8;   --blue-bd:#7fb3d3;
    --amber-dk:#7d4e00;  --amber-md:#ca6f1e;
    --amber-lt:#fef5e7;  --amber-bd:#f0b27a;
    --red-dk:#7b241c;    --red-md:#c0392b;
    --red-lt:#fde8e8;    --red-bd:#e6b0aa;
    --purple-dk:#4a235a; --purple-md:#7d3c98;
    --purple-lt:#f5eef8; --purple-bd:#c39bd3;
    --teal-dk:#0e5447;   --teal-md:#148f77;
    --teal-lt:#d0f0ea;   --teal-bd:#76d7c4;

    --shadow-sm:0 1px 3px rgba(0,60,0,.07),0 1px 2px rgba(0,50,0,.05);
    --shadow-md:0 3px 10px rgba(0,60,0,.09),0 2px 4px rgba(0,50,0,.05);
    --shadow-lg:0 6px 20px rgba(0,60,0,.1),0 3px 8px rgba(0,50,0,.06);
    --shadow-xl:0 14px 36px rgba(0,60,0,.11),0 5px 12px rgba(0,50,0,.06);
  }

  *{box-sizing:border-box}

  body{
    margin:0;
    font-family:'DM Sans',system-ui,sans-serif;
    background:var(--bg);
    color:var(--text);
    -webkit-font-smoothing:antialiased;
  }
  a{color:inherit;text-decoration:none}

  .layout{display:flex;min-height:100vh}

  /* ── SIDEBAR — dark, untouched ── */
  .sidebar{
    width:260px;background:#0a1022;
    border-right:1px solid rgba(255,255,255,.08);
    padding:18px;flex-shrink:0;
  }
  .brand{font-weight:900;margin-bottom:18px;color:#fff;font-family:'Sora',sans-serif}
  .nav a{
    display:block;padding:10px 12px;border-radius:12px;
    text-decoration:none;color:rgba(255,255,255,.72);margin-bottom:5px;
    font-size:13px;transition:all .15s;
  }
  .nav a:hover{background:rgba(255,255,255,.06);color:#fff}
  .nav a.active{
    background:rgba(26,60,255,.2);border:1px solid rgba(26,60,255,.4);
    color:#fff;font-weight:700;
  }

  .content{flex:1;min-width:0}
  .wrap{max-width:1500px;margin:0 auto;padding:24px 22px}

  /* ── PAGE TOPBAR ── */
  .topbar{
    display:flex;align-items:flex-start;justify-content:space-between;
    gap:14px;margin-bottom:22px;flex-wrap:wrap;
  }
  .title h1{
    margin:0;font-family:'Sora',sans-serif;
    font-size:clamp(22px,3vw,30px);font-weight:900;color:var(--text);
  }
  .title p{margin:6px 0 0;color:var(--muted);font-size:13px;max-width:760px;line-height:1.6}
  .inline-actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}

  /* ── ALERTS ── */
  .alerts-stack{display:grid;gap:10px;margin-top:10px}
  .msg{
    display:flex;align-items:flex-start;justify-content:space-between;gap:12px;
    padding:12px 16px;border-radius:14px;border:1.5px solid transparent;
    font-size:13px;line-height:1.55;
  }
  .msg.success{background:var(--green-lt);border-color:var(--green-bd);color:var(--green-dk)}
  .msg.info   {background:var(--blue-lt); border-color:var(--blue-bd); color:var(--blue-dk)}
  .msg.error  {background:var(--red-lt);  border-color:var(--red-bd);  color:var(--red-dk)}
  .msg-body{flex:1;min-width:0}
  .msg-close{
    border:none;background:rgba(0,0,0,.07);color:var(--muted);
    border-radius:8px;width:28px;height:28px;cursor:pointer;font-size:16px;
    flex-shrink:0;transition:background .14s;
    display:flex;align-items:center;justify-content:center;
  }
  .msg-close:hover{background:rgba(0,0,0,.14);color:var(--text)}
  .msg-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px}

  /* ── MAIN CARD ── */
  .card{
    background:var(--surface);border:1.5px solid var(--border);
    border-radius:22px;padding:22px;box-shadow:var(--shadow-lg);
  }
  .hero-card{position:relative;overflow:hidden}
  .hero-card::before{
    content:"";position:absolute;inset:0;pointer-events:none;
    background:
      radial-gradient(ellipse at 96% 4%,rgba(30,132,73,.07),transparent 40%),
      radial-gradient(ellipse at 4% 96%,rgba(36,113,163,.05),transparent 35%);
  }

  /* ── FORM ELEMENTS ── */
  label{
    display:block;font-family:'Sora',sans-serif;
    font-size:11px;color:var(--muted);margin-bottom:6px;
    font-weight:700;letter-spacing:.4px;text-transform:uppercase;
  }
  input,select,button{font:inherit}
  input[type="text"],input[type="date"],input[type="file"],select{
    width:100%;padding:10px 13px;border-radius:11px;
    border:1.5px solid var(--border);
    background:var(--surface);color:var(--text);
    outline:none;font-size:14px;
    transition:border-color .18s,box-shadow .18s;
    box-shadow:var(--shadow-sm);
  }
  input[type="text"]:focus,input[type="date"]:focus,select:focus{
    border-color:var(--green-md);
    box-shadow:0 0 0 3px rgba(30,132,73,.15);
  }
  input[type="text"]::placeholder{color:var(--faint)}
  input[type="file"]{padding:9px 12px}

  /* ── TAB BAR ── */
  .tabbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:22px;position:relative;z-index:1}
  .tabbtn{
    display:inline-flex;align-items:center;gap:7px;
    padding:10px 20px;border-radius:999px;
    border:1.5px solid var(--border2);
    background:var(--surface2);color:var(--muted);
    font-family:'Sora',sans-serif;font-weight:700;font-size:13px;
    cursor:pointer;transition:all .18s;box-shadow:var(--shadow-sm);
  }
  .tabbtn:hover{
    border-color:var(--green-md);color:var(--green-dk);
    background:var(--surface);transform:translateY(-1px);box-shadow:var(--shadow-md);
  }
  .tabbtn.active{
    background:linear-gradient(135deg,#27ae60,var(--green-dk));
    color:#fff;border-color:transparent;
    box-shadow:0 5px 18px rgba(30,132,73,.3);
  }
  .tabpanel{display:none}
  .tabpanel.active{display:block}

  /* ── FILTER CARD ── */
  .filter-card{
    background:var(--surface2);border:1.5px solid var(--border);
    border-radius:18px;padding:18px;margin-bottom:20px;
    box-shadow:var(--shadow-sm);position:relative;overflow:hidden;
  }
  .filter-card::before{
    content:"";position:absolute;top:0;right:0;width:160px;height:100px;
    pointer-events:none;
    background:radial-gradient(ellipse at 100% 0%,rgba(30,132,73,.08),transparent 70%);
  }
  .filter-head{
    display:flex;justify-content:space-between;align-items:flex-start;
    gap:12px;flex-wrap:wrap;margin-bottom:14px;position:relative;z-index:1;
  }
  .filter-head h2{margin:0;font-family:'Sora',sans-serif;font-size:16px;font-weight:800;color:var(--text2)}
  .filter-head p{margin:4px 0 0;color:var(--muted);font-size:12px;line-height:1.6}
  .filter-grid{
    display:grid;grid-template-columns:2fr 1.15fr 1.15fr 1fr auto auto;
    gap:12px;align-items:end;position:relative;z-index:1;
  }
  .filter-grid.temple{grid-template-columns:2fr 1.1fr 1fr 1fr auto auto}
  .filter-grid.alltab{grid-template-columns:2fr 1.2fr 1.2fr 1fr 1fr auto auto}
  .button-stack{display:flex;gap:8px;flex-wrap:wrap;align-items:end}

  /* ── COUNT CARDS — each with own colour identity ── */
  .counts-grid{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
    gap:12px;margin:16px 0 22px;
  }
  .count-card{
    border-radius:16px;padding:16px 18px;position:relative;overflow:hidden;
    box-shadow:var(--shadow-md);transition:all .2s;border:1.5px solid transparent;
  }
  .count-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg)}
  .count-card.cc-pending   {background:var(--cc-pending-bg);  border-color:var(--cc-pending-bd);  border-left:4px solid var(--amber-md)}
  .count-card.cc-packing   {background:var(--cc-packing-bg);  border-color:var(--cc-packing-bd);  border-left:4px solid var(--blue-md)}
  .count-card.cc-packed    {background:var(--cc-packed-bg);    border-color:var(--cc-packed-bd);    border-left:4px solid var(--green-md)}
  .count-card.cc-dispatched{background:var(--cc-dispatched-bg);border-color:var(--cc-dispatched-bd);border-left:4px solid #1e8449}
  .count-card.cc-delivered {background:var(--cc-delivered-bg); border-color:var(--cc-delivered-bd); border-left:4px solid var(--teal-md)}
  .count-card.cc-returned  {background:var(--cc-returned-bg);  border-color:var(--cc-returned-bd);  border-left:4px solid var(--red-md)}
  .count-card.cc-handed    {background:var(--cc-handed-bg);    border-color:var(--cc-handed-bd);    border-left:4px solid var(--purple-md)}
  .count-card:not([class*="cc-"]){background:var(--surface);border-color:var(--border);border-left:4px solid var(--green-md)}

  .count-card-icon{
    font-size:22px;width:40px;height:40px;border-radius:10px;
    display:flex;align-items:center;justify-content:center;
    background:rgba(255,255,255,.75);border:1px solid rgba(0,60,0,.08);
    margin-bottom:12px;
  }
  .count-label{
    font-family:'Sora',sans-serif;font-size:10px;color:var(--muted);
    text-transform:uppercase;letter-spacing:.8px;font-weight:800;
  }
  .count-value{
    font-family:'Sora',sans-serif;font-size:34px;font-weight:900;
    line-height:1;margin-top:7px;color:var(--text);
  }
  .count-sub{font-size:11px;color:var(--faint);margin-top:6px;line-height:1.5}

  /* ── WORKFLOW CARDS — deeper tinted, distinct from count cards ── */
  .workflow-grid-5{grid-template-columns:repeat(6,minmax(0,1fr))}
  .workflow-grid{
    display:grid;grid-template-columns:repeat(6,minmax(0,1fr));
    gap:12px;margin-top:8px;align-items:stretch;
  }
  .workflow-card{
    border-radius:18px;padding:16px;
    box-shadow:var(--shadow-md);min-width:0;
    border:1.5px solid var(--border);background:var(--surface2);
  }
  .status-card.pending-card   {background:var(--wf-pending-bg);   border-color:var(--wf-pending-bd);   border-top:4px solid var(--amber-md)}
  .status-card.packing-card   {background:var(--wf-packing-bg);   border-color:var(--wf-packing-bd);   border-top:4px solid var(--blue-md)}
  .status-card.packed-card    {background:var(--wf-packed-bg);     border-color:var(--wf-packed-bd);     border-top:4px solid var(--green-md)}
  .status-card.dispatched-card{background:var(--wf-dispatched-bg); border-color:var(--wf-dispatched-bd); border-top:4px solid #1e8449}
  .status-card.delivered-card {background:var(--wf-delivered-bg);  border-color:var(--wf-delivered-bd);  border-top:4px solid var(--teal-md)}
  .status-card.returned-card  {background:var(--wf-returned-bg);   border-color:var(--wf-returned-bd);   border-top:4px solid var(--red-md)}

  .workflow-card h3{
    margin:0 0 13px;font-family:'Sora',sans-serif;
    font-size:14px;font-weight:800;color:var(--text2);
    display:flex;align-items:center;justify-content:space-between;
  }
  .workflow-card p,.workflow-note{display:none !important}
  .workflow-row{display:grid;gap:10px}

  .action-box{
    display:grid;gap:8px;padding:11px;border-radius:13px;
    border:1.5px solid rgba(0,60,0,.1);background:rgba(255,255,255,.55);
  }
  .action-box.download-box{background:rgba(255,248,220,.8);  border-color:rgba(202,111,30,.22)}
  .action-box.csv-box     {background:rgba(214,234,248,.85); border-color:rgba(36,113,163,.22)}
  .action-box.bulk-box    {background:rgba(245,239,255,.85); border-color:rgba(125,60,152,.22)}
  .action-box.return-box  {background:rgba(253,232,230,.85); border-color:rgba(192,57,43,.22)}

  .workflow-file{
    width:100%;padding:8px 11px;border-radius:10px;font-size:12px;
    border:1.5px solid var(--border);background:var(--surface);color:var(--text);
  }
  .workflow-file::file-selector-button{
    border:none;margin-right:8px;padding:5px 9px;border-radius:7px;
    background:linear-gradient(135deg,#2471a3,#1a5276);
    color:#fff;font-weight:800;cursor:pointer;font-size:11px;
  }

  /* Action buttons */
  .action-btn{
    width:100%;min-height:40px;padding:8px 10px;border-radius:11px;
    font-family:'Sora',sans-serif;font-size:12px;font-weight:800;
    line-height:1.3;text-align:center;white-space:normal;
    border:none;cursor:pointer;
    transition:transform .13s,box-shadow .13s,filter .13s;
    display:flex;align-items:center;justify-content:center;gap:5px;
  }
  .action-btn:hover{transform:translateY(-1px);filter:brightness(1.06)}
  .action-btn:active{transform:scale(.97)}
  .action-btn:disabled{opacity:.45;cursor:not-allowed;transform:none}
  .action-btn .icon{font-size:14px}
  .download-btn{background:linear-gradient(135deg,#f9d27a,#e67e22);color:#5a2e00;box-shadow:0 3px 10px rgba(202,111,30,.22);border:1px solid rgba(202,111,30,.3)}
  .csv-btn     {background:linear-gradient(135deg,#5dade2,#1a6fa8);color:#fff;box-shadow:0 3px 10px rgba(36,113,163,.22)}
  .bulk-btn    {background:linear-gradient(135deg,#af7ac5,#7d3c98);color:#fff;box-shadow:0 3px 10px rgba(125,60,152,.22)}
  .return-btn  {background:linear-gradient(135deg,#e57373,#c0392b);color:#fff;box-shadow:0 3px 10px rgba(192,57,43,.22)}

  /* ── TOP BUTTONS — all match green theme ── */
  .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:7px;
    min-height:40px;padding:9px 18px;border-radius:12px;
    border:1.5px solid transparent;text-decoration:none;cursor:pointer;
    white-space:nowrap;font-family:'Sora',sans-serif;font-weight:800;font-size:13px;
    transition:all .15s;box-shadow:var(--shadow-sm);
  }
  .btn:hover{transform:translateY(-1px);box-shadow:var(--shadow-md)}
  .btn:active{transform:scale(.97)}
  .btn.primary{background:linear-gradient(135deg,#27ae60,var(--green-dk));color:#fff;box-shadow:0 4px 14px rgba(30,132,73,.28)}
  .btn.primary:hover{box-shadow:0 7px 20px rgba(30,132,73,.38)}
  .btn.ghost  {background:var(--surface);color:var(--text2);border-color:var(--border2)}
  .btn.ghost:hover{background:var(--green-lt);border-color:var(--green-md);color:var(--green-dk)}
  .btn.warn   {background:linear-gradient(135deg,#f7c560,#e67e22);color:#5a2e00}
  .btn.green  {background:linear-gradient(135deg,#52be80,#1e8449);color:#fff;box-shadow:0 4px 14px rgba(30,132,73,.22)}
  .btn.refresh{background:linear-gradient(135deg,#5dade2,#1a6fa8);color:#fff;box-shadow:0 4px 14px rgba(36,113,163,.22)}
  .btn.refresh:hover{box-shadow:0 7px 20px rgba(36,113,163,.35)}
  .btn:disabled{opacity:.5;cursor:not-allowed;transform:none}

  /* ── TABLE ── */
  .tablewrap{
    overflow:auto;border-radius:16px;
    border:1.5px solid var(--border);margin-top:16px;
    box-shadow:var(--shadow-md);
  }
  table{width:100%;border-collapse:collapse;min-width:1250px;background:var(--surface)}
  th,td{
    padding:14px 16px;border-bottom:1px solid var(--border);
    vertical-align:top;text-align:left;
  }
  th{
    position:sticky;top:0;background:var(--surface3);z-index:1;
    font-family:'Sora',sans-serif;font-size:12px;font-weight:800;
    color:var(--muted);text-transform:uppercase;letter-spacing:.5px;
    border-bottom:2px solid var(--border2);
  }
  td{font-size:14px;color:var(--text)}
  td.muted{color:var(--muted)}
  td.tiny{font-size:13px}
  td strong{color:var(--text2);font-weight:700}
  td:first-child,th:first-child{padding-left:18px}
  tr:hover td{background:var(--surface3)}

  /* ── STATUS PILLS ── */
  .pill{
    display:inline-flex;align-items:center;gap:5px;
    padding:5px 11px;border-radius:999px;font-size:12px;
    font-family:'Sora',sans-serif;font-weight:800;
    border:1.5px solid transparent;text-transform:capitalize;
  }
  .pill::before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor;flex-shrink:0}
  .pill.pending     {background:var(--amber-lt);border-color:var(--amber-bd);color:var(--amber-dk)}
  .pill.under_packing{background:var(--blue-lt); border-color:var(--blue-bd); color:var(--blue-dk)}
  .pill.packed      {background:var(--green-lt); border-color:var(--green-bd); color:var(--green-dk)}
  .pill.dispatched  {background:#d5f5e3;         border-color:#52be80;         color:#1a5e37}
  .pill.delivered   {background:var(--teal-lt);  border-color:var(--teal-bd);  color:var(--teal-dk)}
  .pill.handed_over {background:var(--purple-lt);border-color:var(--purple-bd);color:var(--purple-dk)}
  .pill.returned    {background:var(--red-lt);   border-color:var(--red-bd);   color:var(--red-dk)}
  .pill.failed      {background:var(--red-lt);   border-color:var(--red-bd);   color:var(--red-dk)}

  .checkcell{width:42px;text-align:center}
  .muted{color:var(--muted)}
  .tiny{font-size:13px}
  .stack{display:grid;gap:8px}

  .update-form{display:grid;gap:7px;min-width:260px}
  .update-form input[type="text"]{padding:8px 11px;font-size:13px;border-radius:10px}
  .update-form select{padding:8px 11px;font-size:13px;border-radius:10px}
  .update-form .btn{min-height:36px;font-size:13px;padding:7px 14px;border-radius:9px}

  .empty{text-align:center;padding:36px;color:var(--faint);font-size:15px}

  /* ── PAGINATION ── */
  .pagination-bar{
    display:flex;align-items:center;justify-content:space-between;
    gap:12px;flex-wrap:wrap;margin-top:16px;padding:12px 16px;
    border-radius:14px;background:var(--surface2);
    border:1.5px solid var(--border);box-shadow:var(--shadow-sm);
  }
  .pagination-meta{color:var(--muted);font-size:13px}
  .pagination-meta strong{color:var(--text)}
  .pagination-links{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
  .page-link{
    min-width:38px;height:36px;display:inline-flex;align-items:center;justify-content:center;
    padding:0 12px;border-radius:9px;
    background:var(--surface);border:1.5px solid var(--border2);
    color:var(--text2);font-family:'Sora',sans-serif;font-size:13px;font-weight:800;
    transition:all .14s;
  }
  .page-link:hover{border-color:var(--green-md);color:var(--green-dk);background:var(--green-lt)}
  .page-link.active{
    background:linear-gradient(135deg,#27ae60,var(--green-dk));
    border-color:transparent;color:#fff;box-shadow:0 3px 10px rgba(30,132,73,.3);
  }

  /* ── MODALS ── */
  .modal-backdrop{
    display:none;position:fixed;inset:0;
    background:rgba(5,20,8,.42);backdrop-filter:blur(6px);
    z-index:2500;padding:18px;align-items:center;justify-content:center;
  }
  .modal-backdrop.show{display:flex}
  .modal{
    width:min(520px,100%);background:var(--surface);
    border:1.5px solid var(--border2);border-radius:22px;
    box-shadow:var(--shadow-xl);overflow:hidden;animation:modalIn .2s ease;
  }
  @keyframes modalIn{from{opacity:0;transform:scale(.96) translateY(8px)}to{opacity:1;transform:none}}
  .modal-head{padding:20px 22px 0;display:flex;align-items:center;gap:12px}
  .modal-head h3{margin:0;font-family:'Sora',sans-serif;font-size:19px;font-weight:900;color:var(--text)}
  .modal-head-icon{
    font-size:20px;width:42px;height:42px;border-radius:12px;
    border:1.5px solid var(--border2);background:var(--surface3);
    display:flex;align-items:center;justify-content:center;flex-shrink:0;
  }
  .modal-body{padding:14px 22px 0;color:var(--text2);line-height:1.7;font-size:14px}
  .modal-note{
    margin-top:12px;padding:12px 14px;border-radius:12px;
    background:var(--green-lt);border:1.5px solid var(--green-bd);
    color:var(--green-dk);font-size:13px;line-height:1.6;
    display:flex;gap:8px;align-items:flex-start;
  }
  .modal-note::before{content:'💡';font-size:14px;flex-shrink:0}
  .modal-actions{padding:16px 22px 20px;display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap}

  /* ── MOBILE TOPBAR ── */
  .mobile-topbar{
    display:none;position:sticky;top:0;z-index:1200;
    padding:12px 14px;background:#060b1a;
    border-bottom:1px solid rgba(255,255,255,.07);
    align-items:center;justify-content:space-between;gap:12px;
  }
  .mobile-title{font-family:'Sora',sans-serif;font-weight:900;font-size:15px;color:#fff}
  .menu-btn{border:none;border-radius:10px;padding:9px 14px;font-weight:900;cursor:pointer;background:#1a3cff;color:#fff;font-size:13px}
  .sidebar-backdrop{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1198}

  @media(max-width:1600px){.workflow-grid-5{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:1280px){
    .filter-grid,.filter-grid.temple,.filter-grid.alltab{grid-template-columns:repeat(2,minmax(200px,1fr))}
    .button-stack{grid-column:1 / -1}
  }
  @media(max-width:1200px){.workflow-grid-5{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:1100px){
    .mobile-topbar{display:flex !important}
    .sidebar{position:fixed;left:0;top:0;bottom:0;z-index:1199;transform:translateX(-100%);transition:transform .22s ease;box-shadow:0 10px 40px rgba(0,0,0,.45);overflow:auto;flex-shrink:0}
    body.menu-open .sidebar{transform:translateX(0)}
    body.menu-open .sidebar-backdrop{display:block}
    .wrap{margin:16px auto;padding:0 14px}
    .workflow-grid{grid-template-columns:1fr}
    .counts-grid{grid-template-columns:repeat(2,minmax(140px,1fr))}
  }
  @media(max-width:760px){.workflow-grid-5{grid-template-columns:1fr}}
  @media(max-width:700px){
    .filter-grid,.filter-grid.temple,.filter-grid.alltab{grid-template-columns:1fr}
    .counts-grid{grid-template-columns:1fr}
    .title h1{font-size:22px}
    .tabbar{gap:6px}
    .tabbtn{width:100%;justify-content:center}
    .pagination-bar{align-items:flex-start}
  }
</style>
</head>
<body>

<%
  const currentPage = Number(page || 1);
  const pagesTotal = Number(totalPages || 1);
  const totalCountValue = Number(totalCount || 0);
  const pageSizeValue = Number(pageSize || 10);

  const activeTab =
    selectedTab ||
    ((filters && filters.deliveryMode === 'temple_pickup') ? 'temple' :
    (filters && filters.deliveryMode === 'all') ? 'all' :
    'home');

  const shipmentTabStatsSafe = shipmentTabStats || {
    home: {},
    temple: {},
    all: {}
  };

  const homeStats = shipmentTabStatsSafe.home || {};
  const templeStats = shipmentTabStatsSafe.temple || {};
  const allStats = shipmentTabStatsSafe.all || {};

  function pageHref(pageNo, forcedMode) {
    const params = new URLSearchParams();
    params.set('q', (filters && filters.q) || '');
    params.set('delivery_mode', forcedMode || (filters && filters.deliveryMode) || 'home_delivery');
    params.set('status', (filters && filters.status) || 'all');
    params.set('date_from', (filters && filters.dateFrom) || '');
    params.set('date_to', (filters && filters.dateTo) || '');
    params.set('page', String(pageNo));
    return '/admin/shipments?' + params.toString();
  }
%>

<div class="mobile-topbar">
  <button type="button" class="menu-btn" onclick="toggleAdminMenu()">☰ Menu</button>
  <div class="mobile-title">Admin Panel</div>
</div>

<div class="sidebar-backdrop" onclick="closeAdminMenu()"></div>

<div class="modal-backdrop" id="actionModal">
  <div class="modal">
    <div class="modal-head">
      <div class="modal-head-icon">⚡</div>
      <h3 id="actionModalTitle">Confirm action</h3>
    </div>
    <div class="modal-body">
      <div id="actionModalText"></div>
      <div id="actionModalNote" class="modal-note" style="display:none;"></div>
    </div>
    <div class="modal-actions">
      <button type="button" class="btn ghost" onclick="hideActionModal()">Cancel</button>
      <button type="button" class="btn primary" id="actionModalConfirmBtn">Proceed</button>
    </div>
  </div>
</div>


<div class="modal-backdrop" id="resultModal">
  <div class="modal">
    <div class="modal-head">
      <div class="modal-head-icon">✅</div>
      <h3 id="resultModalTitle">Shipment update completed</h3>
    </div>
    <div class="modal-body">
      <div id="resultModalText"></div>
      <div id="resultModalStats" class="modal-note" style="display:none;"></div>
      <div id="resultModalActions" class="msg-actions" style="margin-top:14px;"></div>
    </div>
    <div class="modal-actions">
      <button type="button" class="btn primary" onclick="hideResultModal()">Close</button>
    </div>
  </div>
</div>

<div class="layout">
  <aside class="sidebar">
    <div class="brand">Admin Panel</div>
    <div class="nav">
      <a href="/admin">Overview</a>
      <a href="/admin/user360">View User</a>
      <a href="/admin/users">All Users</a>
      <a href="/admin/feedback">All Feedback</a>
      <a href="/admin/shipment-stock">Current Book Stock</a>
      <a href="/admin/shipments" class="active">Online Shipments</a>
      <a href="/admin/orders">Online Orders</a>
      <a href="/admin/submissions">Online Submissions</a>
      <a href="/admin/contests">Online Contests</a>
      <a href="/admin/offline-dashboard">Offline Overview</a>
      <a href="/admin/offline-orders">Offline Orders</a>
      <a href="/admin/agents">Offline Agents</a>
      <a href="/admin/payments/reconcile-bulk">Razorpay Reconcile</a>
      <a href="/logout" style="margin-top:14px;opacity:.9">Logout</a>
    </div>
  </aside>

  <main class="content">
    <div class="wrap">
      <div class="topbar">
        <div class="title">
          <h1>📦 Admin Shipments</h1>


          <div class="alerts-stack" id="alertsStack">
            <% if (imported) { %>
              <div class="msg info" data-alert>
                <div class="msg-body">
                  India Post result imported. Rows processed: <strong><%= imported %></strong>
                </div>
                <button type="button" class="msg-close" onclick="closeAlert(this)">×</button>
              </div>
            <% } %>

            <% if (okMsg) { %>
              <div class="msg success" data-alert>
                <div class="msg-body"><%= okMsg %></div>
                <button type="button" class="msg-close" onclick="closeAlert(this)">×</button>
              </div>
            <% } %>

            <% if (errorMsg) { %>
              <div class="msg error" data-alert>
                <div class="msg-body"><%= errorMsg %></div>
                <button type="button" class="msg-close" onclick="closeAlert(this)">×</button>
              </div>
            <% } %>

            <% if (rejectedFile) { %>
              <div class="msg info" data-alert>
                <div class="msg-body">
                  Rejected file is ready for review.
                  <div class="msg-actions">
                    <a class="btn ghost" href="/tmp/<%= rejectedFile %>" target="_blank" rel="noopener noreferrer">
                      Download rejected file
                    </a>
                  </div>
                </div>
                <button type="button" class="msg-close" onclick="closeAlert(this)">×</button>
              </div>
            <% } %>
          </div>
        </div>

        <div class="inline-actions">
          <a class="btn ghost" href="/admin">Overview</a>
          <button type="button" class="btn refresh" onclick="window.location.reload()">🔄 Refresh</button>
        </div>
      </div>

      <div class="card hero-card">
        <div class="tabbar" id="shipmentsTabs">
          <button type="button" class="tabbtn <%= activeTab === 'home' ? 'active' : '' %>" data-tab="home">
            🚚 Home Delivery
          </button>
          <button type="button" class="tabbtn <%= activeTab === 'temple' ? 'active' : '' %>" data-tab="temple">
            🛕 Temple Pickup
          </button>
          <button type="button" class="tabbtn <%= activeTab === 'all' ? 'active' : '' %>" data-tab="all">
            📦 All Shipments
          </button>
        </div>

        <!-- HOME DELIVERY TAB -->
        <section class="tabpanel <%= activeTab === 'home' ? 'active' : '' %>" data-panel="home">
          <div class="filter-card">
            <div class="filter-head">
              <div>
                <h2>🏠 Home Delivery Shipments</h2>
              </div>
            </div>

            <form id="homeFiltersForm" method="GET" action="/admin/shipments">
              <input type="hidden" name="delivery_mode" value="home_delivery" />
              <div class="filter-grid">
                <div>
                  <label for="home_q">Search by name or mobile</label>
                  <input id="home_q" name="q" type="text" value="<%= activeTab === 'home' ? (filters.q || '') : '' %>" placeholder="Search by name or phone" />
                </div>

                <div>
                  <label for="home_status">Shipment status</label>
                  <select id="home_status" name="status">
                    <option value="all" <%= activeTab === 'home' && filters.status==='all' ? 'selected' : '' %>>All</option>
                    <option value="pending" <%= activeTab === 'home' && filters.status==='pending' ? 'selected' : '' %>>Pending</option>
                    <option value="under_packing" <%= activeTab === 'home' && filters.status==='under_packing' ? 'selected' : '' %>>Under Packing</option>
                    <option value="packed" <%= activeTab === 'home' && filters.status==='packed' ? 'selected' : '' %>>Packed</option>
                    <option value="dispatched" <%= activeTab === 'home' && filters.status==='dispatched' ? 'selected' : '' %>>Dispatched</option>
                    <option value="delivered" <%= activeTab === 'home' && filters.status==='delivered' ? 'selected' : '' %>>Delivered</option>
                    <option value="returned" <%= activeTab === 'home' && filters.status==='returned' ? 'selected' : '' %>>Returned</option>
                  </select>
                </div>

                <div>
                  <label for="home_date_from">From date</label>
                  <input id="home_date_from" name="date_from" type="date" value="<%= activeTab === 'home' ? (filters.dateFrom || '') : '' %>" />
                </div>

                <div>
                  <label for="home_date_to">To date</label>
                  <input id="home_date_to" name="date_to" type="date" value="<%= activeTab === 'home' ? (filters.dateTo || '') : '' %>" />
                </div>

                <div class="button-stack">
                  <a class="btn ghost" href="/admin/shipments?delivery_mode=home_delivery&status=all&page=1">Reset</a>
                  <button class="btn primary" type="submit">Apply</button>
                </div>

                <div class="button-stack">
                  <button type="button" class="btn refresh" onclick="refreshCurrentTab('home')">Refresh</button>
                </div>
              </div>
            </form>
          </div>

          <div class="counts-grid">
            <div class="count-card cc-pending">
              <div class="count-card-icon">📦</div>
              <div class="count-label">Pending</div>
              <div class="count-value"><%= homeStats.pending || 0 %></div>
              <div class="count-sub">Waiting for packing action</div>
            </div>
            <div class="count-card cc-packing">
              <div class="count-card-icon">🔧</div>
              <div class="count-label">Under Packing</div>
              <div class="count-value"><%= homeStats.under_packing || 0 %></div>
              <div class="count-sub">Tracking assigned and being packed</div>
            </div>
            <div class="count-card cc-packed">
              <div class="count-card-icon">✅</div>
              <div class="count-label">Packed</div>
              <div class="count-value"><%= homeStats.packed || 0 %></div>
              <div class="count-sub">Ready for India Post handoff</div>
            </div>
            <div class="count-card cc-dispatched">
              <div class="count-card-icon">🚚</div>
              <div class="count-label">Dispatched</div>
              <div class="count-value"><%= homeStats.dispatched || 0 %></div>
              <div class="count-sub">Shipped from your side</div>
            </div>
            <div class="count-card cc-delivered">
              <div class="count-card-icon">🎉</div>
              <div class="count-label">Delivered</div>
              <div class="count-value"><%= homeStats.delivered || 0 %></div>
              <div class="count-sub">Reached the participant</div>
            </div>

        <div class="count-card cc-returned">
              <div class="count-card-icon">↩️</div>
              <div class="count-label">Returned</div>
              <div class="count-value"><%= homeStats.returned || 0 %></div>
              <div class="count-sub">Courier returned shipments</div>
                   </div>
          </div>

          <div class="workflow-grid workflow-grid-5">
            <!-- PENDING -->
            <div class="workflow-card status-card pending-card">
              <h3>📦 Pending</h3>
              <div class="workflow-row">
                <div class="action-box download-box">
                  <button
                    type="button"
                    class="btn action-btn download-btn"
                    onclick="confirmShipmentDownload({
                      formId:'homeFiltersForm',
                      endpoint:'/admin/shipments/download-pending',
                      actionLabel:'Download Pending',
                      changeLabel:'This will download all currently filtered pending home-delivery shipments. No status will be changed.',
                      confirmText:'Download'
                    })"
                  >
                    <span>⬇️ Download</span>
                  </button>
                </div>

                <form
                  method="POST"
                  action="/admin/shipments/bulk-upload-status"
                  enctype="multipart/form-data"
                  class="action-box csv-box"
                  onsubmit="return submitShipmentExcelWithModal(this, {
                    title:'Pending → Under Packing',
                    processingText:'Validating pending rows, checking blank tracking ids, checking duplicate tracking ids, and moving only valid rows to under packing...',
                    successTitle:'Pending Excel Update Completed'
                  })"
                >
                  <input type="hidden" name="from_status" value="pending" />
                  <input type="hidden" name="to_status" value="under_packing" />
                  <input type="hidden" name="delivery_mode" value="home_delivery" />
                  <button class="btn action-btn csv-btn" type="submit">

                    <span>📬 → Under Packing</span>
                  </button>
                  <input class="workflow-file" type="file" name="status_file" accept=".xlsx,.xls" required />
                </form>
              </div>
            </div>

            <!-- UNDER PACKING -->
            <div class="workflow-card status-card packing-card">
              <h3>🔧 Under Packing</h3>
              <div class="workflow-row">
                <div class="action-box download-box">
                  <button
                    type="button"
                    class="btn action-btn download-btn"
                    onclick="confirmShipmentDownload({
                      formId:'homeFiltersForm',
                      endpoint:'/admin/shipments/download-status?status=under_packing',
                      actionLabel:'Download Under Packing',
                      changeLabel:'This downloads the currently filtered under packing rows only. No status is changed.',
                      confirmText:'Download'
                    })"
                  >

                    <span>⬇️ Download</span>
                  </button>
                </div>

                <form
                  method="POST"
                  action="/admin/shipments/upload-packed"
                  enctype="multipart/form-data"
                  class="action-box csv-box"
                  onsubmit="return submitShipmentExcelWithModal(this, {
                    title:'Under Packing → Packed',
                    processingText:'Checking current status, tracking id match, and Packed or Not column before moving valid rows to packed...',
                    successTitle:'Packed Excel Update Completed'
                  })"
                >
                  <button class="btn action-btn csv-btn" type="submit">

                    <span>📦 → Packed (Excel)</span>
                  </button>
                  <input class="workflow-file" type="file" name="packed_file" accept=".xlsx,.xls" required />
                </form>

                <form
                  method="POST"
                  action="/admin/shipments/bulk-advance-status"
                  class="action-box bulk-box"
                  onsubmit="return confirmBulkAdvance(this, {
                    title:'Bulk Update Under Packing → Packed',
                    html:'All currently filtered <strong>under packing</strong> home-delivery shipments will be moved to <strong>Packed</strong>.<br><br>Use this only when your team has completed packing for the current batch.',
                    confirmText:'Move All'
                  })"
                >
                  <input type="hidden" name="from_status" value="under_packing" />
                  <input type="hidden" name="to_status" value="packed" />
                  <input type="hidden" name="delivery_mode" value="home_delivery" />
                  <input type="hidden" name="q" value="<%= activeTab === 'home' ? (filters.q || '') : '' %>" />
                  <input type="hidden" name="date_from" value="<%= activeTab === 'home' ? (filters.dateFrom || '') : '' %>" />
                  <input type="hidden" name="date_to" value="<%= activeTab === 'home' ? (filters.dateTo || '') : '' %>" />
                  <button class="btn action-btn bulk-btn" type="submit">
                    <span class="icon">⚡</span>
                    <span>⚡ All → Packed</span>
                  </button>
                </form>
              </div>
            </div>

            <!-- PACKED -->
            <div class="workflow-card status-card packed-card">
              <h3>✅ Packed</h3>
              <div class="workflow-row">
                <div class="action-box download-box">
                  <button
                    type="button"
                    class="btn action-btn download-btn"
                    onclick="confirmShipmentDownload({
                      formId:'homeFiltersForm',
                      endpoint:'/admin/shipments/download-packed',
                      actionLabel:'Download Packed',
                      changeLabel:'This downloads the currently filtered packed rows only. No status is changed.',
                      confirmText:'Download'
                    })"
                  >

                    <span>⬇️ Download</span>
                  </button>
                </div>

                <form
                  method="POST"
                  action="/admin/shipments/upload-dispatched"
                  enctype="multipart/form-data"
                  class="action-box csv-box"
                  onsubmit="return submitShipmentExcelWithModal(this, {
                    title:'Packed → Dispatched',
                    processingText:'Validating packed rows, tracking ids, duplicates and overlaps before dispatch update...',
                    successTitle:'Dispatch Excel Update Completed'
                  })"
                >
                  <button class="btn action-btn csv-btn" type="submit">

                    <span>🚚 → Dispatched (Excel)</span>
                  </button>
                  <input class="workflow-file" type="file" name="dispatched_file" accept=".xlsx,.xls" required />
                </form>

                <form
                  method="POST"
                  action="/admin/shipments/bulk-advance-status"
                  class="action-box bulk-box"
                  onsubmit="return confirmBulkAdvance(this, {
                    title:'Bulk Update Packed → Dispatched',
                    html:'All currently filtered <strong>packed</strong> home-delivery shipments will be moved to <strong>Dispatched</strong>.<br><br>Please use this only after courier handoff is confirmed.',
                    confirmText:'Move All'
                  })"
                >
                  <input type="hidden" name="from_status" value="packed" />
                  <input type="hidden" name="to_status" value="dispatched" />
                  <input type="hidden" name="delivery_mode" value="home_delivery" />
                  <input type="hidden" name="q" value="<%= activeTab === 'home' ? (filters.q || '') : '' %>" />
                  <input type="hidden" name="date_from" value="<%= activeTab === 'home' ? (filters.dateFrom || '') : '' %>" />
                  <input type="hidden" name="date_to" value="<%= activeTab === 'home' ? (filters.dateTo || '') : '' %>" />
                  <button class="btn action-btn bulk-btn" type="submit">
                    <span class="icon">⚡</span>
                    <span>⚡ All → Dispatched</span>
                  </button>
                </form>
              </div>
            </div>

            <!-- DISPATCHED -->
            <div class="workflow-card status-card dispatched-card">
              <h3>🚚 Dispatched</h3>
              <div class="workflow-row">
                <div class="action-box download-box">
                  <button
                    type="button"
                    class="btn action-btn download-btn"
                    onclick="confirmShipmentDownload({
                      formId:'homeFiltersForm',
                      endpoint:'/admin/shipments/download-status?status=dispatched',
                      actionLabel:'Download Dispatched',
                      changeLabel:'This downloads the currently filtered dispatched rows only. No status is changed.',
                      confirmText:'Download'
                    })"
                  >

                    <span>⬇️ Download</span>
                  </button>
                </div>

                <form
                  method="POST"
                  action="/admin/shipments/upload-delivered"
                  enctype="multipart/form-data"
                  class="action-box csv-box"
                  onsubmit="return submitShipmentExcelWithModal(this, {
                    title:'Dispatched → Delivered',
                    processingText:'Checking current status, tracking id match, and Delivered or Not column before moving valid rows to delivered...',
                    successTitle:'Delivered Excel Update Completed'
                  })"
                >
                  <button class="btn action-btn csv-btn" type="submit">

                    <span>✅ → Delivered (Excel)</span>
                  </button>
                  <input class="workflow-file" type="file" name="delivered_file" accept=".xlsx,.xls" required />
                </form>

                <form
                  method="POST"
                  action="/admin/shipments/bulk-advance-status"
                  class="action-box bulk-box"
                  onsubmit="return confirmBulkAdvance(this, {
                    title:'Bulk Update Dispatched → Delivered',
                    html:'All currently filtered <strong>dispatched</strong> home-delivery shipments will be moved to <strong>Delivered</strong>.<br><br>Use this only when delivery has been externally confirmed.',
                    confirmText:'Mark Delivered'
                  })"
                >
                  <input type="hidden" name="from_status" value="dispatched" />
                  <input type="hidden" name="to_status" value="delivered" />
                  <input type="hidden" name="delivery_mode" value="home_delivery" />
                  <input type="hidden" name="q" value="<%= activeTab === 'home' ? (filters.q || '') : '' %>" />
                  <input type="hidden" name="date_from" value="<%= activeTab === 'home' ? (filters.dateFrom || '') : '' %>" />
                  <input type="hidden" name="date_to" value="<%= activeTab === 'home' ? (filters.dateTo || '') : '' %>" />
                  <button class="btn action-btn bulk-btn" type="submit">
                    <span class="icon">⚡</span>
                    <span>⚡ All → Delivered</span>
                  </button>
                </form>

                <form
                  method="POST"
                  action="/admin/shipments/upload-returned"
                  enctype="multipart/form-data"
                  class="action-box return-box"
                  onsubmit="return submitShipmentExcelWithModal(this, {
                    title:'Dispatched → Returned',
                    processingText:'Reading TRACKING_ID rows and moving only valid dispatched shipments to returned...',
                    successTitle:'Returned Upload Completed'
                  })"
                >
                  <button class="btn action-btn return-btn" type="submit">
                    <span class="icon">↩</span>
                    <span>↩️ → Returned</span>
                  </button>
                  <input class="workflow-file" type="file" name="returned_file" accept=".xlsx,.xls" required />
                </form>
              </div>
            </div>

            <!-- DELIVERED -->
            <div class="workflow-card status-card delivered-card">
              <h3>🎉 Delivered</h3>
              <div class="workflow-row">
                <div class="action-box download-box">
                  <button
                    type="button"
                    class="btn action-btn download-btn"
                    onclick="confirmShipmentDownload({
                      formId:'homeFiltersForm',
                      endpoint:'/admin/shipments/download-status?status=delivered',
                      actionLabel:'Download Delivered',
                      changeLabel:'This downloads the currently filtered delivered rows only. No status is changed.',
                      confirmText:'Download'
                    })"
                  >

                    <span>⬇️ Download</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- RETURNED -->
            <div class="workflow-card status-card returned-card">
              <h3>↩️ Returned</h3>
              <div class="workflow-row">
                <div class="action-box download-box">
                  <button
                    type="button"
                    class="btn action-btn download-btn"
                    onclick="confirmShipmentDownload({
                      formId:'homeFiltersForm',
                      endpoint:'/admin/shipments/download-status?status=returned',
                      actionLabel:'Download Returned',
                      changeLabel:'This downloads the currently filtered returned rows only. No status is changed.',
                      confirmText:'Download'
                    })"
                  >

                    <span>⬇️ Download</span>
                  </button>
                </div>

                <form
                  method="POST"
                  action="/admin/shipments/upload-returned-restart"
                  enctype="multipart/form-data"
                  class="action-box csv-box"
                  onsubmit="return submitShipmentExcelWithModal(this, {
                    title:'Returned → Pending',
                    processingText:'Checking returned rows, tracking ids, and Start Again column before reopening valid rows back to pending...',
                    successTitle:'Returned Restart Update Completed'
                  })"
                >
                  <button class="btn action-btn csv-btn" type="submit">

                    <span>🔄 → Pending (Excel)</span>
                  </button>
                  <input class="workflow-file" type="file" name="returned_restart_file" accept=".xlsx,.xls" required />
                </form>

                <form
                  method="POST"
                  action="/admin/shipments/bulk-advance-status"
                  class="action-box bulk-box"
                  onsubmit="return confirmBulkAdvance(this, {
                    title:'Bulk Update Returned → Pending',
                    html:'All currently filtered <strong>returned</strong> home-delivery shipments will be moved back to <strong>Pending</strong>.<br><br>This reopens them for fresh processing.',
                    confirmText:'Reopen All'
                  })"
                >
                  <input type="hidden" name="from_status" value="returned" />
                  <input type="hidden" name="to_status" value="pending" />
                  <input type="hidden" name="delivery_mode" value="home_delivery" />
                  <input type="hidden" name="q" value="<%= activeTab === 'home' ? (filters.q || '') : '' %>" />
                  <input type="hidden" name="date_from" value="<%= activeTab === 'home' ? (filters.dateFrom || '') : '' %>" />
                  <input type="hidden" name="date_to" value="<%= activeTab === 'home' ? (filters.dateTo || '') : '' %>" />
                  <button class="btn action-btn bulk-btn" type="submit">
                    <span class="icon">⚡</span>
                    <span>⚡ All → Pending</span>
                  </button>
                </form>
              </div>
            </div>
          </div>

        </section>

        <!-- TEMPLE PICKUP TAB -->
        <section class="tabpanel <%= activeTab === 'temple' ? 'active' : '' %>" data-panel="temple">
          <div class="filter-card">
            <div class="filter-head">
              <div>
                <h2>🛕 Temple Pickup</h2>
                <p>
                  Use this section for orders collected directly at the temple. The statuses here stay simple and clear: pending or handed over.
                </p>
              </div>
            </div>

            <form id="templeFiltersForm" method="GET" action="/admin/shipments">
              <input type="hidden" name="delivery_mode" value="temple_pickup" />
              <div class="filter-grid temple">
                <div>
                  <label for="temple_q">Search by name or mobile</label>
                  <input id="temple_q" name="q" type="text" value="<%= activeTab === 'temple' ? (filters.q || '') : '' %>" placeholder="Search by name or phone" />
                </div>

                <div>
                  <label for="temple_status">Shipment status</label>
                  <select id="temple_status" name="status">
                    <option value="all" <%= activeTab === 'temple' && filters.status==='all' ? 'selected' : '' %>>All</option>
                    <option value="pending" <%= activeTab === 'temple' && filters.status==='pending' ? 'selected' : '' %>>Pending</option>
                    <option value="handed_over" <%= activeTab === 'temple' && filters.status==='handed_over' ? 'selected' : '' %>>Handed Over</option>
                  </select>
                </div>

                <div>
                  <label for="temple_date_from">From date</label>
                  <input id="temple_date_from" name="date_from" type="date" value="<%= activeTab === 'temple' ? (filters.dateFrom || '') : '' %>" />
                </div>

                <div>
                  <label for="temple_date_to">To date</label>
                  <input id="temple_date_to" name="date_to" type="date" value="<%= activeTab === 'temple' ? (filters.dateTo || '') : '' %>" />
                </div>

                <div class="button-stack">
                  <a class="btn ghost" href="/admin/shipments?delivery_mode=temple_pickup&status=all&page=1">Reset</a>
                  <button class="btn primary" type="submit">Apply</button>
                </div>

                <div class="button-stack">
                  <button type="button" class="btn refresh" onclick="refreshCurrentTab('temple')">Refresh</button>
                </div>
              </div>
            </form>
          </div>

          <div class="counts-grid">
            <div class="count-card cc-pending">
              <div class="count-card-icon">🛕</div>
              <div class="count-label">Pending</div>
              <div class="count-value"><%= templeStats.pending || 0 %></div>
              <div class="count-sub">Waiting for pickup handover</div>
            </div>
            <div class="count-card cc-handed">
              <div class="count-card-icon">🤝</div>
              <div class="count-label">Handed Over</div>
              <div class="count-value"><%= templeStats.handed_over || 0 %></div>
              <div class="count-sub">Already collected by participant</div>
            </div>
          </div>
        </section>

        <!-- ALL TAB -->
        <section class="tabpanel <%= activeTab === 'all' ? 'active' : '' %>" data-panel="all">
          <div class="filter-card">
            <div class="filter-head">
              <div>
                <h2>📦 All Shipments</h2>
                <p>
                  Use this section when you want one combined view. Filters here work across the selected delivery mode and date range.
                </p>
              </div>
            </div>

            <form id="allFiltersForm" method="GET" action="/admin/shipments">
              <div class="filter-grid alltab">
                <div>
                  <label for="all_q">Search by name or mobile</label>
                  <input id="all_q" name="q" type="text" value="<%= activeTab === 'all' ? (filters.q || '') : '' %>" placeholder="Search by name or phone" />
                </div>

                <div>
                  <label for="all_delivery_mode">Delivery mode</label>
                  <select id="all_delivery_mode" name="delivery_mode">
                    <option value="all" <%= activeTab === 'all' && filters.deliveryMode==='all' ? 'selected' : '' %>>All</option>
                    <option value="home_delivery" <%= activeTab === 'all' && filters.deliveryMode==='home_delivery' ? 'selected' : '' %>>Home Delivery</option>
                    <option value="temple_pickup" <%= activeTab === 'all' && filters.deliveryMode==='temple_pickup' ? 'selected' : '' %>>Temple Pickup</option>
                  </select>
                </div>

                <div>
                  <label for="all_status">Shipment status</label>
                  <select id="all_status" name="status" data-current="<%= activeTab === 'all' ? (filters.status || 'all') : 'all' %>"></select>
                </div>

                <div>
                  <label for="all_date_from">From date</label>
                  <input id="all_date_from" name="date_from" type="date" value="<%= activeTab === 'all' ? (filters.dateFrom || '') : '' %>" />
                </div>

                <div>
                  <label for="all_date_to">To date</label>
                  <input id="all_date_to" name="date_to" type="date" value="<%= activeTab === 'all' ? (filters.dateTo || '') : '' %>" />
                </div>

                <div class="button-stack">
                  <a class="btn ghost" href="/admin/shipments?delivery_mode=all&status=all&page=1">Reset</a>
                  <button class="btn primary" type="submit">Apply</button>
                </div>

                <div class="button-stack">
                  <button type="button" class="btn refresh" onclick="refreshCurrentTab('all')">Refresh</button>
                </div>
              </div>
            </form>
          </div>

          <div class="counts-grid">
            <div class="count-card cc-pending">
              <div class="count-card-icon">📦</div>
              <div class="count-label">Pending</div>
              <div class="count-value"><%= allStats.pending || 0 %></div>
              <div class="count-sub">Across all delivery types</div>
            </div>
            <div class="count-card cc-packing">
              <div class="count-card-icon">🔧</div>
              <div class="count-label">Under Packing</div>
              <div class="count-value"><%= allStats.under_packing || 0 %></div>
              <div class="count-sub">Home delivery workflow</div>
            </div>
            <div class="count-card cc-packed">
              <div class="count-card-icon">✅</div>
              <div class="count-label">Packed</div>
              <div class="count-value"><%= allStats.packed || 0 %></div>
              <div class="count-sub">Ready for dispatch or review</div>
            </div>
            <div class="count-card cc-dispatched">
              <div class="count-card-icon">🚚</div>
              <div class="count-label">Dispatched</div>
              <div class="count-value"><%= allStats.dispatched || 0 %></div>
              <div class="count-sub">Courier handoff completed</div>
            </div>
            <div class="count-card cc-delivered">
              <div class="count-card-icon">🎉</div>
              <div class="count-label">Delivered / Handed Over</div>
              <div class="count-value"><%= (allStats.delivered || 0) + (allStats.handed_over || 0) %></div>
              <div class="count-sub">Final completion statuses</div>
            </div>
          </div>
        </section>

        <div class="pagination-bar">
          <div class="pagination-meta">
            Showing page <strong><%= currentPage %></strong> of <strong><%= pagesTotal %></strong>
            <% if (totalCountValue) { %>
              • Total shipments: <strong><%= totalCountValue %></strong>
            <% } %>
          </div>

          <div class="pagination-links">
            <% if (currentPage > 1) { %>
              <a class="page-link" href="<%= pageHref(1, (filters && filters.deliveryMode) || 'home_delivery') %>">First</a>
              <a class="page-link" href="<%= pageHref(currentPage - 1, (filters && filters.deliveryMode) || 'home_delivery') %>">Prev</a>
            <% } %>

            <a class="page-link active" href="javascript:void(0)"><%= currentPage %></a>

            <% if (currentPage < pagesTotal) { %>
              <a class="page-link" href="<%= pageHref(currentPage + 1, (filters && filters.deliveryMode) || 'home_delivery') %>">Next</a>
              <a class="page-link" href="<%= pageHref(pagesTotal, (filters && filters.deliveryMode) || 'home_delivery') %>">Last</a>
            <% } %>
          </div>
        </div>

        <div class="tablewrap">
          <table>
            <thead>
              <tr>
                <th class="checkcell">
                  <input type="checkbox" id="checkAll" />
                </th>
                <th>🔖 Shipment</th>
                <th>👤 User</th>
                <th>📚 Books</th>
                <th>📍 Address</th>
                <th>📡 Tracking</th>
                <th>⚙️ Actions</th>
              </tr>
            </thead>

            <tbody>
              <% if (!items || !items.length) { %>
                <tr>
                  <td colspan="7" class="empty">
                    No shipments found for the selected filters.
                  </td>
                </tr>
              <% } %>

              <% items.forEach(it => { %>
                <tr>
                  <td class="checkcell">
                    <input
                      type="checkbox"
                      name="shipment_ids"
                      value="<%= it.shipment_id %>"
                      class="rowCheck"
                    />
                  </td>

                  <td class="muted tiny">
                    <div><strong>Shipment:</strong> <%= it.shipment_id %></div>
                    <div><strong>Payment:</strong> <%= it.payment_id || '-' %></div>
                    <div><strong>Mode:</strong> <%= it.delivery_mode || '-' %></div>
                  </td>

                  <td>
                    <div style="font-weight:900"><%= it.user_name %></div>
                    <div class="muted tiny"><%= it.email %> • <%= it.phone || '-' %></div>
                  </td>

                  <td>
                    <div><strong>Books:</strong> <%= it.books_display || '-' %></div>
                    <div class="muted tiny"><%= it.contest_titles || '-' %></div>
                  </td>

                  <td class="muted tiny">
                    <div><%= it.address || '-' %></div>
                    <div><%= it.city || '' %> <%= it.state || '' %> <%= it.pincode || '' %></div>
                  </td>

                  <td class="muted tiny">
                    <div><strong>ID:</strong> <%= it.tracking_id || '-' %></div>
                    <div><strong>Courier:</strong> <%= it.courier_mode || '-' %></div>
                    <div style="margin-top:6px">
                      <span class="pill <%= (it.status || 'pending').toLowerCase() %>"><%= it.status || 'pending' %></span>
                    </div>
                  </td>

                  <td style="min-width:300px">
                    <form method="POST" action="/admin/shipments/update" class="update-form">
                      <input type="hidden" name="shipmentId" value="<%= it.shipment_id %>">

                      <div class="tiny muted">
                        <strong>Tracking:</strong> <%= it.tracking_id || '-' %>
                      </div>

                      <input
                        type="text"
                        name="tracking_id"
                        value="<%= it.tracking_id || '' %>"
                        placeholder="Tracking ID"
                      />

                      <input
                        type="hidden"
                        name="courier_mode"
                        value="<%= it.courier_mode || 'india_post' %>"
                      />

                      <div class="tiny muted">
                        Courier: <strong><%= it.courier_mode || 'india_post' %></strong>
                      </div>

                      <div>
                        <label>Shipment status</label>
                        <select name="status">
                          <% if (it.delivery_mode === 'temple_pickup') { %>
                            <option value="pending" <%= it.status==='pending' ? 'selected' : '' %>>Pending</option>
                            <option value="handed_over" <%= it.status==='handed_over' ? 'selected' : '' %>>Handed Over</option>
                          <% } else { %>
                            <option value="pending" <%= it.status==='pending' ? 'selected' : '' %>>Pending</option>
                            <option value="under_packing" <%= it.status==='under_packing' ? 'selected' : '' %>>Under Packing</option>
                            <option value="packed" <%= it.status==='packed' ? 'selected' : '' %>>Packed</option>
                            <option value="dispatched" <%= it.status==='dispatched' ? 'selected' : '' %>>Dispatched</option>
                            <option value="delivered" <%= it.status==='delivered' ? 'selected' : '' %>>Delivered</option>
                            <option value="returned" <%= it.status==='returned' ? 'selected' : '' %>>Returned</option>
                          <% } %>
                        </select>
                      </div>

                      <button class="btn primary" type="submit">Save</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="pagination-bar">
          <div class="pagination-meta">
            Page <strong><%= currentPage %></strong> / <strong><%= pagesTotal %></strong>
            <% if (pageSizeValue) { %> • Page size: <strong><%= pageSizeValue %></strong><% } %>
          </div>

          <div class="pagination-links">
            <% if (currentPage > 1) { %>
              <a class="page-link" href="<%= pageHref(1, (filters && filters.deliveryMode) || 'home_delivery') %>">First</a>
              <a class="page-link" href="<%= pageHref(currentPage - 1, (filters && filters.deliveryMode) || 'home_delivery') %>">Prev</a>
            <% } %>

            <a class="page-link active" href="javascript:void(0)"><%= currentPage %></a>

            <% if (currentPage < pagesTotal) { %>
              <a class="page-link" href="<%= pageHref(currentPage + 1, (filters && filters.deliveryMode) || 'home_delivery') %>">Next</a>
              <a class="page-link" href="<%= pageHref(pagesTotal, (filters && filters.deliveryMode) || 'home_delivery') %>">Last</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<script>
  let modalConfirmHandler = null;

  function toggleAdminMenu() {
    document.body.classList.toggle("menu-open");
  }

  function closeAdminMenu() {
    document.body.classList.remove("menu-open");
  }

  document.addEventListener("keydown", function(e) {
    if (e.key === "Escape") {
      closeAdminMenu();
      hideActionModal();
    }
  });

  function closeAlert(btn) {
    const box = btn.closest("[data-alert]");
    if (box) box.remove();
  }

  function showActionModal({ title, html, note, confirmText = "Proceed", onConfirm }) {
    const modal = document.getElementById("actionModal");
    const titleEl = document.getElementById("actionModalTitle");
    const textEl = document.getElementById("actionModalText");
    const noteEl = document.getElementById("actionModalNote");
    const confirmBtn = document.getElementById("actionModalConfirmBtn");

    titleEl.textContent = title || "Confirm action";
    textEl.innerHTML = html || "";
    if (note) {
      noteEl.style.display = "block";
      noteEl.textContent = note;
    } else {
      noteEl.style.display = "none";
      noteEl.textContent = "";
    }
    confirmBtn.textContent = confirmText;
    modalConfirmHandler = onConfirm || null;
    modal.classList.add("show");
  }

  function hideActionModal() {
    const modal = document.getElementById("actionModal");
    modal.classList.remove("show");
    modalConfirmHandler = null;
  }

  document.getElementById("actionModalConfirmBtn").addEventListener("click", function () {
    if (typeof modalConfirmHandler === "function") modalConfirmHandler();
    hideActionModal();
  });

  (function () {
    const checkAll = document.getElementById("checkAll");
    const rowChecks = Array.from(document.querySelectorAll(".rowCheck"));
    if (!checkAll) return;

    checkAll.addEventListener("change", function () {
      rowChecks.forEach(cb => cb.checked = checkAll.checked);
    });
  })();

  (function () {
    const tabs = Array.from(document.querySelectorAll(".tabbtn"));
    const panels = Array.from(document.querySelectorAll(".tabpanel"));

    function activateTab(tabName) {
      tabs.forEach(btn => btn.classList.toggle("active", btn.dataset.tab === tabName));
      panels.forEach(panel => panel.classList.toggle("active", panel.dataset.panel === tabName));
    }

    tabs.forEach(btn => {
      btn.addEventListener("click", function () {
        activateTab(btn.dataset.tab);
      });
    });
  })();

  (function () {
    const modeEl = document.getElementById("all_delivery_mode");
    const statusEl = document.getElementById("all_status");
    if (!modeEl || !statusEl) return;

    const optionsMap = {
      all: [
        { value: "all", label: "All" },
        { value: "pending", label: "Pending" },
        { value: "under_packing", label: "Under Packing" },
        { value: "packed", label: "Packed" },
        { value: "dispatched", label: "Dispatched" },
        { value: "delivered", label: "Delivered" },
        { value: "returned", label: "Returned" },
        { value: "handed_over", label: "Handed Over" }
      ],
      home_delivery: [
        { value: "all", label: "All" },
        { value: "pending", label: "Pending" },
        { value: "under_packing", label: "Under Packing" },
        { value: "packed", label: "Packed" },
        { value: "dispatched", label: "Dispatched" },
        { value: "delivered", label: "Delivered" },
        { value: "returned", label: "Returned" }
      ],
      temple_pickup: [
        { value: "all", label: "All" },
        { value: "pending", label: "Pending" },
        { value: "handed_over", label: "Handed Over" }
      ]
    };

    function rebuildStatusOptions() {
      const current = statusEl.dataset.current || "all";
      const selectedMode = modeEl.value || "all";
      const opts = optionsMap[selectedMode] || optionsMap.all;

      statusEl.innerHTML = "";
      opts.forEach(opt => {
        const el = document.createElement("option");
        el.value = opt.value;
        el.textContent = opt.label;
        if (opt.value === current) el.selected = true;
        statusEl.appendChild(el);
      });

      if (!Array.from(statusEl.options).some(o => o.value === current)) {
        statusEl.value = "all";
      }
    }

    modeEl.addEventListener("change", function () {
      statusEl.dataset.current = "all";
      rebuildStatusOptions();
    });

    rebuildStatusOptions();
  })();

  function formQueryToParams(form) {
    const params = new URLSearchParams();
    const fd = new FormData(form);
    for (const [key, val] of fd.entries()) {
      if (val === undefined || val === null) continue;
      const v = String(val).trim();
      if (v !== "") params.set(key, v);
    }
    if (!params.get("status")) params.set("status", "all");
    if (!params.get("page")) params.set("page", "1");
    return params;
  }

  function refreshCurrentTab(tabName) {
    const formId =
      tabName === "temple" ? "templeFiltersForm" :
      tabName === "all" ? "allFiltersForm" :
      "homeFiltersForm";

    const form = document.getElementById(formId);
    if (!form) return;

    const params = formQueryToParams(form);
    window.location.href = `${form.action}?${params.toString()}`;
  }

function confirmShipmentDownload({ formId, endpoint, actionLabel, changeLabel, confirmText }) {
  const form = document.getElementById(formId);
  if (!form) return;

  const params = formQueryToParams(form);
  params.delete("page");

  const dateFrom = form.querySelector('input[name="date_from"]')?.value || "";
  const dateTo = form.querySelector('input[name="date_to"]')?.value || "";
  const status = form.querySelector('select[name="status"]')?.value || "all";

  let dateSummary = "No date filter is applied. All currently matching rows will be included.";
  if (dateFrom && dateTo) {
    dateSummary = `Date range: <strong>${dateFrom}</strong> to <strong>${dateTo}</strong>`;
  }

  showActionModal({
    title: actionLabel || "Confirm download",
    html: `
      ${changeLabel || "Please confirm this action."}<br><br>
      <strong>Current status filter:</strong> ${status}<br>
      ${dateSummary}
    `,
    note: "Please make sure the current filtered result is exactly what you want before continuing.",
    confirmText: confirmText || "Proceed",
    onConfirm: function () {
  const url = new URL(endpoint, window.location.origin);

  params.forEach((value, key) => {
    if (!url.searchParams.has(key)) {
      url.searchParams.set(key, value);
    }
  });

  window.location.href = url.pathname + "?" + url.searchParams.toString();
}
  });
}





  function showResultModal({ title, html, statsHtml, rejectedFile }) {
    const modal = document.getElementById("resultModal");
    const titleEl = document.getElementById("resultModalTitle");
    const textEl = document.getElementById("resultModalText");
    const statsEl = document.getElementById("resultModalStats");
    const actionsEl = document.getElementById("resultModalActions");

    titleEl.textContent = title || "Shipment update completed";
    textEl.innerHTML = html || "";
    actionsEl.innerHTML = "";

    if (statsHtml) {
      statsEl.style.display = "block";
      statsEl.innerHTML = statsHtml;
    } else {
      statsEl.style.display = "none";
      statsEl.innerHTML = "";
    }

    if (rejectedFile) {
      const a = document.createElement("a");
      a.className = "btn ghost";
      a.href = "/tmp/" + encodeURIComponent(rejectedFile);
      a.target = "_blank";
      a.rel = "noopener noreferrer";
      a.textContent = "Download Rejected Entries";
      actionsEl.appendChild(a);
    }

    modal.classList.add("show");
  }

  function hideResultModal() {
    const modal = document.getElementById("resultModal");
    modal.classList.remove("show");
  }

  function confirmBulkAdvance(form, cfg) {
    showActionModal({
      title: cfg.title || "Confirm bulk update",
      html: cfg.html || "Please confirm this bulk update action.",
      confirmText: cfg.confirmText || "Proceed",
      onConfirm: function () {
        form.submit();
      }
    });
    return false;
  }

  function showUploadingState(form) {
    const btn = form.querySelector('button[type="submit"]');
    if (btn) {
      btn.disabled = true;
      btn.dataset.originalText = btn.textContent;
      btn.textContent = "Processing...";
    }
    return true;
  }

  async function submitShipmentExcelWithModal(form, cfg) {
    const fileInput = form.querySelector('input[type="file"]');
    if (!fileInput || !fileInput.files || !fileInput.files.length) {
      showActionModal({
        title: cfg.title || "File required",
        html: "Please choose a file before continuing.",
        confirmText: "OK",
        onConfirm: function () {}
      });
      return false;
    }

    showActionModal({
      title: cfg.title || "Confirm Excel update",
      html: cfg.processingText || "The uploaded file will now be validated and processed.",
      confirmText: "Proceed",
      onConfirm: async function () {
        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.dataset.originalText = submitBtn.textContent;
          submitBtn.textContent = "Processing...";
        }

        try {
          const fd = new FormData(form);

          const response = await fetch(form.action, {
              method: "POST",
              body: fd,
              headers: {
                "X-Requested-With": "XMLHttpRequest"
              }
            });

          const data = await response.json().catch(() => null);

          if (!response.ok || !data || data.ok === false) {
            showResultModal({
              title: "Shipment update failed",
              html: data && data.message ? data.message : "Unable to process this file right now."
            });
            return;
          }

          showResultModal({
            title: cfg.successTitle || "Shipment update completed",
            html: data.message || "The uploaded file was processed successfully.",
            statsHtml: `
              <strong>Accepted:</strong> ${Number(data.acceptedCount || 0)}<br>
              <strong>Rejected:</strong> ${Number(data.rejectedCount || 0)}
            `,
            rejectedFile: data.rejectedFile || ""
          });

          if (data.redirectUrl) {
            setTimeout(() => {
              window.location.href = data.redirectUrl;
            }, 1200);
          } else if (data.refresh) {
            setTimeout(() => {
              window.location.href = data.refresh;
            }, 1200);
          }
        } catch (err) {
          showResultModal({
            title: "Shipment update failed",
            html: "Something went wrong while processing the uploaded file."
          });
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = submitBtn.dataset.originalText || "Submit";
          }
        }
      }
    });

    return false;
  }

</script>
</body>
</html>