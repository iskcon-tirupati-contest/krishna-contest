<%- include('partials/admin-shell-start', {
  title: 'Shipments',
  mobileTitle: 'Shipments',
  activeTab: 'shipments'
}) %>

<div class="page-head">
  <div>
    <h1>Shipments</h1>
    <div class="sub">
      Manage grouped shipments, India Post batches, and tracking updates
    </div>
  </div>

  <div class="page-actions">
    <a class="btn ghost" href="/admin">Admin Home</a>
  </div>
</div>

<!-- Alerts -->
<% if (batchCreated) { %>
  <div class="card">
    <div class="pill">
      Batch created: <strong><%= batchCreated %></strong>
      <a class="btn ghost" href="/admin/india-post/export/<%= encodeURIComponent(batchCreated) %>">
        Download Excel
      </a>
    </div>
  </div>
<% } %>

<% if (imported) { %>
  <div class="card">
    <div class="pill">Imported rows: <strong><%= imported %></strong></div>
  </div>
<% } %>

<% if (errorMsg) { %>
  <div class="card">
    <div class="pill"><%= errorMsg %></div>
  </div>
<% } %>

<!-- Filters -->
<div class="card">
  <div class="strong">Filters</div>
  <div class="tiny">Filter shipments by contest, user, tracking and status.</div>

  <div class="section-line"></div>

  <form id="filtersForm" method="GET" action="/admin/shipments">
    <div class="grid grid-3">

      <div>
        <label>Contest</label>
        <select name="contest_id">
          <option value="">All</option>
          <% contests.forEach(c => { %>
            <option value="<%= c.id %>" <%= String(filters.contestId||"")===String(c.id) ? "selected" : "" %>>
              <%= c.title %>
            </option>
          <% }) %>
        </select>
      </div>

      <div>
        <label>User name</label>
        <input name="user_name" value="<%= filters.userName || '' %>" placeholder="Search name" />
      </div>

      <div>
        <label>Status</label>
        <select name="status">
          <option value="all" <%= filters.status==='all'?'selected':'' %>>All</option>
          <option value="pending" <%= filters.status==='pending'?'selected':'' %>>Pending</option>
          <option value="packed" <%= filters.status==='packed'?'selected':'' %>>Packed</option>
          <option value="dispatched" <%= filters.status==='dispatched'?'selected':'' %>>Dispatched</option>
          <option value="delivered" <%= filters.status==='delivered'?'selected':'' %>>Delivered</option>
        </select>
      </div>

      <div>
        <label>Missing Tracking</label>
        <select name="missing_tracking">
          <option value="0">All</option>
          <option value="1" <%= filters.missingTracking==='1'?'selected':'' %>>Missing only</option>
        </select>
      </div>

      <div>
        <label>India Post Status</label>
        <select name="ip_status">
          <option value="all">All</option>
          <option value="pending">Pending</option>
          <option value="booked">Booked</option>
          <option value="delivered">Delivered</option>
        </select>
      </div>

    </div>
  </form>

  <div class="row" style="margin-top:14px">
    <button class="btn primary" form="filtersForm">Apply</button>
    <a class="btn ghost" href="/admin/shipments">Reset</a>
    <a class="btn ghost" href="/admin/shipments/export.csv?<%= qs %>">Export CSV</a>
    <button class="btn primary" form="ipBatchForm">Create Batch</button>
  </div>
</div>

<!-- India Post actions -->
<div class="card">
  <div class="row">
    <form id="ipBatchForm" method="POST" action="/admin/india-post/create-batch"></form>

    <form method="POST" action="/admin/india-post/import-result" enctype="multipart/form-data">
      <input type="file" name="result_file" accept=".xlsx,.xls" />
      <button class="btn ghost">Import Result</button>
    </form>
  </div>
</div>

<!-- Table -->
<div class="card">
  <div class="row" style="justify-content:space-between;margin-bottom:12px">
    <div>
      <div class="strong">Shipments</div>
      <div class="tiny">Scroll horizontally on mobile</div>
    </div>
    <span class="pill"><%= (items || []).length %> rows</span>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th><input type="checkbox" id="checkAll"></th>
          <th>Shipment</th>
          <th>User</th>
          <th>Books</th>
          <th>Address</th>
          <th>Tracking</th>
          <th>India Post</th>
          <th>Update</th>
        </tr>
      </thead>

      <tbody>
        <% if (!items || !items.length) { %>
          <tr><td colspan="8" class="muted">No shipments</td></tr>
        <% } %>

        <% items.forEach(it => { %>
          <tr>
            <td>
              <input type="checkbox" class="rowCheck" form="ipBatchForm" name="shipment_ids" value="<%= it.shipment_id %>">
            </td>

            <td class="tiny">
              <div><strong><%= it.shipment_id %></strong></div>
              <div><%= it.payment_id || '-' %></div>
            </td>

            <td>
              <div class="strong"><%= it.user_name %></div>
              <div class="tiny"><%= it.email %></div>
            </td>

            <td>
              <div><%= it.book_titles %></div>
              <div class="tiny"><%= it.contest_titles %></div>
            </td>

            <td class="tiny">
              <div><%= it.address %></div>
              <div><%= it.city %> <%= it.state %> <%= it.pincode %></div>
            </td>

            <td class="tiny">
              <div>ID: <%= it.tracking_id || '-' %></div>
              <div><%= it.courier_mode || '-' %></div>
              <span class="pill"><%= it.status || 'pending' %></span>
            </td>

            <td class="tiny">
              <div>Batch: <%= it.batch_no || '-' %></div>
              <div>Status: <%= it.ip_booking_status || '-' %></div>
            </td>

            <td>
              <form method="POST" action="/admin/shipments/update">
                <input type="hidden" name="shipmentId" value="<%= it.shipment_id %>" />

                <input name="tracking_id" value="<%= it.tracking_id || '' %>" placeholder="Tracking" />
                <input name="courier_mode" value="<%= it.courier_mode || '' %>" placeholder="Courier" />

                <select name="status">
                  <option value="pending">Pending</option>
                  <option value="packed">Packed</option>
                  <option value="dispatched">Dispatched</option>
                  <option value="delivered">Delivered</option>
                </select>

                <button class="btn primary">Save</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script>
  const checkAll = document.getElementById("checkAll");
  const rows = document.querySelectorAll(".rowCheck");

  if (checkAll) {
    checkAll.addEventListener("change", () => {
      rows.forEach(r => r.checked = checkAll.checked);
    });
  }
</script>

<%- include('partials/admin-shell-end') %>