<%- include('partials/admin-shell-start', {
  title: 'Submissions',
  mobileTitle: 'Submissions',
  activeTab: 'submissions'
}) %>

<div class="page-head">
  <div>
    <h1>Submissions</h1>
    <div class="sub">Showing <strong><%= (items || []).length %></strong> rows (latest 500)</div>
  </div>

  <div class="page-actions">
    <a class="btn ghost" href="/admin/submissions">Reset</a>
    <a class="btn ghost" href="/admin/submissions/export.csv?<%= qs %>">Export CSV</a>
    <button class="btn primary" type="submit" form="filtersForm">Apply</button>
  </div>
</div>

<div class="card">
  <div class="strong" style="margin-bottom:6px">Filters</div>
  <div class="tiny">Filter by contest, user name, and email.</div>

  <div class="section-line"></div>

  <form id="filtersForm" method="GET" action="/admin/submissions">
    <div class="grid grid-3">
      <div>
        <label for="contest_id">Contest</label>
        <select id="contest_id" name="contest_id">
          <option value="" <%= !filters.contestId ? 'selected' : '' %>>All</option>
          <% (contests || []).forEach(c => { %>
            <option value="<%= c.id %>" <%= filters.contestId === c.id ? 'selected' : '' %>><%= c.title %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label for="user_name">User name</label>
        <input id="user_name" name="user_name" value="<%= filters.userName || '' %>" placeholder="e.g. Iskcon" />
      </div>

      <div>
        <label for="email">Email</label>
        <input id="email" name="email" value="<%= filters.email || '' %>" placeholder="e.g. gmail.com" />
      </div>
    </div>
  </form>

  <%
    const base = (obj) => {
      const p = new URLSearchParams();
      Object.keys(obj).forEach(k => { if (obj[k]) p.set(k, obj[k]); });
      return p.toString();
    };

    const f = {
      contest_id: filters.contestId || '',
      user_name: filters.userName || '',
      email: filters.email || ''
    };
  %>

  <div class="row" style="margin-top:14px">
    <% Object.keys(f).forEach(k => { if (f[k]) {
      const copy = { ...f };
      copy[k] = '';
      const qss = base(copy);
    %>
      <span class="pill">
        <span><%= k %>: <%= f[k] %></span>
        <a href="/admin/submissions?<%= qss %>" style="margin-left:6px">✕</a>
      </span>
    <% } }) %>

    <% if (!Object.keys(f).some(k => f[k])) { %>
      <span class="tiny">No active filters.</span>
    <% } %>
  </div>
</div>

<div class="card">
  <div class="row" style="justify-content:space-between;margin-bottom:12px">
    <div>
      <div class="strong">Submissions List</div>
      <div class="tiny">Scrollable safely on mobile while keeping actions usable.</div>
    </div>
    <span class="pill"><%= (items || []).length %> row(s)</span>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Uploaded</th>
          <th>Contest</th>
          <th>User</th>
          <th>Book</th>
          <th>File</th>
          <th>Size</th>
          <th>Lock</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <%
          function bytesToHuman(b){
            const n = Number(b || 0);
            const gb = n / (1024 * 1024 * 1024);
            if (gb >= 1) return gb.toFixed(2) + " GB";
            const mb = n / (1024 * 1024);
            if (mb >= 1) return mb.toFixed(2) + " MB";
            const kb = n / 1024;
            if (kb >= 1) return kb.toFixed(2) + " KB";
            return n + " B";
          }
        %>

        <% (items || []).forEach(s => { %>
          <tr>
            <td><%= s.uploaded_at %></td>
            <td><%= s.contest_title %></td>

            <td>
              <div class="strong"><%= s.user_name %></div>
              <div class="tiny"><%= s.email %></div>
              <div class="tiny">UUID: <%= s.user_id %></div>
            </td>

            <td>
              <% if ((s.book_option || '').toLowerCase() === 'donation') { %>
                Donation
              <% } else { %>
                <%= s.book_title || 'Book' %>
              <% } %>
            </td>

            <td><%= s.original_name || '-' %></td>
            <td><%= s.file_size ? bytesToHuman(s.file_size) : '-' %></td>

            <td>
              <form method="POST" action="/admin/submissions/toggle-lock">
                <input type="hidden" name="submissionId" value="<%= s.id %>" />
                <button class="btn ghost" type="submit"><%= s.is_locked ? 'Unlock' : 'Lock' %></button>
              </form>
            </td>

            <td style="min-width:280px">
              <div class="row mobile-stack">
                <a
                  class="btn ghost"
                  href="/admin/submissions/download?submissionId=<%= s.id %>">
                  Download
                </a>

                <input
                  type="file"
                  id="f-<%= s.order_id %>"
                  style="display:none"
                  accept=".pdf,.doc,.docx,.mp3,.wav,.aac,.m4a,.ogg,.mp4,.m4v,.mov,.webm,.mkv" />

                <button
                  class="btn ghost"
                  type="button"
                  onclick="adminPickFile('<%= s.order_id %>', <%= s.is_locked ? 'true' : 'false' %>, <%= s.deadline_passed ? 'true' : 'false' %>)">
                  Upload
                </button>
              </div>

              <div class="tiny" style="margin-top:8px" id="st-<%= s.order_id %>"></div>
              <progress id="pg-<%= s.order_id %>" value="0" max="100" style="width:220px;display:none;margin-top:8px"></progress>
            </td>
          </tr>
        <% }) %>

        <% if (!items || !items.length) { %>
          <tr>
            <td colspan="8" class="muted">No submissions found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <div class="tiny" style="margin-top:12px">
    Admin upload-on-behalf respects: paid order + deadline + unlocked submission.
  </div>
</div>

<script>
  const MAX_MB = 500;
  const PART_SIZE = 10 * 1024 * 1024;

  function st(orderId){ return document.getElementById("st-" + orderId); }
  function pg(orderId){ return document.getElementById("pg-" + orderId); }

  function setMsg(orderId, msg){
    const el = st(orderId);
    if (el) el.textContent = msg;
  }

  window.adminPickFile = function(orderId, isLocked, deadlinePassed){
    if (deadlinePassed) {
      setMsg(orderId, "Deadline passed. Upload blocked.");
      return;
    }

    if (isLocked) {
      setMsg(orderId, "Submission locked. Unlock first.");
      return;
    }

    const input = document.getElementById("f-" + orderId);
    if (!input) return;

    input.onchange = async () => {
      if (!input.files || !input.files[0]) return;

      try {
        await adminUploadMultipart(orderId, input.files[0]);
      } catch (e) {
        setMsg(orderId, (e && e.message) ? e.message : "Upload error");
        const prog = pg(orderId);
        if (prog) prog.style.display = "none";
      } finally {
        input.value = "";
      }
    };

    input.click();
  };

  async function adminUploadMultipart(orderId, file){
    if (file.size > MAX_MB * 1024 * 1024) {
      throw new Error(`Max file size is ${MAX_MB}MB`);
    }

    setMsg(orderId, "Starting upload...");
    const prog = pg(orderId);
    if (prog) {
      prog.style.display = "block";
      prog.value = 0;
    }

    const startRes = await fetch("/admin/submissions/upload/start", {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify({
        orderId,
        fileName: file.name,
        contentType: file.type || "application/octet-stream",
        fileSize: file.size
      })
    });

    const start = await startRes.json().catch(() => ({}));
    if (!startRes.ok) throw new Error(start.error || "Failed to start upload");

    const { key, uploadId, userId } = start;

    const totalParts = Math.ceil(file.size / PART_SIZE);
    const partNumbers = Array.from({ length: totalParts }, (_, i) => i + 1);

    setMsg(orderId, "Preparing parts...");
    const presignRes = await fetch("/admin/submissions/upload/presign-parts", {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify({ orderId, userId, key, uploadId, partNumbers })
    });

    const presign = await presignRes.json().catch(() => ({}));
    if (!presignRes.ok) throw new Error(presign.error || "Failed to presign parts");

    const urlMap = new Map((presign.urls || []).map(x => [x.partNumber, x.url]));
    const uploadedParts = [];

    for (let partNumber = 1; partNumber <= totalParts; partNumber++) {
      const startByte = (partNumber - 1) * PART_SIZE;
      const endByte = Math.min(partNumber * PART_SIZE, file.size);
      const blob = file.slice(startByte, endByte);

      setMsg(orderId, `Uploading part ${partNumber}/${totalParts}...`);

      const putRes = await fetch(urlMap.get(partNumber), {
        method: "PUT",
        body: blob
      });

      if (!putRes.ok) {
        await fetch("/admin/submissions/upload/abort", {
          method: "POST",
          headers: {"Content-Type":"application/json"},
          body: JSON.stringify({ orderId, userId, key, uploadId })
        }).catch(() => {});

        throw new Error("Upload failed. Please retry (Wi-Fi recommended).");
      }

      uploadedParts.push({
        ETag: putRes.headers.get("ETag"),
        PartNumber: partNumber
      });

      if (prog) {
        prog.value = Math.round((partNumber / totalParts) * 100);
      }
    }

    setMsg(orderId, "Finalizing...");
    const completeRes = await fetch("/admin/submissions/upload/complete", {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify({
        orderId,
        userId,
        key,
        uploadId,
        parts: uploadedParts,
        contentType: file.type || "application/octet-stream",
        originalName: file.name,
        fileSize: file.size
      })
    });

    const complete = await completeRes.json().catch(() => ({}));
    if (!completeRes.ok) throw new Error(complete.error || "Failed to save submission");

    setMsg(orderId, "✅ Uploaded successfully!");
    setTimeout(() => window.location.reload(), 700);
  }
</script>

<%- include('partials/admin-shell-end') %>