<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin - User 360</title>
  <style>
    body{margin:0;font-family:Segoe UI,Tahoma,Verdana,sans-serif;background:#0b1224;color:#fff}
    .layout{display:flex;min-height:100vh}
    .sidebar{width:260px;background:#0a1022;border-right:1px solid rgba(255,255,255,.08);padding:18px}
    .brand{font-weight:900;margin-bottom:18px}
    .nav a{display:block;padding:10px 12px;border-radius:12px;text-decoration:none;color:rgba(255,255,255,.85);margin-bottom:8px}
    .nav a.active{background:rgba(26,60,255,.18);border:1px solid rgba(26,60,255,.35);color:#fff}
    .content{flex:1;min-width:0}
    .wrap{max-width:1200px;margin:26px auto;padding:0 18px}
    .card{background:#111b35;border:1px solid rgba(255,255,255,.12);border-radius:18px;padding:18px;margin-bottom:14px}
    input,textarea,select{width:100%;padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,.18);background:#0e1630;color:#fff}
    .grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .btn{border:none;border-radius:12px;padding:10px 12px;font-weight:900;cursor:pointer;text-decoration:none;display:inline-block}
    .btn.primary{background:#1a3cff;color:#fff}
    .btn.ghost{background:rgba(255,255,255,.10);color:#fff}
    .btn:disabled{opacity:.45;cursor:not-allowed}
    table{width:100%;border-collapse:collapse;margin-top:10px}
    th,td{padding:10px;border-bottom:1px solid rgba(255,255,255,.10);text-align:left;vertical-align:top}
    .muted{color:rgba(255,255,255,.7)}
    .pill{display:inline-block;padding:4px 10px;border-radius:999px;background:rgba(255,255,255,.10);font-size:12px}
    .msg{padding:12px 14px;border-radius:12px;margin-bottom:12px;border:1px solid rgba(255,255,255,.12)}
    .msg.ok{background:rgba(34,197,94,.12);border-color:rgba(34,197,94,.25)}
    .msg.err{background:rgba(239,68,68,.12);border-color:rgba(239,68,68,.25)}
    .mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;word-break:break-all}
    .small{font-size:12px}
    .stack{display:grid;gap:8px}
    .uploadStatus.ok{color:#86efac}
    .uploadStatus.err{color:#fca5a5}
    .uploadStatus.info{color:#fde68a}
    .progressWrap{display:none;width:150px}
    progress{width:150px;height:10px}
    @media (max-width: 900px){
      .grid2{grid-template-columns:1fr}
      .mobile-topbar{display:flex !important}
      .sidebar{
        position:fixed;left:0;top:0;bottom:0;z-index:1199;
        transform:translateX(-100%);transition:transform .22s ease;
        box-shadow:0 10px 30px rgba(0,0,0,.35);overflow:auto;flex-shrink:0;
      }
      body.menu-open .sidebar{transform:translateX(0)}
      body.menu-open .sidebar-backdrop{display:block}
      .wrap{margin:18px auto;padding:0 14px}
      table{font-size:13px}
    }
    .mobile-topbar{
      display:none;position:sticky;top:0;z-index:1200;padding:12px 14px;
      background:#0a1022;border-bottom:1px solid rgba(255,255,255,.08);
      align-items:center;justify-content:space-between;gap:12px;
    }
    .mobile-title{font-weight:900}
    .menu-btn{
      border:none;border-radius:12px;padding:10px 12px;font-weight:900;cursor:pointer;
      background:#1a3cff;color:#fff;
    }
    .sidebar-backdrop{
      display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1198;
    }
  </style>
</head>
<body>
  <div class="mobile-topbar">
    <button type="button" class="menu-btn" onclick="toggleAdminMenu()">☰ Menu</button>
    <div class="mobile-title">Admin Panel</div>
  </div>

  <div class="sidebar-backdrop" onclick="closeAdminMenu()"></div>

  <div class="layout">
    <aside class="sidebar">
      <div class="brand">Admin Panel</div>
      <div class="nav">
        <a href="/admin">Overview</a>
        <a href="/admin/user360" class="active">View User</a>
        <a href="/admin/users">All Users</a>
        <a href="/admin/feedback">All Feedback</a>
        <a href="/admin/shipment-stock">Current Book Stock</a>
        <a href="/admin/shipments">Online Shipments</a>
        <a href="/admin/orders">Online Orders</a>
        <a href="/admin/submissions">Online Submissions</a>
        <a href="/admin/contests">Online Contests</a>
        <a href="/admin/offline-dashboard">Offline Overview</a>
        <a href="/admin/offline-orders">Offline Orders</a>
        <a href="/admin/agents">Offline Agents</a>
        <a href="/admin/payments/reconcile-bulk">Razorpay Reconcile</a>
        <a href="/logout" style="margin-top:14px;opacity:.9">Logout</a>
      </div>
    </aside>

    <main class="content">
      <div class="wrap">

        <% const _okMsg = typeof okMsg !== "undefined" ? okMsg : ""; %>
        <% const _errMsg = typeof errMsg !== "undefined" ? errMsg : ""; %>
        <% const _paymentGroups = typeof paymentGroups !== "undefined" ? paymentGroups : []; %>
        <% const _reconcilePreview = typeof reconcilePreview !== "undefined" ? reconcilePreview : null; %>

        <% if (_okMsg) { %>
          <div class="msg ok"><%= _okMsg %></div>
        <% } %>
        <% if (_errMsg) { %>
          <div class="msg err"><%= _errMsg %></div>
        <% } %>

        <div class="card">
          <div style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start;flex-wrap:wrap">
            <div>
              <h1 style="margin:0 0 6px 0">User 360</h1>
              <div class="muted">Complete profile + orders + shipments + submissions + feedback</div>
            </div>
            <div>
              <a class="btn ghost" href="/admin/user360">← Back</a>
            </div>
          </div>

          <div style="height:1px;background:rgba(255,255,255,.12);margin:14px 0"></div>

          <form method="POST" action="/admin/user360/<%= user.id %>/update">
            <div class="grid2">
              <div>
                <label class="muted">Name</label>
                <input name="name" value="<%= user.name || '' %>" />
              </div>
              <div>
                <label class="muted">Email (display only)</label>
                <input value="<%= user.email || '' %>" disabled />
              </div>

              <div>
                <label class="muted">Phone</label>
                <input name="phone" value="<%= user.phone || '' %>" />
                <div class="muted small" style="margin-top:6px">Admin override allowed</div>
              </div>

              <div>
                <label class="muted">Role</label>
                <input value="<%= user.role || 'user' %>" disabled />
              </div>

              <div>
                <label class="muted">Address</label>
                <textarea name="address"><%= user.address || '' %></textarea>
              </div>

              <div>
                <label class="muted">City / State / Pincode</label>
                <div class="grid2">
                  <input name="city" value="<%= user.city || '' %>" placeholder="City"/>
                  <input name="state" value="<%= user.state || '' %>" placeholder="State"/>
                </div>
                <div style="margin-top:10px">
                  <input name="pincode" value="<%= user.pincode || '' %>" placeholder="Pincode"/>
                </div>
              </div>
            </div>

            <div style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap">
              <button class="btn primary" type="submit">Save User</button>
              <span class="pill">User ID: <%= user.id %></span>
              <span class="pill">Created: <%= user.created_at %></span>
            </div>
          </form>
        </div>

        <div class="card">
          <h2 style="margin:0 0 8px 0">Orders</h2>
          <div class="muted">Latest 200</div>
          <table>
            <thead>
              <tr>
                <th>Order</th>
                <th>Contest</th>
                <th>Status</th>
                <th>Amount</th>
                <th>Book</th>
                <th>Created</th>
              </tr>
            </thead>
            <tbody>
              <% (orders || []).forEach(o => { %>
                <tr>
                  <td>
                    <div class="mono"><%= o.id %></div>
                    <div class="muted small">Payment: <%= o.payment_id || '-' %></div>
                  </td>
                  <td>
                    <div><%= o.contest_title || o.title || '-' %></div>
                    <div class="muted small">Age: <%= o.age_category || '-' %></div>
                  </td>
                  <td><span class="pill"><%= o.payment_status || '-' %></span></td>
                  <td>₹<%= o.amount || 0 %></td>
                  <td>
                    <div><%= o.book_option || '-' %></div>
                    <div class="muted small"><%= [o.book_title, o.book_language].filter(Boolean).join(' - ') || '-' %></div>
                  </td>
                  <td><%= o.created_at || '-' %></td>
                </tr>
              <% }) %>

              <% if (!(orders || []).length) { %>
                <tr><td colspan="6" class="muted">No orders found.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="card">
          <h2 style="margin:0 0 8px 0">Payments / Reconcile</h2>
          <div class="muted">Check Razorpay for pending or failed sessions.</div>

          <table>
            <thead>
              <tr>
                <th>Internal Payment</th>
                <th>Gateway Order</th>
                <th>Session Status</th>
                <th>Amount</th>
                <th>Orders</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% (_paymentGroups || []).forEach(p => { %>
                <% const isSessionPaid = String(p.session_status || '').toLowerCase() === 'paid'; %>
                <tr>
                  <td>
                    <div class="mono"><%= p.internal_payment_id || '-' %></div>
                    <div class="muted small">Session: <span class="mono"><%= p.payment_session_id %></span></div>
                  </td>
                  <td>
                    <div class="mono"><%= p.gateway_order_id || '-' %></div>
                    <div class="muted small"><%= p.created_at || '-' %></div>
                  </td>
                  <td>
                    <span class="pill"><%= p.session_status || '-' %></span>
                    <div class="muted small" style="margin-top:6px">Orders: <%= p.order_statuses || '-' %></div>
                  </td>
                  <td>₹<%= p.session_amount || 0 %></td>
                  <td><%= p.order_count || 0 %></td>
                  <td>
                    <form method="POST" action="/admin/user360/<%= user.id %>/payments/reconcile-preview">
                      <input type="hidden" name="paymentSessionId" value="<%= p.payment_session_id %>" />
                      <button class="btn ghost" type="submit" <%= isSessionPaid ? 'disabled' : '' %>>
                        Check Razorpay
                      </button>
                    </form>
                    <% if (isSessionPaid) { %>
                      <div class="muted small" style="margin-top:6px">Already paid</div>
                    <% } %>
                  </td>
                </tr>
              <% }) %>

              <% if (!(_paymentGroups || []).length) { %>
                <tr><td colspan="6" class="muted">No payment sessions found.</td></tr>
              <% } %>
            </tbody>
          </table>

          <% if (_reconcilePreview && _reconcilePreview.local) { %>
            <div style="height:1px;background:rgba(255,255,255,.12);margin:14px 0"></div>
            <h3 style="margin:0 0 8px 0">Razorpay Check Result</h3>

            <div class="grid2">
              <div class="card" style="margin:0;background:#0f1730">
                <div class="muted" style="margin-bottom:8px">Local Session</div>
                <div class="stack small">
                  <div><strong>Payment Session:</strong> <span class="mono"><%= _reconcilePreview.local.payment_session_id %></span></div>
                  <div><strong>Gateway Order:</strong> <span class="mono"><%= _reconcilePreview.local.gateway_order_id || '-' %></span></div>
                  <div><strong>Internal Payment:</strong> <span class="mono"><%= _reconcilePreview.local.internal_payment_id || '-' %></span></div>
                  <div><strong>Status:</strong> <span class="pill"><%= _reconcilePreview.local.session_status || '-' %></span></div>
                  <div><strong>Expected:</strong> ₹<%= Number(_reconcilePreview.local.session_amount || 0).toFixed(2) %></div>
                </div>
              </div>

              <div class="card" style="margin:0;background:#0f1730">
                <div class="muted" style="margin-bottom:8px">Razorpay</div>
                <% if (_reconcilePreview.apiError) { %>
                  <div class="msg err"><%= _reconcilePreview.apiError %></div>
                <% } else if (_reconcilePreview.selectedPayment) { %>
                  <div class="stack small">
                    <div><strong>Payment ID:</strong> <span class="mono"><%= _reconcilePreview.selectedPayment.id || '-' %></span></div>
                    <div><strong>Status:</strong> <span class="pill"><%= _reconcilePreview.selectedPayment.status || '-' %></span></div>
                    <div><strong>Captured:</strong> ₹<%= Number(_reconcilePreview.capturedAmount || 0).toFixed(2) %></div>
                    <div><strong>Decision:</strong> <span class="pill"><%= _reconcilePreview.decisionLabel || 'Review manually' %></span></div>
                  </div>
                <% } else { %>
                  <div class="muted">No Razorpay payment found.</div>
                <% } %>
              </div>
            </div>

            <div style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap;align-items:center">
              <% const alreadyPaid = String(_reconcilePreview?.local?.session_status || '').toLowerCase() === 'paid'; %>
              <form method="POST" action="/admin/user360/<%= user.id %>/payments/apply-paid">
                <input type="hidden" name="paymentSessionId" value="<%= _reconcilePreview.local.payment_session_id %>" />
                <button class="btn primary" type="submit" <%= (_reconcilePreview.canApplyPaid && !alreadyPaid) ? '' : 'disabled' %>>
                  Apply Paid Status
                </button>
              </form>
              <% if (alreadyPaid) { %>
                <span class="muted small">Already marked as paid</span>
              <% } %>
            </div>
          <% } %>
        </div>

        <div class="card">
          <h2 style="margin:0 0 8px 0">Shipments</h2>
          <div class="muted">Latest 200. Only paid orders can be handed over or marked delivered here.</div>

          <table>
            <thead>
              <tr>
                <th>Shipment</th>
                <th>Mode</th>
                <th>Books / Contests</th>
                <th>Status</th>
                <th>Tracking</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% (shipments || []).forEach(s => { %>
                <% const isTemple = String(s.delivery_mode || '') === 'temple_pickup'; %>
                <% const isPaid = String(s.payment_status || '').toLowerCase() === 'paid'; %>
                <% const shipmentStatus = String(s.status || 'pending').toLowerCase(); %>
                <% const isHome = String(s.delivery_mode || '') === 'home_delivery'; %>
                <% const canHandOver = isPaid && (isTemple || isHome) && shipmentStatus === 'pending'; %>

                <tr>
                  <td>
                    <div style="font-weight:900"><%= s.shipment_id || s.id || '-' %></div>
                    <div class="muted small">Order: <%= s.order_id || '-' %> • Payment: <%= s.payment_id || '-' %></div>
                  </td>
                  <td><span class="pill"><%= s.delivery_mode || '-' %></span></td>
                  <td>
                    <div><%= s.books_display || s.regular_books_with_language || s.book_titles || '-' %></div>
                    <% if (s.contest_titles) { %>
                      <div class="muted small"><%= s.contest_titles %></div>
                    <% } %>
                  </td>
                  <td><span class="pill"><%= s.status || 'pending' %></span></td>
                  <td>
                    <div class="mono"><%= s.tracking_id || '-' %></div>
                    <div class="muted small"><%= s.courier_mode || '-' %></div>
                  </td>
                  <td>
                    <% if (canHandOver) { %>
                      <form method="POST" action="/admin/user360/<%= user.id %>/shipments/hand-over">
                        <input type="hidden" name="shipmentId" value="<%= s.shipment_id || s.id %>" />
                        <button class="btn primary" type="submit"><%= isTemple ? '🏛️ Mark Handed Over' : '🚚 Mark Handed Over' %></button>
                      </form>
                    <% } else if (shipmentStatus !== 'pending') { %>
                      <span class="pill" style="background:rgba(34,197,94,.15);color:#4ade80;border:1px solid rgba(34,197,94,.25)">
                        <%= shipmentStatus %>
                      </span>
                    <% } else { %>
                      <span class="muted">-</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>

              <% if (!(shipments || []).length) { %>
                <tr><td colspan="6" class="muted">No shipment records found.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="card">
          <h2 style="margin:0 0 8px 0">Submissions</h2>
          <div class="muted">Latest 200 paid contests. Admin can upload on behalf of customer.</div>

          <table>
            <thead>
              <tr>
                <th>Contest</th>
                <th>File</th>
                <th>Uploaded</th>
                <th>Locked</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% (submissions || []).forEach(s => { %>
                <% const hasSubmission = !!s.id; %>
                <% const locked = !!s.is_locked; %>

                <tr class="admin-submission-row"
                    data-order-id="<%= s.order_id %>"
                    data-has-submission="<%= hasSubmission ? '1' : '0' %>"
                    data-locked="<%= locked ? '1' : '0' %>">
                  <td>
                    <div><%= s.contest_title || '-' %></div>
                    <div class="muted small">Order: <span class="mono"><%= s.order_id %></span></div>
                    <div class="muted small">Attempts: <%= Number(s.attempts_used || 0) %></div>
                  </td>
                  <td><%= s.original_name || '-' %></td>
                  <td><%= s.uploaded_at || s.last_updated_at || '-' %></td>
                  <td><span class="pill"><%= hasSubmission ? (locked ? 'yes' : 'no') : '-' %></span></td>
                  <td>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                      <% if (hasSubmission) { %>
                        <a class="btn ghost" href="/admin/submissions/download?submissionId=<%= s.id %>">Download</a>

                        <form method="POST" action="/admin/submissions/toggle-lock" style="display:inline">
                          <input type="hidden" name="submissionId" value="<%= s.id %>"/>
                          <button class="btn ghost" type="submit"><%= locked ? 'Unlock' : 'Lock' %></button>
                        </form>
                      <% } else { %>
                        <span class="muted">No submission</span>
                      <% } %>

                      <input class="adminUploadInput"
                             type="file"
                             style="display:none"
                             accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png,image/webp"/>

                      <button class="btn primary adminUploadBtn"
                              type="button"
                              <%= locked ? 'disabled' : '' %>>
                        Upload
                      </button>

                      <div class="progressWrap">
                        <progress class="adminUploadProgress" value="0" max="100"></progress>
                      </div>

                      <span class="muted small uploadStatus"></span>
                    </div>
                  </td>
                </tr>
              <% }) %>

              <% if (!(submissions || []).length) { %>
                <tr><td colspan="5" class="muted">No paid contests found.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="card">
          <h2 style="margin:0 0 8px 0">Feedback</h2>
          <table>
            <thead>
              <tr>
                <th>Message</th>
                <th>Status</th>
                <th>Created</th>
                <th>Closed</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% (feedback || []).forEach(f => { %>
                <tr>
                  <td><%= f.message %></td>
                  <td><span class="pill"><%= f.status %></span></td>
                  <td><%= f.created_at %></td>
                  <td><%= f.closed_at || '-' %></td>
                  <td>
                    <% if (String(f.status || '').toLowerCase() !== 'closed') { %>
                      <form method="POST" action="/admin/user360/<%= user.id %>/feedback/close">
                        <input type="hidden" name="id" value="<%= f.id %>" />
                        <button class="btn ghost" type="submit">Close Ticket</button>
                      </form>
                    <% } else { %>
                      <span class="muted">Closed</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>

              <% if (!(feedback || []).length) { %>
                <tr><td colspan="5" class="muted">No feedback found.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>

      </div>
    </main>
  </div>

  <script>
    function toggleAdminMenu() {
      document.body.classList.toggle("menu-open");
    }

    function closeAdminMenu() {
      document.body.classList.remove("menu-open");
    }

    document.addEventListener("keydown", function(e) {
      if (e.key === "Escape") closeAdminMenu();
    });

    (function(){
      const MAX_MB = 5;
      const allowedExt = new Set(['pdf','doc','docx','jpg','jpeg','png','webp']);

      function extOf(name){
        const m = String(name || '').toLowerCase().match(/\.([a-z0-9]+)$/);
        return m ? m[1] : '';
      }

      function setStatus(row, msg, kind){
        const el = row.querySelector('.uploadStatus');
        if (!el) return;
        el.textContent = msg || '';
        el.className = 'muted small uploadStatus' + (kind ? ' ' + kind : '');
      }

      function setProgress(row, value, show){
        const wrap = row.querySelector('.progressWrap');
        const prog = row.querySelector('.adminUploadProgress');
        if (wrap) wrap.style.display = show ? 'block' : 'none';
        if (prog) prog.value = value || 0;
      }

      function validateFile(file){
        if (!file) return { ok:false, msg:'Please choose a file first.' };

        if (file.size > MAX_MB * 1024 * 1024) {
          return { ok:false, msg:`File is too large. Maximum allowed size is ${MAX_MB} MB.` };
        }

        const mime = String(file.type || '').toLowerCase();
        const ext = extOf(file.name);

        const okMime =
          mime === 'application/pdf' ||
          mime === 'application/msword' ||
          mime === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' ||
          mime === 'image/jpeg' ||
          mime === 'image/png' ||
          mime === 'image/webp';

        if (!(okMime || allowedExt.has(ext))) {
          return { ok:false, msg:'Only PDF, DOC, DOCX, JPG, JPEG, PNG, or WEBP files are accepted.' };
        }

        return { ok:true };
      }

      async function uploadFile(row, file){
        const orderId = row.getAttribute('data-order-id');
        const hasSubmission = row.getAttribute('data-has-submission') === '1';

        if (hasSubmission) {
          const ok = confirm('This will replace the current submission. Continue?');
          if (!ok) return;
        }

        setProgress(row, 0, true);
        setStatus(row, 'Starting upload...', 'info');

        const contentType = file.type || 'application/octet-stream';

        const startRes = await fetch('/admin/submissions/upload/start', {
          method: 'POST',
          headers: {'Content-Type':'application/json'},
          body: JSON.stringify({
            orderId,
            fileName: file.name,
            contentType,
            fileSize: file.size
          })
        });

        const start = await startRes.json().catch(() => ({}));
        if (!startRes.ok) throw new Error(start.error || 'Failed to start upload.');
        if (!start.key || !start.userId) throw new Error('Failed to start upload.');

        setProgress(row, 25, true);
        setStatus(row, 'Uploading...', 'info');

        const fd = new FormData();
        fd.append('file', file);
        fd.append('orderId', orderId);
        fd.append('userId', start.userId);
        fd.append('key', start.key);
        fd.append('contentType', contentType);
        fd.append('originalName', file.name);

        const upRes = await fetch('/admin/submissions/upload/fallback', {
          method: 'POST',
          body: fd
        });
        const upJson = await upRes.json().catch(() => ({}));
        if (!upRes.ok) {
          throw new Error(upJson.error || 'Upload failed. Please try again.');
        }

        setProgress(row, 80, true);
        setStatus(row, 'Saving submission...', 'info');

        const completeRes = await fetch('/admin/submissions/upload/complete', {
          method: 'POST',
          headers: {'Content-Type':'application/json'},
          body: JSON.stringify({
            orderId,
            userId: start.userId,
            key: start.key,
            contentType,
            originalName: file.name,
            fileSize: file.size
          })
        });

        const complete = await completeRes.json().catch(() => ({}));
        if (!completeRes.ok) throw new Error(complete.error || 'Failed to save submission.');

        setProgress(row, 100, true);
        setStatus(row, 'Uploaded successfully. Refreshing...', 'ok');
        setTimeout(() => window.location.reload(), 700);
      }

      document.querySelectorAll('.admin-submission-row').forEach(row => {
        const btn = row.querySelector('.adminUploadBtn');
        const input = row.querySelector('.adminUploadInput');

        if (!btn || !input) return;

        btn.addEventListener('click', () => input.click());

        input.addEventListener('change', async () => {
          const file = input.files && input.files[0] ? input.files[0] : null;
          const valid = validateFile(file);

          if (!valid.ok) {
            setStatus(row, valid.msg, 'err');
            return;
          }

          btn.disabled = true;

          try {
            await uploadFile(row, file);
          } catch (e) {
            console.error({
              online: navigator.onLine,
              browser: navigator.userAgent,
              message: e && e.message
            });
            setStatus(row, e.message || 'Upload failed.', 'err');
            setProgress(row, 0, false);
            btn.disabled = false;
          }
        });
      });
    })();
  </script>
</body>
</html>