<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin - Users 360</title>
  <style>
    body{margin:0;font-family:Segoe UI,Tahoma,Verdana,sans-serif;background:#0b1224;color:#fff}
    .layout{display:flex;min-height:100vh}
    .sidebar{width:260px;background:#0a1022;border-right:1px solid rgba(255,255,255,.08);padding:18px}
    .brand{font-weight:900;margin-bottom:18px}
    .nav a{display:block;padding:10px 12px;border-radius:12px;text-decoration:none;color:rgba(255,255,255,.85);margin-bottom:8px}
    .nav a.active{background:rgba(26,60,255,.18);border:1px solid rgba(26,60,255,.35);color:#fff}
    .content{flex:1}
    .wrap{max-width:1100px;margin:26px auto;padding:0 18px}
    .card{background:#111b35;border:1px solid rgba(255,255,255,.12);border-radius:18px;padding:18px}
    input{width:100%;padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,.18);background:#0e1630;color:#fff}
    .row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
    .btn{border:none;border-radius:12px;padding:10px 12px;font-weight:900;cursor:pointer;text-decoration:none;display:inline-block}
    .btn.primary{background:#1a3cff;color:#fff}
    .btn.ghost{background:rgba(255,255,255,.10);color:#fff}
    table{width:100%;border-collapse:collapse;margin-top:14px}
    th,td{padding:10px;border-bottom:1px solid rgba(255,255,255,.10);text-align:left}
    .muted{color:rgba(255,255,255,.7)}
    .pill{display:inline-block;padding:4px 10px;border-radius:999px;background:rgba(255,255,255,.10);font-size:12px}
    @media (max-width: 900px){ .sidebar{display:none} }
  </style>
</head>
<body>
<div class="layout">
  <aside class="sidebar">
    <div class="brand">Admin Panel</div>
    <div class="nav">
      <a href="/admin">Overview</a>
      <a href="/admin/contests">Contests</a>
      <a href="/admin/user360" class="active">View User</a>
      <a href="/admin/orders">Orders</a>
      <a href="/admin/submissions">Submissions</a>
      <a href="/admin/shipments">Shipments</a>
      <a href="/admin/users">Users</a>
      <a href="/admin/feedback">Feedback</a>
      <a href="/admin/payments/reconcile-bulk">Bulk Reconcile</a>
      <a href="/logout" style="margin-top:14px;opacity:.9">Logout</a>
    </div>
  </aside>

  <main class="content">
    <div class="wrap">
      <div class="card">
        <h1 style="margin:0 0 6px 0">Users 360</h1>
        <div class="muted">Search by name / email / phone / address / pincode. Live search can be toggled.</div>

        <div style="height:1px;background:rgba(255,255,255,.12);margin:14px 0"></div>

        <form method="GET" action="/admin/user360">
          <div class="row">
            <div style="flex:1;min-width:260px">
              <input id="q" name="q" value="<%= q %>" placeholder="Start typing..." autocomplete="off"/>
            </div>

            <label class="pill" style="cursor:pointer">
              <input type="checkbox" id="live" style="margin-right:6px" <%= live==='1' ? 'checked' : '' %> />
              Live search
            </label>

            <input type="hidden" id="liveHidden" name="live" value="<%= live %>"/>
            <button class="btn primary" type="submit">Search</button>
            <a class="btn ghost" href="/admin/user360">Reset</a>
          </div>
        </form>

        <div id="liveHint" class="muted" style="margin-top:10px;display:<%= live==='1' ? 'block' : 'none' %>;">
          Live search enabled (debounced). If server becomes slow later, turn it off.
        </div>

        <table id="tbl">
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Role</th>
              <th>Open</th>
            </tr>
          </thead>
          <tbody id="tbody">
            <% (users || []).forEach(u => { %>
              <tr>
                <td><%= u.name %></td>
                <td><%= u.email %></td>
                <td><%= u.phone || '-' %></td>
                <td><span class="pill"><%= u.role || 'user' %></span></td>
                <td><a class="btn ghost" href="/admin/user360/<%= u.id %>">View</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>

      </div>
    </div>
  </main>
</div>

<script>
(function(){
  const live = document.getElementById("live");
  const liveHidden = document.getElementById("liveHidden");
  const q = document.getElementById("q");
  const tbody = document.getElementById("tbody");
  const liveHint = document.getElementById("liveHint");

  live.addEventListener("change", () => {
    liveHidden.value = live.checked ? "1" : "0";
    liveHint.style.display = live.checked ? "block" : "none";
  });

  let t = null;
  async function doSearch(val){
    const v = (val || "").trim();
    if (!live.checked) return;
    if (v.length < 2){
      tbody.innerHTML = "";
      return;
    }
    const resp = await fetch("/admin/user360/search?q=" + encodeURIComponent(v), { headers: { "Accept": "application/json" } });
    const data = await resp.json();
    const items = data.items || [];
    tbody.innerHTML = items.map(u => `
      <tr>
        <td>${u.name || ""}</td>
        <td>${u.email || ""}</td>
        <td>${u.phone || "-"}</td>
        <td><span class="pill">${u.role || "user"}</span></td>
        <td><a class="btn ghost" href="/admin/user360/${u.id}">View</a></td>
      </tr>
    `).join("");
  }

  q.addEventListener("input", (e) => {
    if (!live.checked) return;
    clearTimeout(t);
    t = setTimeout(() => doSearch(e.target.value), 350);
  });
})();
</script>
</body>
</html>
