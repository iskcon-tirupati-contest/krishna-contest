<%- include('partials/admin-shell-start', {
  title: 'User 360',
  mobileTitle: 'User 360',
  activeTab: 'user360'
}) %>

<div class="page-head">
  <div>
    <h1>User 360</h1>
    <div class="sub">Complete profile, orders, shipments, submissions, and feedback.</div>
  </div>

  <div class="page-actions">
    <a class="btn ghost" href="/admin/user360">← Back</a>
  </div>
</div>

<div class="card">
  <form method="POST" action="/admin/user360/<%= user.id %>/update">
    <div class="grid grid-2">
      <div>
        <label>Name</label>
        <input name="name" value="<%= user.name || '' %>" />
      </div>

      <div>
        <label>Email (display only)</label>
        <input value="<%= user.email || '' %>" disabled />
      </div>

      <div>
        <label>Phone</label>
        <input name="phone" value="<%= user.phone || '' %>" />
        <div class="tiny" style="margin-top:6px">Admin override allowed even if phone is locked.</div>
      </div>

      <div>
        <label>Role</label>
        <select name="role">
          <option value="user" <%= (user.role || 'user') === 'user' ? 'selected' : '' %>>user</option>
          <option value="admin" <%= (user.role || 'user') === 'admin' ? 'selected' : '' %>>admin</option>
        </select>
      </div>

      <div>
        <label>Address</label>
        <textarea name="address"><%= user.address || '' %></textarea>
      </div>

      <div>
        <label>City / State / Pincode</label>
        <div class="grid grid-2">
          <input name="city" value="<%= user.city || '' %>" placeholder="City" />
          <input name="state" value="<%= user.state || '' %>" placeholder="State" />
        </div>
        <div style="margin-top:10px">
          <input name="pincode" value="<%= user.pincode || '' %>" placeholder="Pincode" />
        </div>
      </div>
    </div>

    <div class="row" style="margin-top:14px">
      <button class="btn primary" type="submit">Save User</button>
      <span class="pill">User ID: <%= user.id %></span>
      <span class="pill">Created: <%= user.created_at %></span>
    </div>
  </form>
</div>

<div class="card">
  <div class="row" style="justify-content:space-between;margin-bottom:12px">
    <div>
      <div class="strong">Orders</div>
      <div class="tiny">Latest 200</div>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Order</th>
          <th>Contest</th>
          <th>Status</th>
          <th>Amount</th>
          <th>Book</th>
          <th>Created</th>
        </tr>
      </thead>
      <tbody>
        <% (orders || []).forEach(o => { %>
          <tr>
            <td><%= o.id %></td>
            <td><%= o.contest_title %></td>
            <td><span class="pill"><%= o.payment_status %></span></td>
            <td>₹<%= o.amount %></td>
            <td><%= o.book_option %></td>
            <td><%= o.created_at %></td>
          </tr>
        <% }) %>
        <% if (!orders || !orders.length) { %>
          <tr><td colspan="6" class="muted">No orders found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="card">
  <div class="row" style="justify-content:space-between;margin-bottom:12px">
    <div>
      <div class="strong">Shipments</div>
      <div class="tiny">Latest 200 linked by order</div>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Order</th>
          <th>Status</th>
          <th>Tracking</th>
          <th>Courier</th>
          <th>Updated</th>
        </tr>
      </thead>
      <tbody>
        <% (shipments || []).forEach(s => { %>
          <tr>
            <td><%= s.order_id %></td>
            <td><span class="pill"><%= s.status || 'pending' %></span></td>
            <td><%= s.tracking_id || '-' %></td>
            <td><%= s.courier_mode || '-' %></td>
            <td><%= s.updated_at || '-' %></td>
          </tr>
        <% }) %>
        <% if (!shipments || !shipments.length) { %>
          <tr><td colspan="5" class="muted">No shipments found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="card">
  <div class="row" style="justify-content:space-between;margin-bottom:12px">
    <div>
      <div class="strong">Submissions</div>
      <div class="tiny">Latest 200. Download appends UUID + contest title.</div>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Contest</th>
          <th>File</th>
          <th>Uploaded</th>
          <th>Locked</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% (submissions || []).forEach(s => { %>
          <tr>
            <td><%= s.contest_title %></td>
            <td><%= s.original_name %></td>
            <td><%= s.uploaded_at %></td>
            <td><span class="pill"><%= s.is_locked ? 'yes' : 'no' %></span></td>
            <td>
              <div class="row mobile-stack">
                <a class="btn ghost" href="/admin/submissions/download?submissionId=<%= s.id %>">Download</a>
                <form method="POST" action="/admin/submissions/toggle-lock" style="display:inline">
                  <input type="hidden" name="submissionId" value="<%= s.id %>" />
                  <button class="btn ghost" type="submit"><%= s.is_locked ? 'Unlock' : 'Lock' %></button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
        <% if (!submissions || !submissions.length) { %>
          <tr><td colspan="5" class="muted">No submissions found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <div class="tiny" style="margin-top:12px">
    Admin upload-on-behalf can be added later in this same section.
  </div>
</div>

<div class="card">
  <div class="row" style="justify-content:space-between;margin-bottom:12px">
    <div>
      <div class="strong">Feedback</div>
      <div class="tiny">Recent feedback raised by this user</div>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Message</th>
          <th>Status</th>
          <th>Created</th>
          <th>Closed</th>
        </tr>
      </thead>
      <tbody>
        <% (feedback || []).forEach(f => { %>
          <tr>
            <td><%= f.message %></td>
            <td><span class="pill"><%= f.status %></span></td>
            <td><%= f.created_at %></td>
            <td><%= f.closed_at || '-' %></td>
          </tr>
        <% }) %>
        <% if (!feedback || !feedback.length) { %>
          <tr><td colspan="4" class="muted">No feedback found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-shell-end') %>