<%- include('partials/admin-shell-start', {
  title: 'Users',
  mobileTitle: 'Users',
  activeTab: 'users'
}) %>

<div class="page-head">
  <div>
    <h1>Users</h1>
    <div class="sub">Search users and update admin roles.</div>
  </div>

  <div class="page-actions">
    <a class="btn ghost" href="/admin/users">Reset</a>
    <a class="btn ghost" href="/admin/users/export.csv?<%= qs %>">Export CSV</a>
  </div>
</div>

<div class="card">
  <form method="GET" action="/admin/users" class="row mobile-stack">
    <div style="flex:1;min-width:260px">
      <label for="q">Search</label>
      <input
        id="q"
        name="q"
        value="<%= q || '' %>"
        placeholder="Search name / email / phone"
      />
    </div>
    <div style="display:flex;align-items:end">
      <button class="btn primary" type="submit">Search</button>
    </div>
  </form>
</div>

<div class="card">
  <div class="row" style="justify-content:space-between;margin-bottom:12px">
    <div>
      <div class="strong">Users List</div>
      <div class="tiny">Desktop table with mobile scrolling support</div>
    </div>
    <span class="pill"><%= (users || []).length %> result(s)</span>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>User</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Role</th>
          <th>Created</th>
          <th>Update Role</th>
        </tr>
      </thead>
      <tbody>
        <% (users || []).forEach(u => { %>
          <tr>
            <td>
              <div class="strong"><%= u.name || '-' %></div>
              <div class="tiny">UUID: <%= u.id %></div>
            </td>
            <td><%= u.email || '-' %></td>
            <td><%= u.phone || '-' %></td>
            <td>
              <span class="pill"><%= u.role || 'user' %></span>
            </td>
            <td class="tiny"><%= u.created_at %></td>
            <td>
              <form method="POST" action="/admin/users/role" class="row mobile-stack" style="gap:8px">
                <input type="hidden" name="userId" value="<%= u.id %>" />
                <div style="min-width:150px;flex:1">
                  <select name="role">
                    <option value="user" <%= (u.role || 'user') === 'user' ? 'selected' : '' %>>user</option>
                    <option value="admin" <%= (u.role || '') === 'admin' ? 'selected' : '' %>>admin</option>
                  </select>
                </div>
                <button class="btn ghost" type="submit">Save</button>
              </form>
            </td>
          </tr>
        <% }) %>

        <% if (!users || !users.length) { %>
          <tr>
            <td colspan="6" class="muted">No users found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-shell-end') %>