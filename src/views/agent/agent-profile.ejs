<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Agent Profile – Iskcon Tirupati Essay Contest</title>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{--navy:#1a237e;--navy3:#3949ab;--green:#10b981;--greenLt:#d1fae5;--greenD:#065f46;--red:#ef4444;--redLt:#fee2e2;--redD:#991b1b;--bg:#eef1fb;--card:#fff;--border:#dbe3f6;--text:#1e293b;--muted:#64748b;--shadow:0 8px 28px rgba(26,35,126,.12)}
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text)}
    a{text-decoration:none;color:inherit}
    .app{max-width:560px;margin:0 auto;min-height:100vh;padding-bottom:36px}
    .topbar{background:linear-gradient(135deg,#1a237e 0%,#283593 55%,#3949ab 100%);color:#fff;padding:16px;border-radius:0 0 22px 22px;box-shadow:0 8px 22px rgba(26,35,126,.22)}
    .topbar h1{font-family:'Sora',sans-serif;font-size:20px;font-weight:800}
    .topbar p{margin-top:6px;font-size:13px;color:rgba(255,255,255,.9)}
    .wrap{padding:16px}
    .card{background:var(--card);border:1.5px solid var(--border);border-radius:22px;box-shadow:var(--shadow);overflow:hidden;margin-bottom:16px}
    .section{padding:16px;border-bottom:1px solid #edf1fb}
    .section:last-child{border-bottom:none}
    .section h2{font-family:'Sora',sans-serif;font-size:15px;font-weight:800;margin-bottom:6px;color:#0f172a}
    .sub{font-size:13px;color:var(--muted);line-height:1.6;margin-bottom:14px}
    .alert{padding:12px 14px;border-radius:12px;font-size:13px;font-weight:700;margin-bottom:12px}
    .alert.err{background:var(--redLt);border:1px solid #fecaca;color:var(--redD)}
    .alert.ok{background:var(--greenLt);border:1px solid #a7f3d0;color:var(--greenD)}
    label{display:block;font-size:12px;font-weight:800;color:#475569;margin-bottom:6px}
    input{width:100%;padding:12px 13px;border:1.5px solid #d6def2;border-radius:12px;background:#fff;font-size:14px;outline:none}
    input[readonly]{background:#f8fafc;color:#64748b}
    input:focus{border-color:#5c6bc0;box-shadow:0 0 0 3px rgba(92,107,192,.14)}
    .field{margin-bottom:14px}
    .btn{display:inline-flex;align-items:center;justify-content:center;width:100%;border:none;border-radius:12px;padding:12px 14px;font-family:'Sora',sans-serif;font-size:13px;font-weight:800;cursor:pointer}
    .btn-primary{background:linear-gradient(135deg,#1a237e,#3949ab);color:#fff}
    .btn-gold{background:linear-gradient(135deg,#d97706,#f59e0b);color:#fff}
    .miniLink{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:700;color:#1a237e;margin-top:10px}
    .hint{font-size:12px;color:var(--muted);line-height:1.6;margin-top:6px}
  </style>
</head>
<body>
  <div class="app">
    <div class="topbar">
      <h1>Agent Profile</h1>
      <p>Manage your basic profile and reset your password.</p>
    </div>

    <div class="wrap">
      <div class="card">
        <div class="section">
          <h2>Profile Details</h2>
          <p class="sub">Only name is editable here. Mobile number stays locked.</p>

          <% if (error) { %><div class="alert err"><%= error %></div><% } %>
          <% if (success) { %><div class="alert ok"><%= success %></div><% } %>

          <form method="post" action="/agent/profile">
            <div class="field">
              <label for="name">Agent Name</label>
              <input id="name" name="name" type="text" value="<%= me?.name || '' %>" required />
            </div>

            <div class="field">
              <label for="phone">Mobile Number</label>
              <input id="phone" type="text" value="<%= me?.phone || '' %>" readonly />
              <div class="hint">This mobile number is locked and used for login identification.</div>
            </div>

            <button type="submit" class="btn btn-primary">Save Profile</button>
          </form>
        </div>

        <div class="section">
          <h2>Reset Password</h2>
          <p class="sub">Use this only if you want to change your current agent login password.</p>

          <% if (pwError) { %><div class="alert err"><%= pwError %></div><% } %>
          <% if (pwSuccess) { %><div class="alert ok"><%= pwSuccess %></div><% } %>

          <form method="post" action="/agent/profile/reset-password">
            <div class="field">
              <label for="newPassword">New Password</label>
              <input id="newPassword" name="newPassword" type="password" minlength="6" required />
            </div>

            <div class="field">
              <label for="confirmPassword">Confirm Password</label>
              <input id="confirmPassword" name="confirmPassword" type="password" minlength="6" required />
            </div>

            <button type="submit" class="btn btn-gold">Reset Password</button>
          </form>
        </div>

        <div class="section">
          <a class="miniLink" href="/agent">← Back to Dashboard</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>