<!DOCTYPE html><html lang="en"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Edit Booking Details – Agent Portal</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#1a237e;--navy2:#283593;--navy3:#3949ab;--glt2:#d1fae5;--gdk2:#065f46;
    --rlt:#fee2e2;--rdk:#991b1b;--bg:#eef1fb;--sf:#fff;--bd:#c5cae9;--bdl:#e8eaf6;
    --th:#0f172a;--tb:#1e293b;--tm:#334155;--mu:#64748b;--sh:0 2px 12px rgba(26,35,126,.08);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:'DM Sans',system-ui,sans-serif;background:var(--bg);color:var(--tb);padding-bottom:20px}
  a{text-decoration:none;color:inherit}
  .topbar{background:linear-gradient(135deg,#1a237e 0%,#283593 55%,#3949ab 100%);border-radius:0 0 24px 24px;padding:16px 16px 20px;margin-bottom:16px;box-shadow:0 4px 20px rgba(26,35,126,.25)}
  .tb-inner{display:flex;justify-content:space-between;align-items:center;gap:10px}
  .tb-brand{display:flex;align-items:center;gap:10px;min-width:0;flex:1}
  .tb-logo{width:42px;height:42px;border-radius:12px;background:rgba(255,255,255,.15);border:1.5px solid rgba(255,215,0,.3);overflow:hidden;display:flex;align-items:center;justify-content:center}
  .tb-logo img{width:100%;height:100%;object-fit:contain}
  .tb-title{font-family:'Sora',sans-serif;font-size:clamp(14px,4vw,18px);font-weight:800;color:#fff;line-height:1.2}
  .tb-sub{font-size:12px;color:rgba(255,255,255,.72);margin-top:2px}
  .wrap{max-width:560px;margin:0 auto;padding:0 14px 20px}
  .fcard{background:var(--sf);border:1.5px solid var(--bdl);border-radius:18px;box-shadow:var(--sh);margin-bottom:14px;overflow:hidden}
  .fcard-head{padding:13px 16px;background:linear-gradient(135deg,#f8faff,#fff);border-bottom:1.5px solid var(--bdl);display:flex;align-items:center;gap:10px}
  .fcard-ico{width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,var(--navy),var(--navy3));display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .fcard-ico svg{width:17px;height:17px;fill:#fff}
  .fcard-title{font-family:'Sora',sans-serif;font-size:14px;font-weight:800;color:var(--th)}
  .fcard-sub{font-size:11px;color:var(--mu);margin-top:1px}
  .fcard-body{padding:15px}
  .field{margin-bottom:13px}
  .field:last-child{margin-bottom:0}
  .field label{display:block;font-family:'Sora',sans-serif;font-size:12px;font-weight:700;color:var(--tm);margin-bottom:5px}
  .field input,.field select{width:100%;padding:11px 13px;border:1.5px solid var(--bd);border-radius:11px;font-size:14px;color:var(--tb);background:#f8fafc;outline:none;font-family:'DM Sans',sans-serif}
  .field input[readonly], .field select[disabled]{background:#eef2f7;color:#475569;cursor:not-allowed}
  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:11px}
  @media(max-width:420px){.field-row{grid-template-columns:1fr}}
  .rcards{display:flex;gap:9px;margin-top:4px}
  .rcard{flex:1;display:flex;align-items:center;gap:10px;padding:12px 13px;border:1.5px solid var(--bd);border-radius:13px;background:#fff;font-family:'Sora',sans-serif;font-size:13px;font-weight:700;color:var(--tm)}
  .rcard input[type=radio]{accent-color:var(--navy);width:16px;height:16px;flex-shrink:0}
  .alert-err{background:var(--rlt);border:1.5px solid #fecaca;color:var(--rdk);padding:11px 13px;border-radius:12px;margin-bottom:13px;font-size:13px;font-weight:600;display:flex;gap:8px;line-height:1.6}
  .alert-ok{background:var(--glt2);border:1.5px solid #a7f3d0;color:var(--gdk2);padding:11px 13px;border-radius:12px;margin-bottom:13px;font-size:13px;font-weight:600;display:flex;gap:8px}
  .locked-note{background:#fff7ed;border:1.5px solid #fdba74;color:#9a3412;padding:11px 13px;border-radius:12px;margin-bottom:13px;font-size:13px;font-weight:600;line-height:1.6}
  .co-row-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
  .co-row-name{font-family:'Sora',sans-serif;font-size:13px;font-weight:800;color:var(--navy);flex:1;padding-right:8px;line-height:1.3}
  .co-row-amt{font-family:'Sora',sans-serif;font-size:14px;font-weight:800;color:#92400e;flex-shrink:0}
  .co-row-fields{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
  @media(max-width:480px){.co-row-fields{grid-template-columns:1fr}}
  .co-row-fields .field{margin-bottom:0}
  .co-row-fields .field input,.co-row-fields .field select{padding:9px 10px;font-size:13px}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:12px 18px;border-radius:13px;font-family:'Sora',sans-serif;font-size:13px;font-weight:800;cursor:pointer;border:none;text-decoration:none;line-height:1;text-align:center}
  .btn svg{width:15px;height:15px;fill:currentColor;flex-shrink:0}
  .btn-navy{background:linear-gradient(135deg,var(--navy),var(--navy3));color:#fff}
  .btn-gold{background:linear-gradient(135deg,#d97706,#f59e0b);color:#fff}
  .btn-ghost{background:var(--sf);color:var(--tm);border:1.5px solid var(--bd);box-shadow:var(--sh)}
  @keyframes spin{to{transform:rotate(360deg)}}
</style>
</head><body>
<% const isHomeDelivery = String(booking.delivery_mode || '') === 'home_delivery'; %>

<div class="topbar">
  <div class="tb-inner">
    <div class="tb-brand">
      <div class="tb-logo"><img src="/images/logo_new.png" onerror="this.style.display='none'" alt="logo"></div>
      <div>
        <div class="tb-title">Edit Booking</div>
        <div class="tb-sub">Ref: <%= booking.payment_id||'-' %> · <span style="font-size:11px;background:rgba(255,255,255,.15);padding:2px 8px;border-radius:6px"><%= booking.status||'-' %></span></div>
      </div>
    </div>
  </div>
</div>

<div class="wrap">
  <% if(err){ %><div class="alert-err"><span>⚠️</span><%= err %></div><% } %>
  <% if(ok){ %><div class="alert-ok"><span>✅</span>Saved successfully.</div><% } %>

  <% if(isHomeDelivery){ %>
    <div class="locked-note">
      ⚠️ This is a home delivery booking. Agents can change only the age category here.
      To change address, phone, delivery mode, or book details, please contact admin.
    </div>
  <% } %>

  <form method="POST" action="/agent/bookings/<%= booking.id %>/edit-details" id="editForm">
    <input type="hidden" name="from" value="<%= from||'history' %>">

    <div class="fcard">
      <div class="fcard-head">
        <div class="fcard-ico"><svg viewBox="0 0 24 24"><path d="M12 12c2.7 0 5-2.3 5-5s-2.3-5-5-5-5 2.3-5 5 2.3 5 5 5zm0 2c-3.3 0-10 1.7-10 5v3h20v-3c0-3.3-6.7-5-10-5z"/></svg></div>
        <div><div class="fcard-title">Participant & Delivery</div></div>
      </div>
      <div class="fcard-body">
        <div class="field-row">
          <div class="field">
            <label>Receiver Name</label>
            <input name="fullName" value="<%= booking.full_name||booking.customer_name||'' %>" <%= isHomeDelivery ? 'readonly' : 'required' %> />
          </div>
          <div class="field">
            <label>Receiver Phone</label>
            <input name="phone" value="<%= booking.phone||booking.customer_phone||'' %>" <%= isHomeDelivery ? 'readonly' : 'required' %> />
          </div>
        </div>

        <% if(!isHomeDelivery){ %>
          <div class="field">
            <label>Delivery Mode</label>
            <div class="rcards">
              <label class="rcard">
                <input type="radio" name="deliveryMode" value="handover" <%= String(booking.delivery_mode||'handover')==='handover'?'checked':'' %>>
                <span>🤝</span> Direct Delivery
              </label>
              <label class="rcard">
                <input type="radio" name="deliveryMode" value="donate" <%= String(booking.delivery_mode||'')==='donate'?'checked':'' %>>
                <span>🛕</span> Donate to Temple
              </label>
            </div>
          </div>
        <% } else { %>
          <div class="field">
            <label>Delivery Mode</label>
            <input value="Home Delivery" readonly />
          </div>
        <% } %>
      </div>
    </div>

    <div class="fcard">
      <div class="fcard-head">
        <div class="fcard-ico"><svg viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-2 .9-2 2v16h16V8l-6-6z"/></svg></div>
        <div><div class="fcard-title">Contest Details</div><div class="fcard-sub"><%= isHomeDelivery ? 'Only age category can be changed for home delivery.' : 'Swipe to see all contests →' %></div></div>
      </div>
      <div style="overflow-x:auto;padding:14px">
        <div style="display:flex;gap:12px;min-width:max-content">
          <% (orders||[]).forEach(function(o){ %>
            <div data-book-row style="width:260px;border:1.5px solid var(--bdl);border-radius:14px;padding:13px;background:#fafbff;flex-shrink:0">
              <div class="co-row-top">
                <span class="co-row-name"><%= o.contest_title %></span>
                <span class="co-row-amt">₹<%= Number(o.amount||0) %></span>
              </div>
              <div class="co-row-fields">
                <div class="field">
                  <label>Age Category</label>
                  <select name="ageCategory" required>
                    <option value="0-25" <%= String(o.age_category||'')==='0-25'?'selected':'' %>>0–25 years</option>
                    <option value="above-25" <%= String(o.age_category||'')==='above-25'?'selected':'' %>>Above 25 years</option>
                  </select>
                </div>
                <div class="field">
                  <label>Book</label>
                  <select name="bookTitle" class="book-title" <%= isHomeDelivery ? 'disabled' : 'required' %>>
                    <option value="">Select book</option>
                    <% (o.available_books||[]).forEach(function(b){ %>
                      <option value="<%= b %>" <%= String(o.selected_book_title||'')===String(b)?'selected':'' %>><%= b %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="field">
                  <label>Language</label>
                  <select name="bookLanguage" class="book-language" <%= isHomeDelivery ? 'disabled' : 'required' %>>
                    <option value="">Select language</option>
                    <% (o.available_languages||[]).forEach(function(l){ %>
                      <option value="<%= l %>" <%= String(o.saved_book_language||'')===String(l)?'selected':'' %>><%= l %></option>
                    <% }) %>
                  </select>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">
      <% if(String(from||'')==='user-history'){ %>
        <a class="btn btn-ghost" href="/agent/users/<%= booking.customer_user_id %>">← Back</a>
      <% } else if(String(from||'')==='home'){ %>
        <a class="btn btn-ghost" href="/agent">← Back</a>
      <% } else { %>
        <a class="btn btn-ghost" href="/agent/history">← Back</a>
      <% } %>

      <button class="btn btn-navy" type="submit" id="saveBtn">
        <svg viewBox="0 0 24 24"><path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/></svg>
        Save
      </button>

      <a class="btn btn-gold" href="/agent/bookings/<%= booking.id %>/summary" target="_blank">
        <svg viewBox="0 0 24 24"><path d="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/></svg>
        Print
      </a>
    </div>
  </form>
</div>

<script>
  const isHomeDelivery = <%= String(booking.delivery_mode || '') === 'home_delivery' ? 'true' : 'false' %>;
  const bookLanguageMap = <%- JSON.stringify(availableBookLanguages || {}) %>;

  function refillLanguage(bookSelect, langSelect) {
    if (isHomeDelivery) return;

    const selectedBook = (bookSelect.value || '').trim();
    const previousLang = (langSelect.getAttribute('data-current') || '').trim();
    const languages = bookLanguageMap[selectedBook] || [];

    langSelect.innerHTML = '<option value="">Select language</option>';

    languages.forEach(function(lang){
      const opt = document.createElement('option');
      opt.value = lang;
      opt.textContent = lang;
      if (lang === previousLang) opt.selected = true;
      langSelect.appendChild(opt);
    });

    if (!languages.includes(langSelect.value)) {
      langSelect.value = '';
    }
    langSelect.setAttribute('data-current', langSelect.value || '');
  }

  if (!isHomeDelivery) {
    document.querySelectorAll('[data-book-row]').forEach(function(row){
      const bookSelect = row.querySelector('.book-title');
      const langSelect = row.querySelector('.book-language');
      if (!bookSelect || !langSelect) return;

      langSelect.setAttribute('data-current', langSelect.value || '');
      refillLanguage(bookSelect, langSelect);

      bookSelect.addEventListener('change', function(){
        langSelect.setAttribute('data-current', '');
        refillLanguage(bookSelect, langSelect);
      });

      langSelect.addEventListener('change', function(){
        langSelect.setAttribute('data-current', langSelect.value || '');
      });
    });
  }

  document.getElementById('editForm')?.addEventListener('submit',function(e){
    if (!isHomeDelivery) {
      const deliveryMode = document.querySelector('input[name="deliveryMode"]:checked')?.value;
      if (deliveryMode !== 'donate') {
        let firstInvalid = null;
        document.querySelectorAll('[data-book-row]').forEach(function(row){
          const bookSelect = row.querySelector('.book-title');
          const langSelect = row.querySelector('.book-language');
          if (!bookSelect || !langSelect) return;

          if (!String(bookSelect.value || '').trim()) {
            firstInvalid = firstInvalid || bookSelect;
            return;
          }
          if (!String(langSelect.value || '').trim()) {
            firstInvalid = firstInvalid || langSelect;
            return;
          }
        });

        if (firstInvalid) {
          e.preventDefault();
          alert('Please select book and language for every contest row.');
          firstInvalid.focus();
          return;
        }
      }
    }

    const b=document.getElementById('saveBtn');
    b.disabled=true;
    b.style.opacity='.6';
    b.innerHTML='<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" style="animation:spin 1s linear infinite"><path d="M12 4V2A10 10 0 0 0 2 12h2a8 8 0 0 1 8-8z"/></svg> Saving…';
  });
</script>
</body></html>
