<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Booking Receipt – Iskcon Tirupati Essay Contest</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
<style>
  :root{--navy:#1a237e;--navy3:#3949ab;--gold:#f59e0b;--green:#10b981;--glt:#d1fae5;--gdk:#065f46;--bg:#eef1fb;--bd:#e5e7eb}
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:'DM Sans',system-ui,sans-serif;background:var(--bg);color:#0f172a;-webkit-font-smoothing:antialiased}
  a{text-decoration:none;color:inherit}

  .abar{background:linear-gradient(135deg,#1a237e,#3949ab);padding:14px 16px;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
  .abar-title{font-family:'Sora',sans-serif;font-size:15px;font-weight:800;color:#fff;display:flex;align-items:center;gap:7px}
  .abar-btns{display:flex;gap:8px}
  .btn-print{background:linear-gradient(135deg,#d97706,#f59e0b);color:#fff;border:none;border-radius:11px;padding:10px 18px;font-family:'Sora',sans-serif;font-size:13px;font-weight:800;cursor:pointer;display:flex;align-items:center;gap:6px;transition:transform .14s}
  .btn-print:hover{transform:scale(1.03)}
  .btn-print svg{width:15px;height:15px;fill:currentColor}
  .btn-dash{background:rgba(255,255,255,.15);color:#fff;border:1.5px solid rgba(255,255,255,.25);border-radius:11px;padding:10px 16px;font-family:'Sora',sans-serif;font-size:13px;font-weight:700}

  .receipt{max-width:680px;margin:0 auto;background:#fff;box-shadow:0 8px 32px rgba(26,35,126,.12)}

  .rh{background:linear-gradient(135deg,#1a237e 0%,#283593 55%,#3949ab 100%);padding:20px;position:relative;overflow:hidden}
  .rh::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 85% 20%,rgba(255,255,255,.07),transparent 55%);pointer-events:none}
  .rh::after{content:'';position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.04) 1px,transparent 1px);background-size:20px 20px;pointer-events:none}
  .rh-inner{position:relative;z-index:1;display:flex;align-items:flex-start;gap:14px}
  .rh-logo{width:56px;height:56px;border-radius:13px;background:rgba(255,255,255,.14);border:1.5px solid rgba(255,215,0,.3);overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center}
  .rh-logo img{width:100%;height:100%;object-fit:contain}
  .rh-org{flex:1;min-width:0}
  .rh-org-name{font-family:'Sora',sans-serif;font-size:clamp(14px,3.5vw,18px);font-weight:800;color:#ffd700;line-height:1.2;margin-bottom:3px}
  .rh-org-sub{font-size:11px;color:rgba(255,255,255,.75);line-height:1.5}
  .rh-org-addr{font-size:11px;color:rgba(255,255,255,.6);margin-top:4px;line-height:1.6}
  .rh-right{display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex-shrink:0}
  .rh-badge{display:inline-flex;align-items:center;gap:5px;background:rgba(16,185,129,.22);border:1.5px solid rgba(16,185,129,.4);border-radius:999px;padding:5px 13px;font-family:'Sora',sans-serif;font-size:12px;font-weight:800;color:#6ee7b7;white-space:nowrap}
  .rh-badge::before{content:'';width:6px;height:6px;border-radius:50%;background:#10b981}
  .rh-ref{font-size:11px;color:rgba(255,255,255,.6);text-align:right}

  .rb{padding:18px}

  .sec{border:1.5px solid var(--bd);border-radius:16px;padding:15px;margin-bottom:13px}
  .sec-title{font-family:'Sora',sans-serif;font-size:13px;font-weight:800;color:var(--navy);margin-bottom:11px;padding-bottom:8px;border-bottom:1px solid #f0f4ff;display:flex;align-items:center;gap:6px}
  .ir{display:flex;gap:8px;padding:6px 0;border-bottom:1px solid #f8fafc;font-size:13px;align-items:flex-start}
  .ir:last-child{border-bottom:none}
  .il{color:#64748b;font-weight:600;min-width:125px;flex-shrink:0;font-size:12px}
  .iv{color:#0f172a;font-weight:700;word-break:break-word}

  .cred-sec{background:linear-gradient(135deg,#eff6ff,#fff);border:2px solid #93c5fd;border-radius:16px;padding:15px;margin-bottom:13px}
  .cred-title{font-family:'Sora',sans-serif;font-size:13px;font-weight:800;color:#1e3a8a;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid #bfdbfe;display:flex;align-items:center;gap:6px}
  .cred-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}
  .cred-box{background:#fff;border:1.5px solid #93c5fd;border-radius:12px;padding:12px;text-align:center}
  .cred-label{font-size:10px;font-weight:700;color:#1e3a8a;text-transform:uppercase;letter-spacing:.5px;margin-bottom:5px}
  .cred-val{font-family:'Sora',sans-serif;font-size:17px;font-weight:800;color:#1d4ed8;letter-spacing:.5px;word-break:break-all}
  .cred-url{background:#dbeafe;border-radius:9px;padding:9px 12px;font-size:12px;color:#1e3a8a;display:flex;align-items:center;gap:6px}
  .cred-url svg{width:14px;height:14px;fill:#1d4ed8;flex-shrink:0}
  .cred-url a{color:#1d4ed8;font-weight:700;word-break:break-all}

  .ctable{width:100%;border-collapse:collapse}
  .ctable th{text-align:left;padding:7px 10px;font-family:'Sora',sans-serif;font-size:10px;font-weight:800;color:#64748b;text-transform:uppercase;letter-spacing:.4px;background:#f8fafc;border-bottom:1px solid var(--bd)}
  .ctable td{padding:9px 10px;border-bottom:1px solid #f5f7ff;font-size:13px;vertical-align:top}
  .ctable tr:last-child td{border-bottom:none}
  .ctable .total-row td{font-family:'Sora',sans-serif;font-weight:800;background:#f8faff;border-top:2px solid var(--bd);font-size:14px}
  .amt{text-align:right;font-family:'Sora',sans-serif;font-weight:800}
  .cname{font-family:'Sora',sans-serif;font-weight:700;color:#0f172a}

  .support{background:linear-gradient(135deg,#fffbeb,#fef9ec);border:1.5px solid #fde68a;border-radius:14px;padding:14px;margin-bottom:13px;display:flex;gap:11px;align-items:flex-start}
  .support-icon{font-size:26px;flex-shrink:0}
  .support-text{font-size:12px;color:#78350f;line-height:1.7}
  .support-text strong{color:#92400e;font-family:'Sora',sans-serif}

  .rfooter{background:#f8fafc;border-top:1.5px solid var(--bd);padding:13px;text-align:center;font-size:11px;color:#94a3b8;line-height:1.7}
  .rfooter strong{color:#64748b}

  /* WhatsApp share button */
  .wa-share{background:#25d366;border-radius:14px;padding:14px 16px;display:flex;align-items:center;gap:10px;margin-bottom:10px;cursor:pointer;border:none;width:100%;text-align:left;transition:transform .14s,box-shadow .14s}
  .wa-share:hover{transform:translateY(-1px);box-shadow:0 6px 18px rgba(37,211,102,.35)}
  .wa-share:active{transform:scale(.98)}
  .wa-share-icon{width:40px;height:40px;background:rgba(255,255,255,.2);border-radius:11px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .wa-share-icon svg{width:22px;height:22px;fill:#fff}
  .wa-share-text{flex:1}
  .wa-share-title{font-family:'Sora',sans-serif;font-size:14px;font-weight:800;color:#fff}
  .wa-share-sub{font-size:12px;color:rgba(255,255,255,.82)}

  /* Native share button */
  .native-share{background:linear-gradient(135deg,#334155,#475569);border-radius:14px;padding:14px 16px;display:flex;align-items:center;gap:10px;margin-bottom:10px;cursor:pointer;border:none;width:100%;text-align:left;transition:transform .14s,box-shadow .14s}
  .native-share:hover{transform:translateY(-1px);box-shadow:0 6px 18px rgba(0,0,0,.2)}
  .native-share:active{transform:scale(.98)}
  .native-share-icon{width:40px;height:40px;background:rgba(255,255,255,.15);border-radius:11px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .native-share-icon svg{width:22px;height:22px;fill:#fff}
  .native-share-title{font-family:'Sora',sans-serif;font-size:14px;font-weight:800;color:#fff}
  .native-share-sub{font-size:12px;color:rgba(255,255,255,.75)}

  .bottom-bar{padding:0 18px 18px}
  .dash-btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:15px;border-radius:14px;background:linear-gradient(135deg,#1a237e,#3949ab);color:#fff;font-family:'Sora',sans-serif;font-size:15px;font-weight:800;border:none;cursor:pointer;box-shadow:0 6px 20px rgba(26,35,126,.28);transition:transform .14s}
  .dash-btn:hover{transform:translateY(-1px)}
  .dash-btn svg{width:18px;height:18px;fill:#fff}

  @media print{
    body{background:#fff}
    .abar{display:none!important}
    .wa-section{display:none!important}
    .bottom-bar{display:none!important}
    .receipt{box-shadow:none}
    .rh{-webkit-print-color-adjust:exact;print-color-adjust:exact}
    .cred-sec{-webkit-print-color-adjust:exact;print-color-adjust:exact}
    .sec{break-inside:avoid}
  }
</style>
</head>
<body>

<div class="abar">
  <div class="abar-title">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M14 2H6c-1.1 0-2 .9-2 2v16h16V8l-6-6z"/></svg>
    Booking Receipt
  </div>
  <div class="abar-btns">
    <button class="btn-print" onclick="window.print()">
      <svg viewBox="0 0 24 24"><path d="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/></svg>
      Print / PDF
    </button>
    <a class="btn-dash" href="/agent">← Dashboard</a>
  </div>
</div>

<div class="receipt">

  <!-- HEADER: logo | org | status -->
  <div class="rh">
    <div class="rh-inner">
      <div class="rh-logo"><img src="/images/logo_new.png" alt="ISKCON" onerror="this.style.display='none'"></div>
      <div class="rh-org">
        <div class="rh-org-name">Iskcon Tirupati Essay Writing Contest 2026</div>
        <div class="rh-org-sub">ISKCON, Tirupati · Andhra Pradesh, India</div>
        <div class="rh-org-addr">+91-9493805059 · iskconcontest.org</div>
      </div>
      <div class="rh-right">
        <div class="rh-badge"><%= booking.status==='paid'?'PAID':'CONFIRMED' %></div>
        <div class="rh-ref">Ref: <%= booking.payment_id||'-' %></div>
      </div>
    </div>
  </div>

  <div class="rb">

    <!-- 1. LOGIN CREDENTIALS FIRST -->
    <% if(portalCredentials){ %>
    <div class="cred-sec">
      <div class="cred-title">🔑 Website Login Details</div>
      <div class="cred-grid">
        <div class="cred-box">
          <div class="cred-label">Login Mobile</div>
          <div class="cred-val"><%= portalCredentials.phone||'-' %></div>
        </div>
        <div class="cred-box">
          <div class="cred-label">Password</div>
          <div class="cred-val"><%= portalCredentials.password||'-' %></div>
        </div>
      </div>
      <div style="margin-top:12px;border-radius:13px;background:linear-gradient(135deg,#fff7ed,#fff9f0);border:1.5px solid #fb923c;overflow:hidden">
        <div style="background:linear-gradient(135deg,#ea580c,#f97316);padding:7px 13px;display:flex;align-items:center;gap:7px">
          <span style="font-size:14px">⚠️</span>
          <span style="font-family:'Sora',sans-serif;font-size:11px;font-weight:800;color:#fff;letter-spacing:.4px;text-transform:uppercase">Important Instructions</span>
        </div>
        <div style="padding:11px 13px;display:flex;flex-direction:column;gap:7px">
          <div style="display:flex;align-items:flex-start;gap:8px;font-size:12px;color:#7c2d12;line-height:1.55">
            <span style="background:#ea580c;color:#fff;border-radius:50%;width:18px;height:18px;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;flex-shrink:0;margin-top:1px">1</span>
            <span>Please reset the password immediately using the <strong style="color:#9a3412">Forgot Password</strong> option.</span>
          </div>
          <div style="display:flex;align-items:flex-start;gap:8px;font-size:12px;color:#7c2d12;line-height:1.55">
            <span style="background:#ea580c;color:#fff;border-radius:50%;width:18px;height:18px;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;flex-shrink:0;margin-top:1px">2</span>
            <span>You may submit your essay in <strong style="color:#9a3412">any language you wish</strong>.</span>
          </div>
          <div style="display:flex;align-items:flex-start;gap:8px;font-size:12px;color:#7c2d12;line-height:1.55">
            <span style="background:#ea580c;color:#fff;border-radius:50%;width:18px;height:18px;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;flex-shrink:0;margin-top:1px">3</span>
            <span>Upload your essay before <strong style="color:#9a3412">09 September 2026</strong>. Late submissions will not be accepted.</span>
          </div>
        </div>
      </div>

      <!-- Share buttons — inside login details section -->
      <div style="margin-top:12px;display:flex;flex-direction:column;gap:8px">
        <div style="font-family:'Sora',sans-serif;font-size:11px;font-weight:700;color:#1e3a8a;letter-spacing:.3px;margin-bottom:2px">📲 Send these details to participant</div>
        <button class="wa-share" id="waShareBtn" style="margin-bottom:0">
          <div class="wa-share-icon">
            <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </div>
          <div class="wa-share-text">
            <div class="wa-share-title">Share via WhatsApp</div>
            <div class="wa-share-sub">Send login details to participant's phone</div>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="rgba(255,255,255,.7)"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
        </button>
        <button class="native-share" id="nativeShareBtn" style="margin-bottom:0">
          <div class="native-share-icon">
            <svg viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"/></svg>
          </div>
          <div style="flex:1">
            <div class="native-share-title">Share via...</div>
            <div class="native-share-sub" id="nativeShareSub">SMS, Email, Telegram, Drive and more</div>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="rgba(255,255,255,.6)"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
        </button>
      </div>
      <div class="cred-url">
        <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
        Login at <a href="https://iskconcontest.org/login" target="_blank">https://iskconcontest.org/login</a>
      </div>
    </div>
    <% } %>

    <!-- 2. BOOKING INFO (merged with participant) -->
    <div class="sec">
      <div class="sec-title">📋 Booking Information</div>
      <div class="ir"><span class="il">Participant Name</span><span class="iv"><%= booking.full_name||booking.customer_name||'-' %></span></div>
      <div class="ir"><span class="il">Mobile Number</span><span class="iv"><%= booking.phone||booking.customer_phone||'-' %></span></div>
      <div class="ir"><span class="il">Booking Reference</span><span class="iv" style="font-family:'Sora',sans-serif;color:var(--navy)"><%= booking.payment_id||'-' %></span></div>

      <div class="ir"><span class="il">Booking Date</span><span class="iv"><%= bookingCreatedAtIst || '-' %></span></div>
      <div class="ir"><span class="il">Payment Method</span><span class="iv" style="text-transform:capitalize"><%= booking.payment_method||'-' %></span></div>
      <div class="ir"><span class="il">Delivery Mode</span><span class="iv" style="text-transform:capitalize"><%= booking.delivery_mode||'-' %></span></div>
      <div class="ir"><span class="il">Status</span><span class="iv"><span style="background:#dcfce7;color:#166534;padding:2px 10px;border-radius:999px;font-size:12px;font-weight:800"><%= booking.status||'-' %></span></span></div>
    </div>

    <!-- 3. REGISTERED CONTESTS -->
    <div class="sec">
      <div class="sec-title">📚 Registered Contests</div>
      <table class="ctable">
        <thead><tr><th>#</th><th>Contest</th><th>Age</th><th>Book / Language</th><th style="text-align:right">Amount</th></tr></thead>
        <tbody>
          <% var grand=0; %>
          <% (orders||[]).forEach(function(o,i){ grand+=Number(o.unit_amount||0); %>
          <tr>
            <td style="color:#94a3b8;font-size:12px"><%= i+1 %></td>
            <td><span class="cname"><%= o.contest_title||'-' %></span></td>
            <td style="font-size:12px;white-space:nowrap"><%= o.age_category==='above-25'?'Above 25':'0-25 yrs' %></td>
            <td style="font-size:12px;line-height:1.5">
              <div style="font-weight:700;word-break:break-word;overflow-wrap:anywhere"><%= o.book_title||o.default_book_title||'-' %></div>
              <div style="color:#64748b;word-break:break-word;overflow-wrap:anywhere">Language: <%= o.book_language||'-' %></div>
            </td>
            <td class="amt">Rs.<%= Number(o.unit_amount||0) %></td>
          </tr>
          <% }) %>
          <tr class="total-row"><td colspan="4">Total Paid</td><td class="amt" style="color:var(--navy);font-size:16px">Rs.<%= grand.toLocaleString('en-IN') %></td></tr>
        </tbody>
      </table>
    </div>

    <!-- 4. BONUS BOOKS -->
    <% if((bonusItems||[]).length>0){ %>
    <div class="sec">
      <div class="sec-title">🎁 Free Bonus Books</div>
      <% (bonusItems||[]).forEach(function(b){ %>
      <div class="ir"><span class="il"><%= b.book_title||'-' %></span><span class="iv"><%= b.book_language||'-' %> · Qty <%= Number(b.quantity||0) %></span></div>
      <% }) %>
    </div>
    <% } %>

    <!-- 5. SUPPORT -->
    <div class="support">
      <div class="support-icon">💬</div>
      <div class="support-text">
        <strong>Need Help?</strong> Contact ISKCON Tirupati Support<br>
        WhatsApp &amp; Phone: <strong>+91-9493805059</strong><br>
        Email: <strong><a href="mailto:support@iskconcontest.org">support@iskconcontest.org</a></strong><br>
        Hours: Mon-Sat, 9 AM - 6 PM IST
      </div>
    </div>

  </div>

  <!-- FOOTER -->
  <div class="rfooter">
    <strong>Iskcon Tirupati Essay Writing Contest 2026</strong><br>
    Hare Krishna Land, Hare Krishna Road, Vinayaka Nagar, Tirupati - 517501, Andhra Pradesh, India<br>
    Official Booking Receipt · Hare Krishna
  </div>

  <!-- Full-width Dashboard button -->
  <div class="bottom-bar">
    <a class="dash-btn" href="/agent">
      <svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
      Go to Dashboard
    </a>
  </div>

</div>

<script>
(function(){
  var phone       = '<%= (booking.phone||booking.customer_phone||"").replace(/\D/g,"") %>';
  var name        = '<%= (booking.full_name||booking.customer_name||"Participant").replace(/['"]/g,"") %>';
  var ref         = '<%= (booking.payment_id||"").replace(/['"]/g,"") %>';
  var pwd         = '<%= (portalCredentials ? portalCredentials.password : "").replace(/['"]/g,"") %>';
  var loginPhone  = '<%= (portalCredentials ? portalCredentials.phone : "").replace(/['"]/g,"") %>';

  var msgText = 'Hare Krishna ' + name + '!\n\nYour ISKCON Tirupati Essay Writing Contest 2026 registration is confirmed!\n\nBooking Ref: ' + ref + '\n\nLogin Details:\nMobile: ' + loginPhone + '\nPassword: ' + pwd + '\n\nLogin at: https://iskconcontest.org/login\n\nUpload your essay before 09-Sep-2026.\n\nHelp: +91-9493805059\nHare Krishna!';

  // WhatsApp share
  document.getElementById('waShareBtn').addEventListener('click', function(){
    var waPhone = phone.startsWith('91') ? phone : '91' + phone;
    window.open('https://wa.me/' + waPhone + '?text=' + encodeURIComponent(msgText), '_blank');
  });

  // Native share (Web Share API) with clipboard fallback
  var nativeBtn = document.getElementById('nativeShareBtn');
  var nativeSub = document.getElementById('nativeShareSub');

  nativeBtn.addEventListener('click', async function(){
    if (navigator.share) {
      try {
        await navigator.share({
          title: 'ISKCON Contest Booking - ' + ref,
          text: msgText
        });
      } catch(e) {
        // User cancelled or error — silently ignore AbortError
        if (e.name !== 'AbortError') { copyFallback(); }
      }
    } else {
      copyFallback();
    }
  });

  function copyFallback(){
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(msgText).then(function(){
        nativeSub.textContent = 'Copied to clipboard!';
        nativeBtn.style.background = 'linear-gradient(135deg,#065f46,#10b981)';
        setTimeout(function(){
          nativeSub.textContent = 'SMS, Email, Telegram, Drive and more';
          nativeBtn.style.background = '';
        }, 2500);
      }).catch(function(){ promptCopy(); });
    } else {
      promptCopy();
    }
  }

  function promptCopy(){
    var ta = document.createElement('textarea');
    ta.value = msgText;
    ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand('copy'); nativeSub.textContent = 'Copied to clipboard!'; setTimeout(function(){ nativeSub.textContent = 'SMS, Email, Telegram, Drive and more'; }, 2500); }
    catch(e) { alert('Copy manually:\n\n' + msgText); }
    document.body.removeChild(ta);
  }
})();
</script>
</body>
</html>
