<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Cart Review - Iskcon Tirupati Essay Writing Contest</title>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
  <style>
    :root{--navy:#1a237e;--navy-mid:#283593;--navy-lt:#3949ab;--navy-ghost:#eef2ff;--gold:#f59e0b;--gold-lt:#fef3c7;--gold-dark:#92400e;--green:#10b981;--green-lt:#d1fae5;--green-dark:#065f46;--red:#ef4444;--red-lt:#fee2e2;--red-dark:#991b1b;--bg:#eef1fb;--surface:#fff;--border:#c5cae9;--border-lt:#e8eaf6;--text-h:#0f172a;--text-b:#1e293b;--text-mid:#334155;--text-muted:#64748b;--sh-sm:0 4px 16px rgba(26,35,126,.10);--sh-md:0 8px 28px rgba(26,35,126,.15)}
    *{box-sizing:border-box;margin:0;padding:0}body{font-family:'DM Sans',system-ui,sans-serif;background:var(--bg);color:var(--text-b);padding:16px 12px 40px;-webkit-font-smoothing:antialiased}
    a{text-decoration:none;color:inherit}
    .backLink{display:inline-flex;align-items:center;gap:6px;color:var(--navy);font-size:13px;font-weight:700;margin-bottom:14px;padding:7px 12px;background:#fff;border:1.5px solid var(--border-lt);border-radius:10px;box-shadow:var(--sh-sm);transition:background .14s;max-width:fit-content}
    .backLink:hover{background:var(--navy-ghost)}
    .wrap{max-width:760px;margin:0 auto;background:var(--surface);border-radius:26px;box-shadow:var(--sh-md);overflow:hidden;border:1.5px solid var(--border-lt)}
    .top{padding:20px 20px 18px;background:linear-gradient(135deg,#1a237e 0%,#283593 55%,#3949ab 100%);color:#fff;position:relative;overflow:hidden}
    .top::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 85% 20%,rgba(255,255,255,.07) 0%,transparent 55%);pointer-events:none}
    .topInner{position:relative;display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap}
    .topLeft h1{font-family:'Sora',sans-serif;font-size:22px;font-weight:800;margin-bottom:4px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
    .itemCountPill{display:inline-flex;align-items:center;background:rgba(255,255,255,.18);border:1.5px solid rgba(255,255,255,.28);border-radius:999px;padding:3px 11px;font-family:'Sora',sans-serif;font-size:12px;font-weight:700;color:#fff;letter-spacing:.2px;white-space:nowrap}
    .itemCountPill.hidden{display:none}
    .topLeft p{font-size:13px;opacity:.88;line-height:1.5}
    .clearBtn{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.12);border:1.5px solid rgba(255,255,255,.22);color:#fff;border-radius:11px;padding:9px 13px;font-family:'Sora',sans-serif;font-size:12px;font-weight:700;cursor:pointer;transition:background .16s;white-space:nowrap;margin-top:4px}
    .clearBtn:hover{background:rgba(255,80,80,.25)}
    .content{padding:18px}
    /* bonus */
    .bonusBox{background:linear-gradient(135deg,#eff6ff,#fff);border:1.5px solid #bfdbfe;border-radius:18px;padding:13px 15px;margin-bottom:14px;display:flex;gap:10px;align-items:flex-start}
    .bonusIcon{font-size:22px;flex-shrink:0}
    .bonusTitle{font-family:'Sora',sans-serif;font-size:13px;font-weight:700;color:#1e3a8a;margin-bottom:3px}
    .bonusText{font-size:12px;color:#1d4ed8;line-height:1.55}
    /* FIXED cart item layout */
    .cartList{display:flex;flex-direction:column;gap:12px;margin-bottom:14px}
    .item{border:1.5px solid var(--border-lt);border-radius:18px;padding:14px;background:#fafbff;transition:box-shadow .18s}
    .item:hover{box-shadow:var(--sh-sm)}
    .itemTop{display:flex;gap:12px;align-items:flex-start}
    .thumb{width:72px;height:72px;border-radius:13px;object-fit:cover;background:#edf2f8;flex-shrink:0}
    .itemInfo{flex:1;min-width:0}
    .itemTitle{font-family:'Sora',sans-serif;font-size:14px;font-weight:700;color:var(--text-h);margin-bottom:6px;line-height:1.3}
    .agePill{display:inline-block;padding:4px 10px;border-radius:999px;background:var(--navy-ghost);color:var(--navy);border:1px solid var(--border);font-size:11px;font-weight:700;margin-bottom:8px}
    .ageSelect{width:100%;padding:8px 10px;border:1.5px solid #d1d8f0;border-radius:10px;font-size:13px;font-weight:600;background:#fff;color:var(--text-b);outline:none;transition:border-color .16s}
    .ageSelect:focus{border-color:var(--navy-lt)}
    .itemBottom{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:10px;flex-wrap:wrap}
    .price{font-family:'Sora',sans-serif;font-size:16px;font-weight:800;color:var(--navy)}
    .qtyRow{display:flex;align-items:center;gap:6px}
    .qtyBtn{width:32px;height:32px;border-radius:9px;border:1.5px solid var(--border);background:#fff;cursor:pointer;font-size:17px;font-weight:700;color:var(--text-b);display:inline-flex;align-items:center;justify-content:center;transition:all .14s}
    .qtyBtn:hover{border-color:var(--navy-lt);color:var(--navy);background:var(--navy-ghost)}
    .qtyNum{min-width:22px;text-align:center;font-family:'Sora',sans-serif;font-weight:700;font-size:14px}
    /* STANDARD delete button - X icon */
    .deleteBtn{width:32px;height:32px;border-radius:9px;border:1.5px solid #fecaca;background:#fff;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;color:var(--red-dark);transition:all .14s;padding:0}
    .deleteBtn:hover{background:var(--red-lt)}
    .deleteBtn svg{width:16px;height:16px;fill:currentColor;flex-shrink:0}
    /* summary */
    .summary{border:1.5px solid var(--border-lt);border-radius:18px;padding:14px 16px;background:#fafbff}
    .sumRow{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
    .sumLabel{font-family:'Sora',sans-serif;font-size:15px;font-weight:700;color:var(--text-h)}
    .sumAmount{font-family:'Sora',sans-serif;font-size:18px;font-weight:800;color:var(--navy)}
    /* SAFFRON-GOLD continue button */
    .continueBtn{width:100%;border:none;border-radius:14px;padding:14px 18px;background:linear-gradient(135deg,#d97706 0%,#f59e0b 50%,#d97706 100%);color:#fff;font-family:'Sora',sans-serif;font-size:15px;font-weight:800;cursor:pointer;box-shadow:0 6px 20px rgba(217,119,6,.35);transition:transform .15s,box-shadow .15s;display:flex;align-items:center;justify-content:center;gap:8px}
    .continueBtn:disabled{opacity:.75;cursor:not-allowed;transform:none!important;box-shadow:0 6px 20px rgba(217,119,6,.25)!important}
    @keyframes spin{to{transform:rotate(360deg)}}
    .spinner{width:16px;height:16px;border:2.5px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;flex-shrink:0}
    .empty{border:1.5px dashed var(--border);border-radius:18px;padding:32px 20px;text-align:center;color:var(--text-muted);font-size:14px;background:#fafbff}
    .emptyIcon{font-size:40px;margin-bottom:10px}
    .emptyMsg{margin-bottom:18px;line-height:1.6;color:var(--text-mid)}
    .browseBtn{display:inline-flex;align-items:center;gap:7px;background:linear-gradient(135deg,var(--navy),#3949ab);color:#fff;font-family:'Sora',sans-serif;font-size:13px;font-weight:800;border-radius:12px;padding:11px 20px;box-shadow:0 6px 18px rgba(26,35,126,.25);transition:transform .14s,box-shadow .14s;text-decoration:none}
    .browseBtn:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(26,35,126,.32)}
    .browseBtn:active{transform:scale(.97)}
    .browseBtn svg{width:16px;height:16px;fill:#fff}
    /* toast */
    .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(16px);background:#1e293b;color:#fff;border-radius:14px;padding:12px 18px;font-size:13px;font-weight:600;z-index:200;box-shadow:0 8px 24px rgba(0,0,0,.3);opacity:0;transition:opacity .22s,transform .22s;pointer-events:none;max-width:calc(100vw - 32px);text-align:center}
    .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}.toast.err{background:#7f1d1d}.toast.ok{background:#065f46}
  </style>
</head>
<body>
<a class="backLink" href="/dashboard"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>Back to Dashboard</a>
<div class="wrap">
  <div class="top">
    <div class="topInner">
      <div class="topLeft"><h1>🛒 Cart Review <span class="itemCountPill hidden" id="itemCountPill">0 items</span></h1><p>Review your selected contests before continuing to checkout.</p></div>
      <button id="clearCartBtn" class="clearBtn" type="button"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12ZM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4Z"/></svg>Clear Cart</button>
    </div>
  </div>
  <div class="content">
    <div id="bonusBox" style="display:none" class="bonusBox">
      <div class="bonusIcon">🎁</div>
      <div><div class="bonusTitle">Free Bonus Book Earned!</div><div id="bonusText" class="bonusText"></div></div>
    </div>
    <div class="cartList" id="cartList"></div>
    <div id="cartSummary" style="display:none">
      <div class="summary">
        <div class="sumRow"><span class="sumLabel">Total Amount</span><span class="sumAmount" id="totalAmount">₹0</span></div>
        <form method="POST" action="/cart-review/start" id="checkoutForm">
          <button class="continueBtn" type="submit" id="continueBtn">Continue to Address & Book Details<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg></button>
        </form>
      </div>
    </div>
  </div>
</div>
<div class="toast" id="toast"></div>

<script>
let toastT;
function showToast(msg,type=''){const t=document.getElementById('toast');t.textContent=msg;t.className='toast'+(type?' '+type:'');void t.offsetWidth;t.classList.add('show');clearTimeout(toastT);toastT=setTimeout(()=>t.classList.remove('show'),2800)}

async function fetchJson(url,opts){const r=await fetch(url,opts);const d=await r.json().catch(()=>({}));if(!r.ok||d.ok===false)throw new Error(d.message||'Request failed');return d}
async function loadCart(){const d=await fetchJson('/api/cart/items');return Array.isArray(d.items)?d.items:[]}
async function loadSummary(){const d=await fetchJson('/api/cart/summary');return{ssrCount:Number(d.ssrCount||0)}}
async function updateItem(id,action){await fetchJson('/api/cart/update',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({cartItemId:id,action})})}
async function updateAge(id,age){await fetchJson('/api/cart/age',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({cartItemId:id,ageCategory:age})})}

const cartList=document.getElementById('cartList');
const cartSummary=document.getElementById('cartSummary');
const totalAmountEl=document.getElementById('totalAmount');
const bonusBox=document.getElementById('bonusBox');
const bonusText=document.getElementById('bonusText');
const itemCountPill=document.getElementById('itemCountPill');

function updateCountPill(count){
  if(count>0){
    itemCountPill.textContent=count===1?'1 item':`${count} items`;
    itemCountPill.classList.remove('hidden');
  }else{
    itemCountPill.classList.add('hidden');
  }
}

async function render(){
  let cart=[],summary={ssrCount:0};
  try{cart=await loadCart();summary=await loadSummary()}
  catch(e){cartList.innerHTML=`<div class="empty"><div class="emptyIcon">⚠️</div><div class="emptyMsg">${e.message||'Failed to load cart.'}</div></div>`;cartSummary.style.display='none';updateCountPill(0);return}
  cartList.innerHTML='';
  if(summary.ssrCount>0){bonusText.textContent=`You've earned ${summary.ssrCount} free bonus book${summary.ssrCount>1?'s':''}: Science of Self Realization. This will appear at checkout.`;bonusBox.style.display='flex'}
  else{bonusBox.style.display='none'}
  if(!cart.length){
    updateCountPill(0);
    cartList.innerHTML=`<div class="empty">
      <div class="emptyIcon">🛒</div>
      <div class="emptyMsg">Your cart is empty.<br>Browse contests and add them to get started!</div>
      <a class="browseBtn" href="/dashboard">
        <svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
        Browse Contests
      </a>
    </div>`;
    cartSummary.style.display='none';return;
  }
  const totalQty=cart.reduce((s,i)=>s+Number(i.quantity||0),0);
  updateCountPill(totalQty);
  let total=0;
  cart.forEach(item=>{
    total+=Number(item.price||0)*Number(item.quantity||0);
    const el=document.createElement('div');el.className='item';
    el.innerHTML=`
      <div class="itemTop">
        <img class="thumb" src="${item.image_url||'https://placehold.co/72x72?text=📿'}" alt="${item.title||'Contest'}" onerror="this.src='https://placehold.co/72x72?text=📿'">
        <div class="itemInfo">
          <div class="itemTitle">${item.title||'Contest'}</div>
          <div class="agePill">Age: ${item.age_category==='above-25'?'Above 25 yrs':'0 – 25 yrs'}</div>
          <select class="ageSelect" data-age-id="${item.id}">
            <option value="0-25" ${item.age_category==='0-25'?'selected':''}>0 to 25 years</option>
            <option value="above-25" ${item.age_category==='above-25'?'selected':''}>Above 25 years</option>
          </select>
        </div>
      </div>
      <div class="itemBottom">
        <div class="price">₹${Number(item.price||0)}</div>
        <div class="qtyRow">
          <button class="qtyBtn" data-action="minus" data-id="${item.id}" type="button">−</button>
          <div class="qtyNum">${Number(item.quantity||0)}</div>
          <button class="qtyBtn" data-action="plus" data-id="${item.id}" type="button">+</button>
          <button class="deleteBtn" data-action="delete" data-id="${item.id}" type="button" title="Remove item">
            <svg viewBox="0 0 24 24"><path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
          </button>
        </div>
      </div>`;
    cartList.appendChild(el);
  });
  totalAmountEl.textContent=`₹${total}`;cartSummary.style.display='block';
  cartList.querySelectorAll('[data-action]').forEach(btn=>{
    btn.addEventListener('click',async()=>{try{await updateItem(btn.getAttribute('data-id'),btn.getAttribute('data-action'));await render()}catch(e){showToast('⚠️ '+(e.message||'Failed'),'err')}});
  });
  cartList.querySelectorAll('[data-age-id]').forEach(sel=>{
    sel.addEventListener('change',async()=>{try{await updateAge(sel.getAttribute('data-age-id'),sel.value);await render()}catch(e){showToast('⚠️ '+(e.message||'Failed'),'err')}});
  });
}
render();
document.getElementById('clearCartBtn')?.addEventListener('click',async()=>{
  if(!confirm('Clear all items from cart?'))return;
  try{await fetchJson('/api/cart/clear',{method:'POST',headers:{'Content-Type':'application/json'}});await render();showToast('Cart cleared','ok')}
  catch(e){showToast('⚠️ '+(e.message||'Failed'),'err')}
});
document.getElementById('checkoutForm')?.addEventListener('submit',function(){
  const btn=document.getElementById('continueBtn');
  if(!btn)return;
  btn.disabled=true;
  btn.innerHTML='<div class="spinner"></div>Taking you to checkout…';
});
</script>
</body>
</html>