<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Your Cart</title>
  <style>
    body{font-family:Segoe UI,Tahoma,Verdana,sans-serif;background:#f6f7fb;margin:0;padding:24px}
    .wrap{max-width:900px;margin:0 auto}
    .top{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
    a{color:#1a237e;text-decoration:none;font-weight:700}
    .card{background:#fff;border:1px solid #e5e7eb;border-radius:16px;box-shadow:0 10px 26px rgba(0,0,0,.06);overflow:hidden}
    .row{display:flex;justify-content:space-between;gap:12px;padding:14px 16px;border-bottom:1px solid #eef2f7}
    .row:last-child{border-bottom:none}
    .title{font-weight:900;color:#111827}
    .muted{color:#6b7280;font-size:12px;margin-top:4px}
    .price{font-weight:900;color:#111827;white-space:nowrap}
    .btn{border:0;border-radius:12px;padding:10px 12px;font-weight:900;cursor:pointer}
    .del{background:#fee2e2;color:#991b1b}
    .sum{display:flex;justify-content:space-between;align-items:center;padding:16px}
    .pay{width:100%;padding:14px 16px;border-radius:14px;border:0;background:#1a237e;color:#fff;font-weight:1000;font-size:16px;cursor:pointer}
    .pay:disabled{opacity:.5;cursor:not-allowed}
  </style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <a href="/dashboard">← Back</a>
    <div style="font-weight:900;color:#111827">Your Cart</div>
  </div>

  <div class="card" id="cartCard">
    <% contests.forEach((c) => { %>
      <div class="row cart-item" data-id="<%= c.id %>" data-price="<%= Number(c.price||0) %>">
        <div style="min-width:0">
          <div class="title"><%= c.title %></div>
          <div class="muted">Contest ID: <%= c.id %></div>
        </div>

        <div style="display:flex;align-items:center;gap:10px">
          <div class="price">₹<span class="itemPrice"><%= Number(c.price||0) %></span></div>
          <button type="button" class="btn del" onclick="removeItem('<%= c.id %>')">Delete</button>
        </div>
      </div>
    <% }) %>

    <div class="sum">
      <div style="font-weight:900;color:#111827">
        Total: ₹<span id="total"><%= Number(totalAmount||0) %></span>
      </div>
      <div style="color:#6b7280;font-size:12px">Server will re-check amounts</div>
    </div>
  </div>

  <form id="payForm" action="/payment/start" method="POST" style="margin-top:14px">
    <input type="hidden" name="contestIds" id="contestIds" value="<%= contests.map(c=>c.id).join(',') %>">
    <button id="payBtn" type="submit" class="pay">Proceed to Pay</button>
  </form>
</div>

<script>
  function recalc(){
    const items = Array.from(document.querySelectorAll('.cart-item'));
    const ids = items.map(x => x.dataset.id);
    document.getElementById('contestIds').value = ids.join(',');

    const total = items.reduce((a, el) => a + Number(el.dataset.price || 0), 0);
    document.getElementById('total').textContent = String(total);

    const payBtn = document.getElementById('payBtn');
    payBtn.disabled = ids.length === 0;
    payBtn.textContent = ids.length ? `Proceed to Pay (₹${total})` : 'Cart is empty';
  }

  function removeItem(id){
    const el = document.querySelector(`.cart-item[data-id="${CSS.escape(id)}"]`);
    if (el) el.remove();
    recalc();
  }

  recalc();
</script>
</body>
</html>