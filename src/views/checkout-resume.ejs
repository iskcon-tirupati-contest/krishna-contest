<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Complete Your Registration · ISKCON Essay Contest 2026</title>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{
      font-family:'DM Sans',system-ui,sans-serif;
      background:linear-gradient(160deg,#0f0c2e 0%,#1a1150 40%,#2d1a6e 100%);
      min-height:100vh;padding-bottom:60px;-webkit-font-smoothing:antialiased;
    }

    /* ── TOPBAR ── */
    .topbar{background:linear-gradient(135deg,#0f0c2e 0%,#1a1150 50%,#2d2080 100%);padding:0 16px;position:relative;overflow:hidden}
    .topbar::after{content:'';position:absolute;bottom:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#f5a623,#f97316,#f5a623,#ffd166,#f5a623);background-size:300% 100%;animation:goldShimmer 2.5s linear infinite}
    @keyframes goldShimmer{0%{background-position:0%}100%{background-position:300%}}
    .topbar-inner{max-width:560px;margin:0 auto;display:flex;align-items:center;gap:14px;padding:18px 0 22px;position:relative;z-index:1}
    .logo-box{width:54px;height:54px;border-radius:14px;background:rgba(255,255,255,.12);border:2px solid rgba(245,166,35,.35);display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden}
    .logo-box img{width:100%;height:100%;object-fit:contain}
    .brand-title{font-family:'Sora',sans-serif;font-size:17px;font-weight:800;color:#fff;margin-bottom:2px}
    .brand-sub{font-size:11px;color:rgba(255,255,255,.6)}

    .page{max-width:560px;margin:0 auto;padding:28px 14px 0}
    @keyframes slideUp{from{transform:translateY(14px);opacity:0}to{transform:translateY(0);opacity:1}}

    /* ── MAIN CARD ── */
    .card{background:#fff;border-radius:24px;box-shadow:0 20px 56px rgba(0,0,0,.3);overflow:hidden;animation:slideUp .4s both}

    /* ── AMBER HEADER ── */
    .card-head{
      background:linear-gradient(135deg,#92400e 0%,#b45309 50%,#d97706 100%);
      padding:22px 24px 20px;position:relative;overflow:hidden;
    }
    .card-head::before{content:'';position:absolute;top:-30px;right:-30px;width:140px;height:140px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.12),transparent 70%);pointer-events:none}
    .card-head::after{content:'';position:absolute;bottom:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#fcd34d,#fbbf24,#fcd34d);background-size:200% 100%;animation:goldShimmer 2s linear infinite}
    .head-row{display:flex;align-items:center;gap:14px;position:relative;z-index:1}
    .head-icon{width:52px;height:52px;border-radius:15px;background:rgba(255,255,255,.2);border:2px solid rgba(255,255,255,.3);display:flex;align-items:center;justify-content:center;font-size:28px;flex-shrink:0}
    .head-title{font-family:'Sora',sans-serif;font-size:19px;font-weight:800;color:#fff;margin-bottom:3px}
    .head-sub{font-size:12px;color:rgba(255,255,255,.8);line-height:1.5}

    /* ── CARD BODY ── */
    .card-body{padding:22px 24px 26px}

    /* ref row */
    .ref-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;padding-bottom:14px;border-bottom:1px solid #f1f5f9}
    .ref-label{font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.07em}
    .ref-pill{font-size:11px;font-weight:800;color:#1a1150;background:#eff6ff;border:1px solid #bfdbfe;border-radius:999px;padding:4px 12px;font-family:monospace}

    /* order items */
    .order-label{font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.07em;margin-bottom:10px}
    .order-items{display:flex;flex-direction:column;gap:8px;margin-bottom:16px}
    .order-item{display:flex;justify-content:space-between;align-items:center;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:12px 14px}
    .oi-name{font-size:13px;font-weight:700;color:#1e1b4b}
    .oi-price{font-size:13px;font-weight:800;color:#1a1150}

    /* total */
    .total-row{display:flex;justify-content:space-between;align-items:center;background:linear-gradient(135deg,#fff7ed,#fffbeb);border:1.5px solid #fed7aa;border-radius:14px;padding:14px 16px;margin-bottom:20px}
    .total-label{font-size:13px;font-weight:600;color:#92400e}
    .total-amount{font-family:'Sora',sans-serif;font-size:24px;font-weight:800;color:#b45309}

    /* divider */
    .or-divider{display:flex;align-items:center;gap:10px;margin-bottom:18px}
    .or-line{flex:1;height:1px;background:#e2e8f0}
    .or-text{font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.07em;white-space:nowrap}

    /* ── ACTIONS ── */
    .actions{display:flex;flex-direction:column;gap:10px}

    /* primary — complete payment */
    .btn-complete{
      display:flex;align-items:center;justify-content:center;gap:10px;
      width:100%;padding:16px 20px;border:0;border-radius:16px;
      font-family:'Sora',sans-serif;font-size:16px;font-weight:800;
      color:#fff;cursor:pointer;text-decoration:none;
      background:linear-gradient(135deg,#1a1150,#4338ca);
      box-shadow:0 8px 28px rgba(26,17,80,.3);
      transition:transform .12s,box-shadow .12s;
    }
    .btn-complete:hover{transform:translateY(-2px);box-shadow:0 12px 32px rgba(26,17,80,.4)}
    .btn-complete-icon{font-size:20px}
    .btn-complete-text{}
    .btn-complete-sub{font-size:11px;font-weight:600;opacity:.75;margin-top:2px}

    /* secondary — start fresh */
    .btn-abandon{
      width:100%;padding:0;border:0;background:none;cursor:pointer;
    }
    .abandon-inner{
      display:flex;align-items:center;gap:12px;
      background:#fff;border:1.5px solid #e2e8f0;border-radius:14px;
      padding:14px 16px;transition:border-color .15s,background .15s;
    }
    .btn-abandon:hover .abandon-inner{border-color:#fca5a5;background:#fef2f2}
    .abandon-icon{font-size:22px;flex-shrink:0}
    .abandon-text{flex:1;text-align:left}
    .abandon-title{font-size:14px;font-weight:700;color:#374151;margin-bottom:2px}
    .abandon-sub{font-size:11px;color:#94a3b8;line-height:1.5}
    .abandon-arrow{font-size:18px;color:#d1d5db;transition:color .15s}
    .btn-abandon:hover .abandon-arrow{color:#ef4444}

    /* warning note */
    .warning-note{
      display:flex;align-items:flex-start;gap:8px;
      background:#fff7ed;border:1px solid #fed7aa;border-radius:10px;
      padding:10px 12px;margin-top:12px;
    }
    .warning-note-icon{font-size:14px;flex-shrink:0;margin-top:1px}
    .warning-note-text{font-size:11px;color:#92400e;line-height:1.55}

    /* loading overlay */
    .loading-overlay{display:none;position:fixed;inset:0;background:rgba(10,8,30,.8);backdrop-filter:blur(6px);z-index:9999;flex-direction:column;align-items:center;justify-content:center;gap:14px}
    .loading-overlay.active{display:flex}
    .spinner{width:44px;height:44px;border-radius:50%;border:3px solid rgba(245,166,35,.2);border-top-color:#f5a623;animation:spin .8s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}
    .loading-text{font-family:'Sora',sans-serif;font-size:14px;font-weight:700;color:#fff}
  </style>
</head>
<body>

<div class="loading-overlay" id="loader">
  <div class="spinner"></div>
  <div class="loading-text">Opening payment page…</div>
</div>

<!-- Topbar -->
<div class="topbar">
  <div class="topbar-inner">
    <div class="logo-box">
      <img src="/images/logo_new.png" alt="ISKCON"
           onerror="this.style.display='none';this.parentElement.innerHTML='🪷'">
    </div>
    <div>
      <div class="brand-title">ISKCON Tirupati Essay Contest</div>
      <div class="brand-sub">You have a pending registration</div>
    </div>
  </div>
</div>

<div class="page">
  <div class="card">

    <!-- Amber header -->
    <div class="card-head">
      <div class="head-row">
        <div class="head-icon">⏳</div>
        <div>
          <div class="head-title">Registration in Progress</div>
          <div class="head-sub">
            Your registration is saved — complete the payment to confirm your spot.
          </div>
        </div>
      </div>
    </div>

    <div class="card-body">

      <!-- Ref -->
      <div class="ref-row">
        <div class="ref-label">Order Reference</div>
        <div class="ref-pill"><%= paymentId %></div>
      </div>

      <!-- Items -->
      <div class="order-label">📋 Your Registration</div>
      <div class="order-items">
        <% (orders || []).forEach(function(o){ %>
          <div class="order-item">
            <div class="oi-name"><%= o.contest_title %></div>
            <div class="oi-price">₹<%= Number(o.amount || 0) %></div>
          </div>
        <% }) %>
      </div>

      <!-- Total -->
      <div class="total-row">
        <div class="total-label">Total amount</div>
        <div class="total-amount">₹<%= totalAmount %></div>
      </div>

      <div class="or-divider">
        <div class="or-line"></div>
        <div class="or-text">What would you like to do?</div>
        <div class="or-line"></div>
      </div>

      <div class="actions">

        <!-- Complete payment -->
        <a href="<%= paymentUrl %>" class="btn-complete"
           onclick="document.getElementById('loader').classList.add('active')">
          <div class="btn-complete-icon">🔒</div>
          <div class="btn-complete-text">
            <div>Complete Payment</div>
            <div class="btn-complete-sub">Continue where you left off</div>
          </div>
        </a>

        <!-- Start fresh -->
        <form method="POST" action="/checkout/resume/abandon"
              onsubmit="document.getElementById('loader').classList.add('active');document.querySelector('.loading-text').textContent='Cancelling order…';return true">
          <input type="hidden" name="paymentId" value="<%= paymentId %>">
          <button type="submit" class="btn-abandon">
            <div class="abandon-inner">
              <div class="abandon-icon">🗑️</div>
              <div class="abandon-text">
                <div class="abandon-title">Cancel & Start Fresh</div>
                <div class="abandon-sub">This will cancel the current registration. You can re-register from your dashboard.</div>
              </div>
              <div class="abandon-arrow">›</div>
            </div>
          </button>
        </form>

        <div class="warning-note">
          <div class="warning-note-icon">⚠️</div>
          <div class="warning-note-text">
            Your selected book and language are reserved in this order.
            Cancelling will release the reservation and you'll need to select again.
          </div>
        </div>

      </div>
    </div>

  </div>
</div>

</body>
</html>
