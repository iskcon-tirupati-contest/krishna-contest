<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Checkout - KNC 2026</title>
  <style>
    body{margin:0;font-family:Segoe UI,Tahoma,Verdana,sans-serif;background:#0b1224;color:#fff}
    .wrap{max-width:900px;margin:30px auto;padding:20px}
    .card{background:#111b35;border:1px solid rgba(255,255,255,.12);border-radius:18px;padding:18px}
    .row{display:flex;gap:14px;flex-wrap:wrap}
    .col{flex:1;min-width:280px}
    h1{margin:0 0 8px 0}
    .muted{color:rgba(255,255,255,.7)}
    input,select,textarea{width:100%;padding:10px;border-radius:10px;border:1px solid rgba(255,255,255,.18);background:#0e1630;color:#fff}
    textarea{min-height:90px}
    .btn{border:none;border-radius:12px;padding:12px 14px;font-weight:800;cursor:pointer}
    .btn.primary{background:#1a3cff;color:#fff}
    .btn.ghost{background:rgba(255,255,255,.1);color:#fff;text-decoration:none;display:inline-block}
    .sep{height:1px;background:rgba(255,255,255,.12);margin:14px 0}
    .badge{display:inline-block;background:rgba(255,215,0,.15);color:#ffd700;padding:6px 10px;border-radius:999px;font-weight:800}
    .btn[disabled]{opacity:.7;cursor:not-allowed}
    .spinner{
      width:16px;height:16px;border:2px solid rgba(255,255,255,.35);
      border-top-color:#fff;border-radius:50%;
      display:inline-block;vertical-align:middle;margin-right:10px;
      animation:spin 0.8s linear infinite;
    }
    @keyframes spin{to{transform:rotate(360deg)}}
  </style>
</head>
<body>
  <div class="wrap">
    <a class="btn ghost" href="/dashboard">← Back</a>

    <div class="card" style="margin-top:14px">
      <h1>Checkout</h1>

      <% if (error) { %>
        <div style="background:rgba(244,67,54,.12);border:1px solid rgba(244,67,54,.35);padding:12px;border-radius:12px;color:#ffd1d1;margin-bottom:14px;font-weight:700">
          <%= error %>
        </div>
      <% } %>

      <div class="muted">
        Contest: <b><%= order.contest_title %></b> • Amount: <span class="badge">₹<%= order.amount %></span>
      </div>

      <div class="sep"></div>

      <form method="POST" action="/checkout" id="checkoutForm" novalidate>
        <input type="hidden" name="orderId" value="<%= order.id %>"/>

        <div class="row">
          <div class="col">
            <label class="muted">Mobile Number (WhatsApp contact — locked once saved)</label>
            <input
              name="phone"
              value="<%= user.phone || '' %>"
              <%= user.phone ? 'readonly' : '' %>
              placeholder="10 digit mobile"
              inputmode="numeric"
              maxlength="10"
              pattern="^[6-9][0-9]{9}$"
              required
              autocomplete="tel"
            />
            <div id="phoneError" style="color:#ffbdbd;margin-top:6px;display:none;font-size:13px">
              Please enter a valid 10-digit Indian mobile number.
            </div>
            <% if (!user.phone) { %>
              <div class="muted" style="font-size:12px;margin-top:6px">
                We’ll use this number for WhatsApp updates. After first order, it becomes locked.
              </div>
            <% } %>
          </div>

          <div class="col">
            <label class="muted">Delivery Mode</label>
            <select name="bookOption" id="bookOption">
              <option value="book">Gift Book</option>
              <option value="donation">Donate Book</option>
            </select>
          </div>
        </div>

        <div id="giftFields">
          <div class="sep"></div>

          <div class="row">
            <div class="col">
              <label class="muted">Select Gift Book</label>
              <select name="bookTitle" id="bookTitle">
                <option value="">-- select --</option>
                <% books.forEach(b => { %>
                  <option value="<%= b %>"><%= b %></option>
                <% }) %>
              </select>
            </div>

            <div class="col">
              <label class="muted">DOB</label>
              <input type="date" name="dob" />
            </div>
          </div>

          <div class="row">
            <div class="col">
              <label class="muted">Full Name (for delivery)</label>
              <input name="fullName" id="fullName" placeholder="Receiver name" value="<%= user.name || '' %>"/>
            </div>
          </div>

          <div class="row">
            <div class="col">
              <label class="muted">Address</label>
              <textarea name="address" id="address" placeholder="House no, Street, Area"><%= user.address || '' %></textarea>
            </div>
          </div>

          <div class="row">
            <div class="col">
              <label class="muted">City</label>
              <input name="city" id="city" value="<%= user.city || '' %>" />
            </div>

            <div class="col">
              <label class="muted">State</label>
              <select name="state" id="state">
                <option value="">Select State</option>
                <% const states = ["Andhra Pradesh","Arunachal Pradesh","Assam","Bihar","Chhattisgarh","Goa","Gujarat","Haryana","Himachal Pradesh","Jharkhand","Karnataka","Kerala","Madhya Pradesh","Maharashtra","Manipur","Meghalaya","Mizoram","Nagaland","Odisha","Punjab","Rajasthan","Sikkim","Tamil Nadu","Telangana","Tripura","Uttar Pradesh","Uttarakhand","West Bengal","Andaman and Nicobar Islands","Chandigarh","Dadra and Nagar Haveli and Daman and Diu","Delhi","Jammu and Kashmir","Ladakh","Lakshadweep","Puducherry"]; %>
                <% states.forEach(s => { %>
                  <option value="<%= s %>" <%= (user.state === s ? 'selected' : '') %>><%= s %></option>
                <% }) %>
              </select>
            </div>

            <div class="col">
              <label class="muted">Pincode</label>
              <input
                id="pincode"
                name="pincode"
                inputmode="numeric"
                autocomplete="postal-code"
                maxlength="6"
                pattern="^[1-9][0-9]{5}$"
                value="<%= user.pincode || '' %>"
              />
              <div id="pincodeError" style="color:#ffbdbd;margin-top:6px;display:none;font-size:13px">
                Please enter a valid 6-digit Indian pincode.
              </div>
            </div>
          </div>

          <div class="muted" style="font-size:12px;margin-top:6px">
            Note: This address will be saved as your default for next checkout. For India Post, we will always ship using the shipment address of this order.
          </div>
        </div>

        <div class="sep"></div>

        <button class="btn primary" id="submitBtn" type="submit" style="width:100%">
          Continue to Payment →
        </button>

      </form>
    </div>
  </div>

<script>
  (function () {
    const form = document.getElementById("checkoutForm");
    if (!form) return;

    const opt = document.getElementById("bookOption");

    const phone = form.querySelector('input[name="phone"]');
    const phoneErr = document.getElementById("phoneError");

    const pin = document.getElementById("pincode");
    const pinErr = document.getElementById("pincodeError");

    function isBookMode() {
      return opt && opt.value === "book";
    }

    function validPhone(v) {
      return /^[6-9][0-9]{9}$/.test(String(v || "").trim());
    }

    function validPin(v) {
      return /^[1-9][0-9]{5}$/.test(String(v || "").trim());
    }

    // Allow only digits in phone
    phone && phone.addEventListener("input", () => {
      phone.value = phone.value.replace(/\D/g, "").slice(0, 10);
      if (phoneErr) phoneErr.style.display = "none";
    });

    // Allow only digits in pincode
    pin && pin.addEventListener("input", () => {
      pin.value = pin.value.replace(/\D/g, "").slice(0, 6);
      if (pinErr) pinErr.style.display = "none";
    });

    form.addEventListener("submit", (e) => {
      let ok = true;

      // phone always required
      if (!validPhone(phone ? phone.value : "")) {
        ok = false;
        if (phoneErr) phoneErr.style.display = "block";
        phone && phone.focus();
      }

      // pincode only required in Gift Book mode
      if (ok && isBookMode()) {
        const val = pin ? pin.value : "";
        if (!validPin(val)) {
          ok = false;
          if (pinErr) pinErr.style.display = "block";
          pin && pin.focus();
        }
      }

      if (!ok) e.preventDefault();
    });
  })();
</script>

<script>
  (function () {
    const opt = document.getElementById("bookOption");
    const gift = document.getElementById("giftFields");
    if (!opt || !gift) return;

    const giftInputs = gift.querySelectorAll("input, select, textarea");

    function toggleGift() {
      const isBook = opt.value === "book";

      gift.style.display = isBook ? "block" : "none";

      // disable gift fields in donation mode
      giftInputs.forEach(el => { el.disabled = !isBook; });

      // required only for gift mode
      const bookTitle = document.getElementById("bookTitle");
      const fullName = document.getElementById("fullName");
      const address = document.getElementById("address");
      const city = document.getElementById("city");
      const state = document.getElementById("state");
      const pin = document.getElementById("pincode");

      if (bookTitle) bookTitle.required = isBook;
      if (fullName) fullName.required = isBook;
      if (address) address.required = isBook;
      if (city) city.required = isBook;
      if (state) state.required = isBook;
      if (pin) pin.required = isBook;
    }

    opt.addEventListener("change", toggleGift);
    toggleGift();
  })();
</script>

<script>
  (function () {
    const form = document.getElementById("checkoutForm");
    const btn = document.getElementById("submitBtn");
    if (!form || !btn) return;

    form.addEventListener("submit", () => {
      btn.disabled = true;
      btn.innerHTML = `<span class="spinner"></span> Please wait...`;
    });
  })();
</script>

</body>
</html>
