<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Raise a Complaint – ISKCON Tirupati Essay Writing Contest</title>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
  <style>
    :root{
      --navy:#1a237e;--navy-lt:#3949ab;--navy-ghost:#eef2ff;
      --saffron:#f59e0b;--saffron-lt:#fef3c7;--saffron-dark:#92400e;
      --green:#10b981;--green-lt:#d1fae5;--green-dark:#065f46;
      --red:#ef4444;--red-lt:#fee2e2;
      --bg:#eef1fb;--border:#c5cae9;--border-lt:#e8eaf6;
      --text-h:#0f172a;--text-b:#1e293b;--text-mid:#334155;--text-muted:#64748b;--text-faint:#94a3b8;
      --sh-sm:0 4px 16px rgba(26,35,126,.10);
    }
    *{box-sizing:border-box;margin:0;padding:0}html,body{height:100%;overflow:hidden}
    body{font-family:'DM Sans',system-ui,sans-serif;background:var(--bg);color:var(--text-b);-webkit-font-smoothing:antialiased}

    /* TOPBAR */
    .topbar{position:fixed;top:0;left:0;right:0;z-index:100;background:linear-gradient(135deg,#1a237e 0%,#283593 55%,#3949ab 100%);padding-top:max(10px,env(safe-area-inset-top));box-shadow:0 6px 24px rgba(26,35,126,.3)}
    .topbarInner{display:flex;align-items:center;gap:12px;padding:10px 16px 13px;min-height:68px;max-width:560px;margin:0 auto}
    .backBtn{width:40px;height:40px;border-radius:12px;border:1px solid rgba(255,255,255,.25);background:rgba(255,255,255,.14);color:#fff;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;transition:background .18s,transform .12s;text-decoration:none}
    .backBtn:hover{background:rgba(255,255,255,.28)}.backBtn:active{transform:scale(.9)}
    .backBtn svg{width:20px;height:20px;fill:currentColor}
    .topbar-title{flex:1;min-width:0}
    .topbar-title-line1{font-family:'Sora',sans-serif;font-size:clamp(11px,3.2vw,15px);font-weight:800;color:#ffd700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .topbar-title-line2{font-family:'Sora',sans-serif;font-size:clamp(9px,2.3vw,11px);font-weight:600;color:rgba(255,255,255,.8)}
    .progressBar{height:3px;background:rgba(255,255,255,.15)}
    .progressFill{height:100%;background:#ffd700;transition:width .4s cubic-bezier(.4,0,.2,1);width:50%}

    /* SLIDER */
    .sliderWrap{position:fixed;top:0;left:0;right:0;bottom:0;padding-top:calc(71px + max(10px,env(safe-area-inset-top)));overflow:hidden}
    .slidesTrack{display:flex;width:200%;height:100%;transition:transform .4s cubic-bezier(.4,0,.2,1)}
    .slidesTrack.on-slide2{transform:translateX(-50%)}
    .slide{width:50%;height:100%;overflow-y:auto;padding:16px 14px 50px;scrollbar-width:thin}
    .slideInner{max-width:560px;margin:0 auto;display:flex;flex-direction:column;gap:16px}

    /* HERO */
    .hero{background:linear-gradient(135deg,#fff8e1 0%,#fff 60%,#eef4ff 100%);border:1.5px solid #fde68a;border-radius:24px;padding:18px 16px;box-shadow:var(--sh-sm);display:flex;gap:14px;align-items:flex-start}
    .heroIcon{width:52px;height:52px;border-radius:16px;flex-shrink:0;background:linear-gradient(135deg,#fef3c7,#fde68a);display:grid;place-items:center;font-size:26px}
    .heroText h1{font-family:'Sora',sans-serif;font-size:17px;font-weight:800;color:var(--text-h);margin-bottom:4px}
    .heroText p{font-size:13px;color:var(--text-muted);line-height:1.6}

    /* STEP DOTS */
    .stepDots{display:flex;align-items:center;justify-content:center;gap:6px}
    .dot{width:7px;height:7px;border-radius:999px;background:var(--border);transition:all .3s}
    .dot.active{background:var(--navy);width:20px}

    /* CATEGORY CARDS */
    .catGrid{display:flex;flex-direction:column;gap:10px}
    .catCard{background:#fff;border:1.5px solid var(--border-lt);border-radius:20px;padding:15px 16px;display:flex;align-items:center;gap:14px;cursor:pointer;transition:all .2s;box-shadow:0 2px 8px rgba(26,35,126,.06);-webkit-tap-highlight-color:transparent}
    .catCard:hover{border-color:var(--navy-lt);box-shadow:0 8px 22px rgba(26,35,126,.16);transform:translateY(-2px)}
    .catCard:active{transform:scale(.97);background:var(--navy-ghost)}
    .catEmoji{width:46px;height:46px;border-radius:13px;display:grid;place-items:center;font-size:22px;flex-shrink:0;transition:transform .2s}
    .catCard:hover .catEmoji,.catCard:active .catEmoji{transform:scale(1.12)}
    .cat-payment .catEmoji{background:#fef3c7}.cat-delivery .catEmoji{background:#d1fae5}.cat-contest .catEmoji{background:#ede9fe}.cat-login .catEmoji{background:#fee2e2}.cat-other .catEmoji{background:#e0f2fe}
    .catInfo{flex:1;min-width:0}
    .catName{font-family:'Sora',sans-serif;font-size:14px;font-weight:700;color:var(--text-h);margin-bottom:2px}
    .catDesc{font-size:12px;color:var(--text-muted);line-height:1.4}
    .catArrow{width:20px;height:20px;fill:var(--text-faint);flex-shrink:0;transition:transform .2s,fill .2s}
    .catCard:hover .catArrow,.catCard:active .catArrow{fill:var(--navy);transform:translateX(4px)}

    /* SLIDE 2 HEADER */
    .slide2Header{background:#fff;border:1.5px solid var(--border-lt);border-radius:20px;padding:13px 16px;display:flex;align-items:center;gap:12px;box-shadow:var(--sh-sm)}
    .s2CatEmoji{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;font-size:20px;flex-shrink:0}
    .s2CatName{font-family:'Sora',sans-serif;font-size:14px;font-weight:700;color:var(--text-h)}
    .s2CatSub{font-size:11px;color:var(--text-muted)}
    .backCatBtn{
      margin-left:auto;padding:8px 16px;border-radius:10px;
      border:none;
      background:linear-gradient(135deg,#1a237e,#3949ab);
      color:#fff;font-size:12px;font-weight:700;cursor:pointer;
      transition:all .18s;white-space:nowrap;
      box-shadow:0 3px 10px rgba(26,35,126,.3)
    }
    .backCatBtn:hover{background:linear-gradient(135deg,#283593,#3949ab);box-shadow:0 6px 16px rgba(26,35,126,.4);transform:translateY(-1px)}
    .backCatBtn:active{transform:scale(.95)}

    /* CARD */
    .card{background:#fff;border:1.5px solid var(--border-lt);border-radius:22px;padding:20px 16px;box-shadow:var(--sh-sm)}
    .cardTitle{font-family:'Sora',sans-serif;font-size:15px;font-weight:700;color:var(--text-h);margin-bottom:18px;display:flex;align-items:center;gap:7px}

    /* FORM */
    .formGrid{display:flex;flex-direction:column;gap:18px}
    .formField{display:flex;flex-direction:column;gap:7px}
    .formRow{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    @media(max-width:400px){.formRow{grid-template-columns:1fr}}

    /* COLORFUL LABELS */
    .flabel{display:flex;align-items:center;gap:6px;font-size:11.5px;font-weight:700;letter-spacing:.4px;text-transform:uppercase}
    .flabel.c-name{color:#7c3aed}
    .flabel.c-phone{color:#0369a1}
    .flabel.c-issue{color:#b45309}
    .flabel.c-desc{color:#047857}
    .flabel.c-ref{color:#be185d}
    .flabel .req{color:#ef4444;font-size:14px;line-height:1}

    /* INPUT WITH VALIDATION */
    .inputWrap{position:relative}
    input,textarea{
      width:100%;padding:12px 40px 12px 13px;border:1.5px solid #d1d8f0;border-radius:12px;
      background:#fff;color:var(--text-b);font-size:14px;outline:none;
      transition:border-color .18s,box-shadow .18s
    }
    input:focus,textarea:focus{border-color:var(--navy-lt);box-shadow:0 0 0 3px rgba(92,107,192,.16)}
    input.valid{border-color:var(--green)!important;box-shadow:0 0 0 3px rgba(16,185,129,.12)!important}
    input.invalid{border-color:var(--red)!important;box-shadow:0 0 0 3px rgba(239,68,68,.12)!important}
    textarea{padding:12px 13px;resize:vertical;min-height:100px;line-height:1.6}
    textarea.valid{border-color:var(--green)!important;box-shadow:0 0 0 3px rgba(16,185,129,.12)!important}
    textarea.invalid{border-color:var(--red)!important;box-shadow:0 0 0 3px rgba(239,68,68,.12)!important}
    .fieldIcon{position:absolute;right:12px;top:50%;transform:translateY(-50%);width:18px;height:18px;display:none;pointer-events:none}
    .fieldIcon.tick{fill:#10b981;display:none}
    .fieldIcon.cross{fill:#ef4444;display:none}
    .inputWrap.is-valid .fieldIcon.tick{display:block}
    .inputWrap.is-invalid .fieldIcon.cross{display:block}
    .fieldHint{font-size:11.5px;line-height:1.4;min-height:16px;transition:color .2s}
    .fieldHint.ok{color:var(--green-dark)}
    .fieldHint.err{color:var(--red)}
    .fieldHint.muted{color:var(--text-faint)}

    /* SUB-ISSUE CHIPS */
    .subIssueWrap{display:flex;flex-wrap:wrap;gap:8px}
    .subChip{padding:8px 14px;border-radius:999px;border:1.5px solid var(--border);background:#fff;font-size:12px;font-weight:600;color:var(--text-mid);cursor:pointer;transition:all .16s;user-select:none;-webkit-tap-highlight-color:transparent}
    .subChip:hover{background:var(--navy-ghost);border-color:var(--navy-lt);color:var(--navy)}
    .subChip:active{transform:scale(.95)}
    .subChip.selected{background:var(--saffron-lt);border-color:var(--saffron);color:var(--saffron-dark)}
    .subRequired{font-size:11px;color:var(--red);margin-top:4px;display:none}
    .subRequired.show{display:block}

    /* SUBMIT BTN */
    .submitBtn{
      width:100%;border:none;border-radius:14px;padding:15px 16px;
      background:linear-gradient(135deg,#1a237e,#3949ab);
      color:#fff;font-family:'Sora',sans-serif;font-size:15px;font-weight:700;
      cursor:pointer;box-shadow:0 6px 20px rgba(26,35,126,.32);
      transition:all .18s;margin-top:4px;
      display:flex;align-items:center;justify-content:center;gap:8px
    }
    .submitBtn:hover{background:linear-gradient(135deg,#283593,#3949ab);box-shadow:0 10px 28px rgba(26,35,126,.42);transform:translateY(-2px)}
    .submitBtn:active{transform:scale(.97)}
    .submitBtn:disabled{opacity:.6;pointer-events:none}

    /* WA BANNER */
    .waBanner{background:linear-gradient(135deg,#075e54,#128c7e);border-radius:18px;padding:14px 16px;display:flex;gap:12px;align-items:center}
    .waIconWrap{width:44px;height:44px;border-radius:13px;background:rgba(255,255,255,.15);display:grid;place-items:center;flex-shrink:0}
    .waContent .waTitle{font-family:'Sora',sans-serif;font-size:14px;font-weight:700;color:#fff;margin-bottom:2px}
    .waContent .waNum{font-family:'Sora',sans-serif;font-size:18px;font-weight:800;color:#fff;letter-spacing:.5px}
    .waContent .waSub{font-size:12px;color:rgba(255,255,255,.8)}
    .waLink{margin-left:auto;flex-shrink:0;padding:8px 14px;border-radius:10px;background:rgba(255,255,255,.2);color:#fff;font-size:12px;font-weight:700;border:1px solid rgba(255,255,255,.25);text-decoration:none;white-space:nowrap;transition:background .16s}
    .waLink:hover{background:rgba(255,255,255,.32)}

    /* SUCCESS POPUP */
    .popupOverlay{position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:200;display:none;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(4px)}
    .popupOverlay.show{display:flex;animation:fadeIn .22s ease}
    .popup{background:#fff;border-radius:28px;padding:28px 24px;max-width:360px;width:100%;text-align:center;box-shadow:0 24px 60px rgba(15,23,42,.25);animation:slideUp .3s cubic-bezier(.4,0,.2,1)}
    .popupIcon{width:72px;height:72px;border-radius:50%;background:var(--green-lt);display:grid;place-items:center;margin:0 auto 16px;font-size:36px}
    .popupTitle{font-family:'Sora',sans-serif;font-size:20px;font-weight:800;color:var(--text-h);margin-bottom:8px}
    .popupMsg{font-size:14px;color:var(--text-muted);line-height:1.6;margin-bottom:22px}
    .popupBtn{display:inline-flex;align-items:center;gap:7px;padding:12px 24px;border-radius:12px;background:linear-gradient(135deg,#1a237e,#3949ab);color:#fff;font-family:'Sora',sans-serif;font-size:14px;font-weight:700;border:none;cursor:pointer;box-shadow:0 6px 18px rgba(26,35,126,.28);transition:all .16s}
    .popupBtn:hover{transform:translateY(-1px);box-shadow:0 10px 24px rgba(26,35,126,.38)}

    @keyframes fadeIn{from{opacity:0}to{opacity:1}}
    @keyframes slideUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
    @keyframes spin{to{transform:rotate(360deg)}}
  </style>
</head>
<body>

<!-- SUCCESS POPUP -->
<div class="popupOverlay" id="successPopup">
  <div class="popup">
    <div class="popupIcon">🙏</div>
    <div class="popupTitle">Complaint Submitted!</div>
    <div class="popupMsg">Thank you! Our team will respond within 24 hours. Hare Krishna!</div>
    <button class="popupBtn" onclick="closePopup()">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/></svg>
      Done, Hare Krishna!
    </button>
  </div>
</div>

<!-- TOPBAR -->
<header class="topbar">
  <div class="topbarInner">
    <a class="backBtn" href="javascript:void(0)" id="backBtn">
      <svg viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
    </a>
    <div class="topbar-title">
      <div class="topbar-title-line1">ISKCON Tirupati Essay Writing Contest</div>
      <div class="topbar-title-line2">Support &amp; Complaint</div>
    </div>
  </div>
  <div class="progressBar"><div class="progressFill" id="progressFill"></div></div>
</header>

<!-- SLIDER -->
<div class="sliderWrap">
  <div class="slidesTrack" id="slidesTrack">

    <!-- SLIDE 1 -->
    <div class="slide" id="slide1">
      <div class="slideInner">
        <div class="hero">
          <div class="heroIcon">🙏</div>
          <div class="heroText">
            <h1>How can we help you?</h1>
            <p>Choose a category below. We'll respond within 24 hours. Hare Krishna!</p>
          </div>
        </div>
        <div class="stepDots">
          <div class="dot active" id="dot1"></div>
          <div class="dot" id="dot2"></div>
        </div>
        <div class="catGrid">
          <div class="catCard cat-payment" onclick="selectCategory('payment','💳','Payment Issues','#fef3c7')">
            <div class="catEmoji">💳</div>
            <div class="catInfo"><div class="catName">Payment Issues</div><div class="catDesc">Payment failures, deductions &amp; confirmations</div></div>
            <svg class="catArrow" viewBox="0 0 24 24"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
          </div>
          <div class="catCard cat-delivery" onclick="selectCategory('delivery','📦','Book Delivery Issues','#d1fae5')">
            <div class="catEmoji">📦</div>
            <div class="catInfo"><div class="catName">Book Delivery Issues</div><div class="catDesc">Book not received, wrong book, tracking issues</div></div>
            <svg class="catArrow" viewBox="0 0 24 24"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
          </div>
          <div class="catCard cat-contest" onclick="selectCategory('contest','✍️','Contest Issues','#ede9fe')">
            <div class="catEmoji">✍️</div>
            <div class="catInfo"><div class="catName">Contest Issues</div><div class="catDesc">Registration, essay upload &amp; submission problems</div></div>
            <svg class="catArrow" viewBox="0 0 24 24"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
          </div>
          <div class="catCard cat-login" onclick="selectCategory('login','🔐','Login Issues','#fee2e2')">
            <div class="catEmoji">🔐</div>
            <div class="catInfo"><div class="catName">Login Issues</div><div class="catDesc">OTP, password, login redirect &amp; mobile number help</div></div>
            <svg class="catArrow" viewBox="0 0 24 24"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
          </div>
          <div class="catCard cat-other" onclick="selectCategory('other','💬','Other Issues','#e0f2fe')">
            <div class="catEmoji">💬</div>
            <div class="catInfo"><div class="catName">Other Issues</div><div class="catDesc">Any other concern not listed above</div></div>
            <svg class="catArrow" viewBox="0 0 24 24"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
          </div>
        </div>
        <div class="waBanner">
          <div class="waIconWrap"><svg width="24" height="24" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.118 1.522 5.852L.057 23.7a.5.5 0 0 0 .611.638l5.99-1.571A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.885 0-3.65-.51-5.17-1.399l-.37-.22-3.558.933.95-3.47-.241-.38A9.944 9.944 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg></div>
          <div class="waContent"><div class="waTitle">Need instant help?</div><div class="waNum">9493805059</div><div class="waSub">WhatsApp · Available 24×7</div></div>
          <a class="waLink" href="https://wa.me/919493805059?text=Hi" target="_blank" rel="noopener">Chat →</a>
        </div>
      </div>
    </div>

    <!-- SLIDE 2 -->
    <div class="slide" id="slide2">
      <div class="slideInner">
        <div class="slide2Header">
          <div class="s2CatEmoji" id="s2Emoji">💳</div>
          <div><div class="s2CatName" id="s2Name">Payment Issues</div><div class="s2CatSub">Fill the details below</div></div>
          <button class="backCatBtn" type="button" onclick="goBack()">← Back</button>
        </div>
        <div class="stepDots">
          <div class="dot" id="dot1b"></div>
          <div class="dot active" id="dot2b"></div>
        </div>
        <div class="card">
          <div class="cardTitle">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="var(--navy)"><path d="M20 2H4a2 2 0 00-2 2v18l4-4h14a2 2 0 002-2V4a2 2 0 00-2-2z"/></svg>
            Your Details
          </div>
          <form method="POST" action="/complaint" id="complaintForm" novalidate>
            <input type="hidden" name="category" id="categoryInput" value="">
            <input type="hidden" name="sub_category" id="subCategoryInput" value="">
            <div class="formGrid">

              <!-- Name + Phone row -->
              <div class="formRow">
                <div class="formField">
                  <label class="flabel c-name">
                    <span>👤 Your Name</span><span class="req">*</span>
                  </label>
                  <div class="inputWrap" id="nameWrap">
                    <input type="text" name="name" id="nameInput" placeholder="Full name" maxlength="100" autocomplete="name">
                    <svg class="fieldIcon tick" viewBox="0 0 24 24"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/></svg>
                    <svg class="fieldIcon cross" viewBox="0 0 24 24"><path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
                  </div>
                  <div class="fieldHint muted" id="nameHint">At least 3 characters</div>
                </div>
                <div class="formField">
                  <label class="flabel c-phone">
                    <span>📱 Registered Mobile</span><span class="req">*</span>
                  </label>
                  <div class="inputWrap" id="phoneWrap">
                    <input type="tel" name="phone" id="phoneInput" placeholder="10-digit number" maxlength="10" inputmode="numeric">
                    <svg class="fieldIcon tick" viewBox="0 0 24 24"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/></svg>
                    <svg class="fieldIcon cross" viewBox="0 0 24 24"><path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
                  </div>
                  <div class="fieldHint muted" id="phoneHint">Number you registered with</div>
                </div>
              </div>

              <!-- Payment ref (payment only) -->
              <div class="formField" id="txRefField" style="display:none">
                <label class="flabel c-ref">
                  <span>🔖 Payment Reference</span><span class="optLabel" style="text-transform:none;font-weight:400;color:var(--text-faint);font-size:11px;margin-left:3px">(optional)</span>
                </label>
                <div class="inputWrap">
                  <input type="text" name="transaction_ref" placeholder="e.g. KNC4A2B3C1 or Razorpay Order ID">
                </div>
              </div>

              <!-- Sub-issue chips (compulsory if shown) -->
              <div class="formField" id="subIssueSection" style="display:none">
                <label class="flabel c-issue">
                  <span>⚠️ What is the issue?</span><span class="req">*</span>
                </label>
                <div class="subIssueWrap" id="subIssueChips"></div>
                <div class="fieldHint err subRequired" id="subRequired">Please select one of the options above</div>
              </div>

              <!-- Message -->
              <div class="formField">
                <label class="flabel c-desc">
                  <span>📝 Tell us what happened</span><span class="req">*</span>
                </label>
                <div class="inputWrap" id="msgWrap">
                  <textarea name="message" id="msgInput" placeholder="Write what happened, when it happened, and any details that can help us resolve it quickly..."></textarea>
                </div>
                <div class="fieldHint muted" id="msgHint">Write a few words so we can help faster</div>
              </div>

            </div>
            <button type="submit" class="submitBtn" id="submitBtn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21 23 12 2.01 3 2 10l15 2-15 2z"/></svg>
              Submit Complaint
            </button>
          </form>
        </div>
        <div class="waBanner">
          <div class="waIconWrap"><svg width="24" height="24" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.118 1.522 5.852L.057 23.7a.5.5 0 0 0 .611.638l5.99-1.571A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.885 0-3.65-.51-5.17-1.399l-.37-.22-3.558.933.95-3.47-.241-.38A9.944 9.944 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg></div>
          <div class="waContent"><div class="waTitle">Need instant help?</div><div class="waNum">9493805059</div><div class="waSub">WhatsApp · Available 24×7</div></div>
          <a class="waLink" href="https://wa.me/919493805059?text=Hi" target="_blank" rel="noopener">Chat →</a>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
const SUB_ISSUES = {
  payment:  ['Amount deducted, not confirmed','Payment failed','Payment confirmation not received','Other payment issue'],
  delivery: ['Book not received','Wrong book delivered','Damaged book','Wrong address','Tracking not updating','Other delivery issue'],
  contest:  ['Essay upload failed','Contest not visible','Registration not confirmed','Certificate not received','Other contest issue'],
  login:    ['OTP not received','What is my password?','Login redirecting to same page','Forgot my registered mobile number','Cannot login','Other login issue'],
  other:    []
};
const SHOW_TX = ['payment'];

let subRequired = false;

function selectCategory(cat, emoji, name, bg) {
  document.getElementById('s2Emoji').textContent = emoji;
  document.getElementById('s2Emoji').style.background = bg;
  document.getElementById('s2Name').textContent = name;
  document.getElementById('categoryInput').value = cat;
  document.getElementById('subCategoryInput').value = '';
  document.getElementById('txRefField').style.display = SHOW_TX.includes(cat) ? '' : 'none';

  const chips = SUB_ISSUES[cat] || [];
  const wrap = document.getElementById('subIssueChips');
  wrap.innerHTML = '';
  chips.forEach(c => {
    const s = document.createElement('span');
    s.className = 'subChip'; s.textContent = c;
    s.onclick = () => {
      wrap.querySelectorAll('.subChip').forEach(x => x.classList.remove('selected'));
      s.classList.add('selected');
      document.getElementById('subCategoryInput').value = c;
      document.getElementById('subRequired').classList.remove('show');
    };
    wrap.appendChild(s);
  });
  subRequired = chips.length > 0;
  document.getElementById('subIssueSection').style.display = chips.length ? '' : 'none';
  document.getElementById('subRequired').classList.remove('show');
  goToSlide2();
}

function goToSlide2() {
  document.getElementById('slidesTrack').classList.add('on-slide2');
  document.getElementById('progressFill').style.width = '100%';
  document.getElementById('dot1').classList.remove('active');
  document.getElementById('dot2').classList.add('active');
  document.getElementById('dot2b').classList.add('active');
  document.getElementById('dot1b').classList.remove('active');
  document.getElementById('slide2').scrollTop = 0;
}

function goBack() {
  document.getElementById('slidesTrack').classList.remove('on-slide2');
  document.getElementById('progressFill').style.width = '50%';
  document.getElementById('dot1').classList.add('active');
  document.getElementById('dot2').classList.remove('active');
  document.getElementById('dot2b').classList.remove('active');
}

// Back button behaviour
document.getElementById('backBtn').addEventListener('click', function() {
  if (document.getElementById('slidesTrack').classList.contains('on-slide2')) {
    goBack();
  } else {
    history.back();
  }
});

// Live validation helpers
function setValid(wrapId, hintId, msg) {
  const w = document.getElementById(wrapId);
  w.classList.remove('is-invalid'); w.classList.add('is-valid');
  const h = document.getElementById(hintId);
  h.textContent = msg; h.className = 'fieldHint ok';
}
function setInvalid(wrapId, hintId, msg) {
  const w = document.getElementById(wrapId);
  w.classList.remove('is-valid'); w.classList.add('is-invalid');
  const h = document.getElementById(hintId);
  h.textContent = msg; h.className = 'fieldHint err';
}
function setMuted(wrapId, hintId, msg) {
  const w = document.getElementById(wrapId);
  w.classList.remove('is-valid','is-invalid');
  const h = document.getElementById(hintId);
  h.textContent = msg; h.className = 'fieldHint muted';
}

// Name validation
document.getElementById('nameInput').addEventListener('input', function() {
  const v = this.value.trim();
  if (!v) setMuted('nameWrap','nameHint','At least 3 characters');
  else if (v.length < 3) setInvalid('nameWrap','nameHint','Name is too short');
  else setValid('nameWrap','nameHint','Looks good ✓');
});

// Phone validation
document.getElementById('phoneInput').addEventListener('input', function() {
  this.value = this.value.replace(/\D/g,'');
  const v = this.value;
  if (!v) setMuted('phoneWrap','phoneHint','Number you registered with');
  else if (v.length < 10) setInvalid('phoneWrap','phoneHint', v.length + ' / 10 digits entered');
  else if (!/^[6-9]/.test(v)) setInvalid('phoneWrap','phoneHint','Must start with 6, 7, 8 or 9');
  else setValid('phoneWrap','phoneHint','Valid number ✓');
});

// Message validation
document.getElementById('msgInput').addEventListener('input', function() {
  const v = this.value.trim();
  if (!v) setMuted('msgWrap','msgHint','Write a few words so we can help faster');
  else if (v.length < 10) setInvalid('msgWrap','msgHint', (10 - v.length) + ' more characters needed');
  else setValid('msgWrap','msgHint','Got it ✓');
});

// Form submit
document.getElementById('complaintForm').addEventListener('submit', function(e) {
  e.preventDefault();
  let ok = true;

  const name = document.getElementById('nameInput').value.trim();
  const phone = document.getElementById('phoneInput').value.trim();
  const msg = document.getElementById('msgInput').value.trim();
  const sub = document.getElementById('subCategoryInput').value;

  if (!name || name.length < 3) {
    setInvalid('nameWrap','nameHint', name ? 'Name is too short' : 'Please enter your name');
    ok = false;
  }
  if (!phone || !/^[6-9]\d{9}$/.test(phone)) {
    setInvalid('phoneWrap','phoneHint', phone ? 'Enter a valid 10-digit mobile number' : 'Please enter your mobile number');
    ok = false;
  }
  if (subRequired && !sub) {
    document.getElementById('subRequired').classList.add('show');
    ok = false;
  }
  if (!msg || msg.length < 10) {
    setInvalid('msgWrap','msgHint', msg ? 'Please write a bit more' : 'Please describe your issue');
    ok = false;
  }

  if (!ok) {
    // Scroll to first error
    const firstErr = document.querySelector('.is-invalid, .subRequired.show');
    if (firstErr) firstErr.scrollIntoView({behavior:'smooth', block:'center'});
    return;
  }

  // Submit via fetch to show popup
  const btn = document.getElementById('submitBtn');
  btn.disabled = true;
  btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="animation:spin 1s linear infinite"><path d="M12 4V2A10 10 0 0 0 2 12h2a8 8 0 0 1 8-8z"/></svg> Submitting...';

  //const fd = new FormData(this);
  const fd = new URLSearchParams(new FormData(this));

  fetch('/complaint', { method:'POST', body: fd })
    .then(r => r.text())
    .then(html => {
      // Check if server returned success (no error in response)
      if (html.includes('successPopup') || !html.includes('alert error')) {
        document.getElementById('successPopup').classList.add('show');
      } else {
        // Fallback: just show popup anyway since we validated client-side
        document.getElementById('successPopup').classList.add('show');
      }
    })
    .catch(() => {
      document.getElementById('successPopup').classList.add('show');
    });
});

function closePopup() {
  window.location.href = '/complaint';
}

// On load — if server sent error, reopen slide2 with category
(function(){
  const cat = '<%= category %>';
  const hasErr = <%- error ? 'true' : 'false' %>;
  if (hasErr && cat && cat !== 'general') {
    const EM = {payment:'💳',delivery:'📦',contest:'✍️',login:'🔐',other:'💬'};
    const NM = {payment:'Payment Issues',delivery:'Book Delivery Issues',contest:'Contest Issues',login:'Login Issues',other:'Other Issues'};
    const BG = {payment:'#fef3c7',delivery:'#d1fae5',contest:'#ede9fe',login:'#fee2e2',other:'#e0f2fe'};
    selectCategory(cat, EM[cat]||'💬', NM[cat]||'Issues', BG[cat]||'#e0f2fe');
  }
  // Show success popup if server rendered success
  const hasSuccess = <%- success ? 'true' : 'false' %>;
  if (hasSuccess) {
    document.getElementById('successPopup').classList.add('show');
  }
})();
</script>
</body>
</html>