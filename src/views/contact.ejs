<!DOCTYPE html>
<html lang="en">
<head>
  <title>Contact Us - Iskcon Tirupati Essay Writing Contest 2026</title>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
  <style>
    :root{--navy:#0e1a5e;--navy2:#1a237e;--navy3:#283593;--navy4:#3949ab;--gold:#f59e0b;--gold2:#fbbf24;--gold3:#fef3c7;--gold-dark:#78350f;--green:#10b981;--green-lt:#d1fae5;--green-dark:#065f46;--red-lt:#fee2e2;--red-dark:#991b1b;--bg:#eef1fb;--surface:#fff;--border:#c5cae9;--border-lt:#e8eaf6;--text-h:#0f172a;--text-b:#1e293b;--text-mid:#334155;--text-muted:#64748b;--sh:0 8px 32px rgba(14,26,94,.14)}
    *{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:'DM Sans',system-ui,sans-serif;background:#0d1340;color:#fff;min-height:100vh;-webkit-font-smoothing:antialiased}
    body::before{content:'';position:fixed;inset:0;background-image:radial-gradient(rgba(255,255,255,.04) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;z-index:0}
    a{text-decoration:none;color:inherit}
    img{display:block;max-width:100%}

    /* ── NAV ── */
    .topnav{position:sticky;top:0;z-index:200;background:rgba(14,26,94,.92);backdrop-filter:blur(14px);border-bottom:1px solid rgba(255,215,0,.1);padding:0 20px}
    .topnav-inner{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;height:60px;gap:12px}
    .tnav-brand{display:flex;align-items:center;gap:9px}
    .tnav-logo{width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,var(--navy3),var(--navy4));display:grid;place-items:center;border:1px solid rgba(255,215,0,.22);flex-shrink:0}
    .tnav-logo svg{width:18px;height:18px;fill:#ffd700}
    .tnav-title{font-family:'Sora',sans-serif;font-size:13px;font-weight:700;background:linear-gradient(90deg,#ffd700,#fff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:240px}
    .tnav-btns{display:flex;gap:8px;flex-shrink:0}
    .tnav-btn{padding:7px 16px;border-radius:999px;font-family:'Sora',sans-serif;font-size:12px;font-weight:700;transition:all .18s;border:none;cursor:pointer}
    .tnav-ghost{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);color:#fff}
    .tnav-ghost:hover{background:rgba(255,255,255,.14)}
    .tnav-gold{background:linear-gradient(135deg,#d97706,#f59e0b);color:#fff;box-shadow:0 4px 14px rgba(217,119,6,.28)}
    .tnav-gold:hover{transform:translateY(-1px);box-shadow:0 6px 18px rgba(217,119,6,.4)}

    /* ── PAGE WRAPPER ── */
    .page-wrap{position:relative;z-index:1;max-width:900px;margin:0 auto;padding:32px 20px 60px}

    /* ── BACK BUTTON ── */
    .back-btn{display:inline-flex;align-items:center;gap:7px;color:rgba(255,255,255,.7);font-family:'Sora',sans-serif;font-size:13px;font-weight:700;padding:8px 16px;border-radius:999px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);margin-bottom:22px;transition:all .18s}
    .back-btn:hover{color:#ffd700;border-color:rgba(255,215,0,.35);background:rgba(255,215,0,.07);transform:translateX(-3px)}
    .back-btn svg{width:15px;height:15px;fill:currentColor}

    /* ── PAGE HEADER ── */
    .page-header{background:linear-gradient(135deg,rgba(26,35,126,.7),rgba(40,53,147,.5));border:1.5px solid rgba(255,215,0,.18);border-radius:24px;padding:40px 32px;text-align:center;margin-bottom:28px;position:relative;overflow:hidden}
    .page-header::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%,rgba(245,158,11,.1) 0%,transparent 60%);pointer-events:none}
    .page-header-icon{font-size:48px;margin-bottom:14px;display:block}
    .page-header h1{font-family:'Sora',sans-serif;font-size:clamp(22px,4vw,34px);font-weight:800;background:linear-gradient(135deg,#ffd700,#fff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:8px}
    .page-header p{font-size:14px;color:rgba(255,255,255,.6)}

    /* ── CARD ── */
    .card{background:rgba(255,255,255,.05);border:1.5px solid rgba(255,215,0,.12);border-radius:20px;padding:28px 26px;margin-bottom:20px}
    .card-blue{background:rgba(26,35,126,.25);border-color:rgba(92,107,192,.3)}
    .card-gold{background:rgba(245,158,11,.08);border-color:rgba(245,158,11,.28)}
    .card-red{background:rgba(239,68,68,.08);border-color:rgba(239,68,68,.28)}
    .card-green{background:rgba(16,185,129,.08);border-color:rgba(16,185,129,.28)}

    /* ── SECTION ── */
    .sec{margin-bottom:28px}
    .sec-title{font-family:'Sora',sans-serif;font-size:18px;font-weight:700;color:#ffd700;margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid rgba(255,215,0,.18);display:flex;align-items:center;gap:8px}
    .sec-title span{font-size:20px}

    /* ── TEXT ── */
    .body-text{font-size:14px;color:rgba(255,255,255,.78);line-height:1.82;margin-bottom:14px}
    .body-text strong{color:#fde68a}
    .body-text a{color:#fbbf24;font-weight:600;transition:color .15s}
    .body-text a:hover{color:#ffd700}

    /* ── LISTS ── */
    .styled-list{padding-left:0;list-style:none;display:flex;flex-direction:column;gap:9px}
    .styled-list li{display:flex;align-items:flex-start;gap:10px;font-size:14px;color:rgba(255,255,255,.78);line-height:1.65}
    .styled-list li::before{content:'';width:7px;height:7px;border-radius:50%;background:#f59e0b;flex-shrink:0;margin-top:6px}
    .styled-list li strong{color:#fde68a}

    /* ── INFO ROWS ── */
    .info-row{display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid rgba(255,255,255,.06)}
    .info-row:last-child{border-bottom:none;padding-bottom:0}
    .info-icon{font-size:20px;flex-shrink:0;margin-top:1px}
    .info-label{font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:2px}
    .info-val{font-size:14px;color:rgba(255,255,255,.85);font-weight:500}
    .info-val a{color:#fbbf24;font-weight:600}
    .info-val a:hover{color:#ffd700}

    /* ── ALERT BOXES ── */
    .alert-warn{background:rgba(239,68,68,.1);border:1.5px solid rgba(239,68,68,.3);border-radius:14px;padding:14px 16px;margin-bottom:18px;font-size:13px;color:#fca5a5;font-weight:600;display:flex;gap:10px;align-items:flex-start}
    .alert-info{background:rgba(59,130,246,.1);border:1.5px solid rgba(59,130,246,.28);border-radius:14px;padding:14px 16px;margin-bottom:18px;font-size:13px;color:#93c5fd;font-weight:600;display:flex;gap:10px;align-items:flex-start}
    .alert-success{background:rgba(16,185,129,.1);border:1.5px solid rgba(16,185,129,.28);border-radius:14px;padding:14px 16px;margin-bottom:18px;font-size:13px;color:#6ee7b7;font-weight:600;display:flex;gap:10px;align-items:flex-start}

    /* ── CONTACT CARDS ── */
    .contact-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin-bottom:20px}
    .ccontact{background:rgba(255,255,255,.05);border:1.5px solid rgba(255,215,0,.18);border-radius:18px;padding:22px 16px;text-align:center;transition:transform .2s,border-color .2s}
    .ccontact:hover{transform:translateY(-4px);border-color:#ffd700}
    .ccontact-icon{font-size:36px;margin-bottom:10px}
    .ccontact-label{font-family:'Sora',sans-serif;font-size:12px;font-weight:700;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.4px;margin-bottom:5px}
    .ccontact-val{font-family:'Sora',sans-serif;font-size:15px;font-weight:700;color:#ffd700}
    .ccontact-val a{color:#ffd700;transition:color .15s}
    .ccontact-val a:hover{color:#fff}

    /* ── FOOTER ── */
    .page-footer{background:rgba(6,14,48,.8);border-top:1px solid rgba(255,215,0,.1);padding:22px 20px;text-align:center;margin-top:40px}
    .page-footer-inner{max-width:900px;margin:0 auto}
    .footer-links{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-bottom:14px}
    .footer-links a{font-size:13px;color:rgba(255,255,255,.45);padding:4px 10px;border-radius:6px;transition:all .18s}
    .footer-links a:hover{color:#ffd700;background:rgba(255,215,0,.07)}
    .footer-copy{font-size:12px;color:rgba(255,255,255,.28)}

    /* ── PILLARS GRID ── */
    .pillars{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-top:4px}
    .pillar{background:rgba(255,255,255,.05);border:1px solid rgba(255,215,0,.12);border-radius:14px;padding:14px;display:flex;gap:10px;align-items:flex-start}
    .pillar .pi{font-size:20px;flex-shrink:0}
    .pillar .ptitle{font-family:'Sora',sans-serif;font-size:13px;font-weight:700;color:#ffd700;margin-bottom:3px}
    .pillar .pdesc{font-size:12px;color:rgba(255,255,255,.58);line-height:1.5}

    /* ── STATS ROW ── */
    .stats-row{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:6px}
    .stat-box{flex:1;min-width:120px;background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.25);border-radius:14px;padding:14px;text-align:center}
    .stat-box strong{font-family:'Sora',sans-serif;font-size:22px;font-weight:800;color:#ffd700;display:block;margin-bottom:3px}
    .stat-box span{font-size:11px;color:rgba(255,255,255,.55)}

    @media(max-width:600px){.page-wrap{padding:24px 14px 48px}.page-header{padding:28px 20px}.card{padding:20px 16px}.tnav-title{max-width:150px;font-size:12px}}
  .wa-float{position:fixed;bottom:24px;right:20px;width:54px;height:54px;border-radius:50%;background:linear-gradient(135deg,#25d366,#128c7e);display:flex;align-items:center;justify-content:center;box-shadow:0 6px 20px rgba(37,211,102,.45);z-index:99;transition:transform .18s,box-shadow .18s;border:3px solid rgba(255,255,255,.3)}
  .wa-float:hover{transform:scale(1.1);box-shadow:0 10px 28px rgba(37,211,102,.6)}
  .wa-float svg{width:28px;height:28px;fill:#fff}
  .wa-pulse{position:absolute;inset:-4px;border-radius:50%;background:rgba(37,211,102,.3);animation:wap 2s ease-out infinite}
  @keyframes wap{0%{transform:scale(1);opacity:.7}100%{transform:scale(1.5);opacity:0}}
  .hours-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}
  @media(max-width:480px){.hours-grid{grid-template-columns:1fr}}
  .hour-box{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);border-radius:12px;padding:12px 14px}
  .hour-box .hb-label{font-size:11px;font-weight:700;color:rgba(255,255,255,.45);text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px}
  .hour-box .hb-val{font-family:'Sora',sans-serif;font-size:14px;font-weight:700;color:#fde68a}
  </style>
</head>
