<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Track Delivery - Iskcon Tirupati Essay Writing Contest</title>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
  <style>
    :root{
      --navy:#1a237e;--navy-mid:#283593;--navy-lt:#3949ab;--navy-ghost:#eef2ff;
      --green:#10b981;--green-lt:#d1fae5;--green-dark:#065f46;
      --amber:#f59e0b;--amber-lt:#fef3c7;--amber-dark:#92400e;
      --rose:#ef4444;--rose-lt:#fee2e2;--rose-dark:#991b1b;
      --bg:#eef1fb;--surface:#fff;--border:#c5cae9;--border-lt:#e8eaf6;
      --text-h:#0f172a;--text-b:#1e293b;--text-mid:#334155;--text-muted:#64748b;--text-faint:#94a3b8;
      --sh-sm:0 4px 12px rgba(26,35,126,.08);--sh-md:0 8px 24px rgba(26,35,126,.11);
      --safe-bottom:calc(76px + env(safe-area-inset-bottom));
    }
    *{box-sizing:border-box;margin:0;padding:0}html,body{height:100%}
    body{font-family:'DM Sans',system-ui,sans-serif;background:var(--bg);color:var(--text-b);padding-bottom:var(--safe-bottom);-webkit-font-smoothing:antialiased}
    a{text-decoration:none;color:inherit}

    .app{max-width:560px;margin:0 auto;min-height:100vh}
    .topbar{position:sticky;top:0;z-index:90;background:linear-gradient(135deg,#1a237e 0%,#283593 55%,#3949ab 100%);color:#fff;padding-top:max(10px,env(safe-area-inset-top));box-shadow:0 6px 24px rgba(26,35,126,.3)}
    .topbarInner{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 16px 13px;min-height:68px}
    .brand{flex:1;min-width:0;display:flex;align-items:center;gap:10px;overflow:hidden}
    .topbar-logo-wrap{flex-shrink:0;width:clamp(42px,11vw,54px);height:clamp(42px,11vw,54px);display:flex;align-items:center;justify-content:center}
    .topbar-logo-img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 2px 10px rgba(0,0,0,.4))}
    .topbar-title{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:1.25}
    .topbar-title-line1{font-family:'Sora',sans-serif;font-size:clamp(14px,4vw,19px);font-weight:800;color:#ffd700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:.2px}
    .topbar-title-line2{font-family:'Sora',sans-serif;font-size:clamp(10px,2.8vw,13px);font-weight:600;color:rgba(255,255,255,.88);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:.1px}
    .topActions{flex-shrink:0;display:flex;align-items:center;gap:8px}
    .iconBtn{position:relative;width:42px;height:42px;border-radius:13px;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.13);color:#fff;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;transition:background .16s,transform .12s}
    .iconBtn:hover{background:rgba(255,255,255,.22)}.iconBtn:active{transform:scale(.93)}
    .iconBtn svg{width:20px;height:20px;fill:currentColor}.iconBtn.danger svg{fill:#fca5a5}
    @media(max-width:420px){
      .topbarInner{min-height:62px;padding:8px 12px 11px;gap:8px}
      .topbar-logo-wrap{width:38px;height:38px}
      .topbar-title-line1{font-size:clamp(13px,3.8vw,16px)}
      .topbar-title-line2{font-size:clamp(9px,2.6vw,11px)}
      .iconBtn{width:38px;height:38px}
      .iconBtn svg{width:18px;height:18px}
    }

    .page{padding:14px 12px 24px}
    .hero{background:linear-gradient(135deg,#eef4ff 0%,#fff 60%,#fff8e6 100%);border:1.5px solid #d8e0f8;border-radius:24px;padding:16px;box-shadow:var(--sh-sm);margin-bottom:14px}
    .hero h1{font-family:'Sora',sans-serif;font-size:20px;font-weight:800;color:var(--text-h);margin-bottom:4px}
    .hero p{font-size:13px;color:var(--text-muted);line-height:1.6}

    .grid{display:grid;gap:12px}

    .deliveryCard{
      background:#fff;border:1.5px solid var(--border-lt);border-radius:20px;
      box-shadow:var(--sh-sm);overflow:hidden;
      transition:box-shadow .2s,transform .2s;
    }
    .deliveryCard:hover{box-shadow:var(--sh-md);transform:translateY(-2px)}

    .cardHeader{
      padding:13px 16px;
      background:linear-gradient(135deg,#fafbff,#f0f4ff);
      border-bottom:1.5px solid var(--border-lt);
      display:flex;justify-content:space-between;align-items:flex-start;gap:12px;
    }
    .cardTitle{font-family:'Sora',sans-serif;font-size:14px;font-weight:700;color:var(--text-h);line-height:1.3}

    .statusBadge{
      display:inline-flex;align-items:center;gap:5px;
      padding:6px 11px;border-radius:999px;font-size:11px;font-weight:700;white-space:nowrap;flex-shrink:0;
    }
    .status-processing{background:var(--navy-ghost);color:var(--navy);border:1px solid var(--border)}
    .status-dispatched{background:var(--amber-lt);color:var(--amber-dark);border:1px solid #fde68a}
    .status-delivered{background:var(--green-lt);color:var(--green-dark);border:1px solid #a7f3d0}
    .status-returned{background:var(--rose-lt);color:var(--rose-dark);border:1px solid #fecaca}

    .cardBody{padding:13px 16px;display:grid;gap:10px}

    .trackRow{display:flex;gap:12px;align-items:flex-start}
    .trackDot{
      width:32px;height:32px;border-radius:10px;background:var(--navy-ghost);
      display:grid;place-items:center;font-size:14px;flex-shrink:0;margin-top:1px
    }
    .trackInfo{flex:1;min-width:0}
    .trackLabel{font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:2px}
    .trackVal{font-size:14px;font-weight:600;color:var(--text-b);line-height:1.45}
    .trackVal.mono{font-family:'Sora',sans-serif;font-size:13px;word-break:break-word}
    .trackVal.faint{color:var(--text-faint);font-weight:400;font-size:13px}

    .divider{height:1px;background:var(--border-lt)}

    .trackActions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:8px}
    .copyBtn,.trackLinkBtn{
      appearance:none;border:none;cursor:pointer;
      display:inline-flex;align-items:center;gap:6px;
      padding:8px 12px;border-radius:999px;
      font-size:12px;font-weight:700;line-height:1;
      transition:transform .12s ease, box-shadow .16s ease, background .16s ease;
    }
    .copyBtn{
      color:#1a237e;
      background:linear-gradient(135deg,#eef2ff,#e0e7ff);
      border:1px solid #c7d2fe;
      box-shadow:0 4px 12px rgba(26,35,126,.08);
    }
    .copyBtn:hover{transform:translateY(-1px);box-shadow:0 8px 18px rgba(26,35,126,.12)}
    .copyBtn:active{transform:scale(.97)}
    .trackLinkBtn{
      color:#92400e;
      background:linear-gradient(135deg,#fff7ed,#fffbeb);
      border:1px solid #fed7aa;
      box-shadow:0 4px 12px rgba(245,158,11,.08);
    }
    .trackLinkBtn:hover{transform:translateY(-1px)}
    .noteText{font-size:12px;line-height:1.55;color:var(--text-muted);margin-top:4px}

    .emptyCard{background:#fff;border:1.5px dashed var(--border);border-radius:20px;padding:28px 16px;text-align:center;color:var(--text-muted)}
    .emptyCard .emptyIcon{font-size:40px;margin-bottom:10px}
    .emptyCard .emptyTitle{font-family:'Sora',sans-serif;font-size:15px;font-weight:700;color:var(--text-mid);margin-bottom:6px}
    .emptyCard .emptyText{font-size:13px;line-height:1.6}

    .bottomNav{position:fixed;left:50%;transform:translateX(-50%);bottom:0;width:min(560px,100%);background:#fff;border-top:1.5px solid #e8eaf6;box-shadow:0 -6px 24px rgba(26,35,126,.09);padding-bottom:max(10px,env(safe-area-inset-bottom));z-index:98}
    .bottomNavInner{display:grid;grid-template-columns:repeat(5,1fr);padding:0 4px 0}
    .navBtn{
      display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;
      min-height:58px;color:#64748b;font-size:10px;font-weight:700;
      text-align:center;transition:color .15s;position:relative;padding-top:6px;
    }
    .navBtn svg{width:21px;height:21px;fill:currentColor;transition:transform .2s}
    .navBtn::before{
      content:'';position:absolute;top:0;left:50%;transform:translateX(-50%) scaleX(0);
      width:32px;height:3px;border-radius:0 0 4px 4px;
      background:linear-gradient(90deg,var(--navy),var(--navy-lt));
      transition:transform .22s cubic-bezier(.34,1.56,.64,1),opacity .2s;
      opacity:0;
    }
    .navBtn.active{color:var(--navy)}
    .navBtn.active::before{transform:translateX(-50%) scaleX(1);opacity:1}
    .navBtn.active svg{transform:translateY(-1px)}
  </style>
</head>
<body>
<div class="app">
  <header class="topbar">
    <div class="topbarInner">
      <div class="brand">
        <div class="topbar-logo-wrap">
          <img src="/images/logo_new.png" alt="Iskcon Tirupati" class="topbar-logo-img" onerror="this.style.display='none'">
        </div>
        <div class="topbar-title">
          <span class="topbar-title-line1">Iskcon Tirupati</span>
          <span class="topbar-title-line2">Essay Writing Contest</span>
        </div>
      </div>
      <div class="topActions">
        <a class="iconBtn danger" href="/logout" id="logoutBtn" title="Logout">
          <svg viewBox="0 0 24 24"><path d="M10 17l1.41-1.41L8.83 13H20v-2H8.83l2.58-2.59L10 7l-5 5zm-6 2h8v2H4a2 2 0 0 1-2-2V5c0-1.1.9-2 2-2h8v2H4z"/></svg>
        </a>
      </div>
    </div>
  </header>

  <main class="page">
    <section class="hero">
      <h1>Book Delivery / Pickup 📦</h1>
      <p>Track your home delivery shipment or see the status of books to be collected directly from the temple.</p>
    </section>

    <% if(!shipments || shipments.length === 0){ %>
      <div class="emptyCard">
        <div class="emptyIcon">📭</div>
        <div class="emptyTitle">No Delivery Records Found</div>
        <div class="emptyText">No shipment or temple-pickup record is available yet for your paid gift-book orders. Donation orders will not appear here.</div>
      </div>
    <% } else { %>
      <div class="grid">
        <% shipments.forEach(s => { %>
          <%
            const st = String(s.status || 'pending').trim().toLowerCase();
            const mode = String(s.delivery_mode || 'home_delivery').trim().toLowerCase();
            const normalizedTrackingId = String(s.tracking_id || '').trim();

            let statusClass = 'status-processing';
            if (st === 'dispatched') statusClass = 'status-dispatched';
            else if (st === 'delivered' || st === 'handed_over') statusClass = 'status-delivered';
            else if (st === 'returned') statusClass = 'status-returned';

            const modeLabel = mode === 'temple_pickup' ? 'Temple Pickup' : 'Home Delivery';

            const deliveryTimeMap = {
              home_delivery: {
                pending: 'Expected delivery within 10 to 15 days.',
                under_packing: 'Expected delivery within 10 to 12 days.',
                packed: 'Expected delivery within 7 to 10 days.',
                dispatched: 'Expected delivery within 5 to 7 days.',
                delivered: 'Delivery completed successfully.',
                returned: 'Returned shipment is being reprocessed. It may take around 10 to 15 days.',
                handed_over: 'Successfully handed over.'
              },
              temple_pickup: {
                pending: 'Please collect your books directly from the temple.',
                handed_over: 'Pickup completed successfully.'
              }
            };

            const deliveryTimeText =
              (deliveryTimeMap[mode] && deliveryTimeMap[mode][st]) ||
              'Status updated. Please check again shortly.';

            const courierLabel =
              mode === 'temple_pickup'
                ? (st === 'handed_over' ? 'Collected from temple' : 'Awaiting temple pickup')
                : (String(s.courier_mode || '').trim() || 'India Post');

            const showTrackingId = mode === 'home_delivery' && st === 'dispatched' && !!normalizedTrackingId;
            const showTrackingLink = mode === 'home_delivery';
            const trackingLink = 'https://www.indiapost.gov.in/';

            const displayStatus = String(s.status || 'pending')
              .replace(/_/g, ' ')
              .replace(/\b\w/g, ch => ch.toUpperCase());

            let statusIcon = '⏳';
            if (st === 'dispatched') statusIcon = '🚚';
            else if (st === 'delivered' || st === 'handed_over') statusIcon = '✅';
            else if (st === 'returned') statusIcon = '↩️';
          %>

          <div class="deliveryCard">
            <div class="cardHeader">
              <div>
                <div class="cardTitle"><%= s.title %></div>
                <div style="margin-top:6px;font-size:12px;color:var(--text-muted);font-weight:700;"><%= modeLabel %></div>
              </div>
              <span class="statusBadge <%= statusClass %>">
                <%= statusIcon %> <%= displayStatus %>
              </span>
            </div>

            <div class="cardBody">
              <div class="trackRow">
                <div class="trackDot"><%= mode === 'temple_pickup' ? '🏛️' : '🚛' %></div>
                <div class="trackInfo">
                  <div class="trackLabel">Mode</div>
                  <div class="trackVal"><%= modeLabel %></div>
                </div>
              </div>

              <div class="divider"></div>

              <div class="trackRow">
                <div class="trackDot"><%= mode === 'temple_pickup' ? '📍' : '🚚' %></div>
                <div class="trackInfo">
                  <div class="trackLabel"><%= mode === 'temple_pickup' ? 'Pickup Status' : 'Courier' %></div>
                  <div class="trackVal"><%= courierLabel %></div>
                  <% if (mode === 'temple_pickup' && st === 'pending') { %>
                    <div class="noteText">Your books are ready for temple collection once handover is completed by our team.</div>
                  <% } %>
                </div>
              </div>

              <% if (showTrackingId) { %>
                <div class="divider"></div>

                <div class="trackRow">
                  <div class="trackDot">🔍</div>
                  <div class="trackInfo">
                    <div class="trackLabel">Tracking ID</div>
                    <div class="trackVal mono"><%= normalizedTrackingId %></div>
                    <div class="trackActions">
                      <button
                        type="button"
                        class="copyBtn js-copy-track"
                        data-track-id="<%- normalizedTrackingId %>">
                        📋 Copy ID
                      </button>
                    </div>
                  </div>
                </div>
              <% } %>

              <% if (showTrackingLink) { %>
                <div class="divider"></div>

                <div class="trackRow">
                  <div class="trackDot">🌐</div>
                  <div class="trackInfo">
                    <div class="trackLabel">India Post Tracking</div>
                    <div class="trackVal">Use the official India Post website to track your shipment status.</div>
                    <div class="trackActions">
                      <a
                        class="trackLinkBtn"
                        href="<%= trackingLink %>"
                        target="_blank"
                        rel="noopener noreferrer">
                        Open India Post
                      </a>
                    </div>
                  </div>
                </div>
              <% } %>

              <div class="divider"></div>

              <div class="trackRow">
                <div class="trackDot">⏱️</div>
                <div class="trackInfo">
                  <div class="trackLabel"><%= mode === 'temple_pickup' ? 'Pickup Note' : 'Delivery Time' %></div>
                  <div class="trackVal"><%= deliveryTimeText %></div>
                </div>
              </div>

              <div class="divider"></div>

              <div class="trackRow">
                <div class="trackDot">🕐</div>
                <div class="trackInfo">
                  <div class="trackLabel">Last Updated</div>
                  <div class="trackVal <%= !s.updated_at ? 'faint' : '' %>">
                    <%= s.updated_at ? new Date(s.updated_at).toDateString() : '-' %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>

  <nav class="bottomNav">
    <div class="bottomNavInner">
      <a class="navBtn" href="/dashboard"><svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg><span>Home</span></a>
      <a class="navBtn" href="/dashboard/my-contests"><svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3ZM8 11c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3Zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13Zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.96 1.97 3.45V19h6v-2.5C23 14.17 18.33 13 16 13Z"/></svg><span>My Contests</span></a>
      <a class="navBtn" href="/dashboard/profile"><svg viewBox="0 0 24 24"><path d="M12 12c2.7 0 5-2.3 5-5s-2.3-5-5-5-5 2.3-5 5 2.3 5 5 5Zm0 2c-3.3 0-10 1.7-10 5v3h20v-3c0-3.3-6.7-5-10-5Z"/></svg><span>Profile</span></a>
      <a class="navBtn active" href="/dashboard/delivery"><svg viewBox="0 0 24 24"><path d="M20 8h-3V4H1v13h2a3 3 0 0 0 6 0h6a3 3 0 0 0 6 0h2v-5l-3-4ZM6 18.5A1.5 1.5 0 1 1 6 15a1.5 1.5 0 0 1 0 3.5Zm12 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3ZM17 9.5h2.2l1.3 1.8H17V9.5Z"/></svg><span>Track</span></a>
      <a class="navBtn" href="/dashboard/help"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20Zm0 17a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5Zm1.37-7.75-.57.39c-.86.59-1.3 1.08-1.3 2.11v.25h-2v-.31c0-1.63.75-2.47 1.85-3.22l.79-.54c.46-.31.74-.71.74-1.25 0-.92-.74-1.56-1.79-1.56-1.02 0-1.76.58-2.02 1.55l-1.94-.47C7.6 5.88 9.08 5 11.06 5c2.2 0 3.81 1.31 3.81 3.32 0 1.18-.55 2.11-1.5 2.77Z"/></svg><span>Help</span></a>
    </div>
  </nav>
</div>

<script>
  document.addEventListener('click', async function (e) {
    const btn = e.target.closest('.js-copy-track');
    if (!btn) return;

    const value = (btn.getAttribute('data-track-id') || '').trim();
    if (!value) return;

    const originalText = btn.textContent;

    try {
      await navigator.clipboard.writeText(value);
      btn.textContent = '✅ Copied';
      setTimeout(() => {
        btn.textContent = originalText;
      }, 1600);
    } catch (_err) {
      btn.textContent = '❌ Copy failed';
      setTimeout(() => {
        btn.textContent = originalText;
      }, 1600);
    }
  });
</script>
</body>
</html>