<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>My Contests - Iskcon Tirupati Essay Contest</title>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
  <style>
    :root{--navy:#1a237e;--navy-mid:#283593;--navy-lt:#3949ab;--navy-ghost:#eef2ff;--green:#10b981;--green-lt:#d1fae5;--green-dark:#065f46;--red:#ef4444;--red-lt:#fee2e2;--red-dark:#991b1b;--amber:#f59e0b;--amber-lt:#fef3c7;--amber-dark:#92400e;--bg:#eef1fb;--surface:#fff;--border:#c5cae9;--border-lt:#e8eaf6;--text-h:#0f172a;--text-b:#1e293b;--text-mid:#334155;--text-muted:#64748b;--text-faint:#94a3b8;--sh-sm:0 4px 16px rgba(26,35,126,.10);--sh-md:0 10px 30px rgba(26,35,126,.16);--safe-bottom:calc(76px + env(safe-area-inset-bottom))}
    *{box-sizing:border-box;margin:0;padding:0}html,body{height:100%}
    body{font-family:'DM Sans',system-ui,sans-serif;background:var(--bg);color:var(--text-b);padding-bottom:var(--safe-bottom);-webkit-font-smoothing:antialiased}
    a{text-decoration:none;color:inherit}
    .app{max-width:560px;margin:0 auto;min-height:100vh}

    .brand{flex:1;min-width:0;display:flex;align-items:center;gap:8px;overflow:hidden}
    .topbar-logo-wrap{flex-shrink:0;width:clamp(36px,9vw,46px);height:clamp(36px,9vw,46px);display:flex;align-items:center;justify-content:center}
.topbar-logo-img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 2px 8px rgba(0,0,0,.35))}
    .topbar-title{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:1.2}
    .topbar-title-line1{font-family:'Sora',sans-serif;font-size:clamp(12px,3.2vw,16px);font-weight:800;color:#ffd700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:.1px}
    .topbar-title-line2{font-family:'Sora',sans-serif;font-size:clamp(9px,2.4vw,12px);font-weight:600;color:rgba(255,255,255,.82);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:.1px}

    .topbar{position:sticky;top:0;z-index:90;background:linear-gradient(135deg,#1a237e 0%,#283593 55%,#3949ab 100%);color:#fff;padding-top:max(10px,env(safe-area-inset-top));box-shadow:0 6px 24px rgba(26,35,126,.3)}
    .topbarInner{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 14px 13px;min-height:66px}
    .brand{display:flex;align-items:center;gap:10px;min-width:0;flex:1}
    .logoWrap{width:36px;height:36px;border-radius:11px;overflow:hidden;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);flex-shrink:0}
    .logoWrap img{width:100%;height:100%;object-fit:cover}
    .brandTitle{font-family:'Sora',sans-serif;font-size:14px;font-weight:700;line-height:1.2;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .iconBtn{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:13px;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.13);color:#fff;cursor:pointer;transition:background .16s,transform .12s}
    .iconBtn:hover{background:rgba(255,255,255,.22)}.iconBtn:active{transform:scale(.93)}
    .iconBtn svg{width:20px;height:20px;fill:currentColor}.iconBtn.danger svg{fill:#fca5a5}
    .page {
  padding: 14px 12px calc(var(--safe-bottom) + 20px);
}

    .hero{background:linear-gradient(135deg,#eef4ff 0%,#fff 60%,#fff8e6 100%);border:1.5px solid #d8e0f8;border-radius:24px;padding:16px;box-shadow:var(--sh-sm);margin-bottom:14px}
    .hero h1{font-family:'Sora',sans-serif;font-size:20px;font-weight:800;color:var(--text-h);margin-bottom:4px}
    .hero p{font-size:13px;color:var(--text-muted);line-height:1.6}
    /* count badge */
    .countRow{display:flex;align-items:center;gap:8px;margin-bottom:10px}
    .sectionTitle{font-family:'Sora',sans-serif;font-size:17px;font-weight:700;color:var(--text-h);margin:0;padding:0 2px}
    .countBadge{background:linear-gradient(135deg,var(--navy),var(--navy-lt));color:#fff;border-radius:999px;padding:3px 10px;font-family:'Sora',sans-serif;font-size:12px;font-weight:800}
    .cards{display:grid;gap:14px}
    /* RAISED card with deeper shadow */
    .mineCard{background:#fff;border:1.5px solid var(--border-lt);border-radius:22px;box-shadow:0 6px 22px rgba(26,35,126,.12),0 2px 6px rgba(26,35,126,.06);overflow:hidden;transition:box-shadow .2s,transform .2s}
    .mineCard:hover{box-shadow:0 12px 36px rgba(26,35,126,.18),0 4px 10px rgba(26,35,126,.08);transform:translateY(-3px)}
    .mineTop{padding:14px 16px;background:linear-gradient(135deg,#f5f7ff 0%,#eef2ff 100%);border-bottom:1.5px solid var(--border-lt)}
    .mineTitle{font-family:'Sora',sans-serif;font-size:16px;font-weight:800;color:var(--text-h);margin-bottom:4px}
    .mineDesc{font-size:13px;color:#5b6778;line-height:1.55;margin-bottom:8px}
    .mineMeta{display:flex;flex-wrap:wrap;gap:6px}
    .pill{display:inline-flex;align-items:center;gap:4px;padding:5px 9px;border-radius:999px;font-size:11px;font-weight:700}
    .pill-gray{background:#f8fafc;color:var(--text-mid);border:1px solid #e2e8f0}
    .pill-navy{background:var(--navy-ghost);color:var(--navy);border:1px solid var(--border)}
    .pill-green{background:var(--green-lt);color:var(--green-dark);border:1px solid #a7f3d0}
    .pill-red{background:var(--red-lt);color:var(--red-dark);border:1px solid #fecaca}
    .mineBody{padding:14px;display:grid;gap:10px}
    .box{border:1.5px solid var(--border-lt);border-radius:16px;padding:13px;background:#fafbff}
    .boxTitle{font-family:'Sora',sans-serif;font-size:13px;font-weight:700;color:var(--text-h);margin-bottom:8px;display:flex;align-items:center;gap:6px}
    .boxTitle .dot{width:6px;height:6px;border-radius:50%;background:var(--navy);flex-shrink:0}
    .muted{font-size:12px;color:var(--text-muted);line-height:1.7}.muted b{color:var(--text-mid);font-weight:600}
    .timeleft{display:inline-flex;margin-top:8px;padding:6px 10px;border-radius:999px;font-size:11px;font-weight:700}
    .tagTime{background:var(--navy-ghost);color:var(--navy);border:1px solid var(--border)}
    .tagClosed{background:var(--red-lt);color:var(--red-dark);border:1px solid #fecaca}
    .uploadRow{display:flex;flex-direction:column;gap:8px;margin-top:10px}
    .fileInput{width:100%;border:1.5px solid #d1d8f0;border-radius:10px;background:#fff;padding:10px 12px;font-size:13px;color:var(--text-b);transition:border-color .16s}
    .fileInput:focus{border-color:var(--navy-lt);outline:none}
    .uploadBtn{border:none;border-radius:12px;padding:12px 14px;background:linear-gradient(135deg,#0f766e,#0d9488);color:#fff;font-family:'Sora',sans-serif;font-size:13px;font-weight:700;cursor:pointer;box-shadow:0 5px 14px rgba(13,148,136,.28);transition:transform .14s,box-shadow .14s;display:flex;align-items:center;justify-content:center;gap:6px}
    .uploadBtn:hover{transform:translateY(-2px);box-shadow:0 8px 18px rgba(13,148,136,.38)}.uploadBtn:active{transform:scale(.96)}.uploadBtn:disabled{opacity:.5;cursor:not-allowed;transform:none}
    .downloadBtn{display:flex;justify-content:center;align-items:center;gap:6px;width:100%;border:1.5px solid var(--border);border-radius:12px;padding:11px 13px;font-family:'Sora',sans-serif;font-size:13px;font-weight:700;background:#fff;color:var(--text-b);margin-top:8px;transition:background .14s}
    .downloadBtn:hover{background:var(--navy-ghost)}
    progress{width:100%;display:none;margin-top:6px;height:6px;border-radius:99px;overflow:hidden}
    progress::-webkit-progress-bar{background:#e8eaf6}progress::-webkit-progress-value{background:linear-gradient(90deg,var(--navy),var(--navy-lt))}
    .status{font-size:12px;font-weight:700;min-height:16px;margin-top:4px}.statusErr{color:var(--red-dark)}.statusOk{color:var(--green-dark)}.statusWarn{color:var(--amber-dark)}
    .rulesBox{background:var(--amber-lt);border:1px solid #fde68a;border-radius:10px;padding:10px 12px;font-size:12px;color:var(--amber-dark);line-height:1.6}
    .empty{background:#fff;border:1.5px dashed var(--border);color:var(--text-muted);border-radius:18px;padding:28px 16px;text-align:center;font-size:14px}
    /* toast */
    .toast{position:fixed;bottom:calc(76px + env(safe-area-inset-bottom) + 12px);left:50%;transform:translateX(-50%) translateY(16px);background:#1e293b;color:#fff;border-radius:14px;padding:12px 18px;font-size:13px;font-weight:600;z-index:200;box-shadow:0 8px 24px rgba(0,0,0,.3);opacity:0;transition:opacity .22s,transform .22s;pointer-events:none;max-width:calc(100vw - 32px);text-align:center}
    .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}.toast.err{background:#7f1d1d}.toast.ok{background:#065f46}
    /* custom dialog */
    .dialog-overlay{position:fixed;inset:0;background:rgba(15,23,42,.55);display:none;align-items:center;justify-content:center;padding:20px;z-index:150;backdrop-filter:blur(3px)}
    .dialog-overlay.show{display:flex}
    .dialog{background:#fff;border-radius:22px;padding:22px 20px;width:min(360px,100%);box-shadow:0 24px 60px rgba(0,0,0,.28)}
    .dialog h3{font-family:'Sora',sans-serif;font-size:17px;font-weight:800;color:var(--text-h);margin-bottom:8px}
    .dialog p{font-size:14px;color:var(--text-mid);line-height:1.6;margin-bottom:18px}
    .dialogBtns{display:flex;gap:10px;justify-content:flex-end}
    .dialogBtn{border-radius:11px;padding:10px 18px;font-family:'Sora',sans-serif;font-size:13px;font-weight:700;cursor:pointer;border:none;transition:opacity .14s}
    .dialogBtn.cancel{background:#f1f5f9;color:var(--text-mid)}.dialogBtn.cancel:hover{background:#e2e8f0}
    .dialogBtn.confirm{background:linear-gradient(135deg,#0f766e,#0d9488);color:#fff;box-shadow:0 4px 12px rgba(13,148,136,.28)}.dialogBtn.confirm:hover{opacity:.9}
    .bottomNav{position:fixed;left:50%;transform:translateX(-50%);bottom:0;width:min(560px,100%);background:#fff;border-top:1.5px solid #e8eaf6;box-shadow:0 -6px 24px rgba(26,35,126,.09);padding-bottom:max(10px,env(safe-area-inset-bottom));z-index:98}
    .bottomNavInner{display:grid;grid-template-columns:repeat(5,1fr);padding:0 4px 0}
    .navBtn{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;min-height:58px;color:#64748b;font-size:10px;font-weight:700;text-align:center;transition:color .15s;position:relative;padding-top:6px}
    .navBtn svg{width:21px;height:21px;fill:currentColor;transition:transform .2s}
    .navBtn::before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%) scaleX(0);width:32px;height:3px;border-radius:0 0 4px 4px;background:linear-gradient(90deg,var(--navy),var(--navy-lt));transition:transform .22s cubic-bezier(.34,1.56,.64,1),opacity .2s;opacity:0}
    .navBtn.active{color:var(--navy)}
    .navBtn.active::before{transform:translateX(-50%) scaleX(1);opacity:1}
    .navBtn.active svg{transform:translateY(-1px)}
    /* ── Rewards row ── */
    .rewardsRow{display:grid;grid-template-columns:1fr 1fr;gap:8px}
    .rewardBtn{
      display:flex;align-items:center;gap:8px;
      border:1.5px solid var(--border-lt);border-radius:14px;
      padding:11px 10px;background:#fff;cursor:pointer;
      transition:border-color .16s,background .16s;
      text-align:left;width:100%;min-width:0;overflow:hidden;
    }
    .rewardBtn:hover{border-color:var(--navy-lt);background:var(--navy-ghost)}
    .rewardBtn:active{transform:scale(.97)}
    .certBtn{border-color:#c7d2fe}.certBtn:hover{border-color:#818cf8;background:#eef2ff}
    .courseBtn{border-color:#a7f3d0}.courseBtn:hover{border-color:#34d399;background:#f0fdf4}
    .rewardBtnIcon{font-size:20px;flex-shrink:0;line-height:1}
    .rewardBtnText{display:flex;flex-direction:column;gap:2px;min-width:0;overflow:hidden}
    .rewardBtnLabel{font-family:'Sora',sans-serif;font-size:11px;font-weight:700;color:var(--text-h);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .rewardBtnSub{font-size:10px;font-weight:600;color:var(--text-muted);white-space:nowrap}
    /* ── Coming soon modal ── */
    .csOverlay{position:fixed;inset:0;background:rgba(15,23,42,.55);display:none;align-items:center;justify-content:center;padding:20px;z-index:160;backdrop-filter:blur(4px)}
    .csOverlay.show{display:flex}
    .csModal{background:#fff;border-radius:24px;box-shadow:0 24px 60px rgba(0,0,0,.25);width:min(340px,100%);padding:28px 22px 22px;text-align:center;transform:translateY(20px) scale(.97);transition:transform .22s cubic-bezier(.34,1.56,.64,1)}
    .csOverlay.show .csModal{transform:translateY(0) scale(1)}
    .csModalIcon{font-size:46px;margin-bottom:12px;display:block;animation:iconBounce .5s .1s cubic-bezier(.34,1.56,.64,1) both}
    @keyframes iconBounce{from{transform:scale(0);opacity:0}to{transform:scale(1);opacity:1}}
    .csModalTitle{font-family:'Sora',sans-serif;font-size:17px;font-weight:800;color:var(--text-h);margin-bottom:8px}
    .csModalBadge{display:inline-flex;align-items:center;gap:6px;background:var(--navy-ghost);border:1.5px solid var(--border);border-radius:999px;padding:5px 14px;font-family:'Sora',sans-serif;font-size:11px;font-weight:700;color:var(--navy);margin-bottom:14px}
    .csModalBody{font-size:13px;color:var(--text-mid);line-height:1.65;margin-bottom:20px}
    .csModalBody strong{color:var(--navy);font-weight:700}
    .csModalClose{width:100%;border:none;border-radius:13px;padding:13px;background:linear-gradient(135deg,var(--navy),var(--navy-lt));color:#fff;font-family:'Sora',sans-serif;font-size:14px;font-weight:700;cursor:pointer;box-shadow:0 6px 18px rgba(26,35,126,.22);transition:transform .14s}
    .csModalClose:hover{transform:translateY(-1px)}
  </style>
</head>
<body>
<%
  function formatDateOnly(d){ if(!d)return'-'; return new Date(d).toLocaleDateString('en-GB',{timeZone:'Asia/Kolkata'}); }
  function formatDateTime(d){ if(!d)return'-'; return new Date(d).toLocaleString('en-IN',{timeZone:'Asia/Kolkata'}); }
%>
<div class="app">
  <header class="topbar">
    <div class="topbarInner">
      <div class="brand">
        <div class="topbar-logo-wrap">
          <img src="/images/logo_new.png" alt="Iskcon Tirupati" class="topbar-logo-img" onerror="this.style.display='none'">
        </div>
        <div class="topbar-title">
          <span class="topbar-title-line1">Iskcon Tirupati</span>
          <span class="topbar-title-line2">Essay Writing Contest</span>
        </div>
      </div>

      <a class="iconBtn danger" href="/logout" id="logoutBtn" title="Logout"><svg viewBox="0 0 24 24"><path d="M10 17l1.41-1.41L8.83 13H20v-2H8.83l2.58-2.59L10 7l-5 5zm-6 2h8v2H4a2 2 0 0 1-2-2V5c0-1.1.9-2 2-2h8v2H4z"/></svg></a>
    </div>
  </header>
  <main class="page">
    <section class="hero">
      <h1>My Contests 🏆</h1>
      <p>Upload or replace your essay before the deadline. Maximum <b>3 attempts</b> per contest.</p>
    </section>
    <div class="countRow">
      <h2 class="sectionTitle">Purchased Contests</h2>
      <span class="countBadge" id="contestCount">0</span>
    </div>
    <% if(!registered||!registered.length){ %>
      <div class="empty">You haven't joined any contest yet.<br>Go to Home to browse available contests.</div>
    <% } else { %>
      <div class="cards">
        <% registered.forEach((r,idx)=>{ %>
          <div class="mineCard contest-card"
            data-order-id="<%= r.order_id %>"
            data-has-submission="<%= r.file_url?'1':'0' %>"
            data-attempts-used="<%= Number(r.attempts_used||0) %>"
            data-deadline-passed="<%= r.deadline_passed?'1':'0' %>">
            <div class="mineTop">
              <div class="mineTitle"><%= r.title %></div>
              <div class="mineMeta">
                <span class="pill pill-navy">Age: <%= r.age_category==='above-25'?'Above 25 yrs':'0–25 yrs' %></span>
                <% if(r.submission_deadline){ %><span class="pill pill-gray">⏰ <%= formatDateTime(r.submission_deadline) %></span><% } %>
                <% if(r.deadline_passed){ %><span class="pill pill-red">● Closed</span><% }else{ %><span class="pill pill-green">● Open</span><% } %>
              </div>
            </div>
            <div class="mineBody">
              <div class="box">
                <div class="boxTitle"><span class="dot"></span>Current Submission</div>
                <% if(r.file_url){ %>
                  <div class="muted"><div><b>File:</b> <%= r.original_name||'Uploaded submission' %></div><div><b>Uploaded:</b> <%= formatDateTime(r.uploaded_at||r.last_updated_at) %></div><div><b>Attempts:</b> <%= Number(r.attempts_used||0) %> / 3</div></div>
                  <a class="downloadBtn" href="/dashboard/submission/download?orderId=<%= encodeURIComponent(r.order_id) %>"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 9h-4V3H9v6H5l7 7 7-7ZM5 18v2h14v-2H5Z"/></svg>Download My Submission</a>
                <% }else{ %>
                  <div class="muted">No submission yet.<br><b>Attempts:</b> <%= Number(r.attempts_used||0) %> / 3</div>
                <% } %>
                <% if(r.submission_deadline){ %>
                  <div class="timeleft <%= r.deadline_passed?'tagClosed':'tagTime' %>" data-seconds-left="<%= Number(r.seconds_left||0) %>"><%= r.deadline_passed?'Deadline passed':'⏳ Time remaining' %></div>
                <% } %>
              </div>
              <div class="box">
                <div class="boxTitle"><span class="dot"></span>Upload / Replace Essay</div>
                <div class="rulesBox">PDF, DOC, DOCX, JPG, JPEG, PNG or WEBP · Max 5 MB · Max 3 attempts</div>
                <% if(r.deadline_passed){ %>
                  <div class="status statusErr" style="margin-top:10px">Submission deadline has passed.</div>
                <% }else{ %>
                  <div class="uploadRow">
                    <input class="fileInput" type="file" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"/>
                    <button class="uploadBtn upload-btn" type="button" data-order-id="<%= r.order_id %>">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16h6v-6h4l-7-7-7 7h4v6Zm-4 2h14v2H5v-2Z"/></svg>
                      <%= r.file_url?'Replace Submission':'Upload Submission' %>
                    </button>
                    <progress max="100" value="0"></progress>
                    <div class="status"></div>
                  </div>
                <% } %>
              </div>
              <!-- Rewards -->
              <div class="rewardsRow">
                <button class="rewardBtn certBtn" type="button" onclick="openComingSoon('cert')">
                  <span class="rewardBtnIcon">🎓</span>
                  <span class="rewardBtnText">
                    <span class="rewardBtnLabel">Download Certificate</span>
                    <span class="rewardBtnSub">After results</span>
                  </span>
                </button>
                <button class="rewardBtn courseBtn" type="button" onclick="openComingSoon('course')">
                  <span class="rewardBtnIcon">📖</span>
                  <span class="rewardBtnText">
                    <span class="rewardBtnLabel">Free Course</span>
                    <span class="rewardBtnSub">For participants</span>
                  </span>
                </button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>
  <nav class="bottomNav">
    <div class="bottomNavInner">
      <a class="navBtn" href="/dashboard"><svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg><span>Home</span></a>
      <a class="navBtn active" href="/dashboard/my-contests"><svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3ZM8 11c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3Zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13Zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.96 1.97 3.45V19h6v-2.5C23 14.17 18.33 13 16 13Z"/></svg><span>My Contests</span></a>
      <a class="navBtn" href="/dashboard/profile"><svg viewBox="0 0 24 24"><path d="M12 12c2.7 0 5-2.3 5-5s-2.3-5-5-5-5 2.3-5 5 2.3 5 5 5Zm0 2c-3.3 0-10 1.7-10 5v3h20v-3c0-3.3-6.7-5-10-5Z"/></svg><span>Profile</span></a>
      <a class="navBtn" href="/dashboard/delivery"><svg viewBox="0 0 24 24"><path d="M20 8h-3V4H1v13h2a3 3 0 0 0 6 0h6a3 3 0 0 0 6 0h2v-5l-3-4ZM6 18.5A1.5 1.5 0 1 1 6 15a1.5 1.5 0 0 1 0 3.5Zm12 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3ZM17 9.5h2.2l1.3 1.8H17V9.5Z"/></svg><span>Track</span></a>
      <a class="navBtn" href="/dashboard/help"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20Zm0 17a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5Zm1.37-7.75-.57.39c-.86.59-1.3 1.08-1.3 2.11v.25h-2v-.31c0-1.63.75-2.47 1.85-3.22l.79-.54c.46-.31.74-.71.74-1.25 0-.92-.74-1.56-1.79-1.56-1.02 0-1.76.58-2.02 1.55l-1.94-.47C7.6 5.88 9.08 5 11.06 5c2.2 0 3.81 1.31 3.81 3.32 0 1.18-.55 2.11-1.5 2.77Z"/></svg><span>Help</span></a>
    </div>
  </nav>
</div>
<div class="toast" id="toast"></div>
<!-- Coming soon modal -->
<div class="csOverlay" id="csOverlay" onclick="if(event.target===this)closeComingSoon()">
  <div class="csModal">
    <span class="csModalIcon" id="csModalIcon">🎓</span>
    <div class="csModalTitle" id="csModalTitle">Coming Soon!</div>
    <div class="csModalBadge">⏳ After Results Are Announced</div>
    <div class="csModalBody" id="csModalBody"></div>
    <button class="csModalClose" onclick="closeComingSoon()">Got it, I'll check back later</button>
  </div>
</div>
<!-- Custom confirm dialog -->
<div class="dialog-overlay" id="dialogOverlay">
  <div class="dialog">
    <h3 id="dialogTitle">Confirm</h3>
    <p id="dialogMsg">Are you sure?</p>
    <div class="dialogBtns">
      <button class="dialogBtn cancel" id="dialogCancel">Cancel</button>
      <button class="dialogBtn confirm" id="dialogConfirm">Continue</button>
    </div>
  </div>
</div>

<script>
(function(){
  /* dynamic contest count */
  const cards=document.querySelectorAll('.contest-card');
  const countBadge=document.getElementById('contestCount');
  if(countBadge)countBadge.textContent=String(cards.length);

  /* toast */
  let toastT;
  function showToast(msg,type=''){const t=document.getElementById('toast');t.textContent=msg;t.className='toast'+(type?' '+type:'');void t.offsetWidth;t.classList.add('show');clearTimeout(toastT);toastT=setTimeout(()=>t.classList.remove('show'),2800)}

  /* custom dialog */
  function showDialog(title,msg){return new Promise(res=>{const overlay=document.getElementById('dialogOverlay');document.getElementById('dialogTitle').textContent=title;document.getElementById('dialogMsg').textContent=msg;overlay.classList.add('show');function cleanup(result){overlay.classList.remove('show');document.getElementById('dialogConfirm').removeEventListener('click',onOk);document.getElementById('dialogCancel').removeEventListener('click',onCancel);res(result)}function onOk(){cleanup(true)}function onCancel(){cleanup(false)}document.getElementById('dialogConfirm').addEventListener('click',onOk);document.getElementById('dialogCancel').addEventListener('click',onCancel)})}

const MAX_ATTEMPTS = 3;
const allowedExt = new Set(['pdf','doc','docx','jpg','jpeg','png','webp']);
const MAX_MB = 5;


function extOf(name){
  const m = String(name || '').toLowerCase().match(/\.([a-z0-9]+)$/);
  return m ? m[1] : '';
}

function validateFile(file){
  if(!file){
    return { ok:false, msg:'Please choose a file first.' };
  }

  if (file.size === 0) {
    return { 
       ok: false, 
       msg: 'Please download the file to your device first, then upload.' 
    };
  }
	
  if(file.size > MAX_MB * 1024 * 1024){
    return { ok:false, msg:`File is too large. Maximum allowed size is ${MAX_MB} MB.` };
  }

  const mime = String(file.type || '').toLowerCase();
  const ext = extOf(file.name);

  const okMime =
    mime === 'application/pdf' ||
    mime === 'application/msword' ||
    mime === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' ||
    mime === 'image/jpeg' ||
    mime === 'image/png' ||
    mime === 'image/webp';

  if(!(okMime || allowedExt.has(ext))){
    return {
      ok:false,
      msg:'Only PDF, DOC, DOCX, JPG, JPEG, PNG, or WEBP files are accepted.'
    };
  }

  return { ok:true };
}

  function formatLeft(seconds){const s=Math.max(0,Math.floor(Number(seconds||0)));const d=Math.floor(s/86400);const h=Math.floor((s%86400)/3600);if(s<=0)return'Deadline passed';if(d>0)return`${d}d ${h}h left`;return`${h}h left`}
  function setErr(el,msg){if(!el)return;el.textContent=msg;el.className='status statusErr'}
  function setOk(el,msg){if(!el)return;el.textContent=msg;el.className='status statusOk'}
  function setInfo(el,msg){if(!el)return;el.textContent=msg;el.className='status statusWarn'}

  function initTimeLeft(){const nodes=document.querySelectorAll('.timeleft[data-seconds-left]');nodes.forEach(n=>{n.textContent=formatLeft(Number(n.getAttribute('data-seconds-left')||'0'))});setInterval(()=>{nodes.forEach(n=>{const next=Number(n.getAttribute('data-seconds-left')||'0')-60;n.setAttribute('data-seconds-left',String(next));n.textContent=formatLeft(next);if(next<=0){n.classList.add('tagClosed');n.classList.remove('tagTime')}})},60000)}

  function initAttemptLocks(){document.querySelectorAll('.contest-card').forEach(card=>{const used=Number(card.getAttribute('data-attempts-used')||'0');if(card.getAttribute('data-deadline-passed')==='1')return;if(used>=MAX_ATTEMPTS){const file=card.querySelector('.fileInput');const btn=card.querySelector('.upload-btn');const status=card.querySelector('.status');if(file)file.disabled=true;if(btn)btn.disabled=true;if(status)setErr(status,'Max 3 submissions reached.')}})}

  async function logFailure(orderId,stage,message,meta){try{await fetch('/dashboard/upload/log',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({orderId,stage,message,meta})})}catch{}}


  /**
   * Customer uploads go through OUR server (same-origin), then the server
   * writes to S3. Browser→S3 direct PUT fails for many mobile/ISP networks
   * even when the website itself loads fine. Admin path is separate.
   */
  async function uploadFile(orderId, file, ui) {
    setInfo(ui.status, 'Starting upload...');
    ui.prog.style.display = 'block';
    ui.prog.value = 0;

    const contentType = file.type || 'application/octet-stream';
    let key;

    try {
      const startRes = await fetch('/dashboard/upload/start', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          orderId,
          fileName: file.name,
          contentType,
          fileSize: file.size
        })
      });
      const start = await startRes.json().catch(() => ({}));
      if (!startRes.ok) throw new Error(start.error || 'Failed to start upload');
      key = start.key;
      if (!key) throw new Error('Failed to start upload');
    } catch (e) {
      await logFailure(orderId, 'start', e.message || 'start failed', {
        fileName: file.name,
        fileSize: file.size,
        contentType,
        browser: navigator.userAgent
      });
      throw e;
    }

    ui.prog.value = 25;
    setInfo(ui.status, 'Uploading...');

    try {
      const fd = new FormData();
      fd.append('file', file);
      fd.append('orderId', orderId);
      fd.append('key', key);
      fd.append('contentType', contentType);
      fd.append('originalName', file.name);

      const upRes = await fetch('/dashboard/upload/fallback', {
        method: 'POST',
        body: fd
      });
      const upJson = await upRes.json().catch(() => ({}));
      if (!upRes.ok) {
        throw new Error(upJson.error || 'Upload failed. Please try again.');
      }
    } catch (e) {
      await logFailure(orderId, 'server_upload', e.message || 'server upload failed', {
        fileName: file.name,
        fileSize: file.size,
        contentType,
        browser: navigator.userAgent,
        online: navigator.onLine
      });
      throw e;
    }

    ui.prog.value = 80;
    setInfo(ui.status, 'Saving submission...');

    const completeRes = await fetch('/dashboard/upload/complete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        orderId,
        key,
        contentType,
        originalName: file.name,
        fileSize: file.size
      })
    });
    const complete = await completeRes.json().catch(() => ({}));
    if (!completeRes.ok) throw new Error(complete.error || 'Failed to save submission');

    ui.prog.value = 100;
    setOk(ui.status, 'Uploaded successfully! 🎉');
    showToast('✅ Submission uploaded!', 'ok');
    setTimeout(() => window.location.reload(), 700);
  }


  initTimeLeft();initAttemptLocks();

  document.querySelectorAll('.upload-btn').forEach(btn=>{
    btn.addEventListener('click',async()=>{
      const card=btn.closest('.contest-card');const fileInput=card.querySelector('.fileInput');const status=card.querySelector('.status');const prog=card.querySelector('progress');const orderId=btn.dataset.orderId;
      const file=fileInput.files&&fileInput.files[0]?fileInput.files[0]:null;const v=validateFile(file);
      if(!v.ok){showToast('⚠️ '+v.msg,'err');setErr(status,v.msg);return}
      const attemptsUsed=Number(card.getAttribute('data-attempts-used')||'0');
      if(attemptsUsed>=MAX_ATTEMPTS){showToast('⚠️ Max 3 submissions reached.','err');setErr(status,'Attempts over.');return}
      if(card.dataset.hasSubmission==='1'){const ok=await showDialog('Replace Submission','This will replace your current submission. Are you sure you want to continue?');if(!ok)return}
      try{btn.disabled=true;await uploadFile(orderId,file,{status,prog})}
      catch(e){setErr(status,e.message||'Upload error');prog.style.display='none';showToast('⚠️ Upload failed','err')}
      finally{btn.disabled=false}
    });
  });

  document.getElementById('logoutBtn')?.addEventListener('click',function(e){if(!confirm('Are you sure you want to logout?'))e.preventDefault()});
})();

const CS_CONTENT={
  cert:{icon:'🎓',title:'Certificate Coming Soon!',body:'Once the prizes are announced, you will be able to <strong>download your participation & winner certificate</strong> directly from this page.'},
  course:{icon:'📖',title:'Free Course Coming Soon!',body:'After the results are announced, all participants will get exclusive access to <strong>attend the free course</strong>. We\'ll notify you as soon as it\'s available!'}
};
function openComingSoon(type){
  const c=CS_CONTENT[type]||CS_CONTENT.cert;
  document.getElementById('csModalIcon').textContent=c.icon;
  document.getElementById('csModalTitle').textContent=c.title;
  document.getElementById('csModalBody').innerHTML=c.body;
  document.getElementById('csOverlay').classList.add('show');
  document.body.style.overflow='hidden';
}
function closeComingSoon(){
  document.getElementById('csOverlay').classList.remove('show');
  document.body.style.overflow='';
}
</script>
</body>
