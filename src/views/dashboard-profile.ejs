<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Profile - Krishna Wisdom Contest 2026</title>
  <style>
    :root{
      --bg:#f6f7fb;--card:#fff;--ink:#132238;--muted:#64748b;--line:#e7ecf3;
      --primary:#1a237e;--primary2:#283593;--shadow:0 10px 26px rgba(15,23,42,.07);
      --safe-bottom:calc(96px + env(safe-area-inset-bottom));
    }
    *{box-sizing:border-box} html,body{margin:0;padding:0}
    body{font-family:Segoe UI,Tahoma,Verdana,sans-serif;background:var(--bg);color:var(--ink);padding-bottom:var(--safe-bottom)}
    a{text-decoration:none;color:inherit}
    input,textarea,select,button{font:inherit}
    .app{max-width:560px;margin:0 auto;min-height:100vh}
    .topbar{position:sticky;top:0;z-index:90;background:linear-gradient(135deg,var(--primary),var(--primary2));color:#fff;padding-top:max(10px, env(safe-area-inset-top))}
    .topbarInner{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 14px 14px}
    .brand{display:flex;align-items:center;gap:10px}
    .logo{width:40px;height:40px;border-radius:14px;overflow:hidden;background:#fff1;border:1px solid rgba(255,255,255,.18)}
    .logo img{width:100%;height:100%;object-fit:cover}
    .brandTitle{font-size:16px;font-weight:900;line-height:1.15}
    .iconBtn{min-width:42px;height:42px;border-radius:14px;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.12);color:#fff;display:inline-flex;align-items:center;justify-content:center;cursor:pointer}
    .page{padding:14px 12px 22px}
    .hero{background:#fff;border:1px solid var(--line);border-radius:24px;padding:16px;box-shadow:var(--shadow);margin-bottom:14px}
    .hero h1{margin:0 0 6px;font-size:21px;color:#111827}
    .hero p{margin:0;font-size:13px;color:#475569;line-height:1.6}
    .tabs{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
    .tab{display:flex;align-items:center;justify-content:center;border:1px solid #dbe4ef;background:#fff;color:#334155;border-radius:14px;padding:12px;font-weight:900;cursor:pointer}
    .tab.active{background:linear-gradient(135deg,var(--primary),#3949ab);color:#fff;border-color:transparent}
    .card{background:#fff;border:1px solid rgba(15,23,42,.08);border-radius:22px;padding:16px;box-shadow:var(--shadow)}
    .sectionCard{border:1px solid #e7edf6;border-radius:18px;padding:14px;background:#fbfdff}
    .sectionCard + .sectionCard{margin-top:14px}
    .sectionTitle{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:6px}
    .sectionTitle h3{margin:0;font-size:15px;color:#0f172a}
    .sectionSub{font-size:12px;color:#64748b;line-height:1.5;margin-bottom:12px}
    .muted{color:var(--muted)}
    .sep{height:1px;background:rgba(15,27,61,.10);margin:14px 0}
    .grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    @media (max-width:600px){.grid2{grid-template-columns:1fr}}
    label{display:block;font-size:12px;color:#64748b;font-weight:800;margin-bottom:6px}
    .labelRow{display:flex;align-items:center;gap:6px}
    .lockIcon{font-size:13px;line-height:1;color:#64748b}
    .inputWrap{position:relative}
    input,textarea,select{width:100%;padding:11px 12px;border-radius:12px;border:1px solid rgba(15,23,42,.14);background:#fff;color:#132238}
    input[readonly]{background:#f8fafc;color:#475569}
    textarea{min-height:72px;resize:vertical}
    .btn{border:none;border-radius:14px;padding:12px 14px;font-weight:900;cursor:pointer}
    .btn.primary{background:var(--primary);color:#fff;width:100%}
    .btn.ghost{background:#fff;border:1px solid #dbe4ef;color:#1e293b}
    .alert{padding:12px;border-radius:12px;font-weight:800;margin-bottom:12px}
    .alert.err{background:rgba(244,67,54,.10);border:1px solid rgba(244,67,54,.24);color:#b42318}
    .alert.ok{background:rgba(76,175,80,.10);border:1px solid rgba(76,175,80,.24);color:#027a48}
    .hint{font-size:12px;color:var(--muted);margin-top:6px}
    .passwordRow{display:flex;gap:8px;align-items:center}
    .passwordRow .inputWrap{flex:1}
    .toggleEye{
      position:absolute;right:10px;top:50%;transform:translateY(-50%);
      width:34px;height:34px;border:none;background:transparent;cursor:pointer;
      display:flex;align-items:center;justify-content:center;color:#64748b;padding:0;
    }
    .inputWithIcon{padding-right:42px}
    .hiddenBlock{display:none}
    .paymentCard{border:1px solid #e7edf6;border-radius:18px;padding:14px;margin-bottom:12px;background:#fbfdff}
    .paymentHead{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
    .paymentRef{font-weight:900;color:#0f172a;font-size:14px}
    .paymentMeta{font-size:12px;color:#64748b;line-height:1.6}
    .pill{display:inline-flex;align-items:center;padding:6px 10px;border-radius:999px;font-size:11px;font-weight:900;border:1px solid #dbe4ef;background:#f8fafc;color:#334155}
    .pill.ok{background:#ecfdf3;color:#166534;border-color:#bbf7d0}
    .pill.fail{background:#fef2f2;color:#991b1b;border-color:#fecaca}
    .pill.pending{background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe}
    .actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
    .miniBtn{display:inline-flex;align-items:center;justify-content:center;padding:10px 12px;border-radius:12px;font-weight:900;border:1px solid #dbe4ef;background:#fff;color:#1e293b}
    .miniBtn.primary{background:linear-gradient(135deg,var(--primary),#3949ab);border:none;color:#fff}
    .inlineForm{margin-top:12px;padding:12px;border:1px solid #e6edf5;border-radius:16px;background:#fff}
    .bottomNav{position:fixed;left:50%;transform:translateX(-50%);bottom:0;width:min(560px, 100%);background:#fff;border-top:1px solid #e6edf6;box-shadow:0 -10px 24px rgba(15,23,42,.08);padding-bottom:max(10px, env(safe-area-inset-bottom));z-index:98}
    .bottomNavInner{display:grid;grid-template-columns:repeat(5,1fr);padding:8px 6px 0}
    .navBtn{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;min-height:58px;color:#64748b;font-size:10px;font-weight:800;border-radius:14px;text-align:center}
    .navBtn svg{width:20px;height:20px;fill:currentColor}
    .navBtn.active{color:var(--primary);background:#eef2ff}




    .sectionCard{border:1px solid #e7edf6;border-radius:18px;padding:14px;background:#fbfdff}
.sectionCard + .sectionCard{margin-top:14px}
.sectionTitle{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:6px}
.sectionTitle h3{margin:0;font-size:15px;color:#0f172a}
.sectionSub{font-size:12px;color:#64748b;line-height:1.5;margin-bottom:12px}


.passwordRow{display:flex;gap:8px;align-items:center}
.passwordRow .inputWrap{flex:1}
.inputWrap{position:relative}
.inputWithIcon{padding-right:44px}
.hiddenBlock{display:none}
.toggleEye{
  position:absolute;
  right:10px;
  top:50%;
  transform:translateY(-50%);
  width:32px;
  height:32px;
  border:none;
  background:transparent;
  color:#64748b;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:0;
}
.toggleEye:hover{color:#1a237e}
.passwordInlineMsg{
  padding:12px;
  border-radius:12px;
  font-weight:800;
  margin-bottom:12px;
}
.passwordInlineMsg.err{
  background:rgba(244,67,54,.10);
  border:1px solid rgba(244,67,54,.24);
  color:#b42318;
}
.passwordInlineMsg.ok{
  background:rgba(76,175,80,.10);
  border:1px solid rgba(76,175,80,.24);
  color:#027a48;
}
  </style>
</head>
<body>
  <div class="app">
    <header class="topbar">
      <div class="topbarInner">
        <div class="brand">
          <div class="logo"><img src="/images/icon.png" alt="" onerror="this.style.display='none'"></div>
          <div class="brandTitle">Krishna Wisdom Contest 2026</div>
        </div>
        <a class="iconBtn" href="/logout" title="Logout" aria-label="Logout">
          <svg viewBox="0 0 24 24"><path fill="currentColor" d="M10 17l1.41-1.41L8.83 13H20v-2H8.83l2.58-2.59L10 7l-5 5zm-6 2h8v2H4a2 2 0 0 1-2-2V5c0-1.1.9-2 2-2h8v2H4z"/></svg>
        </a>
      </div>
    </header>

    <main class="page">
      <section class="hero">
        <h1>Profile & Account Settings</h1>
        <p>View your registered details, update your contact information, and manage your password from one place.</p>
      </section>

      <% if (error) { %><div class="alert err"><%= error %></div><% } %>
      <% if (success) { %><div class="alert ok"><%= success %></div><% } %>

      <div class="tabs">
        <a class="tab <%= profileTab === 'profile' ? 'active' : '' %>" href="/dashboard/profile?tab=profile">Profile</a>
        <a class="tab <%= profileTab === 'payments' ? 'active' : '' %>" href="/dashboard/profile?tab=payments">My Payments</a>
      </div>

      <% if (profileTab === 'profile') { %>
        <div class="card">

          <form method="POST" action="/dashboard/profile" id="profileForm" novalidate>
            <div class="sectionCard">
              <div class="sectionTitle">
                <h3>Registered Identity</h3>
              </div>

              <div class="grid2">
                <div>
                  <label class="labelRow">
                    <span>Full Name</span>
                    <span class="lockIcon" aria-hidden="true">🔒</span>
                  </label>
                  <input value="<%= user.name || '' %>" readonly />
                </div>
                <div>
                  <label class="labelRow">
                    <span>Mobile Number</span>
                    <span class="lockIcon" aria-hidden="true">🔒</span>
                  </label>
                  <input
                    id="phone"
                    name="phone"
                    value="<%= user.phone || '' %>"
                    readonly
                    inputmode="numeric"
                    maxlength="10"
                  />
                </div>
              </div>
            </div>

            <div class="sectionCard">
              <div class="sectionTitle">
                <h3>Contact & Address</h3>
              </div>
              <div class="grid2">
                <div>
                  <label class="labelRow">
                    <span>Email</span>
                    <% if (user.email) { %>
                      <span class="lockIcon" style="visibility:hidden;">🔒</span>
                    <% } %>
                  </label>
                  <input
                    type="email"
                    name="email"
                    value="<%= (old && old.email) || user.email || '' %>"
                    placeholder="Enter your email address"
                    autocomplete="email"
                  />
                </div>
                <div>
                  <label>Address</label>
                  <textarea name="address" placeholder="House no, Street, Area"><%= (old && old.address) || (addr && addr.address) || '' %></textarea>
                </div>
              </div>

              <div class="sep"></div>

              <div class="grid2">
                <div>
                  <label>City</label>
                  <input name="city" value="<%= (old && old.city) || (addr && addr.city) || '' %>" />
                </div>
                <div>
                  <label>State</label>
                  <select name="state">
                    <option value="">Select State</option>
                    <% const states = ["Andhra Pradesh","Arunachal Pradesh","Assam","Bihar","Chhattisgarh","Goa","Gujarat","Haryana","Himachal Pradesh","Jharkhand","Karnataka","Kerala","Madhya Pradesh","Maharashtra","Manipur","Meghalaya","Mizoram","Nagaland","Odisha","Punjab","Rajasthan","Sikkim","Tamil Nadu","Telangana","Tripura","Uttar Pradesh","Uttarakhand","West Bengal","Andaman and Nicobar Islands","Chandigarh","Dadra and Nagar Haveli and Daman and Diu","Delhi","Jammu and Kashmir","Ladakh","Lakshadweep","Puducherry"]; %>
                    <% states.forEach(s => { %>
                      <option value="<%= s %>" <%= (((old && old.state) || (addr && addr.state) || '') === s) ? 'selected' : '' %>><%= s %></option>
                    <% }) %>
                  </select>
                </div>
              </div>

              <div class="sep"></div>

              <div class="grid2">
                <div>
                  <label>Pincode</label>
                  <input name="pincode" id="pincode" inputmode="numeric" maxlength="6" value="<%= (old && old.pincode) || (addr && addr.pincode) || '' %>" />
                  <div class="hint">6-digit Indian pincode</div>
                </div>
              </div>

              <div class="sep"></div>
              <button class="btn primary" type="submit">Save Profile</button>
            </div>
          </form>


          <div class="sectionCard">
  <div class="sectionTitle">
    <h3>Reset Password</h3>
  </div>
  <div class="sectionSub">Choose a new password for your account. It must be at least 6 characters.</div>

  <div id="passwordMsg" style="display:none;"></div>

  <form id="passwordForm" novalidate>
    <div class="passwordRow" style="justify-content:flex-end;">
      <button class="btn ghost" type="button" id="showResetFieldsBtn">Reset Password</button>
    </div>

    <div id="resetFields" class="hiddenBlock">
      <div class="sep"></div>

      <div class="grid2">
        <div>
          <label>New Password</label>
          <div class="inputWrap">
            <input
              id="newPassword"
              class="inputWithIcon"
              type="password"
              name="newPassword"
              value=""
              placeholder="Minimum 6 characters"
              autocomplete="new-password"
            />
            <button class="toggleEye" type="button" data-target="newPassword" aria-label="Show or hide new password">
              <span class="eyeIcon eyeOff" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20">
                  <path fill="currentColor" d="M2.1 3.51 3.51 2.1l18.39 18.39-1.41 1.41-3.08-3.08A11.77 11.77 0 0 1 12 20C6.5 20 2 16 0 12c1.02-2.04 2.54-3.78 4.39-5.08L2.1 3.51Zm7.56 7.56A3 3 0 0 0 12.93 14.34l-3.27-3.27ZM12 6c5.5 0 10 4 12 8a12.7 12.7 0 0 1-3.59 4.35l-2.9-2.9A5 5 0 0 0 8.55 6.49L6.6 4.54A12.37 12.37 0 0 1 12 6Zm0 2a3.02 3.02 0 0 1 3 3c0 .35-.06.69-.17 1.01l-3.84-3.84c.32-.11.66-.17 1.01-.17Z"/>
                </svg>
              </span>
              <span class="eyeIcon eyeOn" aria-hidden="true" style="display:none;">
                <svg viewBox="0 0 24 24" width="20" height="20">
                  <path fill="currentColor" d="M12 5c5.5 0 10 4 12 7-2 3-6.5 7-12 7S2 15 0 12c2-3 6.5-7 12-7Zm0 2C8 7 4.73 9.11 2.4 12 4.73 14.89 8 17 12 17s7.27-2.11 9.6-5C19.27 9.11 16 7 12 7Zm0 2.5A2.5 2.5 0 1 1 9.5 12 2.5 2.5 0 0 1 12 9.5Z"/>
                </svg>
              </span>
            </button>
          </div>
        </div>

        <div>
          <label>Re-enter New Password</label>
          <div class="inputWrap">
            <input
              id="confirmNewPassword"
              class="inputWithIcon"
              type="password"
              name="confirmNewPassword"
              value=""
              placeholder="Re-enter new password"
              autocomplete="new-password"
            />
            <button class="toggleEye" type="button" data-target="confirmNewPassword" aria-label="Show or hide confirm password">
              <span class="eyeIcon eyeOff" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20">
                  <path fill="currentColor" d="M2.1 3.51 3.51 2.1l18.39 18.39-1.41 1.41-3.08-3.08A11.77 11.77 0 0 1 12 20C6.5 20 2 16 0 12c1.02-2.04 2.54-3.78 4.39-5.08L2.1 3.51Zm7.56 7.56A3 3 0 0 0 12.93 14.34l-3.27-3.27ZM12 6c5.5 0 10 4 12 8a12.7 12.7 0 0 1-3.59 4.35l-2.9-2.9A5 5 0 0 0 8.55 6.49L6.6 4.54A12.37 12.37 0 0 1 12 6Zm0 2a3.02 3.02 0 0 1 3 3c0 .35-.06.69-.17 1.01l-3.84-3.84c.32-.11.66-.17 1.01-.17Z"/>
                </svg>
              </span>
              <span class="eyeIcon eyeOn" aria-hidden="true" style="display:none;">
                <svg viewBox="0 0 24 24" width="20" height="20">
                  <path fill="currentColor" d="M12 5c5.5 0 10 4 12 7-2 3-6.5 7-12 7S2 15 0 12c2-3 6.5-7 12-7Zm0 2C8 7 4.73 9.11 2.4 12 4.73 14.89 8 17 12 17s7.27-2.11 9.6-5C19.27 9.11 16 7 12 7Zm0 2.5A2.5 2.5 0 1 1 9.5 12 2.5 2.5 0 0 1 12 9.5Z"/>
                </svg>
              </span>
            </button>
          </div>
        </div>
      </div>

      <div class="hint" style="margin-top:10px;">Password must be at least 6 characters.</div>
      <div class="sep"></div>
      <button class="btn primary" type="submit" id="savePasswordBtn">Save New Password</button>
    </div>
  </form>
</div>



        </div>
      <% } else { %>
        <div class="card">
          <% if (!payments || !payments.length) { %>
            <div class="muted">No payment attempts found yet.</div>
          <% } else { %>
            <% payments.forEach((p) => { %>
              <div class="paymentCard">
                <div class="paymentHead">
                  <div>
                    <div class="paymentRef">Reference: <%= p.internal_payment_id %></div>
                    <div class="paymentMeta"><%= p.contest_titles %></div>
                    <div class="paymentMeta"><%= p.created_at ? new Date(p.created_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) : '-' %></div>
                    <div class="paymentMeta">Total: ₹<%= Number(p.total_amount || 0) %></div>
                  </div>
                  <div>
                    <% if (String(p.status) === 'paid') { %>
                      <span class="pill ok">Success</span>
                    <% } else if (String(p.status) === 'failed') { %>
                      <span class="pill fail">Failed</span>
                    <% } else { %>
                      <span class="pill pending">Pending</span>
                    <% } %>
                  </div>
                </div>

                <div class="actions">
                  <% if (String(p.status) === 'pending') { %>
                    <a class="miniBtn primary" href="/payment/embedded?paymentId=<%= encodeURIComponent(p.internal_payment_id) %>">Resume Payment</a>
                  <% } %>

                  <% if (String(p.status) === 'failed') { %>
                    <a class="miniBtn primary" href="/payment/embedded?paymentId=<%= encodeURIComponent(p.internal_payment_id) %>">Retry Payment</a>
                  <% } %>

                  <% if (String(p.status) !== 'paid') { %>
                    <button class="miniBtn" type="button" onclick="toggleComplaint('<%= p.internal_payment_id %>')">Raise Complaint</button>
                  <% } %>
                </div>

                <% if (String(p.status) !== 'paid') { %>
                  <div class="inlineForm" id="complaint-<%= p.internal_payment_id %>" style="display:none;">
                    <form method="POST" action="/dashboard/help/ticket">
                      <input type="hidden" name="category" value="payment">
                      <input type="hidden" name="transactionRef" value="<%= p.internal_payment_id %>">
                      <label>Message</label>
                      <textarea name="message" placeholder="Describe the issue, transaction reference, or amount problem" required></textarea>
                      <div class="sep"></div>
                      <button class="miniBtn primary" type="submit">Submit Complaint</button>
                    </form>
                  </div>
                <% } %>
              </div>
            <% }) %>
          <% } %>
        </div>
      <% } %>
    </main>

    <nav class="bottomNav">
      <div class="bottomNavInner">
        <a class="navBtn" href="/dashboard">
          <svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg><span>Home</span>
        </a>
        <a class="navBtn" href="/dashboard/my-contests">
          <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3ZM8 11c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3Zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13Zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.96 1.97 3.45V19h6v-2.5C23 14.17 18.33 13 16 13Z"/></svg><span>My Contests</span>
        </a>
        <a class="navBtn active" href="/dashboard/profile">
          <svg viewBox="0 0 24 24"><path d="M12 12c2.7 0 5-2.3 5-5s-2.3-5-5-5-5 2.3-5 5 2.3 5 5 5Zm0 2c-3.3 0-10 1.7-10 5v3h20v-3c0-3.3-6.7-5-10-5Z"/></svg><span>Profile</span>
        </a>
        <a class="navBtn" href="/dashboard/delivery">
          <svg viewBox="0 0 24 24"><path d="M20 8h-3V4H1v13h2a3 3 0 0 0 6 0h6a3 3 0 0 0 6 0h2v-5l-3-4ZM6 18.5A1.5 1.5 0 1 1 6 15a1.5 1.5 0 0 1 0 3.5Zm12 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3ZM17 9.5h2.2l1.3 1.8H17V9.5Z"/></svg><span>Track</span>
        </a>
        <a class="navBtn" href="/dashboard/help">
          <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20Zm0 17a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5Zm1.37-7.75-.57.39c-.86.59-1.3 1.08-1.3 2.11v.25h-2v-.31c0-1.63.75-2.47 1.85-3.22l.79-.54c.46-.31.74-.71.74-1.25 0-.92-.74-1.56-1.79-1.56-1.02 0-1.76.58-2.02 1.55l-1.94-.47C7.6 5.88 9.08 5 11.06 5c2.2 0 3.81 1.31 3.81 3.32 0 1.18-.55 2.11-1.5 2.77Z"/></svg><span>Help</span>
        </a>
      </div>
    </nav>
  </div>

<script>
(function () {
  const pin = document.getElementById("pincode");
  const showResetFieldsBtn = document.getElementById("showResetFieldsBtn");
  const resetFields = document.getElementById("resetFields");
  const passwordForm = document.getElementById("passwordForm");
  const passwordMsg = document.getElementById("passwordMsg");
  const newPassword = document.getElementById("newPassword");
  const confirmNewPassword = document.getElementById("confirmNewPassword");
  const savePasswordBtn = document.getElementById("savePasswordBtn");

  function digitsOnly(el, max){
    if(!el) return;
    el.addEventListener("input", () => {
      el.value = el.value.replace(/\D/g,"").slice(0,max);
    });
  }

  function showPasswordMessage(type, text) {
    if (!passwordMsg) return;
    passwordMsg.className = "passwordInlineMsg " + (type === "ok" ? "ok" : "err");
    passwordMsg.textContent = text;
    passwordMsg.style.display = "block";
  }

  function clearPasswordMessage() {
    if (!passwordMsg) return;
    passwordMsg.style.display = "none";
    passwordMsg.className = "";
    passwordMsg.textContent = "";
  }

  function openResetFields() {
    if (!resetFields || !showResetFieldsBtn) return;
    resetFields.style.display = "block";
    showResetFieldsBtn.textContent = "Cancel";
  }

  function closeResetFields() {
    if (!resetFields || !showResetFieldsBtn) return;
    resetFields.style.display = "none";
    showResetFieldsBtn.textContent = "Reset Password";
  }

  function updateEyeState(btn, input) {
    const eyeOff = btn.querySelector(".eyeOff");
    const eyeOn = btn.querySelector(".eyeOn");
    const isHidden = input.type === "password";
    if (eyeOff) eyeOff.style.display = isHidden ? "inline-flex" : "none";
    if (eyeOn) eyeOn.style.display = isHidden ? "none" : "inline-flex";
  }

  digitsOnly(pin, 6);

  if (showResetFieldsBtn && resetFields) {
    showResetFieldsBtn.addEventListener("click", function () {
      clearPasswordMessage();
      const isOpen = resetFields.style.display === "block";
      if (isOpen) {
        closeResetFields();
        if (newPassword) newPassword.value = "";
        if (confirmNewPassword) confirmNewPassword.value = "";
      } else {
        openResetFields();
        if (newPassword) newPassword.focus();
      }
    });
  }

  document.querySelectorAll(".toggleEye").forEach(function (btn) {
    const targetId = btn.getAttribute("data-target");
    const input = targetId ? document.getElementById(targetId) : null;
    if (!input) return;

    updateEyeState(btn, input);

    btn.addEventListener("click", function () {
      input.type = input.type === "password" ? "text" : "password";
      updateEyeState(btn, input);
    });
  });

  if (passwordForm) {
    passwordForm.addEventListener("submit", async function (e) {
      e.preventDefault();
      clearPasswordMessage();
      openResetFields();

      const newVal = newPassword ? newPassword.value.trim() : "";
      const confirmVal = confirmNewPassword ? confirmNewPassword.value.trim() : "";

      if (!newVal || !confirmVal) {
        showPasswordMessage("err", "Please enter and confirm your new password.");
        if (newPassword) newPassword.focus();
        return;
      }

      if (newVal.length < 6) {
        showPasswordMessage("err", "New password must be at least 6 characters.");
        if (newPassword) newPassword.focus();
        return;
      }

      if (newVal !== confirmVal) {
        showPasswordMessage("err", "New passwords do not match.");
        if (confirmNewPassword) confirmNewPassword.focus();
        return;
      }

      try {
        if (savePasswordBtn) {
          savePasswordBtn.disabled = true;
          savePasswordBtn.textContent = "Saving...";
        }

        const formData = new URLSearchParams();
        formData.append("newPassword", newVal);
        formData.append("confirmNewPassword", confirmVal);

        const response = await fetch("/dashboard/profile/password", {
          method: "POST",
          headers: {
            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
            "X-Requested-With": "XMLHttpRequest"
          },
          body: formData.toString()
        });

        const data = await response.json();

        if (!response.ok || !data.ok) {
          showPasswordMessage("err", data.message || "Unable to reset password.");
          openResetFields();
          return;
        }

        showPasswordMessage("ok", data.message || "Password reset successfully.");
        if (newPassword) newPassword.value = "";
        if (confirmNewPassword) confirmNewPassword.value = "";
        closeResetFields();
      } catch (err) {
        showPasswordMessage("err", "Unable to reset password right now. Please try again.");
        openResetFields();
      } finally {
        if (savePasswordBtn) {
          savePasswordBtn.disabled = false;
          savePasswordBtn.textContent = "Save New Password";
        }
      }
    });
  }
})();

function toggleComplaint(id){
  const el = document.getElementById("complaint-" + id);
  if (!el) return;
  el.style.display = el.style.display === "none" ? "block" : "none";
}
</script>



