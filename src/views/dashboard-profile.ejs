<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Profile - Wisdom Contest 2026</title>
  <style>
    :root{--ink:#0f1b3d;--bg:#f6f3ea;--card:#fff;--muted:#667085;--primary:#1a237e;--gold:#d9a441;--ring:rgba(26,35,126,.22)}
    *{box-sizing:border-box}
    body{margin:0;font-family:Segoe UI,Tahoma,Verdana,sans-serif;background:var(--bg);color:var(--ink)}

    .topbar{position:sticky;top:0;z-index:50;background:linear-gradient(180deg,#0b2b66 0%,#081c40 100%);border-bottom:1px solid rgba(255,255,255,.12)}
    .topbarInner{max-width:1100px;margin:0 auto;padding:14px 16px;display:flex;align-items:center;justify-content:space-between;gap:12px}
    .brand{display:flex;align-items:center;gap:10px;color:#fff}
    .logoDot{width:38px;height:38px;border-radius:12px;background:radial-gradient(circle at 30% 20%,#ffe7a5 0%,#d9a441 35%,#7a4b00 100%);box-shadow:0 10px 28px rgba(0,0,0,.25), inset 0 0 0 1px rgba(255,255,255,.2);position:relative}
    .logoDot:after{content:"";position:absolute;inset:9px 13px;border-radius:999px;border:2px solid rgba(255,255,255,.6)}
    .brandTitle{line-height:1.05}
    .brandTitle .t1{font-weight:900;font-size:18px}
    .brandTitle .t2{font-weight:800;font-size:12px;opacity:.86}
    .bellBtn{border:none;cursor:pointer;color:#fff;background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.16);width:44px;height:44px;border-radius:14px;display:grid;place-items:center}

    .wrap{max-width:980px;margin:16px auto;padding:0 16px 112px}
    .card{background:var(--card);border:1px solid rgba(15,27,61,.10);border-radius:20px;padding:18px;box-shadow:0 18px 44px rgba(15,27,61,.08)}
    .muted{color:var(--muted)}
    input,textarea,select{width:100%;padding:10px;border-radius:12px;border:1px solid rgba(15,27,61,.16);background:#fff;color:var(--ink)}
    textarea{min-height:70px;resize:vertical}
    .sep{height:1px;background:rgba(15,27,61,.10);margin:14px 0}
    .grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    @media (max-width: 900px){ .grid2{grid-template-columns:1fr} }
    .btn{border:none;border-radius:14px;padding:12px 14px;font-weight:900;cursor:pointer}
    .btn.primary{background:var(--primary);color:#fff;width:100%}
    .btn.primary[disabled]{opacity:.6;cursor:not-allowed}
    .alert{padding:12px;border-radius:12px;font-weight:800;margin-bottom:12px}
    .alert.err{background:rgba(244,67,54,.10);border:1px solid rgba(244,67,54,.24);color:#b42318}
    .alert.ok{background:rgba(76,175,80,.10);border:1px solid rgba(76,175,80,.24);color:#027a48}
    .hint{font-size:12px;color:var(--muted);margin-top:6px}
    .spinner{
      display:none;margin-left:10px;width:14px;height:14px;border-radius:50%;
      border:2px solid rgba(15,27,61,.25);
      border-top-color:var(--ink);
      animation:spin .8s linear infinite;
      vertical-align:middle;
    }
    @keyframes spin{to{transform:rotate(360deg)}}

    .bottomNav{position:fixed;left:0;right:0;bottom:0;z-index:60;background:linear-gradient(180deg,#0c2f73 0%,#081c40 100%);border-top:1px solid rgba(255,255,255,.14)}
    .navInner{max-width:1100px;margin:0 auto;padding:10px 14px;display:flex;justify-content:space-between;gap:10px}
    .navItem{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;text-decoration:none;color:rgba(255,255,255,.76);font-weight:900;font-size:12px;padding:10px 10px;border-radius:16px}
    .navItem.active{color:#fff;background:rgba(217,164,65,.20);border:1px solid rgba(217,164,65,.22)}
    .navItem svg{width:22px;height:22px;opacity:.9}
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbarInner">
      <div class="brand">
	      <div class="logo-badge"> <img src="/images/logo.png" alt="" class="logo-img" height="40"> </div>

        <div class="brandTitle">
          <div class="t1">BhakthiVedanta Wisdom Contest 2026</div>
          <div class="t2">Profile</div>
        </div>
      </div>
      <button class="bellBtn" type="button" title="Notifications" aria-label="Notifications">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 8a6 6 0 10-12 0c0 7-3 7-3 7h18s-3 0-3-7"/>
          <path d="M13.73 21a2 2 0 01-3.46 0"/>
        </svg>
      </button>
    </div>
  </header>

  <main class="wrap">
        <div class="card">
          <h1 style="margin:0 0 6px 0">Profile</h1>
          <div class="muted">Name / Email / Phone cannot be modified once saved. To change it, Whatsapp us at +91 9493805059</div>

          <div class="sep"></div>

          <% if (error) { %><div class="alert err"><%= error %></div><% } %>
          <% if (success) { %><div class="alert ok"><%= success %></div><% } %>

          <form method="POST" action="/dashboard/profile" id="profileForm" novalidate>
            <div class="grid2">
              <div>
                <label class="muted">Full Name (locked)</label>
                <input value="<%= user.name || '' %>" readonly />
              </div>
              <div>
                <label class="muted">Email (locked)</label>
                <input value="<%= user.email || '' %>" readonly />
              </div>
            </div>

            <div class="sep"></div>

            <div class="grid2">
              <div>
                <label class="muted">Mobile Number (WhatsApp contact)</label>
                <input
                  id="phone"
                  name="phone"
                  value="<%= (old && old.phone) || user.phone || '' %>"
                  <%= user.phone ? 'readonly' : '' %>
                  placeholder="10 digit mobile"
                  inputmode="numeric"
                  maxlength="10"
                />
                <% if (!user.phone) { %>
                  <div class="hint">Set once carefully. After saving, it will be locked.</div>
                <% } else { %>
                  <div class="hint">To change mobile number, please contact support at +91 9493805059 (Whatsapp).</div>
                <% } %>
              </div>

              <% if (!user.phone) { %>
              <div>
                <label class="muted">Confirm Mobile Number</label>
                <input
                  id="confirmPhone"
                  name="confirmPhone"
                  value="<%= (old && old.confirmPhone) || '' %>"
                  placeholder="Re-enter mobile number"
                  inputmode="numeric"
                  maxlength="10"
                />
                <div class="hint">Prevents mistakes.</div>
              </div>
              <% } %>
            </div>

            <div class="sep"></div>

            <div>
              <label class="muted">Address</label>
              <textarea name="address" placeholder="House no, Street, Area"><%= (old && old.address) || (addr && addr.address) || '' %></textarea>
            </div>

            <div class="sep"></div>

            <div class="grid2">
              <div>
                <label class="muted">City</label>
                <input name="city" value="<%= (old && old.city) || (addr && addr.city) || '' %>" />
              </div>

              <div>
                <label class="muted">State</label>
                <select name="state">
                  <option value="">Select State</option>
                  <% const states = ["Andhra Pradesh","Arunachal Pradesh","Assam","Bihar","Chhattisgarh","Goa","Gujarat","Haryana","Himachal Pradesh","Jharkhand","Karnataka","Kerala","Madhya Pradesh","Maharashtra","Manipur","Meghalaya","Mizoram","Nagaland","Odisha","Punjab","Rajasthan","Sikkim","Tamil Nadu","Telangana","Tripura","Uttar Pradesh","Uttarakhand","West Bengal","Andaman and Nicobar Islands","Chandigarh","Dadra and Nagar Haveli and Daman and Diu","Delhi","Jammu and Kashmir","Ladakh","Lakshadweep","Puducherry"]; %>
                  <% states.forEach(s => { %>
                    <option value="<%= s %>" <%= (((old && old.state) || (addr && addr.state) || '') === s) ? 'selected' : '' %>><%= s %></option>
                  <% }) %>
                </select>
              </div>
            </div>

            <div class="sep"></div>

            <div class="grid2">
              <div>
                <label class="muted">Pincode</label>
                <input name="pincode" id="pincode" inputmode="numeric" maxlength="6"
                       value="<%= (old && old.pincode) || (addr && addr.pincode) || '' %>" />
                <div class="hint">6-digit Indian pincode</div>
              </div>
              <div></div>
            </div>

            <div class="sep"></div>

            <button class="btn primary" id="saveBtn" type="submit">
              <span id="btnText">Save</span>
              <span class="spinner" id="spin"></span>
            </button>
          </form>

        </div>
  </main>

  <nav class="bottomNav" aria-label="Bottom navigation">
    <div class="navInner">
      <a class="navItem <%= (activeTab==='dashboard' || activeTab==='home') ? 'active' : '' %>" href="/dashboard">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-8 9 8v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
        Home
      </a>
      <a class="navItem <%= activeTab==='profile' ? 'active' : '' %>" href="/dashboard/profile">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        Profile
      </a>
      <a class="navItem <%= activeTab==='delivery' ? 'active' : '' %>" href="/dashboard/delivery">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h13v10H3z"/><path d="M16 10h4l1 2v5h-5"/><circle cx="7.5" cy="19" r="1.5"/><circle cx="18.5" cy="19" r="1.5"/></svg>
        Track
      </a>
      <a class="navItem <%= activeTab==='faqs' ? 'active' : '' %>" href="/dashboard/faqs">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 2-3 4"/><path d="M12 17h.01"/></svg>
        FAQs
      </a>
    </div>
  </nav>

<script>
  (function(){
    const form = document.getElementById("profileForm");
    const btn = document.getElementById("saveBtn");
    const spin = document.getElementById("spin");
    const phone = document.getElementById("phone");
    const confirmPhone = document.getElementById("confirmPhone");
    const pin = document.getElementById("pincode");

    function digitsOnly(el, max){
      if(!el) return;
      el.addEventListener("input", () => el.value = el.value.replace(/\\D/g,"").slice(0,max));
    }
    digitsOnly(phone, 10);
    digitsOnly(confirmPhone, 10);
    digitsOnly(pin, 6);

    form.addEventListener("submit", (e) => {
      if (confirmPhone) {
        const p = (phone.value || "").trim();
        const cp = (confirmPhone.value || "").trim();
        const okPhone = /^[6-9][0-9]{9}$/.test(p);
        if (!okPhone) { e.preventDefault(); alert("Enter a valid 10-digit Indian mobile number."); return; }
        if (p !== cp) { e.preventDefault(); alert("Mobile numbers do not match."); return; }
      }

      btn.disabled = true;
      spin.style.display = "inline-block";
      document.getElementById("btnText").innerText = "Saving...";
    });
  })();
</script>

</body>
</html>
