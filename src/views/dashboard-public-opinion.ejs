<script>
(function(){
  const TOTAL = 28;
  const answers = {};
  const textQ = [27, 28]; // text input questions

  // Show first question on load
  showCard(1);

  function showCard(n) {
    const card = document.getElementById('q' + n);
    if (card) {
      card.classList.add('visible');
      // For text questions, show next button immediately
      if (textQ.includes(n)) {
        const nextBtn = document.getElementById('q' + n + '-next');
        if (nextBtn) nextBtn.style.display = 'inline-flex';
      }
    }
  }

  function updateProgress() {
    const answered = Object.keys(answers).length;
    const pct = Math.round((answered / TOTAL) * 100);
    document.getElementById('progressFill').style.width = pct + '%';
    document.getElementById('progressCount').textContent = answered + ' of ' + TOTAL + ' answered';
  }

  function markAnswered(qNum) {
    const card = document.getElementById('q' + qNum);
    if (card) card.classList.add('answered');
    updateProgress();
  }

  function scrollToNext(nextNum) {
    setTimeout(() => {
      const nextCard = document.getElementById('q' + nextNum);
      if (nextCard) {
        nextCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        // Show submit
        const sub = document.getElementById('submitSection');
        sub.classList.add('visible');
        sub.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }, 180);
  }

  // Handle option button clicks (auto-advance)
  document.querySelectorAll('.opt-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const qNum = parseInt(this.dataset.q);
      const val = this.dataset.val;

      // Already answered? skip
      if (answers[qNum]) return;

      // Mark selected
      this.closest('.q-options').querySelectorAll('.opt-btn').forEach(b => b.classList.remove('selected'));
      this.classList.add('selected');

      // Save answer
      answers[qNum] = val;

      // Mark card answered after short delay (so user sees selection)
      setTimeout(() => {
        markAnswered(qNum);
        const next = qNum + 1;
        if (next <= TOTAL) {
          showCard(next);
          scrollToNext(next);
        } else {
          const sub = document.getElementById('submitSection');
          sub.classList.add('visible');
          sub.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }, 320);
    });
  });

  // Handle text question next buttons
  [27, 28].forEach(n => {
    const btn = document.getElementById('q' + n + '-next');
    if (!btn) return;
    btn.addEventListener('click', function() {
      if (answers[n]) return;
      const ta = document.getElementById('q' + n + '-text');
      answers[n] = (ta ? ta.value.trim() : '') || '(skipped)';
      markAnswered(n);

      if (n < TOTAL) {
        showCard(n + 1);
        scrollToNext(n + 1);
      } else {
        const sub = document.getElementById('submitSection');
        sub.classList.add('visible');
        sub.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  });

  // Submit
  document.getElementById('submitBtn').addEventListener('click', async function() {
  this.disabled = true;
  this.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="animation:spin 1s linear infinite"><path d="M12 4V2A10 10 0 0 0 2 12h2a8 8 0 0 1 8-8z"/></svg> Submitting...';

  try {
    const resp = await fetch('/dashboard/public-opinion/submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        answers,
        submittedAt: new Date().toISOString()
      })
    });

    const data = await resp.json().catch(() => ({}));

    if (!resp.ok || !data.ok) {
      throw new Error(data.error || 'Unable to save feedback');
    }

    document.getElementById('submitSection').style.display = 'none';
    document.getElementById('progressWrap').style.display = 'none';
    document.querySelectorAll('.q-card, .section-header, .sec-divider').forEach(el => el.style.display = 'none');

    const ty = document.getElementById('thankyou');
    ty.classList.add('visible');
    ty.scrollIntoView({ behavior: 'smooth', block: 'center' });

  } catch (e) {
    alert('Sorry buddy, feedback could not be saved. Please try again.');
    this.disabled = false;
    this.innerHTML = '<svg viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg> Submit My Feedback';
  }
});

})();
</script>
