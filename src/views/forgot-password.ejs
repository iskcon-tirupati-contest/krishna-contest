<!DOCTYPE html>
<html lang="en">
<head>
  <title>Forgot Password - Iskcon Tirupati Essay Contest</title>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
  <style>
    :root{--navy:#1a237e;--navy-mid:#283593;--navy-lt:#3949ab;--gold:#f59e0b;--green:#10b981;--green-lt:#d1fae5;--green-dark:#065f46;--red:#ef4444;--red-lt:#fee2e2;--red-dark:#991b1b;--text-h:#0f172a;--text-b:#1e293b;--text-mid:#334155;--text-muted:#64748b}
    *{box-sizing:border-box;margin:0;padding:0}
    html,body{min-height:100%;font-family:'DM Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
    body{background:#0d1340;display:flex;align-items:center;justify-content:center;padding:20px;min-height:100vh;position:relative;overflow:hidden}
    .bg-orb{position:fixed;border-radius:50%;pointer-events:none;z-index:0}
    .bg-orb-1{width:500px;height:500px;top:-200px;left:-150px;background:radial-gradient(circle,rgba(92,107,192,.3) 0%,transparent 70%)}
    .bg-orb-2{width:450px;height:450px;bottom:-150px;right:-100px;background:radial-gradient(circle,rgba(245,158,11,.12) 0%,transparent 70%)}
    body::before{content:'';position:fixed;inset:0;background-image:radial-gradient(rgba(255,255,255,.06) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;z-index:0}

    .card{position:relative;z-index:1;width:100%;max-width:440px;background:rgba(255,255,255,.97);border-radius:28px;box-shadow:0 32px 80px rgba(0,0,0,.4),0 0 0 1px rgba(255,255,255,.08);overflow:hidden}
    .card-accent{height:5px;background:linear-gradient(90deg,#1a237e 0%,#3949ab 50%,#f59e0b 100%)}
    .card-body{padding:30px 28px 26px}

    /* brand */
    .brand{display:flex;flex-direction:column;align-items:center;margin-bottom:20px}
    .brand-logo{width:60px;height:60px;border-radius:17px;background:linear-gradient(135deg,#1a237e,#3949ab);display:flex;align-items:center;justify-content:center;margin-bottom:10px;box-shadow:0 8px 24px rgba(26,35,126,.35)}
    .brand-logo svg{width:30px;height:30px;fill:#fff}
    .brand-name{font-family:'Sora',sans-serif;font-size:12px;font-weight:700;color:var(--text-muted);text-align:center;letter-spacing:.3px;text-transform:uppercase}

    /* step indicator */
    .steps{display:flex;align-items:center;justify-content:center;gap:0;margin-bottom:24px}
    .step-dot{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Sora',sans-serif;font-size:13px;font-weight:800;border:2px solid #d1d8f0;background:#f8faff;color:var(--text-muted);transition:all .28s}
    .step-dot.active{background:linear-gradient(135deg,var(--navy),var(--navy-lt));color:#fff;border-color:transparent;box-shadow:0 4px 12px rgba(26,35,126,.3)}
    .step-dot.done{background:var(--green-lt);color:var(--green-dark);border-color:#a7f3d0}
    .step-line{width:40px;height:2px;background:#d1d8f0;transition:background .28s}
    .step-line.done{background:var(--green)}

    h1{font-family:'Sora',sans-serif;font-size:23px;font-weight:800;color:var(--text-h);text-align:center;margin-bottom:5px}
    .sub{text-align:center;color:var(--text-muted);font-size:13px;line-height:1.55;margin-bottom:22px}

    .alert-box{display:none;margin-bottom:12px;padding:10px 13px;border-radius:11px;font-size:13px;font-weight:600}
    .alert-box.err{background:var(--red-lt);border:1.5px solid #fecaca;color:var(--red-dark)}
    .alert-box.ok{background:var(--green-lt);border:1.5px solid #a7f3d0;color:var(--green-dark)}

    .form-group{margin-bottom:14px}
    .field-label{display:block;font-size:12px;font-weight:700;color:var(--text-muted);margin-bottom:5px;letter-spacing:.2px}
    .input-wrap{position:relative}
    .input-icon{position:absolute;left:13px;top:50%;transform:translateY(-50%);width:17px;height:17px;fill:var(--text-muted);pointer-events:none}
    input{width:100%;padding:12px 14px 12px 40px;border:1.5px solid #d1d8f0;border-radius:13px;background:#fafbff;color:var(--text-b);font-size:14px;font-family:'DM Sans',system-ui,sans-serif;outline:none;transition:border-color .18s,box-shadow .18s,background .18s}
    input:focus{border-color:var(--navy-lt);box-shadow:0 0 0 3px rgba(92,107,192,.18);background:#fff}
    .hint{margin-top:4px;font-size:11.5px;color:var(--text-muted)}

    /* OTP input group */
    .otp-wrap{display:flex;gap:8px;justify-content:center;margin:4px 0}
    .otp-input{width:48px;height:54px;text-align:center;font-family:'Sora',sans-serif;font-size:22px;font-weight:800;border:2px solid #d1d8f0;border-radius:13px;background:#fafbff;color:var(--text-h);padding:0;outline:none;transition:border-color .18s,box-shadow .18s}
    .otp-input:focus{border-color:var(--navy-lt);box-shadow:0 0 0 3px rgba(92,107,192,.18);background:#fff}

    /* resend */
    .resend-row{text-align:center;margin-top:10px;font-size:13px;color:var(--text-muted)}
    .resend-btn{background:none;border:none;color:var(--navy-lt);font-weight:700;cursor:pointer;font-size:13px;font-family:'DM Sans',system-ui,sans-serif;transition:color .14s}
    .resend-btn:hover{color:var(--navy)}.resend-btn:disabled{color:var(--text-muted);cursor:default}
    #countdown{font-weight:700;color:var(--navy-lt)}

    /* eye toggle */
    .pw-input{padding-right:44px}
    .eye-btn{position:absolute;right:12px;top:50%;transform:translateY(-50%);width:32px;height:32px;border:none;background:transparent;color:var(--text-muted);cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;border-radius:8px;transition:color .14s}
    .eye-btn:hover{color:var(--navy)}.eye-btn svg{width:18px;height:18px;fill:currentColor}

    .submit-btn{width:100%;border:none;border-radius:13px;padding:14px 18px;background:linear-gradient(135deg,var(--navy) 0%,var(--navy-lt) 100%);color:#fff;font-family:'Sora',sans-serif;font-size:15px;font-weight:700;cursor:pointer;box-shadow:0 8px 22px rgba(26,35,126,.32);transition:transform .15s,box-shadow .15s,opacity .15s;display:flex;align-items:center;justify-content:center;gap:8px;margin-top:4px}
    .submit-btn:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(26,35,126,.42)}.submit-btn:active{transform:scale(.97)}.submit-btn:disabled{opacity:.6;cursor:not-allowed;transform:none}

    /* success screen */
    .success-screen{display:none;text-align:center;padding:10px 0}
    .success-icon{width:72px;height:72px;border-radius:50%;background:var(--green-lt);display:flex;align-items:center;justify-content:center;margin:0 auto 16px}
    .success-icon svg{width:36px;height:36px;fill:var(--green-dark)}
    .success-title{font-family:'Sora',sans-serif;font-size:22px;font-weight:800;color:var(--text-h);margin-bottom:8px}
    .success-sub{font-size:14px;color:var(--text-muted);line-height:1.6;margin-bottom:20px}

    .card-footer{background:#f8faff;border-top:1.5px solid #e8eaf6;padding:14px 28px;text-align:center;font-size:14px;color:var(--text-mid)}
    .card-footer a{color:var(--navy-lt);font-weight:700;text-decoration:none}.card-footer a:hover{color:var(--navy)}
    @keyframes spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}
    @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
    .step-panel{animation:fadeIn .28s ease}
  </style>
</head>
<body>
  <div class="bg-orb bg-orb-1"></div>
  <div class="bg-orb bg-orb-2"></div>

  <div class="card">
    <div class="card-accent"></div>
    <div class="card-body">

      <div class="brand">
        <div class="brand-logo">
          <svg viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
        </div>
        <div class="brand-name">Iskcon Tirupati Essay Contest</div>
      </div>

      <!-- Step indicator -->
      <div class="steps">
        <div class="step-dot active" id="dot1">1</div>
        <div class="step-line" id="line1"></div>
        <div class="step-dot" id="dot2">2</div>
        <div class="step-line" id="line2"></div>
        <div class="step-dot" id="dot3">3</div>
      </div>

      <div id="errBox" class="alert-box err"></div>
      <div id="okBox" class="alert-box ok"></div>

      <!-- ── STEP 1: Mobile number ── -->
      <div id="step1" class="step-panel">
        <h1>Reset Password?</h1>
        <p class="sub">Enter your registered mobile number. We'll send an OTP to reset your password.</p>
        <div class="form-group">
          <label class="field-label">Registered Mobile Number</label>
          <div class="input-wrap">
            <svg class="input-icon" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
            <input id="fpPhone" placeholder="Enter 10-digit mobile number" inputmode="numeric" maxlength="10" autocomplete="tel"/>
          </div>
          <!--<div class="hint">OTP will be sent via SMS to this number.</div>-->
          <div class="hint">OTP will be sent to Whatsapp in this number.</div>
        </div>
        <button class="submit-btn" id="sendOtpBtn" type="button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21 23 12 2.01 3 2 10l15 2-15 2z"/></svg>
          Send OTP
        </button>
      </div>

      <!-- ── STEP 2: OTP verification ── -->
      <div id="step2" class="step-panel" style="display:none">
        <h1>Enter OTP</h1>
        <p class="sub" id="otpSubtext">We've sent a 6-digit OTP to your mobile number.</p>
        <div class="form-group" style="margin-bottom:8px">
          <label class="field-label" style="text-align:center;display:block">Enter the 6-digit code</label>
          <div class="otp-wrap" id="otpWrap">
            <input class="otp-input" maxlength="1" inputmode="numeric" type="text"/>
            <input class="otp-input" maxlength="1" inputmode="numeric" type="text"/>
            <input class="otp-input" maxlength="1" inputmode="numeric" type="text"/>
            <input class="otp-input" maxlength="1" inputmode="numeric" type="text"/>
            <input class="otp-input" maxlength="1" inputmode="numeric" type="text"/>
            <input class="otp-input" maxlength="1" inputmode="numeric" type="text"/>
          </div>
        </div>
        <div class="resend-row">
          Didn't receive it?
          <button class="resend-btn" id="resendBtn" type="button" disabled>Resend OTP</button>
          <span id="countdown"></span>
        </div>
        <button class="submit-btn" id="verifyOtpBtn" type="button" style="margin-top:16px">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
          Verify OTP
        </button>
      </div>

      <!-- ── STEP 3: New password ── -->
      <div id="step3" class="step-panel" style="display:none">
        <h1>Create New Password</h1>
        <p class="sub">Choose a strong new password for your account.</p>
        <div class="form-group">
          <label class="field-label">New Password</label>
          <div class="input-wrap">
            <svg class="input-icon" viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
            <input id="newPw" type="password" class="pw-input" placeholder="New password (min 6 chars)" autocomplete="new-password"/>
            <button class="eye-btn" type="button" id="eyeNew" aria-label="Show/hide">
              <svg class="eye-closed" viewBox="0 0 24 24"><path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75C21.27 7.11 17 4 12 4c-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 6.13 11.35 6 12 6zm0-3C6.48 4 2 8.48 2 14c0 2.08.62 4.01 1.68 5.62L.29 22.42l1.42 1.42 3.07-3.07C6.08 21.62 7.95 22 10 22c5.52 0 10-4.48 10-10 0-2.08-.62-4.01-1.68-5.62l3.07-3.07-1.42-1.42L17.1 4.97C15.87 4.35 14 4 12 4zm0 13c-2.76 0-5-2.24-5-5 0-.65.13-1.26.36-1.83L4.44 7.25C2.93 8.51 1.73 10.14 1 12c1.73 4.39 6 7.5 11 7.5 1.4 0 2.74-.25 3.98-.7l-2.16-2.16C13.26 16.87 12.65 17 12 17z"/></svg>
              <svg class="eye-open" viewBox="0 0 24 24" style="display:none"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
            </button>
          </div>
        </div>
        <div class="form-group">
          <label class="field-label">Confirm New Password</label>
          <div class="input-wrap">
            <svg class="input-icon" viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
            <input id="confirmPw" type="password" class="pw-input" placeholder="Re-enter new password" autocomplete="new-password"/>
            <button class="eye-btn" type="button" id="eyeConfirm" aria-label="Show/hide">
              <svg class="eye-closed" viewBox="0 0 24 24"><path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75C21.27 7.11 17 4 12 4c-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 6.13 11.35 6 12 6zm0-3C6.48 4 2 8.48 2 14c0 2.08.62 4.01 1.68 5.62L.29 22.42l1.42 1.42 3.07-3.07C6.08 21.62 7.95 22 10 22c5.52 0 10-4.48 10-10 0-2.08-.62-4.01-1.68-5.62l3.07-3.07-1.42-1.42L17.1 4.97C15.87 4.35 14 4 12 4zm0 13c-2.76 0-5-2.24-5-5 0-.65.13-1.26.36-1.83L4.44 7.25C2.93 8.51 1.73 10.14 1 12c1.73 4.39 6 7.5 11 7.5 1.4 0 2.74-.25 3.98-.7l-2.16-2.16C13.26 16.87 12.65 17 12 17z"/></svg>
              <svg class="eye-open" viewBox="0 0 24 24" style="display:none"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
            </button>
          </div>
          <div class="hint" id="fpMatchHint"></div>
        </div>
        <button class="submit-btn" id="resetPwBtn" type="button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
          Reset Password
        </button>
      </div>

      <!-- ── SUCCESS ── -->
      <div id="successScreen" class="success-screen">
        <div class="success-icon">
          <svg viewBox="0 0 24 24"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
        </div>
        <div class="success-title">Password Reset! 🎉</div>
        <div class="success-sub">Your password has been updated successfully. You can now login with your new password.</div>
        <a class="submit-btn" href="/login" style="text-decoration:none">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M11 7L9.6 8.4l2.6 2.6H2v2h10.2l-2.6 2.6L11 17l5-5-5-5zm9 12h-8v2h8c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-8v2h8v14z"/></svg>
          Go to Login
        </a>
      </div>

    </div><!-- /card-body -->

    <div class="card-footer">
      Remembered it? <a href="/login">Back to Login</a>
      &nbsp;·&nbsp;
      <a href="/register">Register</a>
    </div>
  </div>

<script>
(function(){
  const errBox=document.getElementById('errBox');
  const okBox=document.getElementById('okBox');
  function showErr(msg){errBox.textContent=msg||'Something went wrong';errBox.style.display='block';okBox.style.display='none'}
  function showOk(msg){okBox.textContent=msg||'';okBox.style.display='block';errBox.style.display='none'}
  function clearMsg(){errBox.style.display='none';okBox.style.display='none'}
  function norm(v){return String(v||'').trim()}
  function validPhone(v){return/^[6-9][0-9]{9}$/.test(norm(v))}

  let currentPhone='';let otpToken='';
  const RESEND_SECS=30;let resendTimer=null;

  /* ── step navigation ── */
  function goStep(n){
    [1,2,3].forEach(i=>{
      document.getElementById('step'+i).style.display=i===n?'block':'none';
    });
    // update dots
    for(let i=1;i<=3;i++){
      const dot=document.getElementById('dot'+i);
      if(i<n){dot.className='step-dot done';dot.textContent='✓'}
      else if(i===n){dot.className='step-dot active';dot.textContent=String(i)}
      else{dot.className='step-dot';dot.textContent=String(i)}
    }
    for(let i=1;i<=2;i++){
      document.getElementById('line'+i).className='step-line'+(i<n?' done':'');
    }
    clearMsg();
  }

  /* ── phone input ── */
  const fpPhone=document.getElementById('fpPhone');
  fpPhone.addEventListener('input',()=>{fpPhone.value=fpPhone.value.replace(/\D/g,'').slice(0,10)});

  /* ── STEP 1: Send OTP ── */
  document.getElementById('sendOtpBtn').addEventListener('click',async function(){
    const phone=norm(fpPhone.value);
    if(!validPhone(phone))return showErr('Please enter a valid 10-digit Indian mobile number.');
    currentPhone=phone;
    this.disabled=true;this.innerHTML=spinnerHTML('Sending OTP...');
    try{
      const r=await fetch('/forgot-password/send-otp',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({phone})});
      const d=await r.json();
      if(!r.ok||!d.ok)throw new Error(d.message||'Failed to send OTP');
      goStep(2);
      document.getElementById('otpSubtext').textContent=`We've sent a 6-digit OTP to +91 ${phone}.`;
      startResendTimer();
      document.querySelectorAll('.otp-input')[0].focus();
    }catch(e){showErr(e.message||'Failed to send OTP')}
    finally{this.disabled=false;this.innerHTML=sendOtpHTML()}
  });

  /* ── OTP inputs: auto-advance, backspace ── */
  const otpInputs=Array.from(document.querySelectorAll('.otp-input'));
  otpInputs.forEach((inp,i)=>{
    inp.addEventListener('input',()=>{
      inp.value=inp.value.replace(/\D/g,'').slice(0,1);
      if(inp.value&&i<otpInputs.length-1)otpInputs[i+1].focus();
    });
    inp.addEventListener('keydown',e=>{
      if(e.key==='Backspace'&&!inp.value&&i>0){otpInputs[i-1].focus();otpInputs[i-1].value=''}
    });
    inp.addEventListener('paste',e=>{
      e.preventDefault();const paste=(e.clipboardData||window.clipboardData).getData('text').replace(/\D/g,'').slice(0,6);
      paste.split('').forEach((ch,j)=>{if(otpInputs[j])otpInputs[j].value=ch});
      if(otpInputs[Math.min(paste.length,5)])otpInputs[Math.min(paste.length,5)].focus();
    });
  });

  /* ── Resend timer ── */
  function startResendTimer(){
    const resendBtn=document.getElementById('resendBtn');
    const countdown=document.getElementById('countdown');
    resendBtn.disabled=true;
    let secs=RESEND_SECS;
    countdown.textContent=` (${secs}s)`;
    clearInterval(resendTimer);
    resendTimer=setInterval(()=>{secs--;countdown.textContent=secs>0?` (${secs}s)`:'';if(secs<=0){clearInterval(resendTimer);resendBtn.disabled=false}},1000);
  }

  document.getElementById('resendBtn').addEventListener('click',async function(){
    if(!currentPhone)return;
    this.disabled=true;
    try{
      const r=await fetch('/forgot-password/send-otp',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({phone:currentPhone})});
      const d=await r.json();
      if(!r.ok||!d.ok)throw new Error(d.message||'Failed');
      showOk('OTP resent successfully!');otpInputs.forEach(i=>i.value='');otpInputs[0].focus();
      startResendTimer();
    }catch(e){showErr(e.message||'Failed to resend OTP');this.disabled=false}
  });

  /* ── STEP 2: Verify OTP ── */
  document.getElementById('verifyOtpBtn').addEventListener('click',async function(){
    const otp=otpInputs.map(i=>i.value).join('');
    if(otp.length<6||!/^\d{6}$/.test(otp))return showErr('Please enter the complete 6-digit OTP.');
    this.disabled=true;this.innerHTML=spinnerHTML('Verifying...');
    try{
      const r=await fetch('/forgot-password/verify-otp',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({phone:currentPhone,otp})});
      const d=await r.json();
      if(!r.ok||!d.ok)throw new Error(d.message||'Invalid OTP');
      otpToken=d.token||'';
      goStep(3);
      document.getElementById('newPw').focus();
    }catch(e){showErr(e.message||'Invalid or expired OTP')}
    finally{this.disabled=false;this.innerHTML='<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>Verify OTP'}
  });

  /* ── eye toggles for step 3 ── */
  function makeEye(btnId,inputEl){
    document.getElementById(btnId).addEventListener('click',function(){
      const isPass=inputEl.type==='password';inputEl.type=isPass?'text':'password';
      this.querySelector('.eye-closed').style.display=isPass?'none':'block';
      this.querySelector('.eye-open').style.display=isPass?'block':'none';
    });
  }
  const newPwEl=document.getElementById('newPw');
  const confirmPwEl=document.getElementById('confirmPw');
  makeEye('eyeNew',newPwEl);makeEye('eyeConfirm',confirmPwEl);

  const fpMatchHint=document.getElementById('fpMatchHint');
  function checkMatch(){
    if(!confirmPwEl.value)return fpMatchHint.textContent='';
    if(confirmPwEl.value===newPwEl.value){fpMatchHint.textContent='✓ Passwords match';fpMatchHint.style.color='#059669'}
    else{fpMatchHint.textContent='✗ Passwords do not match';fpMatchHint.style.color='#ef4444'}
  }
  newPwEl.addEventListener('input',checkMatch);confirmPwEl.addEventListener('input',checkMatch);

  /* ── STEP 3: Reset password ── */
  document.getElementById('resetPwBtn').addEventListener('click',async function(){
    const newPassword=String(newPwEl.value||'');const confirmPassword=String(confirmPwEl.value||'');
    if(newPassword.length<6)return showErr('Password must be at least 6 characters.');
    if(newPassword!==confirmPassword)return showErr('Passwords do not match.');
    this.disabled=true;this.innerHTML=spinnerHTML('Resetting...');
    try{
      const r=await fetch('/forgot-password/reset',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({phone:currentPhone,token:otpToken,newPassword,confirmPassword})});
      const d=await r.json();
      if(!r.ok||!d.ok)throw new Error(d.message||'Reset failed');
      // show success screen
      [1,2,3].forEach(i=>document.getElementById('step'+i).style.display='none');
      document.getElementById('successScreen').style.display='block';
      // hide step dots
      document.querySelector('.steps').style.display='none';
      clearMsg();
    }catch(e){showErr(e.message||'Password reset failed')}
    finally{this.disabled=false;this.innerHTML='<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>Reset Password'}
  });

  /* helpers */
  function spinnerHTML(label){return`<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="animation:spin 1s linear infinite"><path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 14.03 20 13.07 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 9.97 4 10.93 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/></svg>${label}`}
  function sendOtpHTML(){return'<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21 23 12 2.01 3 2 10l15 2-15 2z"/></svg>Send OTP'}
})();
</script>
</body>
</html>
