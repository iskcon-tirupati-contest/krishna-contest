        <div class="sp-row"><span>🛕</span><span>VIP Darshan Tirumala Balaji</span><span class="sp-place">3rd</span></div>
        <div class="sp-row"><span>🪷</span><span>ISKCON Life Patron Membership</span><span class="sp-place">4th</span></div>
        <div class="sp-row"><span>🪷</span><span>ISKCON Life Patron Membership</span><span class="sp-place">5th</span></div>
      </div>
      <div class="slide-pills">
        <span class="spill gold">₹<%= Number(comboContest.price||1596) %> for all 4 contests</span>
        <span class="spill gold">🎁 FREE Book included</span>
        <span class="spill">📅 Submit by 09/09/2026</span>
      </div>
      <div class="slide-btns"><a class="s-btn s-btn-gold" href="/register">Get the Combo Deal 🔥</a></div>
    </div>
    <% } %>

    <!-- ── Previous Contest Slide ── -->
    <div class="slide">
      <div class="slide-badge" style="background:rgba(16,185,129,.14);border-color:rgba(16,185,129,.35);color:#6ee7b7"><span class="bdot" style="background:#10b981"></span>Proven Track Record</div>
