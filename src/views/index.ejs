<script>
(function(){
  /* ── Slideshow ── */
  const track = document.getElementById('slidesTrack');
  const dotNav = document.getElementById('dotNav');
  const slideEls = track.querySelectorAll('.slide');
  const n = slideEls.length;
  let cur = 0, autoTimer;

  for(let i = 0; i < n; i++){
    const d = document.createElement('button');
    d.className = 'slide-dot' + (i === 0 ? ' active' : '');
    d.setAttribute('aria-label','Slide '+(i+1));
    d.addEventListener('click', () => goTo(i, true));
    dotNav.appendChild(d);
  }

  function goTo(idx, stopAuto){
    // scroll current slide back to top when leaving
    slideEls[cur].scrollTop = 0;
    cur = ((idx % n) + n) % n;
    track.style.transform = `translateX(-${cur * 100}%)`;
    dotNav.querySelectorAll('.slide-dot').forEach((d,i) => d.classList.toggle('active', i === cur));
    if(stopAuto){ clearInterval(autoTimer); autoTimer = setInterval(() => goTo(cur+1, false), 7000); }
  }

  document.getElementById('prevBtn').addEventListener('click', () => goTo(cur-1, true));
  document.getElementById('nextBtn').addEventListener('click', () => goTo(cur+1, true));

  /* touch swipe */
  let tx = 0;
  track.addEventListener('touchstart', e => { tx = e.touches[0].clientX; }, {passive:true});
  track.addEventListener('touchend', e => { const dx = e.changedTouches[0].clientX - tx; if(Math.abs(dx) > 40) goTo(cur + (dx < 0 ? 1 : -1), true); }, {passive:true});

  /* slower auto-advance — 7 seconds */
  autoTimer = setInterval(() => goTo(cur+1, false), 7000);

  /* ── Scroll reveal ── */
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('visible'); obs.unobserve(e.target); }});
  }, {threshold: .1});
  document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
})();
</script>
