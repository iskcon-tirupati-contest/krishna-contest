    .about-cta .ac-btn:hover{transform:translateY(-2px);box-shadow:0 9px 24px rgba(217,119,6,.5)}

    /* ═══ FOOTER ═══ */
    .footer{background:#060e30;border-top:1px solid rgba(255,215,0,.12);padding:40px 20px 0}
    .footer-grid{max-width:1160px;margin:0 auto;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:28px;padding-bottom:32px;border-bottom:1px solid rgba(255,255,255,.07)}
