<!DOCTYPE html>
<html lang="en">
<head>
  <title>Iskcon Tirupati Essay Writing Contest 2026</title>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="description" content="Iskcon Tirupati Essay Writing Contest 2026 — Write with devotion. Win amazing prizes."/>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800;900&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
  <style>
    :root{
      --navy:#0e1a5e;--navy2:#1a237e;--navy3:#283593;--navy4:#3949ab;
      --gold:#f59e0b;--gold-dark:#78350f;
    }
    *{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:'DM Sans',system-ui,sans-serif;background:var(--navy);color:#fff;overflow-x:hidden;-webkit-font-smoothing:antialiased}
    a{text-decoration:none;color:inherit}
    img{display:block;max-width:100%}

    /* ═══ NAV — no login/register buttons to avoid right-gap on scroll ═══ */
    .nav{
      position:sticky;top:0;z-index:200;
      background:rgba(14,26,94,.95);
      backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
      border-bottom:1px solid rgba(255,215,0,.12);
      padding:0 16px;
      /* FIX: width:100% prevents the right-gap issue */
      width:100%;
    }
    .nav-inner{
      max-width:1200px;margin:0 auto;
      display:flex;align-items:center;justify-content:space-between;
      height:54px;gap:10px;
    }
    .nav-brand{display:flex;align-items:center;gap:9px;min-width:0;flex:1}
    .nav-logo{width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,var(--navy3),var(--navy4));display:grid;place-items:center;border:1px solid rgba(255,215,0,.25);flex-shrink:0}
    .nav-logo svg{width:18px;height:18px;fill:#ffd700}
    .nav-title{font-family:'Sora',sans-serif;font-size:13px;font-weight:800;background:linear-gradient(90deg,#ffd700,#fff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .nav-btns{display:flex;gap:7px;flex-shrink:0}
    .nav-btn{padding:7px 14px;border-radius:999px;font-family:'Sora',sans-serif;font-size:12px;font-weight:700;cursor:pointer;border:none;transition:all .18s;white-space:nowrap}
    .nav-ghost{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:#fff}
    .nav-gold{background:linear-gradient(135deg,#d97706,#f59e0b);color:#fff;box-shadow:0 3px 10px rgba(217,119,6,.3)}
    .nav-gold:hover{transform:translateY(-1px);box-shadow:0 5px 16px rgba(217,119,6,.45)}


.brand{flex:1;min-width:0;display:flex;align-items:center;gap:8px;overflow:hidden}
    .topbar-logo-wrap{flex-shrink:0;width:clamp(36px,9vw,46px);height:clamp(36px,9vw,46px);display:flex;align-items:center;justify-content:center}
.topbar-logo-img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 2px 8px rgba(0,0,0,.35))}
    .topbar-title{display:flex;flex-direction:column;justify-content:center;min-width:0;line-height:1.2}
    .topbar-title-line1{font-family:'Sora',sans-serif;font-size:clamp(12px,3.2vw,16px);font-weight:800;color:#ffd700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:.1px}
    .topbar-title-line2{font-family:'Sora',sans-serif;font-size:clamp(9px,2.4vw,12px);font-weight:600;color:rgba(255,255,255,.82);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:.1px}

    /* ═══ SLIDESHOW — height = 100dvh - navHeight ═══ */
    .slideshow{
      position:relative;overflow:hidden;
      /* KEY FIX: exact viewport height minus nav */
      height:calc(100dvh - 54px);
      min-height:520px;
      background:linear-gradient(160deg,var(--navy) 0%,#101c6b 60%,#0a1545 100%);
    }
    /* fallback for browsers without dvh */
    @supports not (height: 100dvh){
      .slideshow{height:calc(100vh - 54px)}
    }
    .slideshow::before{content:'';position:absolute;inset:0;pointer-events:none;z-index:0;background:radial-gradient(ellipse at 15% 40%,rgba(245,158,11,.1) 0%,transparent 50%),radial-gradient(ellipse at 85% 20%,rgba(92,107,192,.15) 0%,transparent 50%)}
    .slideshow::after{content:'';position:absolute;inset:0;pointer-events:none;z-index:0;background-image:radial-gradient(rgba(255,255,255,.04) 1px,transparent 1px);background-size:28px 28px}

    .slides{display:flex;height:100%;transition:transform .5s cubic-bezier(.4,0,.2,1);position:relative;z-index:1}
    .slide{
      min-width:100%;height:100%;
      display:flex;flex-direction:column;align-items:center;justify-content:flex-start;
      text-align:center;
      overflow-y:auto;
      /* KEY FIX: padding accounts for dot nav at bottom */
      padding:14px 16px 52px;
      -ms-overflow-style:none;scrollbar-width:none;
    }
    .slide::-webkit-scrollbar{display:none}

    /* ── Slide badge ── */
    .slide-badge{
      display:inline-flex;align-items:center;gap:6px;
      background:rgba(245,158,11,.14);border:1px solid rgba(245,158,11,.35);
      border-radius:999px;padding:5px 13px;margin-bottom:10px;flex-shrink:0;
      font-family:'Sora',sans-serif;font-size:11px;font-weight:700;color:#fde68a;letter-spacing:.4px;text-transform:uppercase;
    }
    .slide-badge .bdot{width:6px;height:6px;border-radius:50%;background:#f59e0b;animation:blink 1.8s ease-in-out infinite;flex-shrink:0}
    @keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}

    /* ── Slide 1 typography ── */
    .slide h1{font-family:'Sora',sans-serif;font-size:clamp(24px,6vw,52px);font-weight:900;line-height:1.08;margin-bottom:8px;background:linear-gradient(135deg,#ffd700 0%,#fff 45%,#ffd700 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;flex-shrink:0}
    .slide-sub{font-size:clamp(12px,3vw,15px);color:#c7d9ff;line-height:1.5;margin-bottom:10px;max-width:600px;flex-shrink:0}

    /* ── Contest name tags on slide 1 ── */
    .contest-names{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-bottom:10px}
    .cn-tag{padding:5px 12px;border-radius:999px;font-size:11px;font-weight:700;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);color:#e2e8ff}

    /* ── Prize strip ── */
    .prize-strip{display:flex;flex-wrap:wrap;justify-content:center;gap:6px;margin-bottom:10px;max-width:560px;width:100%}
    .prize-chip{
      background:rgba(255,255,255,.07);border:1px solid rgba(255,215,0,.22);
      border-radius:11px;padding:7px 10px;flex:1;min-width:90px;max-width:120px;
    }
    .pc-rank{font-size:18px;margin-bottom:2px}
    .pc-amt{font-family:'Sora',sans-serif;font-size:11px;font-weight:800;color:#ffd700;line-height:1.3;margin-bottom:1px}
    .pc-label{font-size:10px;color:#94a3b8}

    /* ── CTA buttons ── */
    .slide-btns{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;flex-shrink:0;margin-top:2px}
    .s-btn{padding:11px 22px;border-radius:999px;font-family:'Sora',sans-serif;font-size:13px;font-weight:800;cursor:pointer;border:none;transition:all .2s;display:inline-flex;align-items:center;gap:6px}
    .s-btn-gold{background:linear-gradient(135deg,#d97706,#f59e0b);color:#fff;box-shadow:0 6px 20px rgba(217,119,6,.38)}
    .s-btn-gold:hover{transform:translateY(-2px);box-shadow:0 10px 26px rgba(217,119,6,.52)}
    .s-btn-outline{background:rgba(255,255,255,.07);border:1.5px solid rgba(255,255,255,.2);color:#e2e8ff}
    .s-btn-outline:hover{border-color:rgba(255,215,0,.5);color:#ffd700}

    /* ── Individual contest slides ── */
    .slide-img{
      width:min(130px,28vw);height:min(130px,28vw);
      border-radius:18px;object-fit:cover;object-position:center;
      border:2px solid rgba(255,215,0,.3);
      box-shadow:0 8px 28px rgba(0,0,0,.4);
      margin-bottom:8px;flex-shrink:0;
      background:linear-gradient(135deg,#fff7d6,#f0e0a0);
    }
    .slide-icon{
      width:min(80px,20vw);height:min(80px,20vw);
      border-radius:18px;background:linear-gradient(135deg,#1e2d82,#2a3d9e);
      border:2px solid rgba(255,215,0,.25);
      display:flex;align-items:center;justify-content:center;
      font-size:min(38px,9vw);margin-bottom:8px;flex-shrink:0;
    }
    .slide h2{font-family:'Sora',sans-serif;font-size:clamp(16px,4.5vw,26px);font-weight:800;color:#ffd700;margin-bottom:5px;line-height:1.2;flex-shrink:0}
    .slide-desc{font-size:clamp(11px,2.5vw,13px);color:#c7d9ff;max-width:520px;line-height:1.5;margin-bottom:8px;flex-shrink:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}

    /* ── Benefits row ── */
    .slide-benefits{display:flex;flex-wrap:wrap;justify-content:center;gap:5px;margin-bottom:7px;max-width:560px;width:100%}
    .sb-item{display:inline-flex;align-items:center;gap:5px;background:rgba(16,185,129,.12);border:1px solid rgba(16,185,129,.28);border-radius:999px;padding:4px 10px;font-size:11px;font-weight:600;color:#6ee7b7;flex-shrink:0}
    .sb-icon{font-size:12px}
    .sb-val{color:rgba(110,231,183,.75);font-size:10px}

    /* ── Prize rows compact ── */
    .slide-prizes{display:flex;flex-direction:column;gap:4px;margin-bottom:8px;width:100%;max-width:360px}
    .sp-row{display:flex;align-items:center;gap:7px;padding:5px 10px;border-radius:8px;background:rgba(255,215,0,.07);border:1px solid rgba(255,215,0,.15);font-size:11px;font-weight:700;color:#fde68a}
    .sp-row span:first-child{font-size:13px;flex-shrink:0}
    .sp-place{font-size:10px;color:#64748b;margin-left:auto;font-weight:500}

    /* ── Pills ── */
    .slide-pills{display:flex;flex-wrap:wrap;gap:5px;justify-content:center;margin-bottom:8px;flex-shrink:0}
    .spill{padding:4px 11px;border-radius:999px;font-size:11px;font-weight:700;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);color:#e2e8ff}
    .spill.gold{background:rgba(245,158,11,.14);border-color:rgba(245,158,11,.35);color:#fde68a}

    /* ── Previous contest slide ── */
    .prev-slide-stats{display:flex;gap:8px;justify-content:center;margin-bottom:10px;flex-wrap:wrap}
    .pss{background:rgba(255,255,255,.06);border:1px solid rgba(255,215,0,.18);border-radius:12px;padding:8px 14px;text-align:center;min-width:90px}
    .pss strong{display:block;font-family:'Sora',sans-serif;font-size:18px;font-weight:800;color:#ffd700;margin-bottom:2px}
    .pss span{font-size:10px;color:#94a3b8}

    /* ── Winner photo cards ── */
    .winner-photos{display:flex;gap:8px;justify-content:center;margin-bottom:10px;flex-wrap:wrap;width:100%;max-width:500px}
    .wphoto{flex:1;min-width:100px;max-width:150px;border-radius:14px;overflow:hidden;border:2px solid rgba(255,215,0,.25);position:relative;box-shadow:0 6px 18px rgba(0,0,0,.4)}
    .wphoto img{width:100%;height:110px;object-fit:cover;object-position:top center;display:block}
    .wphoto-info{background:linear-gradient(0deg,rgba(0,0,0,.85) 0%,transparent 100%);position:absolute;bottom:0;left:0;right:0;padding:5px 7px}
    .wphoto-rank{font-size:10px;font-weight:800;color:#ffd700;display:block;line-height:1.2}
    .wphoto-name{font-size:10px;font-weight:600;color:#fff;display:block;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

    /* ── ISKCON slide ── */
    .iskcon-big{font-size:clamp(52px,12vw,80px);margin-bottom:6px;flex-shrink:0}
    .iskcon-pillars{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:10px;width:100%;max-width:400px}
    .ip{background:rgba(255,255,255,.05);border:1px solid rgba(255,215,0,.12);border-radius:11px;padding:8px 10px;display:flex;gap:7px;align-items:center;text-align:left}
    .ip-icon{font-size:16px;flex-shrink:0}
    .ip-text{font-size:11px;color:#c7d9ff;line-height:1.4;font-weight:600}

    /* ── Slide nav dots ── */
    .slide-nav{position:absolute;bottom:10px;left:0;right:0;display:flex;align-items:center;justify-content:center;gap:6px;z-index:5}
    .slide-dot{width:7px;height:7px;border-radius:999px;background:rgba(255,255,255,.25);cursor:pointer;transition:all .25s;border:none;padding:0}
    .slide-dot.active{background:#f59e0b;width:20px}

    /* ── Slide arrows ── */
    .slide-arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:5;width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .18s;backdrop-filter:blur(6px)}
    .slide-arrow:hover{background:rgba(245,158,11,.25);border-color:#f59e0b}
    .slide-arrow svg{width:16px;height:16px;fill:currentColor}
    .slide-arrow.prev{left:8px}.slide-arrow.next{right:8px}
    @media(max-width:480px){.slide-arrow{display:none}}

    /* ═══ STATS BAR ═══ */
    .stats-bar{background:linear-gradient(135deg,#d97706,#f59e0b,#d97706);padding:12px 20px}
    .stats-inner{max-width:1000px;margin:0 auto;display:flex;flex-wrap:wrap;justify-content:center;gap:0}
    .stat-item{display:flex;flex-direction:column;align-items:center;padding:6px 18px;border-right:1px solid rgba(255,255,255,.25);min-width:100px}
    .stat-item:last-child{border-right:none}
    .stat-num{font-family:'Sora',sans-serif;font-size:20px;font-weight:900;color:#fff;line-height:1}
    .stat-label{font-size:10px;font-weight:600;color:rgba(255,255,255,.8);margin-top:2px;text-align:center}
    @media(max-width:600px){.stat-item{border-right:none;padding:4px 12px}}

    /* ═══ SECTIONS ═══ */
    .sec{padding:48px 20px;position:relative;z-index:1}
    .sec-dark{background:rgba(0,0,0,.18)}
    .sec-title{font-family:'Sora',sans-serif;font-size:clamp(22px,4vw,36px);font-weight:800;text-align:center;margin-bottom:8px;background:linear-gradient(135deg,#ffd700,rgba(255,255,255,.8));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .sec-sub{text-align:center;color:#94a3b8;font-size:14px;max-width:580px;margin:0 auto 32px;line-height:1.6}
    .sec-wrap{max-width:1160px;margin:0 auto}

    /* ═══ CONTESTS GRID ═══ */
    .contests-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px}
    .ccard{background:rgba(255,255,255,.05);border:1.5px solid rgba(255,215,0,.16);border-radius:20px;overflow:hidden;transition:transform .22s,box-shadow .22s,border-color .22s;box-shadow:0 4px 20px rgba(0,0,0,.2)}
    .ccard:hover{transform:translateY(-5px);border-color:#ffd700;box-shadow:0 12px 36px rgba(245,158,11,.18)}
    .ccard-img{width:100%;height:160px;object-fit:cover;background:linear-gradient(135deg,#1e2d82,#2a3d9e)}
    .ccard-img-fallback{width:100%;height:160px;background:linear-gradient(135deg,#1e2d82,#2a3d9e);display:flex;align-items:center;justify-content:center;font-size:52px}
    .ccard-body{padding:14px}
    .ccard-title{font-family:'Sora',sans-serif;font-size:16px;font-weight:700;color:#ffd700;margin-bottom:5px;line-height:1.3}
    .ccard-desc{font-size:12px;color:#94a3b8;line-height:1.55;margin-bottom:10px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .ccard-meta{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:9px}
    .ccard-tag{font-size:11px;font-weight:700;padding:3px 8px;border-radius:999px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);color:#c7d9ff}
    .ccard-benefits{display:flex;flex-direction:column;gap:4px;margin-bottom:8px}
    .cb-row{display:flex;align-items:center;gap:6px;font-size:11px;color:#6ee7b7}
    .cb-icon{font-size:12px;flex-shrink:0}
    .ccard-prizes{display:flex;flex-direction:column;gap:3px;margin-bottom:9px}
    .cp-row{display:flex;align-items:center;gap:7px;padding:5px 8px;border-radius:8px;background:rgba(255,215,0,.06);border:1px solid rgba(255,215,0,.12);font-size:11px;font-weight:700;color:#fde68a}
    .cp-row span:first-child{font-size:13px;flex-shrink:0}
    .cp-place{font-size:10px;color:#64748b;font-weight:500;margin-left:auto}
    .ccard-price{font-family:'Sora',sans-serif;font-size:16px;font-weight:800;color:#ffd700;display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
    .ccard-price span{font-size:11px;color:#64748b;font-weight:500}
    .ccard-btn{display:block;width:100%;padding:10px;border-radius:10px;text-align:center;background:linear-gradient(135deg,var(--navy3),var(--navy4));color:#fff;font-family:'Sora',sans-serif;font-size:12px;font-weight:700;border:1.5px solid rgba(255,255,255,.1);transition:all .18s}
    .ccard-btn:hover{background:linear-gradient(135deg,#d97706,#f59e0b);border-color:transparent}
    .ccard.combo{border-color:rgba(245,158,11,.4);background:linear-gradient(145deg,rgba(245,158,11,.07),rgba(26,35,126,.1))}

    /* ═══ PROMO BAND ═══ */
    .promo-band{background:linear-gradient(135deg,#78350f 0%,#92400e 50%,#b45309 100%);border-radius:22px;padding:22px 20px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;box-shadow:0 10px 36px rgba(120,53,15,.4);margin:0 auto;max-width:900px}
    .promo-icon{font-size:44px;flex-shrink:0}
    .promo-text .pt1{font-family:'Sora',sans-serif;font-size:clamp(16px,3.5vw,22px);font-weight:800;color:#fef3c7;margin-bottom:4px}
    .promo-text .pt2{font-size:13px;color:rgba(254,243,199,.8);line-height:1.6}
    .promo-btn{margin-left:auto;padding:10px 20px;border-radius:999px;background:#fef3c7;color:#78350f;font-family:'Sora',sans-serif;font-size:13px;font-weight:800;flex-shrink:0;transition:all .18s;white-space:nowrap}
    .promo-btn:hover{background:#fff;transform:scale(1.04)}
    @media(max-width:600px){.promo-btn{margin-left:0;width:100%;text-align:center}}

    /* ═══ HOW IT WORKS ═══ */
    .steps-row{display:flex;flex-wrap:wrap;justify-content:center;position:relative}
    .steps-row::before{content:'';position:absolute;top:32px;left:15%;right:15%;height:2px;background:linear-gradient(90deg,transparent,rgba(245,158,11,.4),transparent);z-index:0}
    .step-box{flex:1;min-width:150px;max-width:190px;display:flex;flex-direction:column;align-items:center;text-align:center;padding:14px 10px;position:relative;z-index:1}
    .step-num{width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,var(--navy3),var(--navy4));border:2px solid rgba(245,158,11,.4);display:flex;align-items:center;justify-content:center;font-family:'Sora',sans-serif;font-size:18px;font-weight:800;color:#ffd700;margin-bottom:10px;box-shadow:0 4px 14px rgba(26,35,126,.4)}
    .step-emoji{font-size:20px;margin-bottom:5px}
    .step-title{font-family:'Sora',sans-serif;font-size:13px;font-weight:700;color:#fff;margin-bottom:4px}
    .step-desc{font-size:11px;color:#94a3b8;line-height:1.5}

    /* ═══ PREVIOUS CONTEST (below slideshow) ═══ */
    .prev-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:22px;align-items:start}
    @media(max-width:860px){.prev-grid{grid-template-columns:1fr}}
    .prev-card{background:rgba(255,255,255,.04);border:1.5px solid rgba(255,215,0,.16);border-radius:22px;padding:22px}
    .prev-card h3{font-family:'Sora',sans-serif;font-size:clamp(16px,3vw,22px);font-weight:800;color:#ffd700;margin-bottom:8px;line-height:1.3}
    .prev-period{display:inline-block;background:rgba(245,158,11,.14);border:1px solid rgba(245,158,11,.3);border-radius:999px;padding:4px 12px;font-size:11px;font-weight:700;color:#fde68a;margin-bottom:12px}
    .prev-text{font-size:13px;color:#c7d9ff;line-height:1.75;margin-bottom:14px}
    .prev-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
    .prev-stat{background:rgba(255,255,255,.05);border:1px solid rgba(255,215,0,.14);border-radius:12px;padding:12px 8px;text-align:center}
    .prev-stat strong{display:block;font-family:'Sora',sans-serif;font-size:clamp(16px,3vw,22px);font-weight:800;color:#ffd700;margin-bottom:3px}
    .prev-stat span{font-size:10px;color:#94a3b8;line-height:1.4}

    /* winner cards */
    .winner-list{display:flex;flex-direction:column;gap:10px}
