    @media(max-width:520px){.footer-grid{grid-template-columns:1fr}}
    .fb-logo{display:flex;align-items:center;gap:9px;margin-bottom:12px}
    .fb-logo-icon{width:38px;height:38px;border-radius:11px;background:linear-gradient(135deg,var(--navy3),var(--navy4));display:grid;place-items:center;border:1px solid rgba(255,215,0,.2);flex-shrink:0}
    .fb-logo-icon svg{width:20px;height:20px;fill:#ffd700}
    .fb-name{font-family:'Sora',sans-serif;font-size:14px;font-weight:800;color:#ffd700;line-height:1.2}
    .fb-name span{display:block;font-size:10px;color:#475569;font-weight:500}
    .footer-brand p{font-size:12px;color:#475569;line-height:1.75;margin-bottom:10px}
    .footer-brand address{font-style:normal;font-size:11px;color:#334155;line-height:1.8}
    .contact-row{display:flex;align-items:center;gap:6px;font-size:12px;color:#475569;margin-top:8px}
    .contact-row a{color:#f59e0b;font-weight:600;transition:color .14s}
    .contact-row a:hover{color:#ffd700}
    .footer-col h4{font-family:'Sora',sans-serif;font-size:12px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.6px;margin-bottom:12px}
    .footer-col ul{list-style:none}
    .footer-col li{margin-bottom:8px}
    .footer-col a{font-size:13px;color:#475569;transition:color .18s;display:flex;align-items:center;gap:5px}
    .footer-col a:hover{color:#ffd700}
    .footer-bottom{max-width:1160px;margin:0 auto;padding:14px 0 18px;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
    .footer-bottom p{font-size:11px;color:#334155}
    .wa-link{display:inline-flex;align-items:center;gap:6px;background:#25d366;color:#fff;padding:7px 14px;border-radius:999px;font-family:'Sora',sans-serif;font-size:11px;font-weight:700;transition:all .18s}
    .wa-link:hover{background:#1ebe5d;transform:scale(1.04)}
    .wa-link svg{width:14px;height:14px;fill:#fff}

    /* ═══ REVEAL ═══ */
    .reveal{opacity:0;transform:translateY(20px);transition:opacity .5s ease,transform .5s ease}
    .reveal.visible{opacity:1;transform:translateY(0)}
  </style>
</head>
<body>

<%
  function getEmoji(title){
    const t=(title||'').toLowerCase();
    if(t.includes('gita'))return'📖';
    if(t.includes('bhagavatam'))return'📿';
    if(t.includes('ramayana'))return'🏹';
    if(t.includes('krishna'))return'🪈';
    if(t.includes('combo'))return'🎯';
    return'📘';
  }
  const allContests = Array.isArray(contests) ? contests.filter(c=>!String(c.title||'').toLowerCase().includes('combo')) : [];
  const comboContest = Array.isArray(contests) ? contests.find(c=>String(c.title||'').toLowerCase().includes('combo')) : null;
