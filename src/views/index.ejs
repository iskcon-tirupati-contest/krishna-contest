    .about-text p{font-size:13px;color:#c7d9ff;line-height:1.75;margin-bottom:8px}
    .about-pillars{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:4px}
    .pillar{background:rgba(255,255,255,.05);border:1px solid rgba(255,215,0,.14);border-radius:12px;padding:10px;display:flex;gap:8px;align-items:flex-start}
