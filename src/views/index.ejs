    <div class="section" id="contests">
        <h2>🏆 Contest Categories & Prizes</h2>
        <p class="section-subtitle">Win prestigious gold medals and celebrate your devotion!</p>
        
        <div class="contests-grid">
            <!-- Painting Contest -->
            <div class="contest-card">
                <span class="contest-icon">🎨</span>
                <h3>Krishna Painting Contest</h3>
                <p>Express your devotion through vibrant art and creativity. Share your vision of Lord Krishna's divine leelas.</p>
                
                <div class="prizes-section">
                    <div class="prizes-title">🏅 Gold Medal Prizes</div>
                    <div class="medals">
                        <div class="medal">
