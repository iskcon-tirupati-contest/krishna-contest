        const isCombo = String(c.title||'').toLowerCase().includes('combo');
        const emoji = getEmoji(c.title);
      %>
      <div class="ccard <%= isCombo?'combo':'' %> reveal" style="transition-delay:<%=i*0.07%>s">
        <% if(c.image_url && !isCombo){ %>
          <img class="ccard-img" src="<%= c.image_url %>" alt="<%= c.title %>" loading="lazy" onerror="this.parentElement.innerHTML='<div class=ccard-img-fallback><%=emoji%></div>'">
