          </div>
          <% } %>
          <div class="ccard-prizes">
            <div class="cp-row"><span>🥇</span><span>10g Pure Gold Medal</span><span class="cp-place">1st Prize</span></div>
            <div class="cp-row"><span>🛕</span><span>VIP Darshan – Tirumala Balaji</span><span class="cp-place">2nd</span></div>
            <div class="cp-row"><span>🛕</span><span>VIP Darshan – Tirumala Balaji</span><span class="cp-place">3rd</span></div>
            <div class="cp-row"><span>🪷</span><span>ISKCON Life Patron Membership</span><span class="cp-place">4th</span></div>
            <div class="cp-row"><span>🪷</span><span>ISKCON Life Patron Membership</span><span class="cp-place">5th</span></div>
          </div>
          <div class="ccard-price">
            <span>₹<%= Number(c.price||399) %></span>
            <% if(isCombo){ %><span style="color:#f59e0b;font-size:11px;font-weight:700">🔥 Best Value</span><% }else{ %><span>per entry</span><% } %>
          </div>
          <a href="/register" class="ccard-btn">Register for This Contest →</a>
