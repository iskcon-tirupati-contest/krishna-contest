<!DOCTYPE html>
<html lang="en">
<head>
  <title>Login - Iskcon Tirupati Essay Writing Contest</title>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    html,body{height:100%}
    body{
      font-family:'DM Sans',system-ui,sans-serif;
      background:#0d1340;
      min-height:100vh;
      display:flex;align-items:center;justify-content:center;
      padding:20px 16px 40px;
      position:relative;overflow-x:hidden;
      -webkit-font-smoothing:antialiased;
    }
    /* atmospheric background */
    body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
      background:
        radial-gradient(ellipse at 20% 30%,rgba(245,158,11,.13) 0%,transparent 50%),
        radial-gradient(ellipse at 80% 70%,rgba(57,73,171,.2) 0%,transparent 50%),
        radial-gradient(ellipse at 50% 100%,rgba(26,35,126,.3) 0%,transparent 55%);
    }
    body::after{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
      background-image:radial-gradient(rgba(255,255,255,.04) 1px,transparent 1px);
      background-size:28px 28px;
    }

    .wrap{position:relative;z-index:1;width:100%;max-width:420px}

    /* ── Logo + brand at top ── */
    .brand-header{display:flex;flex-direction:column;align-items:center;margin-bottom:22px}
    .brand-logo{width:72px;height:72px;border-radius:20px;overflow:hidden;
      background:linear-gradient(135deg,#1a237e,#3949ab);
      border:2px solid rgba(255,215,0,.3);
      box-shadow:0 8px 28px rgba(26,35,126,.5);
      display:flex;align-items:center;justify-content:center;
      margin-bottom:12px;flex-shrink:0;
    }
    .brand-logo img{width:100%;height:100%;object-fit:contain}
    .brand-logo-fallback{width:36px;height:36px;fill:#ffd700}
    .brand-name-line1{font-family:'Sora',sans-serif;font-size:15px;font-weight:800;color:#ffd700;letter-spacing:.2px;text-align:center}
    .brand-name-line2{font-family:'Sora',sans-serif;font-size:12px;font-weight:600;color:rgba(255,255,255,.7);text-align:center;margin-top:2px}

    /* ── Card ── */
    .card{
      background:rgba(255,255,255,.97);
      border-radius:26px;
      box-shadow:0 24px 60px rgba(0,0,0,.35);
      overflow:hidden;
      border:1px solid rgba(255,215,0,.15);
    }
    /* card top accent stripe */
    .card-stripe{height:5px;background:linear-gradient(90deg,#1a237e,#3949ab,#f59e0b)}

    .card-body{padding:26px 24px 28px}

    .card-title{font-family:'Sora',sans-serif;font-size:26px;font-weight:800;color:#0f172a;text-align:center;margin-bottom:5px}
    .card-sub{font-size:14px;color:#64748b;text-align:center;margin-bottom:22px;line-height:1.55}

    /* ── Form ── */
    .form-group{margin-bottom:14px}
    .form-label{font-family:'Sora',sans-serif;font-size:12px;font-weight:700;color:#334155;margin-bottom:6px;display:block;letter-spacing:.2px}
    .input-wrap{position:relative;display:flex;align-items:center}
    .input-icon{position:absolute;left:14px;top:50%;transform:translateY(-50%);width:18px;height:18px;fill:#94a3b8;flex-shrink:0;pointer-events:none}
    input{
      width:100%;padding:13px 14px 13px 42px;
      border:1.5px solid #dbe2ea;border-radius:14px;
      font-family:'DM Sans',system-ui,sans-serif;font-size:15px;color:#0f172a;
      outline:none;background:#fff;transition:border-color .18s,box-shadow .18s;
    }
    input:focus{border-color:#1a237e;box-shadow:0 0 0 3px rgba(26,35,126,.1)}
    input::placeholder{color:#94a3b8}
    .hint{margin-top:5px;font-size:12px;color:#64748b;padding-left:2px}

    /* eye toggle */
    .eye-btn{position:absolute;right:13px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;padding:4px;color:#94a3b8;display:flex;align-items:center;justify-content:center;transition:color .15s}
    .eye-btn:hover{color:#334155}
    .eye-btn svg{width:18px;height:18px;fill:currentColor}

    /* forgot password */
    .forgot-row{text-align:right;margin-top:-6px;margin-bottom:14px}
    .forgot-row a{font-size:12px;font-weight:700;color:#1a237e;text-decoration:none;transition:color .15s}
    .forgot-row a:hover{color:#f59e0b}

    /* submit button */
    .submit-btn{
      width:100%;border:0;border-radius:14px;padding:15px 16px;margin-top:4px;
      background:linear-gradient(135deg,#1a237e,#3949ab);color:#fff;
      font-family:'Sora',sans-serif;font-size:16px;font-weight:800;cursor:pointer;
      box-shadow:0 8px 24px rgba(26,35,126,.35);transition:all .2s;
      display:flex;align-items:center;justify-content:center;gap:8px;
    }
    .submit-btn:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(26,35,126,.45)}
    .submit-btn:active{transform:scale(.98)}
    .submit-btn:disabled{opacity:.7;cursor:not-allowed;transform:none}
    .submit-btn svg{width:18px;height:18px;fill:currentColor}

    /* alerts */
    .alert,.ok{display:none;margin-bottom:14px;padding:12px 14px;border-radius:12px;font-size:13px;font-weight:600}
    .alert{background:#fee2e2;color:#991b1b;border:1px solid #fecaca}
    .ok{background:#dcfce7;color:#166534;border:1px solid #bbf7d0}

    /* links */
    .links{margin-top:18px;text-align:center;font-size:13px;color:#64748b;line-height:1.8}
    .links a{color:#1a237e;font-weight:700;text-decoration:none;transition:color .15s}
    .links a:hover{color:#f59e0b}

    /* security note */
    .security-note{display:flex;align-items:center;justify-content:center;gap:5px;margin-top:14px;font-size:11px;color:#94a3b8}
    .security-note svg{width:13px;height:13px;fill:#94a3b8}
  </style>
</head>
<body>
  <div class="wrap">

    <!-- Logo header -->
    <div class="brand-header">
      <div class="brand-logo">
        <img src="/images/logo_new.png" alt="Iskcon Tirupati" onerror="this.style.display='none';this.nextElementSibling.style.display='block'">
        <svg class="brand-logo-fallback" style="display:none" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15v-4H7l5-8v4h4l-5 8z"/></svg>
      </div>
      <div class="brand-name-line1">Iskcon Tirupati</div>
      <div class="brand-name-line2">Essay Writing Contest</div>
    </div>

    <!-- Card -->
    <div class="card">
      <div class="card-stripe"></div>
      <div class="card-body">
        <div class="card-title">Welcome Back 🙏</div>
        <div class="card-sub">Login with your mobile number and password</div>

        <div id="errBox" class="alert"></div>
        <div id="okBox" class="ok"></div>

        <form id="loginForm" autocomplete="off" novalidate>

          <div class="form-group">
            <label class="form-label" for="phone">Mobile Number</label>
            <div class="input-wrap">
              <svg class="input-icon" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
              <input id="phone" name="phone" placeholder="10-digit mobile number" inputmode="numeric" maxlength="10" autocomplete="tel" required/>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="password">Password</label>
            <div class="input-wrap">
              <svg class="input-icon" viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
              <input id="password" name="password" type="password" placeholder="Enter your password" autocomplete="current-password" required/>
              <button type="button" class="eye-btn" id="eyeBtn" aria-label="Toggle password">
                <svg id="eyeIcon" viewBox="0 0 24 24"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
              </button>
            </div>
          </div>

          <div class="forgot-row"><a href="/forgot-password">Forgot Password?</a></div>

          <button type="submit" id="loginBtn" class="submit-btn">
            <svg viewBox="0 0 24 24"><path d="M11 7L9.6 8.4l2.6 2.6H2v2h10.2l-2.6 2.6L11 17l5-5-5-5zm9 12h-8v2h8c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-8v2h8v14z"/></svg>
            Login
          </button>
        </form>

        <div class="links">
          New user? <a href="/register">Register Here</a>
          &nbsp;·&nbsp;
          <a href="/">Go to Home</a>
        </div>

        <div class="security-note">
          <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
          Secured · Your data is safe with us
        </div>
      </div>
    </div>
  </div>

<script>
(function () {
  const phoneEl = document.getElementById("phone");
  const passwordEl = document.getElementById("password");
  const loginForm = document.getElementById("loginForm");
  const loginBtn = document.getElementById("loginBtn");
  const errBox = document.getElementById("errBox");
  const okBox = document.getElementById("okBox");
  const eyeBtn = document.getElementById("eyeBtn");
  const eyeIcon = document.getElementById("eyeIcon");

  // Eye toggle
  const eyeOpen = `<path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>`;
  const eyeClosed = `<path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46A11.8 11.8 0 0 0 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/>`;

  eyeBtn.addEventListener('click', () => {
    const isPassword = passwordEl.type === 'password';
    passwordEl.type = isPassword ? 'text' : 'password';
    eyeIcon.innerHTML = isPassword ? eyeClosed : eyeOpen;
  });

  function showError(msg) { errBox.textContent = msg||"Something went wrong"; errBox.style.display="block"; okBox.style.display="none"; }
  function showOk(msg) { okBox.textContent = msg||""; okBox.style.display="block"; errBox.style.display="none"; }
  function clearMsg() { errBox.style.display="none"; okBox.style.display="none"; }
  function norm(v){ return String(v||"").trim(); }
  function validPhone(v){ return /^[6-9][0-9]{9}$/.test(norm(v)); }

  phoneEl.addEventListener("input", () => { phoneEl.value = phoneEl.value.replace(/\D/g,"").slice(0,10); clearMsg(); });

  loginForm.addEventListener("submit", async (e) => {
    e.preventDefault(); clearMsg();
    const phone = norm(phoneEl.value);
    const password = String(passwordEl.value||"");
    if (!validPhone(phone)) return showError("Please enter a valid 10-digit mobile number.");
    if (!password) return showError("Please enter your password.");
    loginBtn.disabled = true;
    loginBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="animation:spin 1s linear infinite"><path d="M12 4V2A10 10 0 0 0 2 12h2a8 8 0 0 1 8-8z"/></svg> Logging in...';
    try {
      const r = await fetch("/login", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      credentials: "same-origin", // IMPORTANT
      body: JSON.stringify({ phone, password }),
    });

      const data = await r.json();
      if (!r.ok||!data.ok) throw new Error(data.message||"Login failed");
      showOk("Login successful. Redirecting...");
      window.location.href = data.redirect||"/dashboard";
    } catch(e) {
      showError(e.message||"Login failed");
    } finally {
      loginBtn.disabled = false;
      loginBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M11 7L9.6 8.4l2.6 2.6H2v2h10.2l-2.6 2.6L11 17l5-5-5-5zm9 12h-8v2h8c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-8v2h8v14z"/></svg> Login';
    }
  });
})();
</script>
</body>
</html>