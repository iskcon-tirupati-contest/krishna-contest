<!DOCTYPE html>
<html lang="en">
<head>
  <title>Login - BhakthiVedanta Wisdom Contest 2026</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    body{
      font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;
      background:linear-gradient(135deg,#1a237e 0%,#0d47a1 50%,#01579b 100%);
      min-height:100vh;display:flex;align-items:center;justify-content:center;
      padding:20px;position:relative;overflow:hidden
    }
    body::before{
      content:'';position:fixed;top:0;left:0;width:100%;height:100%;
      background-image:
        radial-gradient(circle at 20% 50%, rgba(255,215,0,0.1) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(255,193,7,0.1) 0%, transparent 50%);
      animation:float 15s ease-in-out infinite;pointer-events:none
    }
    @keyframes float{0%,100%{opacity:.5;transform:scale(1)}50%{opacity:.8;transform:scale(1.1)}}
    .login-container{
      background:rgba(255,255,255,.95);backdrop-filter:blur(10px);
      border-radius:25px;box-shadow:0 15px 50px rgba(0,0,0,.3);
      width:100%;max-width:420px;padding:50px 40px;position:relative;z-index:1;
      border:2px solid rgba(255,215,0,.3)
    }
    .logo{text-align:center;margin-bottom:28px}
    .logo h1{font-size:26px;color:#1a237e;margin-bottom:5px}
    .logo p{font-size:14px;color:#546e7a}
    .alert{
      background:rgba(244,67,54,.10);
      border:1px solid rgba(244,67,54,.35);
      color:#b42318;
      padding:12px 14px;border-radius:12px;font-weight:700;
      margin-bottom:14px;font-size:14px;display:none
    }
    .ok{
      background:rgba(16,185,129,.10);
      border:1px solid rgba(16,185,129,.35);
      color:#065f46;
      padding:12px 14px;border-radius:12px;font-weight:700;
      margin-bottom:14px;font-size:14px;display:none
    }
    form{display:flex;flex-direction:column;gap:18px}
    .form-group{position:relative}
    input{
      width:100%;padding:15px 20px;border:2px solid #e0e0e0;border-radius:12px;
      font-size:16px;transition:all .3s ease;background:#fff;color:#333
    }
    input:focus{outline:none;border-color:#ffd700;box-shadow:0 0 0 4px rgba(255,215,0,.1)}
    .btn{
      width:100%;padding:16px;border:none;border-radius:12px;cursor:pointer;
      font-size:16px;font-weight:700;transition:all .3s ease;
      background:linear-gradient(135deg,#ffd700 0%,#ffb300 100%);
      color:#1a237e;box-shadow:0 6px 20px rgba(255,215,0,.4)
    }
    .btn:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(255,215,0,.6)}
    .btn:disabled{opacity:.65;cursor:not-allowed;transform:none}
    .links{text-align:center;margin-top:18px}
    .links a{
      color:#1a237e;text-decoration:none;font-weight:500;
      display:inline-block;margin:8px 15px
    }
    .back-home{
      position:absolute;top:20px;left:20px;color:#fff;text-decoration:none;font-weight:500;
      padding:10px 20px;background:rgba(255,255,255,.1);backdrop-filter:blur(5px);
      border-radius:25px;border:1px solid rgba(255,255,255,.2);z-index:10
    }
    .otp-wrap{display:none}
    @media (max-width:480px){
      .login-container{padding:40px 30px}
      .logo h1{font-size:22px}
      input,.btn{font-size:15px}
      .back-home{font-size:14px;padding:8px 16px}
    }
  </style>
</head>
<body>

<a href="/" class="back-home">← Back to Home</a>

<div class="login-container">
  <div class="logo">
    <div><img src="/images/logo.png" alt="" class="logo-img" height="80"></div>
    <h1>Welcome Back</h1>
    <p>Login using your mobile number</p>
  </div>

  <div id="errBox" class="alert"></div>
  <div id="okBox" class="ok"></div>

  <form id="loginForm" autocomplete="off" novalidate>
    <div class="form-group">
      <input id="phone" name="phone" placeholder="Mobile Number" inputmode="numeric" maxlength="10" autocomplete="tel" required />
    </div>

    <div id="otpWrap" class="otp-wrap">
      <div class="form-group">
        <input id="otp" name="otp" placeholder="Enter OTP" inputmode="numeric" maxlength="6" autocomplete="one-time-code" />
      </div>
    </div>

    <button type="button" id="sendOtpBtn" class="btn">Send OTP</button>
    <button type="button" id="verifyOtpBtn" class="btn" style="display:none;">Verify OTP & Login</button>
  </form>

  <div class="links">
    <p style="color:#546e7a;margin-bottom:10px;">Don't have an account?</p>
    <a href="/register">Register Now</a>
    <span style="color:#e0e0e0;">|</span>
    <a href="/">Go to Home</a>
  </div>
</div>

<script>
(function () {
  const phoneEl = document.getElementById("phone");
  const otpEl = document.getElementById("otp");
  const otpWrap = document.getElementById("otpWrap");
  const sendOtpBtn = document.getElementById("sendOtpBtn");
  const verifyOtpBtn = document.getElementById("verifyOtpBtn");
  const errBox = document.getElementById("errBox");
  const okBox = document.getElementById("okBox");

  function showError(msg) {
    errBox.textContent = msg || "Something went wrong";
    errBox.style.display = "block";
    okBox.style.display = "none";
  }

  function showOk(msg) {
    okBox.textContent = msg || "";
    okBox.style.display = "block";
    errBox.style.display = "none";
  }

  function clearMsg() {
    errBox.style.display = "none";
    okBox.style.display = "none";
  }

  function norm(v){ return String(v || "").trim(); }
  function validPhone(v){ return /^[6-9][0-9]{9}$/.test(norm(v)); }

  phoneEl.addEventListener("input", () => {
    phoneEl.value = phoneEl.value.replace(/\D/g, "").slice(0, 10);
    clearMsg();
  });

  otpEl.addEventListener("input", () => {
    otpEl.value = otpEl.value.replace(/\D/g, "").slice(0, 6);
    clearMsg();
  });

  sendOtpBtn.addEventListener("click", async () => {
    clearMsg();

    const phone = norm(phoneEl.value);
    if (!validPhone(phone)) {
      return showError("Please enter a valid 10-digit Indian mobile number.");
    }

    sendOtpBtn.disabled = true;
    sendOtpBtn.textContent = "Sending...";

    try {
      const r = await fetch("/login/send-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phone })
      });

      const data = await r.json();
      if (!r.ok || !data.ok) {
        throw new Error(data.message || "Failed to send OTP");
      }

      otpWrap.style.display = "block";
      verifyOtpBtn.style.display = "block";
      showOk(data.message || "OTP sent successfully.");
      otpEl.focus();
    } catch (e) {
      showError(e.message || "Failed to send OTP");
    } finally {
      sendOtpBtn.disabled = false;
      sendOtpBtn.textContent = "Send OTP";
    }
  });

  verifyOtpBtn.addEventListener("click", async () => {
    clearMsg();

    const phone = norm(phoneEl.value);
    const otp = norm(otpEl.value);

    if (!validPhone(phone)) return showError("Please enter a valid mobile number.");
    if (!/^\d{4,10}$/.test(otp)) return showError("Please enter a valid OTP.");

    verifyOtpBtn.disabled = true;
    verifyOtpBtn.textContent = "Verifying...";

    try {
      const r = await fetch("/login/verify-otp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phone, otp })
      });

      const data = await r.json();
      if (!r.ok || !data.ok) {
        throw new Error(data.message || "OTP verification failed");
      }

      window.location.href = data.redirect || "/dashboard";
    } catch (e) {
      showError(e.message || "OTP verification failed");
    } finally {
      verifyOtpBtn.disabled = false;
      verifyOtpBtn.textContent = "Verify OTP & Login";
    }
  });
})();
</script>

</body>
</html>