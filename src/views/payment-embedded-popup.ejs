<!DOCTYPE html>
<html lang="en">
<head>
  <title>Secure Payment — ISKCON Tirupati</title>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    html,body{height:100%;background:#fff;font-family:system-ui,sans-serif}

    /* ── Browser alert popup ── */
    .ba-overlay{
      position:fixed;inset:0;z-index:9999;
      background:rgba(0,0,0,.5);
      display:flex;align-items:center;justify-content:center;
      padding:20px;
    }
    .ba-overlay.hide{display:none}
    .ba-popup{
      background:#fff;border-radius:18px;
      padding:24px 20px;max-width:340px;width:100%;
      box-shadow:0 20px 60px rgba(0,0,0,.3);
      position:relative;
    }
    .ba-icon{font-size:32px;text-align:center;display:block;margin-bottom:12px}
    .ba-title{font-size:16px;font-weight:800;color:#92400e;text-align:center;margin-bottom:10px}
    .ba-text{font-size:13px;color:#78350f;line-height:1.7;margin-bottom:8px}
    .ba-text b{color:#92400e;font-weight:800}
    .ba-divider{height:1px;background:#fde68a;margin:12px 0}
    .ba-text-te{font-size:13px;color:#78350f;line-height:1.7}
    .ba-text-te b{color:#92400e;font-weight:800}
    .ba-close{
      width:100%;margin-top:16px;border:none;border-radius:12px;
      padding:12px;background:#1a237e;color:#fff;
      font-size:14px;font-weight:700;cursor:pointer;
    }
    .ba-close:active{opacity:.85}


    /* ── Iframe fullscreen ── */
    .rzp-frame{
      width:100%;
      height:calc(100vh - 90px);
      border:none;display:block;
    }

    /* ── Loader shown while iframe loads ── */
    .loader{
      display:flex;flex-direction:column;
      align-items:center;justify-content:center;
      gap:14px;padding:60px 20px;
      height:calc(100vh - 90px);
    }
    .loader.hide{display:none}
    .spinner{
      width:42px;height:42px;border-radius:50%;
      border:4px solid #e0e7ff;
      border-top-color:#1a237e;
      animation:spin .8s linear infinite;
    }
    .loader-text{font-size:14px;font-weight:700;color:#1a237e}
    .loader-sub{font-size:12px;color:#64748b;text-align:center}
    @keyframes spin{to{transform:rotate(360deg)}}
  </style>
</head>
<body>

  <!-- Browser alert popup -->
  <div class="ba-overlay" id="baOverlay">
    <div class="ba-popup">
      <span class="ba-icon">⚠️</span>
      <div class="ba-title">Important / ముఖ్యమైన సూచన</div>
      <div class="ba-text">
        If <b>PhonePe, Paytm, GPay</b> or other UPI options are not appearing, please try from <b>Google Chrome</b> browser.
      </div>
      <div class="ba-divider"></div>
      <div class="ba-text-te">
        <b>PhonePe, Paytm, GPay</b> లేదా ఇతర UPI options కనిపించకపోతే, దయచేసి <b>Google Chrome</b> బ్రౌజర్ నుండి ప్రయత్నించండి.
      </div>
      <button class="ba-close" onclick="document.getElementById('baOverlay').classList.add('hide')">
        OK, I Understand / అర్థమైంది ✓
      </button>
    </div>
  </div>

  <!-- Loader -->
  <div class="loader" id="loader">
    <div class="spinner"></div>
    <div class="loader-text">Opening secure payment...</div>
    <div class="loader-sub">Please do not press back or refresh</div>
  </div>

  <!-- Razorpay iframe -->
  <iframe
    id="rzpFrame"
    name="rzp_iframe"
    class="rzp-frame"
    style="display:none"
    title="Secure Payment"
  ></iframe>

  <!-- Hidden Razorpay form -->
  <form
    id="rzpForm"
    method="POST"
    action="https://api.razorpay.com/v1/checkout/embedded"
    target="rzp_iframe"
    style="display:none"
  >
    <input type="hidden" name="key_id"              value="<%= rzpKeyId %>">
    <input type="hidden" name="amount"               value="<%= rzpAmountPaise %>">
    <input type="hidden" name="order_id"             value="<%= rzpOrderId %>">
    <input type="hidden" name="callback_url"         value="<%= callbackUrl %>">
    <input type="hidden" name="redirect"             value="true">
    <input type="hidden" name="webview_intent"       value="true">
    <input type="hidden" name="name"                 value="ISKCON Tirupati EWC 2026">
    <input type="hidden" name="description"          value="Essay Writing Contest Registration">
    <input type="hidden" name="prefill[name]"        value="<%= prefillName || '' %>">
    <input type="hidden" name="prefill[email]"       value="<%= prefillEmail || '' %>">
    <input type="hidden" name="prefill[contact]"     value="<%= prefillContact ? ('+91' + String(prefillContact).replace(/\D/g,'').replace(/^91/,'')) : '' %>">
    <input type="hidden" name="notes[payment_group]" value="<%= paymentId %>">
  </form>

  <script>
  (function() {
    var frame  = document.getElementById('rzpFrame');
    var loader = document.getElementById('loader');
    var form   = document.getElementById('rzpForm');

    function revealIframe() {
      loader.classList.add('hide');
      frame.style.display = 'block';
    }

    /* Show iframe when Razorpay loads */
    frame.addEventListener('load', revealIframe);

    /* Fallback — show after 8s if load event doesn't fire */
    setTimeout(revealIframe, 8000);

    /* Submit form into iframe on page load */
    form.submit();

  })();
  </script>

</body>
</html>