<!DOCTYPE html>
<html lang="en">
<head>
  <title>Payment - Secure Checkout</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body{font-family:Segoe UI,Tahoma,Verdana,sans-serif;background:#0b1220;margin:0;padding:24px;color:#e5e7eb}
    .wrap{max-width:980px;margin:0 auto}
    .top{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
    a{color:#93c5fd;text-decoration:none;font-weight:900}
    .card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.10);border-radius:18px;box-shadow:0 10px 26px rgba(0,0,0,.25);overflow:hidden}
    .cardHead{padding:16px 18px;border-bottom:1px solid rgba(255,255,255,.08);display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
    .h1{font-weight:1000;font-size:18px;color:#fff}
    .muted{color:rgba(229,231,235,.75);font-size:12px;line-height:1.45}
    .pill{display:inline-block;padding:6px 10px;border-radius:999px;background:rgba(59,130,246,.15);border:1px solid rgba(59,130,246,.35);color:#dbeafe;font-size:12px;font-weight:900}
    .sum{padding:16px 18px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
    .btn{border:0;border-radius:14px;padding:12px 16px;font-weight:1000;cursor:pointer}
    .pay{background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff}
    .pay:disabled{opacity:.6;cursor:not-allowed}
    .embed-box{margin-top:14px;padding:14px;border:1px dashed rgba(148,163,184,.55);border-radius:16px;background:rgba(255,255,255,.03)}
    iframe{width:100%;height:620px;border:1px solid rgba(255,255,255,.10);border-radius:14px;background:#fff}
    details{padding:0 18px 16px}
    summary{cursor:pointer;color:#e5e7eb;font-weight:900;margin-top:10px}
    .list{margin-top:10px;border-top:1px solid rgba(255,255,255,.08);padding-top:10px}
    .row{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.06)}
    .row:last-child{border-bottom:none}
    .title{font-weight:900;color:#fff}
    .price{font-weight:900;color:#fff;white-space:nowrap}
  </style>
</head>
<body>
<div class="wrap">

  <div class="top">
    <a href="/dashboard">← Back</a>
    <div style="font-weight:1000;color:#fff">Secure Payment</div>
  </div>

  <div class="card">
    <div class="cardHead">
      <div>
        <div class="h1">Review & Pay</div>
        <div class="muted">
          You selected <span class="pill"><%= (orders || []).length %> contest(s)</span>
          &nbsp;•&nbsp; Complete payment to confirm registration.
        </div>
      </div>
      <div class="muted" style="text-align:right">
        Reference<br><b style="color:#fff"><%= paymentId %></b>
      </div>
    </div>

    <div class="sum">
      <div style="font-weight:1000;color:#fff;font-size:16px">Total: ₹<%= Number(totalAmount||0) %></div>
      <button id="payBtn" class="btn pay" type="button">Pay Now (HDFC CollectNow)</button>
    </div>

    <details>
      <summary>View selected contests</summary>
      <div class="list">
        <% (orders || []).forEach((o) => { %>
          <div class="row">
            <div style="min-width:0">
              <div class="title"><%= o.contest_title %></div>
              <div class="muted">Order: <%= o.id %></div>
            </div>
            <div class="price">₹<%= Number(o.amount||0) %></div>
          </div>
        <% }) %>
      </div>
    </details>
  </div>

  <div class="embed-box" id="embedBox">
    <div style="font-weight:1000;color:#fff">HDFC CollectNow</div>
    <div class="muted" style="margin-top:6px">
      The checkout will open below. If payment succeeds, you will be redirected to complete delivery/donation details.
      Please do not refresh while processing.
    </div>

    <div style="margin-top:12px">
      <iframe id="rzpFrame" name="rzp_iframe" title="Payment"></iframe>
    </div>

    <form
      id="rzpForm"
      method="POST"
      action="https://api.razorpay.com/v1/checkout/embedded"
      target="rzp_iframe"
      style="display:none"
    >
      <input type="hidden" name="key_id" value="<%= rzpKeyId %>">
      <input type="hidden" name="amount" value="<%= rzpAmountPaise %>">
      <input type="hidden" name="order_id" value="<%= rzpOrderId %>">
      <input type="hidden" name="callback_url" value="<%= callbackUrl %>">

      <input type="hidden" name="redirect" value="true">

      <input type="hidden" name="name" value="BhakthiVedanta Wisdom Contest 2026">
      <input type="hidden" name="description" value="Krishna Contest Registration">

      <input type="hidden" name="prefill[name]" value="<%= prefillName %>">
      <input type="hidden" name="prefill[email]" value="<%= prefillEmail %>">
      <input type="hidden" name="prefill[contact]" value="<%= prefillContact %>">

      <input type="hidden" name="notes[payment_group]" value="<%= paymentId %>">
    </form>
  </div>

</div>

<script>
  const payBtn = document.getElementById("payBtn");
  const form = document.getElementById("rzpForm");
  const embedBox = document.getElementById("embedBox");

  payBtn?.addEventListener("click", () => {
    try {
      payBtn.disabled = true;
      payBtn.textContent = "Opening secure checkout...";
      form.submit();
      embedBox.scrollIntoView({ behavior: "smooth", block: "start" });
    } catch (e) {
      payBtn.disabled = false;
      payBtn.textContent = "Pay Now (HDFC CollectNow)";
      alert("Unable to open payment. Please try again.");
    }
  });
</script>

</body>
</html>
