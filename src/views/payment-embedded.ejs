<!DOCTYPE html>
<html lang="en">
<head>
  <title>Payment - Developer Simulation</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body{font-family:Segoe UI,Tahoma,Verdana,sans-serif;background:#0b1220;margin:0;padding:24px;color:#e5e7eb}
    .wrap{max-width:980px;margin:0 auto}
    .top{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
    a{color:#93c5fd;text-decoration:none;font-weight:900}
    .card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.10);border-radius:18px;box-shadow:0 10px 26px rgba(0,0,0,.25);overflow:hidden}
    .cardHead{padding:16px 18px;border-bottom:1px solid rgba(255,255,255,.08);display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
    .h1{font-weight:1000;font-size:18px;color:#fff}
    .muted{color:rgba(229,231,235,.75);font-size:12px;line-height:1.45}
    .pill{display:inline-block;padding:6px 10px;border-radius:999px;background:rgba(59,130,246,.15);border:1px solid rgba(59,130,246,.35);color:#dbeafe;font-size:12px;font-weight:900}
    .sum{padding:16px 18px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
    .embed-box{margin-top:14px;padding:18px;border:1px dashed rgba(148,163,184,.55);border-radius:16px;background:rgba(255,255,255,.03)}
    details{padding:0 18px 16px}
    summary{cursor:pointer;color:#e5e7eb;font-weight:900;margin-top:10px}
    .list{margin-top:10px;border-top:1px solid rgba(255,255,255,.08);padding-top:10px}
    .row{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.06)}
    .row:last-child{border-bottom:none}
    .title{font-weight:900;color:#fff}
    .price{font-weight:900;color:#fff;white-space:nowrap}
    .devBadge{display:inline-block;margin-top:8px;padding:8px 12px;border-radius:999px;background:rgba(245,158,11,.14);border:1px solid rgba(245,158,11,.4);color:#fde68a;font-size:12px;font-weight:1000}
    .note{margin-top:10px;color:#cbd5e1;font-size:14px;line-height:1.6}
    .btnRow{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px}
    .btn{border:0;border-radius:14px;padding:13px 18px;font-weight:1000;cursor:pointer;text-decoration:none}
    .success{background:linear-gradient(135deg,#16a34a,#15803d);color:#fff}
    .failure{background:linear-gradient(135deg,#dc2626,#b91c1c);color:#fff}
    .ghost{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.10);color:#fff}
    .meta{margin-top:12px;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}
    .metaBox{padding:12px 14px;border-radius:14px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08)}
    .metaLabel{font-size:12px;color:#94a3b8;margin-bottom:4px}
    .metaVal{font-size:14px;color:#fff;font-weight:900;word-break:break-word}
  </style>
</head>
<body>
<div class="wrap">

  <div class="top">
    <a href="/dashboard">← Back</a>
    <div style="font-weight:1000;color:#fff">Developer Payment Simulation</div>
  </div>

  <div class="card">
    <div class="cardHead">
      <div>
        <div class="h1">Review & Simulate Payment</div>
        <div class="muted">
          You selected <span class="pill"><%= (orders || []).length %> contest(s)</span>
          &nbsp;•&nbsp; This developer environment does not call the real payment gateway.
        </div>
        <div class="devBadge">DEV ONLY · REAL HDFC / RAZORPAY IS DISABLED</div>
      </div>
      <div class="muted" style="text-align:right">
        Reference<br><b style="color:#fff"><%= paymentId %></b>
      </div>
    </div>

    <div class="sum">
      <div style="font-weight:1000;color:#fff;font-size:16px">Total: ₹<%= Number(totalAmount || 0) %></div>
      <div class="pill">Pending Order Group</div>
    </div>

    <details open>
      <summary>View selected contests</summary>
      <div class="list">
        <% (orders || []).forEach((o) => { %>
          <div class="row">
            <div style="min-width:0">
              <div class="title"><%= o.contest_title %></div>
              <div class="muted">Order: <%= o.id %></div>
            </div>
            <div class="price">₹<%= Number(o.amount || 0) %></div>
          </div>
        <% }) %>
      </div>
    </details>
  </div>

  <div class="embed-box">
    <div style="font-weight:1000;color:#fff;font-size:16px">Simulated Gateway Control</div>
    <div class="note">
      Choose one action below to test the same downstream flow that would normally happen after a real payment.
      <br>
      <b>Simulate Success</b> will mark the linked pending orders as <b>paid</b>.
      <br>
      <b>Simulate Failure</b> will mark the linked pending orders as <b>failed</b>.
    </div>

    <div class="meta">
      <div class="metaBox">
        <div class="metaLabel">Internal Payment Reference</div>
        <div class="metaVal"><%= paymentId %></div>
      </div>
      <div class="metaBox">
        <div class="metaLabel">Payment Session ID</div>
        <div class="metaVal"><%= paymentSessionId %></div>
      </div>
      <div class="metaBox">
        <div class="metaLabel">Orders Count</div>
        <div class="metaVal"><%= (orders || []).length %></div>
      </div>
      <div class="metaBox">
        <div class="metaLabel">Amount</div>
        <div class="metaVal">₹<%= Number(totalAmount || 0) %></div>
      </div>
    </div>

    <div class="btnRow">
      <form method="POST" action="/payment/mock-success" style="margin:0">
        <input type="hidden" name="paymentId" value="<%= paymentId %>">
        <button class="btn success" type="submit">Simulate Success</button>
      </form>

      <form method="POST" action="/payment/mock-failure" style="margin:0">
        <input type="hidden" name="paymentId" value="<%= paymentId %>">
        <button class="btn failure" type="submit">Simulate Failure</button>
      </form>

      <a href="/dashboard" class="btn ghost">Cancel and Return</a>
    </div>
  </div>

</div>
</body>
</html>