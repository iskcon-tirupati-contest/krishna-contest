<!DOCTYPE html>
<html lang="en">
<head>
  <title>Payment - Embedded Checkout</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    body{font-family:Segoe UI,Tahoma,Verdana,sans-serif;background:#f6f7fb;margin:0;padding:24px}
    .wrap{max-width:900px;margin:0 auto}
    .card{background:#fff;border:1px solid #e5e7eb;border-radius:16px;box-shadow:0 10px 26px rgba(0,0,0,.06);overflow:hidden}
    .top{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
    a{color:#1a237e;text-decoration:none;font-weight:800}
    .row{display:flex;justify-content:space-between;gap:12px;padding:14px 16px;border-bottom:1px solid #eef2f7}
    .row:last-child{border-bottom:none}
    .title{font-weight:900;color:#111827}
    .price{font-weight:900;color:#111827;white-space:nowrap}
    .sum{display:flex;justify-content:space-between;align-items:center;padding:16px}
    .btn{border:0;border-radius:12px;padding:12px 14px;font-weight:1000;cursor:pointer}
    .pay{background:#1a237e;color:#fff}
    .muted{color:#6b7280;font-size:12px}
    .embed-box{margin-top:14px;padding:14px;border:1px dashed #cbd5e1;border-radius:14px;background:#f8fafc}
    .smallbtn{padding:10px 12px;border-radius:10px;text-decoration:none;font-weight:900;display:inline-block}
    .ok{background:#1a237e;color:#fff}
    .bad{background:#b42318;color:#fff}
  </style>
</head>
<body>
<div class="wrap">

  <div class="top">
    <a href="/dashboard">← Back</a>
    <div style="font-weight:1000;color:#111827">Embedded Checkout</div>
  </div>

  <div class="card">
    <% orders.forEach((o) => { %>
      <div class="row">
        <div style="min-width:0">
          <div class="title"><%= o.contest_title %></div>
          <div class="muted">Order: <%= o.id %></div>
        </div>
        <div class="price">₹<%= Number(o.amount||0) %></div>
      </div>
    <% }) %>

    <div class="sum">
      <div style="font-weight:1000;color:#111827">Total: ₹<%= Number(totalAmount||0) %></div>
      <div class="muted">Payment ID: <%= paymentId %></div>
    </div>
  </div>

  <div style="margin-top:14px">
    <button id="payBtn" class="btn pay" type="button">Pay Now (HDFC Embedded)</button>
    <div class="muted" style="margin-top:8px">
      Payment opens inside this page (embedded). Do not refresh while processing.
    </div>
  </div>

  <div class="embed-box" id="embedBox">
    <div style="font-weight:900;color:#0f172a">Secure Payment (HDFC CollectNow)</div>
    <div class="muted" style="margin-top:6px">
      The checkout will open below. If payment succeeds, you will be redirected to complete delivery details.
    </div>

    <div style="margin-top:12px">
      <iframe
        id="rzpFrame"
        name="rzp_iframe"
        title="Payment"
        style="width:100%;height:620px;border:1px solid #e2e8f0;border-radius:12px;background:#fff"
      ></iframe>
    </div>

    <!-- Razorpay Embedded Checkout Form -->
    <form
      id="rzpForm"
      method="POST"
      action="https://api.razorpay.com/v1/checkout/embedded"
      target="rzp_iframe"
      style="display:none"
    >
      <input type="hidden" name="key_id" value="<%= rzpKeyId %>">
      <input type="hidden" name="amount" value="<%= rzpAmountPaise %>">
      <input type="hidden" name="order_id" value="<%= rzpOrderId %>">
      <input type="hidden" name="callback_url" value="<%= callbackUrl %>">

      <input type="hidden" name="name" value="Wisdom Contest 2026">
      <input type="hidden" name="description" value="Krishna Contest Registration">

      <input type="hidden" name="prefill[name]" value="<%= prefillName %>">
      <input type="hidden" name="prefill[email]" value="<%= prefillEmail %>">
      <input type="hidden" name="prefill[contact]" value="<%= prefillContact %>">

      <input type="hidden" name="notes[payment_group]" value="<%= paymentId %>">
    </form>
  </div>

</div>

<script>
  const payBtn = document.getElementById("payBtn");
  const form = document.getElementById("rzpForm");

  payBtn?.addEventListener("click", () => {
    // Submit the embedded checkout form into iframe
    try {
      payBtn.disabled = true;
      payBtn.textContent = "Opening secure checkout...";
      form.submit();
    } catch (e) {
      payBtn.disabled = false;
      payBtn.textContent = "Pay Now (HDFC Embedded)";
      alert("Unable to open payment. Please try again.");
    }
  });
</script>

</body>
</html>