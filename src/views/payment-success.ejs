<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Registration Successful - BhakthiVedanta Wisdom Contest 2026</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .success-container {
      background: white;
      border-radius: 25px;
      box-shadow: 0 15px 50px rgba(0, 0, 0, 0.1);
      max-width: 550px;
      width: 100%;
      text-align: center;
      padding: 60px 40px;
      position: relative;
      overflow: hidden;
    }

    .success-container::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 6px;
      background: linear-gradient(90deg, #4caf50, #81c784, #4caf50);
      animation: shimmer 2s ease-in-out infinite;
    }

    @keyframes shimmer {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.7; }
    }

    .success-icon {
      width: 100px;
      height: 100px;
      background: linear-gradient(135deg, #4caf50 0%, #81c784 100%);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 30px;
      animation: pop 0.6s ease-out;
      box-shadow: 0 10px 30px rgba(76, 175, 80, 0.3);
    }

    @keyframes pop {
      0% { transform: scale(0.2); opacity: 0; }
      70% { transform: scale(1.1); opacity: 1; }
      100% { transform: scale(1); }
    }

    .success-icon::before {
      content: '✓';
      color: white;
      font-size: 52px;
      font-weight: bold;
    }

    h1 {
      color: #2e7d32;
      font-size: 30px;
      margin-bottom: 12px;
    }

    .message {
      color: #37474f;
      font-size: 16px;
      line-height: 1.7;
      margin-bottom: 10px;
    }

    .info-box {
      background: rgba(76, 175, 80, 0.08);
      border: 2px solid rgba(76, 175, 80, 0.2);
      border-radius: 15px;
      padding: 22px;
      margin: 24px 0;
      text-align: left;
      color: #1b5e20;
      line-height: 1.6;
      font-size: 14px;
    }

    .btn {
      display: inline-block;
      padding: 14px 26px;
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      color: white;
      text-decoration: none;
      border-radius: 16px;
      font-weight: 800;
      font-size: 15px;
      margin-top: 10px;
      transition: all 0.3s ease;
      box-shadow: 0 6px 20px rgba(37, 99, 235, 0.25);
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(37, 99, 235, 0.35);
    }

    .muted {
      margin-top: 14px;
      color: #607d8b;
      font-size: 12px;
    }

    @media (max-width: 480px) {
      .success-container { padding: 50px 30px; }
      h1 { font-size: 24px; }
      .success-icon { width: 80px; height: 80px; }
      .success-icon::before { font-size: 42px; }
    }
  </style>
</head>
<body>
  <div class="success-container">
    <div class="success-icon"></div>

    <h1>Registration Successful 🎉</h1>

    <% if (deliveryMode === 'donate') { %>
      <p class="message">Thank you! Your registration is confirmed.</p>
      <p class="message">You chose to <b>donate</b> the gift books. We will donate them to someone on your behalf.</p>
      <div class="info-box">
        <b>What happens next?</b><br/>
        • We’ll count your contest registration as confirmed.<br/>
        • The books will be donated via the temple distribution program.<br/>
        • If you need help, WhatsApp us at <b>+91 9493805059</b>.
      </div>
    <% } else { %>
      <p class="message">Thank you! Your registration is confirmed.</p>
      <p class="message">You chose <b>delivery</b>. We will dispatch your gift books soon.</p>
      <div class="info-box">
        <b>What happens next?</b><br/>
        • Books will be dispatched within <b>7–15 business days</b>.<br/>
        • You can revisit “My Contests” anytime from the dashboard.<br/>
        • If you need help, WhatsApp us at <b>+91 9493805059</b>.
      </div>
    <% } %>

    <a class="btn" href="/dashboard">Go to Dashboard</a>

    <div class="muted">BhakthiVedanta Wisdom Contest 2026 • ISKCON</div>
  </div>
</body>
</html>
