<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Payment Status</title>
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:Segoe UI,Tahoma,Verdana,sans-serif;background:#f5f7fb;padding:18px}
    .wrap{max-width:860px;margin:0 auto;background:#fff;border-radius:18px;box-shadow:0 12px 30px rgba(0,0,0,.08);overflow:hidden}
    .top{padding:20px;background:linear-gradient(135deg,#1a237e,#283593);color:#fff}
    .top h1{font-size:22px;margin-bottom:6px}
    .top p{opacity:.92;font-size:13px;line-height:1.5}
    .content{padding:18px}
    .box{border:1px solid #e5e7eb;border-radius:14px;padding:14px;margin-bottom:14px}
    .pill{display:inline-block;padding:6px 10px;border-radius:999px;background:#eef2ff;color:#243b8b;font-size:12px;font-weight:900;margin:4px 6px 0 0}
    .ok{background:#ecfdf3;color:#166534}
    .bad{background:#fef2f2;color:#991b1b}
    .btnRow{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
    .btn{display:inline-block;border:0;border-radius:12px;padding:12px 16px;font-weight:1000;text-decoration:none}
    .primary{background:linear-gradient(135deg,#1a237e,#3949ab);color:#fff}
    .ghost{background:#fff;border:1px solid #cbd5e1;color:#1e293b}
  </style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <% if (paid) { %>
      <h1>Payment Successful ✅</h1>
      <p>Your registration is confirmed. You can now view all purchased contests under My Contests.</p>
    <% } else { %>
      <h1>Payment Not Completed ⚠️</h1>
      <p>We could not confirm your payment yet. Please retry payment.</p>
    <% } %>
  </div>

  <div class="content">
    <div class="box">
      <div><b>Reference:</b> <%= paymentId %></div>
      <div style="margin-top:10px">
        <% orders.forEach((o) => { %>
          <span class="pill"><%= o.contest_title %></span>
        <% }) %>
      </div>
      <div style="margin-top:10px">
        <span class="pill <%= paid ? 'ok' : 'bad' %>"><%= paid ? 'Paid' : 'Pending / Failed' %></span>
      </div>
    </div>

    <% if (paid && shipment) { %>
      <div class="box">
        <div><b>Delivery Name:</b> <%= shipment.full_name || '-' %></div>
        <div><b>Phone:</b> <%= shipment.phone || '-' %></div>
        <div><b>Address:</b> <%= shipment.address_line1 || '-' %>, <%= shipment.city || '-' %>, <%= shipment.state || '-' %> - <%= shipment.pincode || '-' %></div>
      </div>
    <% } %>

    <div class="btnRow">
      <% if (paid) { %>
        <a class="btn primary" href="/dashboard/my-contests">Go to My Contests</a>
        <a class="btn ghost" href="/dashboard">Back to Dashboard</a>
      <% } else { %>
        <a class="btn primary" href="/payment/embedded?paymentId=<%= encodeURIComponent(paymentId) %>">Retry Payment</a>
        <a class="btn ghost" href="/dashboard">Back to Dashboard</a>
      <% } %>
    </div>
  </div>
</div>
</body>
</html>