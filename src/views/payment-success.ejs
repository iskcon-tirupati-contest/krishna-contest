<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Payment Successful</title>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --navy:       #1a237e;
      --navy-mid:   #283593;
      --navy-light: #3949ab;
      --accent:     #5c6bc0;
      --gold:       #f59e0b;
      --gold-light: #fef3c7;
      --gold-dark:  #92400e;
      --green:      #10b981;
      --green-light:#d1fae5;
      --green-dark: #065f46;
      --sky:        #e8eaf6;
      --slate:      #f1f5f9;
      --border:     #c5cae9;
      --text-dark:  #0f172a;
      --text-mid:   #334155;
      --text-muted: #64748b;
      --white:      #ffffff;
      --shadow:     0 20px 60px rgba(26,35,126,.13);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'DM Sans', sans-serif;
      background: linear-gradient(160deg, #e8eaf6 0%, #f1f5f9 60%, #dde3f8 100%);
      min-height: 100vh;
      padding: 28px 18px 48px;
      color: var(--text-dark);
    }

    /* ── wrapper ── */
    .wrap {
      max-width: 780px;
      margin: 0 auto;
      background: var(--white);
      border-radius: 28px;
      box-shadow: var(--shadow);
      overflow: hidden;
      border: 1px solid rgba(197,202,233,.5);
    }

    /* ── hero header ── */
    .top {
      padding: 32px 28px;
      background: linear-gradient(135deg, var(--navy) 0%, var(--navy-mid) 55%, var(--navy-light) 100%);
      color: var(--white);
      position: relative;
      overflow: hidden;
    }
    .top::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 80% 20%, rgba(255,255,255,.07) 0%, transparent 60%),
                  radial-gradient(circle at 10% 90%, rgba(92,107,192,.3) 0%, transparent 55%);
      pointer-events: none;
    }
    .top-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255,255,255,.15);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255,255,255,.25);
      border-radius: 999px;
      padding: 6px 14px;
      font-family: 'Sora', sans-serif;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 14px;
      letter-spacing: .3px;
    }
    .top-badge .dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 0 3px rgba(16,185,129,.35);
      animation: pulse 1.8s ease-in-out infinite;
    }
    @keyframes pulse {
      0%,100% { box-shadow: 0 0 0 3px rgba(16,185,129,.35); }
      50%      { box-shadow: 0 0 0 6px rgba(16,185,129,.12); }
    }
    .top h1 {
      font-family: 'Sora', sans-serif;
      font-size: 30px;
      font-weight: 800;
      letter-spacing: -.3px;
      margin-bottom: 14px;
    }
    .id-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .id-chip {
      background: rgba(255,255,255,.12);
      border: 1px solid rgba(255,255,255,.2);
      border-radius: 10px;
      padding: 6px 14px;
      font-size: 12px;
      font-family: 'Sora', sans-serif;
      font-weight: 600;
    }
    .id-chip span { opacity: .7; font-weight: 400; margin-right: 6px; }

    /* ── content area ── */
    .content { padding: 22px; display: flex; flex-direction: column; gap: 16px; }

    /* ── generic card ── */
    .box {
      border-radius: 20px;
      padding: 20px;
      border: 1.5px solid var(--border);
      background: var(--white);
      transition: box-shadow .2s;
    }
    .box:hover { box-shadow: 0 6px 24px rgba(26,35,126,.07); }

    .box-title {
      font-family: 'Sora', sans-serif;
      font-size: 15px;
      font-weight: 700;
      color: var(--text-dark);
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .box-title .icon {
      width: 30px; height: 30px;
      border-radius: 8px;
      display: grid; place-items: center;
      font-size: 15px;
      flex-shrink: 0;
    }

    /* ── deadline banner ── */
    .box.deadline {
      background: linear-gradient(135deg, var(--gold-light) 0%, #fffbeb 100%);
      border-color: #fde68a;
    }
    .box.deadline .box-title { color: var(--gold-dark); }
    .box.deadline .icon { background: #fef3c7; }
    .deadline-hero {
      font-family: 'Sora', sans-serif;
      font-size: 22px;
      font-weight: 800;
      color: var(--gold-dark);
      margin-bottom: 10px;
      letter-spacing: -.2px;
    }
    .deadline-sub {
      font-size: 14px;
      color: #78350f;
      line-height: 1.6;
      font-weight: 500;
      display: flex;
      align-items: baseline;
      gap: 6px;
    }
    .deadline-sub strong { color: var(--gold-dark); }
    .icon-inline { font-size: 15px; flex-shrink: 0; }

    /* ── contests ── */
    .box.contests { background: var(--sky); border-color: #9fa8da; }
    .box.contests .box-title { color: var(--navy); }
    .box.contests .icon { background: #e8eaf6; }

    /* ── books ── */
    .box.books { background: #f0fdf4; border-color: #a7f3d0; }
    .box.books .box-title { color: var(--green-dark); }
    .box.books .icon { background: var(--green-light); }

    /* ── delivery ── */
    .box.delivery { background: #fafbff; border-color: var(--border); }
    .box.delivery .box-title { color: var(--navy-mid); }
    .box.delivery .icon { background: var(--sky); }

    /* ── support ── */
    .box.support {
      background: linear-gradient(135deg, #1a237e 0%, #283593 100%);
      border-color: transparent;
    }
    .box.support .box-title { color: #fff; }
    .box.support .icon { background: rgba(255,255,255,.15); }
    .support-text {
      font-size: 14px;
      color: rgba(255,255,255,.85);
      line-height: 1.7;
    }
    .support-text b { color: #fff; font-weight: 700; }
    .wa-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: rgba(255,255,255,.15);
      border: 1px solid rgba(255,255,255,.25);
      border-radius: 10px;
      padding: 7px 14px;
      font-size: 13px;
      font-weight: 700;
      color: #fff;
      margin-top: 12px;
      letter-spacing: .2px;
    }

    /* ── list items ── */
    .list { display: flex; flex-direction: column; gap: 10px; }

    .item {
      border-radius: 14px;
      padding: 14px 16px;
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }
    .item-num {
      width: 28px; height: 28px;
      border-radius: 8px;
      display: grid; place-items: center;
      font-family: 'Sora', sans-serif;
      font-size: 12px;
      font-weight: 700;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .item-body { flex: 1; }
    .item-title { font-family: 'Sora', sans-serif; font-size: 14px; font-weight: 700; }
    .item-sub   { font-size: 13px; margin-top: 3px; }

    /* contest item colours */
    .item.contest-item { background: rgba(255,255,255,.7); border: 1px solid #c5cae9; }
    .item.contest-item .item-num { background: var(--navy); color: #fff; }
    .item.contest-item .item-title { color: var(--navy); }
    .item.contest-item .item-sub   { color: var(--accent); }

    /* book item colours */
    .item.book-item { background: rgba(255,255,255,.8); border: 1px solid #a7f3d0; }
    .item.book-item .item-num { background: var(--green); color: #fff; }
    .item.book-item .item-title { color: var(--green-dark); }
    .item.book-item .item-sub   { color: #059669; }

    /* bonus item */
    .item.bonus-item { background: #fffbeb; border: 1px solid #fde68a; }
    .item.bonus-item .item-num { background: var(--gold); color: #fff; }
    .item.bonus-item .item-title { color: var(--gold-dark); }
    .item.bonus-item .item-sub   { color: #b45309; }
    .bonus-tag {
      display: inline-block;
      background: var(--gold-light);
      color: var(--gold-dark);
      border: 1px solid #fde68a;
      border-radius: 999px;
      padding: 2px 8px;
      font-size: 11px;
      font-weight: 700;
      margin-left: 6px;
      vertical-align: middle;
    }

    /* ── delivery details ── */
    .muted { font-size: 14px; color: var(--text-mid); line-height: 1.8; }
    .muted b { color: var(--text-dark); font-weight: 600; }
    .detail-grid {
      display: grid;
      gap: 10px;
      margin-top: 4px;
    }
    .detail-row {
      display: flex;
      gap: 10px;
      align-items: baseline;
    }
    .detail-label {
      font-size: 12px;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: .5px;
      min-width: 110px;
      flex-shrink: 0;
    }
    .detail-val {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-dark);
    }
    .delivery-note {
      margin-top: 12px;
      background: var(--sky);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 10px 14px;
      font-size: 13px;
      color: var(--navy-mid);
      font-weight: 500;
      line-height: 1.5;
    }

    /* ── buttons ── */
    .btnRow { display: flex; gap: 12px; flex-wrap: wrap; padding: 0 22px 24px; }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      border-radius: 14px;
      padding: 13px 22px;
      font-family: 'Sora', sans-serif;
      font-weight: 700;
      font-size: 14px;
      text-decoration: none;
      transition: transform .15s, box-shadow .15s;
      cursor: pointer;
    }
    .btn:hover { transform: translateY(-2px); }
    .primary {
      background: linear-gradient(135deg, var(--navy), var(--navy-light));
      color: #fff;
      box-shadow: 0 6px 20px rgba(26,35,126,.3);
    }
    .primary:hover { box-shadow: 0 10px 28px rgba(26,35,126,.4); }
    .ghost {
      background: var(--white);
      border: 1.5px solid var(--border);
      color: var(--text-dark);
    }
    .ghost:hover { background: var(--slate); }

    /* ── responsive ── */
    @media (max-width: 520px) {
      .top { padding: 24px 20px; }
      .top h1 { font-size: 24px; }
      .content { padding: 16px; }
      .btnRow { padding: 0 16px 20px; }
      .detail-label { min-width: 90px; }
    }
  </style>
</head>
<body>
<div class="wrap">

  <!-- ── HEADER ── -->
  <div class="top">
    <h1>Payment Successful ✅</h1>
    <div class="id-row">
      <div class="id-chip"><span>Order ID</span><%= paymentId %></div>
      <div class="id-chip"><span>Session ID</span><%= payment_session_id %></div>
    </div>
  </div>
  </div>

  <div class="content">

    <!-- ── DEADLINE ── -->
    <div class="box deadline">
      <div class="deadline-hero">🎉 Thanks for joining the contests!</div>
      <div class="deadline-sub">
        <span class="icon-inline">📅</span>
        Please submit your essay before <strong>09 September 2026</strong>. Late entries will not be accepted.
      </div>
    </div>

    <!-- ── CONTESTS REGISTERED ── -->
    <div class="box contests">
      <div class="box-title"><span class="icon">🏆</span> Contests Registered</div>
      <div class="list">
        <% (orders || []).forEach((o, i) => { %>
          <div class="item contest-item">
            <div class="item-num"><%= i + 1 %></div>
            <div class="item-body">
              <div class="item-title"><%= o.contest_title %></div>
              <div class="item-sub">Age Category: <%= o.age_category === 'above-25' ? 'Above 25 years' : '0 to 25 years' %></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- ── BOOKS SELECTED ── -->
    <% if ((shipmentItems || []).length > 0 || (bonusItems || []).length > 0) { %>
      <div class="box books">
        <div class="box-title"><span class="icon">📚</span> Books Selected</div>
        <div class="list">
          <% (shipmentItems || []).forEach((b, i) => { %>
            <div class="item book-item">
              <div class="item-num"><%= i + 1 %></div>
              <div class="item-body">
                <div class="item-title"><%= b.book_title %></div>
                <div class="item-sub"><%= b.book_language %> &bull; For <%= b.contest_title %></div>
              </div>
            </div>
          <% }) %>

          <% (bonusItems || []).forEach((b, i) => { %>
            <div class="item bonus-item">
              <div class="item-num">★</div>
              <div class="item-body">
                <div class="item-title"><%= b.book_title %><span class="bonus-tag">Free Bonus</span></div>
                <div class="item-sub"><%= b.book_language %></div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- ── DELIVERY / COLLECTION ── -->
    <div class="box delivery">
      <div class="box-title"><span class="icon">📦</span> Delivery / Collection Details</div>

      <% if (shipment?.delivery_mode === 'home_delivery') { %>
        <div class="detail-grid">
          <div class="detail-row">
            <span class="detail-label">Recipient</span>
            <span class="detail-val"><%= shipment.recipient_name || user?.name || '-' %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Phone</span>
            <span class="detail-val"><%= shipment.recipient_phone || user?.phone || '-' %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Address</span>
            <span class="detail-val"><%= shipment.address || '-' %>, <%= shipment.city || '-' %>, <%= shipment.state || '-' %> – <%= shipment.pincode || '-' %></span>
          </div>
        </div>
        <div class="delivery-note">📬 Your books will be delivered to the address above.</div>

      <% } else if (shipment?.delivery_mode === 'temple_pickup') { %>
        <div class="detail-grid">
          <div class="detail-row">
            <span class="detail-label">Recipient</span>
            <span class="detail-val"><%= shipment.recipient_name || user?.name || '-' %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Phone</span>
            <span class="detail-val"><%= shipment.recipient_phone || user?.phone || '-' %></span>
          </div>
        </div>
        <div class="delivery-note">🛕 Please collect your books from the contest stall at the temple. Your handover status will remain pending until books are collected.</div>

      <% } else { %>
        <div class="muted">🙏 You have selected donation. The books will be donated by the temple on your behalf.</div>
      <% } %>
    </div>

    <!-- ── SUPPORT ── -->
    <div class="box support">
      <div class="box-title"><span class="icon">💬</span> Need Help?</div>
      <div class="support-text">
        For any queries, reach out to us on WhatsApp — we are available <b>24×7</b> to assist you.
      </div>
      <div class="wa-badge">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.118 1.522 5.852L.057 23.7a.5.5 0 0 0 .611.638l5.99-1.571A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.885 0-3.65-.51-5.17-1.399l-.37-.22-3.558.933.95-3.47-.241-.38A9.944 9.944 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
        9493805059
      </div>
    </div>

  </div><!-- /content -->

  <!-- ── BUTTONS ── -->
  <div class="btnRow">
    <a class="btn primary" href="/dashboard/my-contests">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
      Go to My Contests
    </a>
    <a class="btn ghost" href="/dashboard">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      Back to Dashboard
    </a>
  </div>

</div>
</body>
</html>