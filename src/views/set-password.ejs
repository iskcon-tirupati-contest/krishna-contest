<!DOCTYPE html>
<html lang="en">
<head>
  <title>Set Your Password – ISKCON Tirupati Essay Contest</title>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
  <style>
    :root{--navy:#1a237e;--navy-mid:#283593;--navy-lt:#3949ab;--gold:#f59e0b;--green:#10b981;--green-lt:#d1fae5;--green-dark:#065f46;--red:#ef4444;--red-lt:#fee2e2;--red-dark:#991b1b;--text-h:#0f172a;--text-b:#1e293b;--text-mid:#334155;--text-muted:#64748b}
    *{box-sizing:border-box;margin:0;padding:0}
    html,body{min-height:100%;font-family:'DM Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
    body{background:#0d1340;display:flex;align-items:center;justify-content:center;padding:20px;min-height:100vh;position:relative;overflow:hidden}
    .bg-orb{position:fixed;border-radius:50%;pointer-events:none;z-index:0}
    .bg-orb-1{width:500px;height:500px;top:-200px;left:-150px;background:radial-gradient(circle,rgba(92,107,192,.3) 0%,transparent 70%)}
    .bg-orb-2{width:450px;height:450px;bottom:-150px;right:-100px;background:radial-gradient(circle,rgba(245,158,11,.12) 0%,transparent 70%)}
    body::before{content:'';position:fixed;inset:0;background-image:radial-gradient(rgba(255,255,255,.06) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;z-index:0}

    .card{position:relative;z-index:1;width:100%;max-width:440px;background:rgba(255,255,255,.97);border-radius:28px;box-shadow:0 32px 80px rgba(0,0,0,.4),0 0 0 1px rgba(255,255,255,.08);overflow:hidden}
    .card-accent{height:5px;background:linear-gradient(90deg,#f59e0b 0%,#f97316 50%,#1a237e 100%)}
    .card-body{padding:30px 28px 26px}

    /* brand */
    .brand{display:flex;flex-direction:column;align-items:center;margin-bottom:22px}
    .brand-logo{width:64px;height:64px;border-radius:18px;background:linear-gradient(135deg,#f59e0b,#f97316);display:flex;align-items:center;justify-content:center;margin-bottom:10px;box-shadow:0 8px 24px rgba(245,158,11,.35)}
    .brand-logo svg{width:32px;height:32px;fill:#fff}
    .brand-name{font-family:'Sora',sans-serif;font-size:12px;font-weight:700;color:var(--text-muted);text-align:center;letter-spacing:.3px;text-transform:uppercase}

    /* welcome strip */
    .welcome-strip{
      background:linear-gradient(135deg,#f0fdf4,#dcfce7);
      border:1.5px solid #86efac;
      border-radius:14px;
      padding:12px 14px;
      margin-bottom:22px;
      display:flex;align-items:flex-start;gap:10px;
    }
    .ws-icon{font-size:20px;flex-shrink:0;margin-top:1px}
    .ws-title{font-family:'Sora',sans-serif;font-size:13px;font-weight:800;color:#065f46;margin-bottom:2px}
    .ws-sub{font-size:12px;color:#047857;line-height:1.4}

    h1{font-family:'Sora',sans-serif;font-size:22px;font-weight:800;color:var(--text-h);text-align:center;margin-bottom:5px}
    .sub{text-align:center;color:var(--text-muted);font-size:13px;line-height:1.55;margin-bottom:22px}

    .alert-box{display:none;margin-bottom:14px;padding:10px 13px;border-radius:11px;font-size:13px;font-weight:600}
    .alert-box.err{background:var(--red-lt);border:1.5px solid #fecaca;color:var(--red-dark)}
    .alert-box.ok{background:var(--green-lt);border:1.5px solid #a7f3d0;color:var(--green-dark)}

    .form-group{margin-bottom:14px}
    .field-label{display:block;font-size:12px;font-weight:700;color:var(--text-muted);margin-bottom:5px;letter-spacing:.2px}
    .input-wrap{position:relative}
    .input-icon{position:absolute;left:13px;top:50%;transform:translateY(-50%);width:17px;height:17px;fill:var(--text-muted);pointer-events:none}
    input{width:100%;padding:12px 44px 12px 40px;border:1.5px solid #d1d8f0;border-radius:13px;background:#fafbff;color:var(--text-b);font-size:14px;font-family:'DM Sans',system-ui,sans-serif;outline:none;transition:border-color .18s,box-shadow .18s,background .18s}
    input:focus{border-color:var(--navy-lt);box-shadow:0 0 0 3px rgba(92,107,192,.18);background:#fff}

    /* strength bar */
    .strength-wrap{margin-top:6px}
    .strength-bar{height:4px;border-radius:999px;background:#e2e8f0;overflow:hidden;margin-bottom:4px}
    .strength-fill{height:100%;border-radius:999px;width:0%;transition:width .3s,background .3s}
    .strength-label{font-size:11px;color:var(--text-muted)}

    .match-hint{margin-top:4px;font-size:11.5px}

    /* eye toggle */
    .eye-btn{position:absolute;right:12px;top:50%;transform:translateY(-50%);width:32px;height:32px;border:none;background:transparent;color:var(--text-muted);cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;border-radius:8px;transition:color .14s}
    .eye-btn:hover{color:var(--navy)}
    .eye-btn svg{width:18px;height:18px;fill:currentColor}

    .submit-btn{width:100%;border:none;border-radius:13px;padding:14px 18px;background:linear-gradient(135deg,#f59e0b 0%,#f97316 100%);color:#fff;font-family:'Sora',sans-serif;font-size:15px;font-weight:700;cursor:pointer;box-shadow:0 8px 22px rgba(245,158,11,.38);transition:transform .15s,box-shadow .15s,opacity .15s;display:flex;align-items:center;justify-content:center;gap:8px;margin-top:6px}
    .submit-btn:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(245,158,11,.5)}
    .submit-btn:active{transform:scale(.97)}
    .submit-btn:disabled{opacity:.6;cursor:not-allowed;transform:none}

    /* success screen */
    .success-screen{display:none;text-align:center;padding:10px 0}
    .success-icon{width:72px;height:72px;border-radius:50%;background:var(--green-lt);display:flex;align-items:center;justify-content:center;margin:0 auto 16px}
    .success-icon svg{width:36px;height:36px;fill:var(--green-dark)}
    .success-title{font-family:'Sora',sans-serif;font-size:22px;font-weight:800;color:var(--text-h);margin-bottom:8px}
    .success-sub{font-size:14px;color:var(--text-muted);line-height:1.6;margin-bottom:20px}
    .success-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%;border:none;border-radius:13px;padding:14px 18px;background:linear-gradient(135deg,var(--navy),var(--navy-lt));color:#fff;font-family:'Sora',sans-serif;font-size:15px;font-weight:700;cursor:pointer;box-shadow:0 8px 22px rgba(26,35,126,.32);text-decoration:none;transition:transform .15s,box-shadow .15s}
    .success-btn:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(26,35,126,.42)}

    .card-footer{background:#f8faff;border-top:1.5px solid #e8eaf6;padding:14px 28px;text-align:center;font-size:14px;color:var(--text-mid)}
    .card-footer a{color:var(--navy-lt);font-weight:700;text-decoration:none}
    .card-footer a:hover{color:var(--navy)}

    @keyframes spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}
    @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
    .fade-in{animation:fadeIn .28s ease}
  </style>
</head>
<body>
  <div class="bg-orb bg-orb-1"></div>
  <div class="bg-orb bg-orb-2"></div>

  <div class="card">
    <div class="card-accent"></div>
    <div class="card-body">

      <div class="brand">
        <div class="brand-logo">
          <svg viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
        </div>
        <div class="brand-name">ISKCON Tirupati Essay Contest</div>
      </div>

      <!-- Welcome strip -->
      <div class="welcome-strip">
        <div class="ws-icon">🎉</div>
        <div>
          <div class="ws-title">Registration Successful!</div>
          <div class="ws-sub">Set a password to access your dashboard and upload your essay.</div>
        </div>
      </div>

      <div id="errBox" class="alert-box err"></div>
      <div id="okBox"  class="alert-box ok"></div>

      <!-- Set password form -->
      <div id="formSection" class="fade-in">
        <h1>Set Your Password</h1>
        <p class="sub">Choose a password you'll remember to log in next time.</p>

        <div class="form-group">
          <label class="field-label">New Password</label>
          <div class="input-wrap">
            <svg class="input-icon" viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
            <input id="newPw" type="password" placeholder="Min 6 characters" autocomplete="new-password"/>
            <button class="eye-btn" type="button" id="eyeNew" aria-label="Show/hide password">
              <svg class="eye-closed" viewBox="0 0 24 24"><path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75C21.27 7.11 17 4 12 4c-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 6.13 11.35 6 12 6zm0-3C6.48 4 2 8.48 2 14c0 2.08.62 4.01 1.68 5.62L.29 22.42l1.42 1.42 3.07-3.07C6.08 21.62 7.95 22 10 22c5.52 0 10-4.48 10-10 0-2.08-.62-4.01-1.68-5.62l3.07-3.07-1.42-1.42L17.1 4.97C15.87 4.35 14 4 12 4zm0 13c-2.76 0-5-2.24-5-5 0-.65.13-1.26.36-1.83L4.44 7.25C2.93 8.51 1.73 10.14 1 12c1.73 4.39 6 7.5 11 7.5 1.4 0 2.74-.25 3.98-.7l-2.16-2.16C13.26 16.87 12.65 17 12 17z"/></svg>
              <svg class="eye-open"   viewBox="0 0 24 24" style="display:none"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
            </button>
          </div>
          <div class="strength-wrap">
            <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
            <div class="strength-label" id="strengthLabel"></div>
          </div>
        </div>

        <div class="form-group">
          <label class="field-label">Confirm Password</label>
          <div class="input-wrap">
            <svg class="input-icon" viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
            <input id="confirmPw" type="password" placeholder="Re-enter password" autocomplete="new-password"/>
            <button class="eye-btn" type="button" id="eyeConfirm" aria-label="Show/hide password">
              <svg class="eye-closed" viewBox="0 0 24 24"><path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75C21.27 7.11 17 4 12 4c-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 6.13 11.35 6 12 6zm0-3C6.48 4 2 8.48 2 14c0 2.08.62 4.01 1.68 5.62L.29 22.42l1.42 1.42 3.07-3.07C6.08 21.62 7.95 22 10 22c5.52 0 10-4.48 10-10 0-2.08-.62-4.01-1.68-5.62l3.07-3.07-1.42-1.42L17.1 4.97C15.87 4.35 14 4 12 4zm0 13c-2.76 0-5-2.24-5-5 0-.65.13-1.26.36-1.83L4.44 7.25C2.93 8.51 1.73 10.14 1 12c1.73 4.39 6 7.5 11 7.5 1.4 0 2.74-.25 3.98-.7l-2.16-2.16C13.26 16.87 12.65 17 12 17z"/></svg>
              <svg class="eye-open"   viewBox="0 0 24 24" style="display:none"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
            </button>
          </div>
          <div class="match-hint" id="matchHint"></div>
        </div>

        <button class="submit-btn" id="setPwBtn" type="button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
          Set Password & Continue
        </button>
      </div>

      <!-- Success screen -->
      <div id="successScreen" class="success-screen">
        <div class="success-icon">
          <svg viewBox="0 0 24 24"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
        </div>
        <div class="success-title">Password Set! 🎉</div>
        <div class="success-sub">You're all set. Head to My Contests to view your registration and upload your essay.</div>
        <a class="success-btn" href="/dashboard/my-contests">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
          Go to My Contests
        </a>
      </div>

    </div><!-- /card-body -->

    <div class="card-footer" id="cardFooter">
      Want to skip for now? <a href="/dashboard">Go to Dashboard</a>
    </div>
  </div>

<script>
(function(){
  const errBox   = document.getElementById('errBox');
  const okBox    = document.getElementById('okBox');
  const newPwEl  = document.getElementById('newPw');
  const confPwEl = document.getElementById('confirmPw');
  const matchHint= document.getElementById('matchHint');
  const fillEl   = document.getElementById('strengthFill');
  const labelEl  = document.getElementById('strengthLabel');

  function showErr(msg){ errBox.textContent = msg; errBox.style.display = 'block'; okBox.style.display = 'none'; }
  function clearMsg()  { errBox.style.display = 'none'; okBox.style.display = 'none'; }

  /* ── Eye toggles ── */
  function makeEye(btnId, inputEl){
    document.getElementById(btnId).addEventListener('click', function(){
      const isPass = inputEl.type === 'password';
      inputEl.type = isPass ? 'text' : 'password';
      this.querySelector('.eye-closed').style.display = isPass ? 'none'  : 'block';
      this.querySelector('.eye-open'  ).style.display = isPass ? 'block' : 'none';
    });
  }
  makeEye('eyeNew',     newPwEl);
  makeEye('eyeConfirm', confPwEl);

  /* ── Password strength ── */
  function calcStrength(pw){
    if (!pw) return 0;
    let s = 0;
    if (pw.length >= 6)  s++;
    if (pw.length >= 10) s++;
    if (/[A-Z]/.test(pw)) s++;
    if (/[0-9]/.test(pw)) s++;
    if (/[^A-Za-z0-9]/.test(pw)) s++;
    return s;
  }
  newPwEl.addEventListener('input', function(){
    const s = calcStrength(this.value);
    const pct = [0, 20, 40, 65, 85, 100][s];
    const colors = ['', '#ef4444', '#f97316', '#f59e0b', '#84cc16', '#10b981'];
    const labels = ['', 'Too weak', 'Weak', 'Fair', 'Good', 'Strong'];
    fillEl.style.width      = pct + '%';
    fillEl.style.background = colors[s] || '';
    labelEl.textContent     = this.value ? labels[s] : '';
    labelEl.style.color     = colors[s] || '';
    checkMatch();
  });

  /* ── Match hint ── */
  function checkMatch(){
    if (!confPwEl.value){ matchHint.textContent = ''; return; }
    if (confPwEl.value === newPwEl.value){
      matchHint.textContent = '✓ Passwords match';
      matchHint.style.color = '#059669';
    } else {
      matchHint.textContent = '✗ Passwords do not match';
      matchHint.style.color = '#ef4444';
    }
  }
  confPwEl.addEventListener('input', checkMatch);

  /* ── Submit ── */
  document.getElementById('setPwBtn').addEventListener('click', async function(){
    clearMsg();
    const pw   = newPwEl.value;
    const conf = confPwEl.value;
    if (pw.length < 6)   return showErr('Password must be at least 6 characters.');
    if (pw !== conf)      return showErr('Passwords do not match.');

    this.disabled = true;
    this.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="animation:spin 1s linear infinite"><path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 14.03 20 13.07 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 9.97 4 10.93 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/></svg> Saving...';

    try {
      const r = await fetch('/set-password', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ newPassword: pw, confirmPassword: conf }),
      });
      const d = await r.json();
      if (!r.ok || !d.ok) throw new Error(d.message || 'Failed to set password');

      // Show success screen
      document.getElementById('formSection').style.display  = 'none';
      document.getElementById('successScreen').style.display = 'block';
      document.getElementById('cardFooter').style.display    = 'none';
      errBox.style.display = 'none';

    } catch(e) {
      showErr(e.message || 'Something went wrong. Please try again.');
      this.disabled = false;
      this.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg> Set Password & Continue';
    }
  });
})();
</script>
</body>
</html>
