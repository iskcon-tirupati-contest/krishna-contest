<h2>Available Contests</h2>

<% contests.forEach(contest => { %>
<div class="card">
    <h3><%= contest.title %></h3>
    <p><%= contest.description %></p>
    <p><strong>Price:</strong> ₹<%= contest.price %></p>

    <% if (purchased.includes(contest.id)) { %>
        <div class="success">Already Registered ✅</div>
    <% } else { %>
        <form method="POST" action="/participate/<%= contest.id %>">
            <button type="submit">Participate</button>
        </form>
    <% } %>
</div>
<% }) %>

