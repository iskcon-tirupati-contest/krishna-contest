<!DOCTYPE html>
<html>
<head>
    <title>Krishna National Contest 2026</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(to bottom, #8B5E3C, #3E2723);
            color: white;
        }

        .navbar {
            background: #4E342E;
            padding: 15px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .navbar a {
            color: #FFD700;
            text-decoration: none;
            margin-left: 20px;
            font-weight: bold;
        }

        .hero {
            text-align: center;
            padding: 120px 20px;
        }

        .hero h1 {
            font-size: 48px;
            color: #FFD700;
        }

        .hero p {
            font-size: 20px;
            margin-top: 10px;
        }

        .btn {
            margin-top: 30px;
            padding: 15px 30px;
            background: #FFD700;
            color: #4E342E;
            font-weight: bold;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
        }

        .section {
            padding: 60px 20px;
            text-align: center;
        }

        .section h2 {
            color: #FFD700;
            margin-bottom: 20px;
        }

        .cards {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
        }

        .card {
            background: rgba(0,0,0,0.4);
            padding: 25px;
            width: 250px;
            border-radius: 8px;
        }

        .footer {
            background: #2E1B12;
            padding: 30px;
            text-align: center;
            font-size: 14px;
        }

        .footer a {
            color: #FFD700;
            margin: 0 10px;
            text-decoration: none;
        }
    </style>
</head>
<body>

    <div class="navbar">
        <div><strong>Krishna National Contest 2026</strong></div>
        <div>
            <a href="/register">Register</a>
            <a href="/login">Login</a>
        </div>
    </div>

    <div class="hero">
        <h1>Krishna National Contest 2026</h1>
        <p>Celebrating Devotion, Creativity & Culture</p>
        <a href="/register">
            <button class="btn">Participate Now</button>
        </a>
    </div>

    <div class="section">
        <h2>Contest Categories</h2>
        <div class="cards">
            <div class="card">
                <h3>Krishna Painting Contest</h3>
                <p>Express devotion through art.</p>
            </div>
            <div class="card">
                <h3>Bhagavad Gita Essay</h3>
                <p>Share your understanding of Gita wisdom.</p>
            </div>
            <div class="card">
                <h3>Devotional Singing</h3>
                <p>Offer your bhajans and kirtans.</p>
            </div>
        </div>
    </div>

    <div class="section">
        <h2>About The Organizer</h2>
        <p>
            Organized by International Society for Krishna Consciousness (ISKCON).
            Promoting devotional culture and spiritual education across the nation.
        </p>
    </div>

    <div class="footer">
        <p>
            International Society for Krishna Consciousness (ISKCON)
        </p>
        <p>
            Email: support@krishnacontest.org | Phone: +91-XXXXXXXXXX
        </p>
        <p>
	   <a href="/about">About</a> |
	   <a href="/contact">Contact</a> |
            <a href="/privacy-policy">Privacy Policy</a> |
            <a href="/terms">Terms & Conditions</a> |
            <a href="/refund-policy">Refund Policy</a>
        </p>
        <p>© 2026 Krishna National Contest. All Rights Reserved.</p>
    </div>

</body>
</html>

