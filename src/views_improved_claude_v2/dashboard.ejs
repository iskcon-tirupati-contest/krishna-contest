<!DOCTYPE html>
<html lang="en">
<head>
    <title>Dashboard - Krishna Contest 2026</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1a237e 0%, #0d47a1 50%, #01579b 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            color: #fff;
        }

        /* Header */
        .navbar {
            background: rgba(13, 19, 38, 0.95);
            padding: 18px 0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        }

        .navbar-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo-img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #ffd700;
        }

        .logo-text {
            font-size: 24px;
            font-weight: bold;
            background: linear-gradient(135deg, #ffd700 0%, #ffb300 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .logout-btn {
            color: white;
            text-decoration: none;
            padding: 10px 25px;
            background: rgba(255, 215, 0, 0.2);
            border-radius: 25px;
            border: 2px solid #ffd700;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .logout-btn:hover {
            background: #ffd700;
            color: #1a237e;
        }

        /* Main */
        .main-content {
            flex: 1;
            padding: 40px 30px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .welcome-section {
            background: rgba(255, 255, 255, 0.1);
            padding: 30px;
            border-radius: 20px;
            margin-bottom: 40px;
            border: 1px solid rgba(255, 215, 0, 0.3);
            text-align: center;
        }

        .welcome-section h2 {
            color: #ffd700;
            font-size: 28px;
            margin-bottom: 10px;
        }

        .section-title {
            font-size: 32px;
            font-weight: 600;
            color: #ffd700;
            margin-bottom: 30px;
        }

        .contests-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 25px;
        }

        .card {
            background: rgba(255, 255, 255, 0.05);
            padding: 30px;
            border-radius: 20px;
            border: 1px solid rgba(255, 215, 0, 0.2);
            transition: all 0.3s ease;
        }

        .card:hover {
            transform: translateY(-5px);
            border-color: #ffd700;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
        }

        .card h3 {
            color: #ffd700;
            font-size: 22px;
            margin-bottom: 15px;
        }

        .card p {
            color: #e3f2fd;
            line-height: 1.7;
            margin-bottom: 15px;
        }

        .price-tag {
            display: inline-block;
            background: linear-gradient(135deg, #ffd700 0%, #ffb300 100%);
            color: #1a237e;
            padding: 8px 20px;
            border-radius: 25px;
            font-weight: 600;
            font-size: 18px;
            margin: 15px 0;
        }

        .participate-btn {
            width: 100%;
            padding: 14px;
            border: none;
            background: linear-gradient(135deg, #ffd700 0%, #ffb300 100%);
            color: #1a237e;
            border-radius: 12px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s ease;
            margin-top: 10px;
        }

        .participate-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(255, 215, 0, 0.4);
        }

        .registered {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: #4caf50;
            font-weight: 600;
            padding: 14px;
            background: rgba(76, 175, 80, 0.1);
            border: 2px solid #4caf50;
            border-radius: 12px;
            margin-top: 10px;
        }

        /* Footer */
        .footer {
            background: rgba(13, 19, 38, 0.95);
            padding: 25px 30px;
            text-align: center;
            border-top: 2px solid rgba(255, 215, 0, 0.2);
        }

        .footer p {
            color: #b0bec5;
            font-size: 14px;
        }

        @media (max-width: 768px) {
            .contests-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <nav class="navbar">
        <div class="navbar-content">
            <div class="logo-container">
                <img src="/lord_krishna.avif" alt="Krishna" class="logo-img" onerror="this.style.display='none'">
                <div class="logo-text">Krishna Contest</div>
            </div>
            <a href="/logout" class="logout-btn">Logout</a>
        </div>
    </nav>

    <div class="main-content">
        <div class="container">
            <div class="welcome-section">
                <h2>🙏 Welcome, Devotee!</h2>
                <p>Explore the contest categories below</p>
            </div>

            <div class="section-title">Available Contests</div>

            <% if (contests && contests.length > 0) { %>
                <div class="contests-grid">
                    <% contests.forEach(contest => { %>
                        <div class="card">
                            <h3><%= contest.title %></h3>
                            <p><%= contest.description %></p>
                            <div class="price-tag">₹<%= contest.price %></div>

                            <% if (purchased && purchased.includes(contest.id)) { %>
                                <div class="registered">✅ Already Registered</div>
                            <% } else { %>
                                <form method="POST" action="/participate/<%= contest.id %>">
                                    <button type="submit" class="participate-btn">Participate Now</button>
                                </form>
                            <% } %>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>

    <footer class="footer">
        <p>© 2026 Krishna Contest. All Rights Reserved.</p>
    </footer>

</body>
</html>
